<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:AccountERP.MobileDesktop"
    xmlns:shared="clr-namespace:AccountERP.SharedUI;assembly=AccountERP.SharedUI"
             x:Class="AccountERP.MobileDesktop.MainPage">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <!-- 🟢 استدعاء الـ Routes من الجذر مباشرة بنجاح تام -->
                <RootComponent Selector="#app" ComponentType="{x:Type shared:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
    </Grid>
</ContentPage>