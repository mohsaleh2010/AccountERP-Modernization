    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AccountERP.Web.styles.css"]" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
<link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
   
    @if (LangService.IsArabic)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css">
    }
    else
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    }

    @if (CultureInfo.CurrentCulture.TextInfo.IsRightToLeft)
    {
    }
    else
    {

    } *@

     <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["AccountERP.Web.styles.css"]" />
    @* 🟢 شارة عدد الإشعارات غير المقروءة (جرس الإشعارات فى الشريط العلوي، BadgeClass="notification-badge"
       فى NotificationsMenu.razor) كانت تُقص جزئياً من الأعلى داخل MudAppBar بوضع Dense - القيمة الافتراضية
       فى MudBlazor.min.css لـ mud-badge-top.right.mud-badge-overlap تضعها مرتفعة جداً (inset: ... calc(100% - 12px)
       calc(100% - 12px)). عمداً كـ <style> عام هنا (وليس ملف .razor.css خاص بالمكوّن نفسه) لأن شارة الـ scope
       الخاصة بعزل CSS فى Blazor لم تصل إطلاقاً لعناصر MudBadge/MudMenu الداخلية فى هذه الشجرة (تم التأكد فعلياً
       فى المتصفح)، فـ ::deep داخل ملف .razor.css لم يكن له أثر - تعديل CSS عام هنا هو الحل الموثوق والمباشر. *@
    <style>
        .mud-badge.mud-badge-top.right.mud-badge-overlap.notification-badge {
            inset: auto auto calc(100% - 22px) calc(100% - 20px) !important;
        }
    </style>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
   <!-- استخدام الاسم الكامل للمكون المشترك لحل التعارض وتفعيل التفاعلية عليه بسلام -->
<AccountERP.SharedUI.Routes @rendermode="InteractiveServer" />
 
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/AccountERP.SharedUI/js/interop.js"></script>
</body>
</html>