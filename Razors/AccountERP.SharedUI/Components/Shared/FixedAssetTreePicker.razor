@* 🟢 مكوّن شجرة الأصول الثابتة القابل لإعادة الاستخدام - نسخة مُقتبَسة من CostCenterTreePicker.razor بنفس
   الشكل/السلوك، لكن مبنية على FixedAssetNodeViewModel/AccountsTree.Get_FixedAsset_Account (نفس شجرة
   الحسابات العامة Submain_Account.Main_Account_Id، مُقيَّدة على Account_Customer_Type_Value=8 - نفس شرط
   Main_FixedAsset_Id/FixedAssetTreeViewUSCTRL.Fill_Account_Tree الأصلى بالضبط). عقد الشجرة هنا يمكن أن
   تكون "فئة" أو "أصل فعلى" - لا فرق بينهما فى شكل العرض هنا (كلاهما بنفس الأيقونة)، التمييز الفعلى يتم فى
   الشاشة المستضيفة عند التحديد (FixedAssetCLS.Get_FixedAsset) تماماً كما يفعل الأصل. يحمّل بياناته بنفسه
   لكل Branch_Id (نفس شجرة الحسابات العامة، مُفلترة بفرع) ولا يفترض شيئاً عن استخدام المستدعي له. *@

@using System.Data
@using System.Globalization
@using Microsoft.AspNetCore.Components
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.ViewModels
@inject LanguageService LangService
@inject IJSRuntime JSRuntime

<div class="fixed-asset-tree-picker-root" style="@($"height:{Height ?? "100%"};")">
    <div class="fixed-asset-tree-scroll" @ref="_scrollRef">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2">
            <MudTooltip Text="@Tr("ExpandAllAccounts")">
                <MudIconButton Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" OnClick="ExpandAll" Disabled="@(_roots.Count == 0)" />
            </MudTooltip>
            <MudTooltip Text="@Tr("CollapseAllAccounts")">
                <MudIconButton Icon="@Icons.Material.Filled.UnfoldLess" Size="Size.Small" OnClick="CollapseAll" Disabled="@(_roots.Count == 0)" />
            </MudTooltip>
            <MudAutocomplete T="FixedAssetNodeViewModel" Value="null" ValueChanged="OnSearchResultSelected"
                              SearchFunc="SearchAsync" ToStringFunc="@(a => a == null ? null : $"{a.SubAccount_NO}  {a.SubAccount_Name}")"
                              Label="@Tr("SearchAccountLabel")" Placeholder="@Tr("SearchAccountPlaceholder")"
                              Variant="Variant.Outlined" Dense="true" Clearable="true" ResetValueOnEmptyText="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="flex:1; min-width:200px;" />
        </MudStack>

        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2" />
        }

        <div class="fixed-asset-tree-guides">
            @if (_roots.Count == 0 && !_isLoading)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("NoFixedAssetsYet")</MudAlert>
            }
            else
            {
                <MudTreeView T="FixedAssetNodeViewModel" Items="@_treeItems" Hover="true" ExpandOnClick="true"
                             SelectedValue="SelectedValue" SelectedValueChanged="OnNodeSelected">
                    <ItemTemplate>
                        <MudTreeViewItem T="FixedAssetNodeViewModel" Value="@context.Value" Items="@context.Children"
                                          Icon="@context.Icon" Text="@context.Text"
                                          @bind-Expanded="context.Expanded" />
                    </ItemTemplate>
                </MudTreeView>
            }
        </div>
    </div>

    @if (_roots.Count > 0)
    {
        <MudTooltip Text="@Tr("ScrollTreeToTop")">
            <MudIconButton Icon="@Icons.Material.Filled.KeyboardDoubleArrowUp" Color="Color.Primary" Variant="Variant.Filled"
                           Size="Size.Small" Class="fixed-asset-tree-scrolltop-fab" OnClick="ScrollToTopAsync" />
        </MudTooltip>
    }
</div>

<style>
    .fixed-asset-tree-picker-root {
        display: flex;
        flex-direction: column;
        position: relative;
    }

    .fixed-asset-tree-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .fixed-asset-tree-guides .mud-treeview-group {
        border-inline-start: 1px dashed var(--mud-palette-lines-default);
    }

    .fixed-asset-tree-guides .mud-treeview-group .mud-treeview-item-content {
        padding-inline-start: 4px;
    }

    .fixed-asset-tree-scrolltop-fab {
        position: absolute;
        bottom: 8px;
        inset-inline-end: 8px;
        z-index: 2;
        box-shadow: 0 2px 6px rgba(0,0,0,.3);
    }
</style>

@code {
    [Parameter] public FixedAssetNodeViewModel? SelectedValue { get; set; }
    [Parameter] public EventCallback<FixedAssetNodeViewModel?> SelectedValueChanged { get; set; }
    [Parameter] public long BranchId { get; set; }
    [Parameter] public string? Height { get; set; }

    private long _loadedForBranchId = -1;
    private bool _isLoading;
    private List<FixedAssetNodeViewModel> _roots = new();
    private List<TreeItemData<FixedAssetNodeViewModel>> _treeItems = new();
    private Dictionary<long, FixedAssetNodeViewModel> _nodeById = new();
    private Dictionary<long, TreeItemData<FixedAssetNodeViewModel>> _treeItemById = new();
    private ElementReference _scrollRef;

    private async Task ScrollToTopAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("accountErpInterop.scrollElementToTop", _scrollRef);
        }
        catch
        {
            // 🟢 غير حرج: قد يفشل النداء إن لم يكتمل ربط JS بعد أو أُزيل العنصر.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (BranchId != 0 && BranchId != _loadedForBranchId)
        {
            _loadedForBranchId = BranchId;
            await ReloadAsync();
        }
    }

    public async Task ReloadAsync()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var branchId = (int)BranchId;
            var roots = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                int excp = 0;
                var at = new AccountsTree();
                var dt = at.Get_FixedAsset_Account(ref excp, branchId);
                return FixedAssetNodeViewModel.BuildTree(dt);
            });
            _roots = roots;
            _nodeById = FlattenById(_roots);
            _treeItemById = new Dictionary<long, TreeItemData<FixedAssetNodeViewModel>>();
            _treeItems = BuildTreeItems(_roots, _treeItemById);
        }
        finally
        {
            _isLoading = false;
        }
    }

    public async Task SelectAndRevealAsync(long id)
    {
        if (!_nodeById.TryGetValue(id, out var node)) return;
        ExpandAncestors(node);
        await OnNodeSelected(node);
    }

    public void ExpandAncestors(FixedAssetNodeViewModel node)
    {
        FixedAssetNodeViewModel? current = node;
        while (current != null)
        {
            if (_treeItemById.TryGetValue(current.Id, out var item))
            {
                item.Expanded = true;
            }

            current = current.Main_Account_Id != 0 && _nodeById.TryGetValue(current.Main_Account_Id, out var parent)
                ? parent
                : null;
        }
    }

    private void ExpandAll() => SetExpandedRecursive(_treeItems, true);

    private void CollapseAll() => SetExpandedRecursive(_treeItems, false);

    private static void SetExpandedRecursive(List<TreeItemData<FixedAssetNodeViewModel>> items, bool expanded)
    {
        foreach (var item in items)
        {
            item.Expanded = expanded;
            if (item.Children is List<TreeItemData<FixedAssetNodeViewModel>> children)
            {
                SetExpandedRecursive(children, expanded);
            }
        }
    }

    private Task<IEnumerable<FixedAssetNodeViewModel>> SearchAsync(string value, System.Threading.CancellationToken token)
    {
        IEnumerable<FixedAssetNodeViewModel> result = string.IsNullOrWhiteSpace(value)
            ? Enumerable.Empty<FixedAssetNodeViewModel>()
            : _nodeById.Values.Where(a =>
                (!string.IsNullOrEmpty(a.SubAccount_Name) && a.SubAccount_Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrEmpty(a.SubAccount_NO) && a.SubAccount_NO.Contains(value, StringComparison.OrdinalIgnoreCase)))
                .Take(30);
        return Task.FromResult(result);
    }

    private async Task OnSearchResultSelected(FixedAssetNodeViewModel? node)
    {
        if (node == null) return;
        ExpandAncestors(node);
        await OnNodeSelected(node);
    }

    private async Task OnNodeSelected(FixedAssetNodeViewModel? node)
    {
        SelectedValue = node;
        await SelectedValueChanged.InvokeAsync(node);
    }

    private static List<TreeItemData<FixedAssetNodeViewModel>> BuildTreeItems(
        List<FixedAssetNodeViewModel> nodes, Dictionary<long, TreeItemData<FixedAssetNodeViewModel>> index)
    {
        var list = new List<TreeItemData<FixedAssetNodeViewModel>>();
        foreach (var n in nodes)
        {
            var item = new TreeItemData<FixedAssetNodeViewModel>
            {
                Value = n,
                Text = $"{n.SubAccount_NO}  {n.SubAccount_Name}",
                Icon = n.HasChildren ? Icons.Material.Filled.Folder : Icons.Material.Filled.Inventory2,
                Expandable = n.HasChildren,
                Children = n.HasChildren ? BuildTreeItems(n.Children, index) : null,
            };
            index[n.Id] = item;
            list.Add(item);
        }
        return list;
    }

    private static Dictionary<long, FixedAssetNodeViewModel> FlattenById(List<FixedAssetNodeViewModel> roots)
    {
        var dict = new Dictionary<long, FixedAssetNodeViewModel>();
        void Walk(List<FixedAssetNodeViewModel> nodes)
        {
            foreach (var n in nodes)
            {
                dict[n.Id] = n;
                Walk(n.Children);
            }
        }
        Walk(roots);
        return dict;
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
