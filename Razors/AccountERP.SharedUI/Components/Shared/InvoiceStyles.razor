@* 🟢 نظام تصميم موحّد لشاشات الفواتير (بيع/مرتجع/بيع يومى/تجميل/POS): بطاقات واضحة، هرمية خطوط مريحة، أرقام محاذاة بـ
   tabular-nums، وملخص جانبى ثابت. كل الألوان من متغيّرات MudBlazor (--mud-palette-*) فتعمل تلقائياً فى الوضعين الفاتح والداكن
   ومع أى لون أساسى يختاره المستخدم. عناصر <style> المباشرة فقط هى التى تصل لعناصر مكوّنات MudBlazor (CSS isolation لا يصل،
   راجع mudtable-conventions) لذا يوضع هذا المكوّن مرة واحدة فى أعلى كل صفحة فاتورة. *@
<style>
    .inv-page { max-width: 1440px; margin-inline: auto; padding-bottom: 32px; }

    /* رأس الصفحة: العنوان + شارات الحالة + الإجراء الثانوى */
    .inv-head { display: flex; flex-wrap: wrap; gap: 12px 20px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .inv-title { font-size: 1.6rem; font-weight: 700; line-height: 1.3; margin: 0; color: var(--mud-palette-text-primary); text-wrap: balance; }
    .inv-badges { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* البطاقة: حد رفيع بدل ظل ثقيل، وعنوان قسم واضح */
    .inv-card { background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default); border-radius: 14px; padding: 20px 22px; }
    .inv-card + .inv-card { margin-top: 16px; }
    .inv-card-title { display: flex; align-items: center; gap: 10px; font-size: 1.05rem; font-weight: 600; margin: 0 0 16px; color: var(--mud-palette-text-primary); }
    .inv-card-title .mud-icon-root { color: var(--mud-palette-primary); font-size: 1.35rem; }
    .inv-card-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; flex-wrap: wrap; }
    .inv-card-head .inv-card-title { margin: 0; }

    /* صف خيارات الضريبة */
    /* خيارات الضريبة: احتياجها قليل بطلب المستخدم، فهى مصغّرة (مربعات صغيرة وخط أصغر وحشوة أقل) */
    .inv-tax { display: flex; flex-wrap: wrap; gap: 2px 16px; align-items: center; margin-top: 10px; padding: 2px 10px; border-radius: 8px;
               background: var(--mud-palette-background-gray); border: 1px dashed var(--mud-palette-lines-default); width: fit-content; max-width: 100%; }
    .inv-tax .mud-input-control-boolean-input { margin: 0; }
    .inv-tax .mud-checkbox .mud-typography { font-size: .8125rem; }

    /* ملاحظات الفاتورة أسفل جدول الأصناف وحقل البحث بالكود/الباركود */
    .inv-notes { margin-top: 14px; }
    .inv-extra { margin-top: 16px;  }
    /* بيانات إضافية: مغلقة افتراضياً بزر عريض (عنوان + عدد الحقول المعبّأة + إظهار/إخفاء + سهم) */
    .inv-extra-toggle { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 14px; border: 1px dashed var(--mud-palette-lines-inputs, var(--mud-palette-lines-default)); border-radius: 10px;
        background: transparent; color: var(--mud-palette-text-primary); font: inherit; text-align: start; cursor: pointer; transition: background .15s, border-color .15s; }
    .inv-extra-toggle:hover { background: var(--mud-palette-action-default-hover, rgba(128,128,128,.08)); border-color: var(--mud-palette-primary); }
    .inv-extra-toggle:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 2px; }
    .inv-extra.open .inv-extra-toggle { border-style: solid; background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent); }
    .inv-extra-toggle .ico { display: inline-flex; color: var(--mud-palette-primary); }
    .inv-extra-toggle .ttl { font-weight: 600; }
    .inv-extra-toggle .hint { margin-inline-start: auto; font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .inv-extra-toggle .chev { transition: transform .2s; color: var(--mud-palette-text-secondary); }
    .inv-extra.open .inv-extra-toggle .chev { transform: rotate(180deg); }
    .inv-extra-body { padding-top: 14px; animation: inv-extra-in .18s ease-out; }
    @@keyframes inv-extra-in { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .inv-extra-body { animation: none; } .inv-extra-toggle .chev { transition: none; } }
    .inv-barcode { flex: 1 1 260px; max-width: 420px; }

    /* جدول الأصناف: رأس واضح، خلايا مريحة، أرقام محاذاة */
    .inv-table .mud-table-container { border-radius: 10px; border: 1px solid var(--mud-palette-lines-default); }
    .inv-table .mud-table-head .mud-table-cell { background: var(--mud-palette-background-gray); font-weight: 600; font-size: .875rem; white-space: nowrap;
                                                 color: var(--mud-palette-text-secondary); padding: 12px 14px; border-bottom: 1px solid var(--mud-palette-lines-default); }
    .inv-table .mud-table-body .mud-table-cell { font-size: .9375rem; padding: 12px 14px; }
    .inv-table .mud-table-row:hover { background: var(--mud-palette-action-default-hover); }
    .inv-num { font-variant-numeric: tabular-nums; text-align: end !important; white-space: nowrap; }
    .inv-empty { padding: 36px 12px; text-align: center; color: var(--mud-palette-text-secondary); }

    /* ===== قائمة أسطر الفاتورة (بديل الجدول التقليدى) ===== */
    .inv-count { display: inline-flex; align-items: center; justify-content: center; min-width: 26px; height: 26px; padding: 0 8px; border-radius: 999px;
                 font-size: .8125rem; font-weight: 700; background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .inv-lines { border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; overflow-x: auto; overflow-y: hidden; background: var(--mud-palette-surface); }
    .inv-lines-head, .inv-line, .inv-lines-foot { display: grid; grid-template-columns: var(--cols); align-items: center; column-gap: 12px; padding-inline: 16px; min-width: var(--minw, 0); }
    /* هيدر الجدول ملوَّن بلون الثيم الأساسى (نص أبيض/تباين تلقائى) وخط أكبر - بطلب المستخدم لوضوح الجدول */
    .inv-lines-head { height: 54px; font-size: 1.05rem; font-weight: 700; letter-spacing: .01em; color: var(--mud-palette-primary-text);
                      background: var(--mud-palette-primary); border-bottom: 1px solid var(--mud-palette-primary-darken); }
    .inv-line { position: relative; min-height: 80px; padding-block: 12px; font-size: 1.1rem; border-bottom: 1px solid var(--mud-palette-lines-default);
                transition: background-color .15s ease; animation: inv-line-in .22s ease-out both; }
    .inv-line:last-of-type { border-bottom: 0; }
    /* تظليل خفيف بالتناوب يميّز الأصناف عن بعضها */
    .inv-line:nth-of-type(even) { background: color-mix(in srgb, var(--mud-palette-primary) 4%, var(--mud-palette-surface)); }
    .inv-line::before { content: ""; position: absolute; inset-block: 10px; inset-inline-start: 0; width: 3px; border-radius: 3px; background: var(--mud-palette-primary);
                        opacity: 0; transition: opacity .15s ease; }
    .inv-line:hover, .inv-line:focus-within { background: color-mix(in srgb, var(--mud-palette-primary) 6%, var(--mud-palette-surface)); }
    .inv-line:hover::before, .inv-line:focus-within::before { opacity: 1; }
    .inv-idx { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9px; font-size: 1rem; font-weight: 700;
               background: var(--mud-palette-background-gray); color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums; }
    .inv-item { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .inv-item b { font-size: 1.2rem; font-weight: 700; line-height: 1.4; overflow-wrap: anywhere; color: var(--mud-palette-text-primary); }
    .inv-item small { font-size: .95rem; color: var(--mud-palette-text-secondary); overflow-wrap: anywhere; }
    .inv-formula { display: none; }
    .inv-qty { display: inline-block; padding: 5px 14px; border-radius: 999px; font-size: 1.1rem; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;
               background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); color: var(--mud-palette-primary); }
    .inv-line .n, .inv-lines-head .n, .inv-lines-foot .n { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .inv-line .muted { color: var(--mud-palette-text-secondary); }
    .inv-netcell { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; }
    .inv-extras { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-top: 6px; }
    .inv-xchip { font-size: .8125rem; line-height: 1.5; padding: 1px 9px; border-radius: 999px; background: var(--mud-palette-background-gray); border: 1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-primary); white-space: nowrap; }
    .inv-xchip i { font-style: normal; color: var(--mud-palette-text-secondary); margin-inline-end: 4px; }
    .inv-taxline { font-size: .9rem; color: var(--mud-palette-text-secondary); white-space: nowrap; font-weight: 400; }
    .inv-net { font-size: 1.3rem; font-weight: 800; color: var(--mud-palette-text-primary); }
    .inv-acts { display: flex; justify-content: flex-end; gap: 2px; opacity: .55; transition: opacity .15s ease; }
    .inv-line:hover .inv-acts, .inv-line:focus-within .inv-acts { opacity: 1; }
    .inv-lines-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 6px 20px; min-height: 60px; height: auto; padding-block: 10px; font-size: 1.1rem; background: var(--mud-palette-background-gray); border-top: 1px solid var(--mud-palette-lines-default); }
    .inv-lines-foot .stat { display: inline-flex; align-items: baseline; gap: 6px; color: var(--mud-palette-text-secondary); }
    .inv-lines-foot .stat b { color: var(--mud-palette-text-primary); font-variant-numeric: tabular-nums; }
    .inv-empty2 { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 44px 16px; text-align: center; border: 2px dashed var(--mud-palette-lines-default);
                  border-radius: 14px; color: var(--mud-palette-text-secondary); }
    .inv-empty2 .ico { width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center;
                       background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); color: var(--mud-palette-primary); }
    .inv-empty2 .ico .mud-icon-root { font-size: 2.2rem; }
    @@keyframes inv-line-in { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .inv-line { animation: none; } .inv-line, .inv-line::before, .inv-acts { transition: none; } }

    /* شريط العميل */
    .inv-cust { display: flex; align-items: center; gap: 14px; margin-top: 14px; padding: 12px 14px; border-radius: 12px;
                border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-background-gray); }
    .inv-avatar { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; flex: none; font-weight: 700; font-size: 1.05rem;
                  background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .inv-cust .who { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .inv-cust .who b { font-size: 1rem; overflow-wrap: anywhere; }
    .inv-cust .who small { color: var(--mud-palette-text-secondary); font-size: .8125rem; }

    /* مساحة التبويبات (mud-tabs) عليها overflow:hidden فيمنع position:sticky من العمل؛ overflow:clip يقصّ بنفس الشكل بلا إنشاء
       حاوية تمرير، فيثبت شريط الملخص أسفل نافذة العرض أثناء التمرير. */
    .mud-tabs, .mud-tabs.mud-tabs-rounded { overflow: clip !important; }

    /* شريط الملخص الثابت أسفل جدول الفاتورة */
    .inv-dock { position: sticky; bottom: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px;
                margin-top: 16px; padding: 12px 20px; background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);
                border-radius: 14px; box-shadow: 0 -6px 18px rgba(0,0,0,.08); }
    .inv-dock-cells { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0; }
    .inv-dock .cell { display: flex; flex-direction: column; justify-content: center; gap: 2px; padding: 4px 22px; border-inline-start: 1px solid var(--mud-palette-lines-default); }
    .inv-dock .cell:first-child { border-inline-start: 0; padding-inline-start: 0; }
    .inv-dock .cell .lbl { font-size: .8125rem; color: var(--mud-palette-text-secondary); white-space: nowrap; }
    .inv-dock .cell b { font-size: 1.1rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-primary); }
    .inv-dock .cell.net b { font-size: 1.6rem; font-weight: 700; color: var(--mud-palette-primary); line-height: 1.2; }
    .inv-dock-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .inv-dock-actions .mud-button-root { min-height: 44px; }
    @@media (max-width: 599px) { .inv-dock { padding: 10px 14px; } .inv-dock .cell { padding: 4px 12px; } .inv-dock-actions { width: 100%; justify-content: space-between; } }

    /* الملخص الجانبى الثابت */
    .inv-sum-col { align-self: flex-start; }
    .inv-sum { position: sticky; top: 16px; }
    .inv-table .inv-name { min-width: 230px; }
    .inv-sum-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 9px 0; font-size: .9375rem;
                   color: var(--mud-palette-text-secondary); border-bottom: 1px dashed var(--mud-palette-lines-default); }
    .inv-sum-row b { color: var(--mud-palette-text-primary); font-weight: 600; font-variant-numeric: tabular-nums; }
    .inv-sum-net { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 14px; padding: 14px 16px; border-radius: 12px;
                   background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .inv-sum-net .lbl { font-size: 1rem; font-weight: 600; }
    .inv-sum-net .amount { font-size: 1.85rem; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.2; }
    .inv-sum-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
    .inv-sum-actions .mud-button-root { min-height: 46px; font-size: 1rem; }

    /* شارة حالة خفيفة */
    .inv-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 999px; font-size: .875rem; font-weight: 600;
                background: var(--mud-palette-background-gray); color: var(--mud-palette-text-primary); border: 1px solid var(--mud-palette-lines-default); }
    .inv-chip.primary { background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); border-color: transparent; }
    .inv-chip.success { background: color-mix(in srgb, var(--mud-palette-success) 16%, transparent); color: var(--mud-palette-success-darken, var(--mud-palette-success)); border-color: transparent; }
    .inv-chip.warn { background: color-mix(in srgb, var(--mud-palette-warning) 18%, transparent); color: var(--mud-palette-warning-darken, var(--mud-palette-warning)); border-color: transparent; }

    /* مساحات لمس مريحة للأزرار والحقول داخل الفاتورة */
    .inv-page .mud-button-root { min-height: 40px; }
    .inv-page .mud-input-control { margin-top: 2px; }

    /* الشاشات الصغيرة: كل سطر يصير بطاقة (الاسم + الكمية × السعر + الصافى)، وتُخفى أعمدة التفصيل */
    @@media (max-width: 899px) {
        .inv-lines-head, .inv-line, .inv-lines-foot { min-width: 0; }
        .inv-lines-head { display: none; }
        .inv-lines-head, .inv-line, .inv-lines-foot { grid-template-columns: 32px 1fr auto auto; }
        .inv-line .hide-sm, .inv-lines-foot .hide-sm { display: none; }
        .inv-formula { display: block; }
        .inv-acts { opacity: 1; }
    }
    @@media (max-width: 1279px) { .inv-sum { position: static; } }
    @@media (max-width: 599px) { .inv-card { padding: 16px; } .inv-title { font-size: 1.35rem; } .inv-sum-net .amount { font-size: 1.6rem; } }
</style>
