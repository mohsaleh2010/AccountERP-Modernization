@* 🔎 لوحة البحث السريع Ctrl+K (P8.2.2، ai-assistant-p82-plan.md س23–س29). مكوّن خاص لا MudDialog (س27): طبقة + لوحة بنمط ARIA combobox.
   تُرسم خارج MudRTLProvider بجوار AssistantWidget وتضبط dir بنفسها. P8.2.2 = مجموعة الشاشات (فورية، فى الذاكرة).
   P8.2.4: بحث البيانات بعد 250 مللى (س5) مع إلغاء السابق ورقم تسلسل يرفض النتائج المتأخرة، هيكل انتظار بعد 150 مللى + aria-busy،
   مجموعات العملاء/الموردين/الأصناف/المستندات، و«الأخيرة» حين الحقل فارغ مع «مسح الأخيرة» (س19–س21). البيانات للويب فقط (س32).
   الأسهم وHome/End وTab وEsc فى palette.js؛ Enter يستدعى ActivateFromKeyboard برقم الصف النشط. aria-selected وaria-activedescendant يضبطهما JS فقط.
   z-index 1450: فوق حوارات MudBlazor (1400) وتحت رسائل التنبيه (1500). على MAUI تعمل كما هى (بلا بحث بيانات). *@
@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@if (_svc != null)
{
    <style>
        /* زر الشريط العلوى (MainLayoutMud) — على خلفية اللون الأساسى */
        .cmdk-trigger { display: flex; align-items: center; gap: 8px; height: 36px; min-width: 200px; max-width: 360px; width: 32vw;
                        padding-inline: 10px 6px; border-radius: 8px; cursor: pointer; font: inherit; font-size: .875rem; color: inherit;
                        background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.28); transition: background-color .15s ease-out; }
        .cmdk-trigger:hover { background: rgba(255,255,255,.22); }
        .cmdk-trigger:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
        .cmdk-trigger .cmdk-trigger-text { flex: 1; text-align: start; opacity: .9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cmdk-trigger kbd { font: 600 .75rem/1 system-ui, sans-serif; padding: 4px 6px; border-radius: 4px; direction: ltr;
                            background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.3); color: inherit; }

        .cmdk-scrim { position: fixed; inset: 0; z-index: 1449; background: var(--mud-palette-overlay-dark, rgba(33,33,33,.5)); animation: cmdk-fade .12s ease-out; }
        .cmdk-panel { position: fixed; z-index: 1450; top: 12vh; inset-inline: 0; margin-inline: auto;
                      width: min(640px, calc(100vw - 32px)); display: flex; flex-direction: column; overflow: hidden;
                      background: var(--mud-palette-surface); color: var(--mud-palette-text-primary);
                      border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; box-shadow: var(--mud-elevation-16);
                      animation: cmdk-in .14s ease-out; }
        @@keyframes cmdk-fade { from { opacity: 0; } to { opacity: 1; } }
        @@keyframes cmdk-in { from { opacity: 0; margin-top: -8px; } to { opacity: 1; margin-top: 0; } }

        .cmdk-head { display: flex; align-items: center; gap: 8px; min-height: 56px; padding-inline: 16px 6px; border-bottom: 1px solid var(--mud-palette-lines-default); }
        .cmdk-head:focus-within { box-shadow: inset 0 -2px 0 var(--mud-palette-primary); }
        .cmdk-head .cmdk-search-icon { color: var(--mud-palette-text-secondary); flex: none; }
        .cmdk-input { flex: 1; min-width: 0; height: 44px; border: 0; outline: 0; background: transparent; color: inherit; font: inherit; font-size: 1.0625rem; }
        .cmdk-input::placeholder { color: var(--mud-palette-text-secondary); opacity: 1; }
        .cmdk-close { flex: none; width: 44px; height: 44px; display: grid; place-items: center; border: 0; border-radius: 8px; cursor: pointer;
                      background: transparent; color: var(--mud-palette-text-secondary); }
        .cmdk-close:hover { background: var(--mud-palette-action-default-hover); }
        .cmdk-close:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }

        .cmdk-list { max-height: min(60vh, 480px); overflow-y: auto; overscroll-behavior: contain; padding: 6px; }
        .cmdk-group-label { padding: 10px 10px 4px; font-size: .75rem; font-weight: 700; letter-spacing: .02em; color: var(--mud-palette-text-secondary); }
        .cmdk-opt { position: relative; display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 6px 10px; border-radius: 8px; cursor: pointer; }
        .cmdk-opt[aria-selected="true"] { background: color-mix(in srgb, var(--mud-palette-primary) 12%, var(--mud-palette-surface)); }
        .cmdk-opt[aria-selected="true"]::before { content: ""; position: absolute; inset-block: 8px; inset-inline-start: 0; width: 3px; border-radius: 3px; background: var(--mud-palette-primary); }
        .cmdk-opt-icon { flex: none; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 8px;
                         background: color-mix(in srgb, var(--mud-palette-primary) 10%, var(--mud-palette-surface)); color: var(--mud-palette-primary); }
        .cmdk-opt-text { flex: 1; min-width: 0; display: flex; flex-direction: column; }
        .cmdk-opt-title { font-size: .95rem; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cmdk-opt-sub { font-size: .8rem; color: var(--mud-palette-text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .cmdk-opt-enter { flex: none; visibility: hidden; color: var(--mud-palette-text-secondary); }
        .cmdk-opt[aria-selected="true"] .cmdk-opt-enter { visibility: visible; }
        .cmdk-group-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-inline-end: 4px; }
        .cmdk-group-head .cmdk-group-label { flex: 1; }
        .cmdk-clear { border: 0; background: transparent; color: var(--mud-palette-primary); font: inherit; font-size: .75rem; font-weight: 600;
                      min-height: 32px; padding: 4px 8px; border-radius: 6px; cursor: pointer; }
        .cmdk-clear:hover { background: var(--mud-palette-action-default-hover); }
        .cmdk-clear:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 0; }
        .cmdk-opt-trail { flex: none; font-size: .85rem; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-secondary); }
        .cmdk-num { unicode-bidi: isolate; direction: ltr; }
        .cmdk-note { padding: 8px 12px; font-size: .8rem; color: var(--mud-palette-text-secondary); }
        .cmdk-note.cmdk-warn { color: var(--mud-palette-warning-darken, var(--mud-palette-warning)); }
        .cmdk-skel { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 6px 10px; }
        .cmdk-skel span { display: block; border-radius: 6px; background: var(--mud-palette-action-disabled-background, rgba(127,127,127,.18)); animation: cmdk-pulse 1.2s ease-in-out infinite; }
        .cmdk-skel .b1 { width: 32px; height: 32px; border-radius: 8px; flex: none; }
        .cmdk-skel .b2 { height: 12px; width: 45%; }
        .cmdk-skel .b2.short { width: 30%; }
        @@keyframes cmdk-pulse { 0%, 100% { opacity: .55; } 50% { opacity: 1; } }
        .cmdk-empty { padding: 28px 16px; text-align: center; color: var(--mud-palette-text-secondary); font-size: .9rem; }

        .cmdk-foot { display: flex; align-items: center; gap: 16px; padding: 8px 16px; border-top: 1px solid var(--mud-palette-lines-default);
                     font-size: .75rem; color: var(--mud-palette-text-secondary); }
        .cmdk-foot kbd { font: 600 .7rem/1 system-ui, sans-serif; padding: 3px 5px; margin-inline-end: 4px; border-radius: 4px; direction: ltr; display: inline-block;
                         border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-background-gray, transparent); color: var(--mud-palette-text-primary); }
        .cmdk-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

        @@media (max-width: 600px) {
            .cmdk-panel { inset: 0; width: auto; height: 100dvh; border-radius: 0; border: 0; }
            .cmdk-list { max-height: none; flex: 1; }
            .cmdk-foot { display: none; }
        }
        @@media (prefers-reduced-motion: reduce) { .cmdk-scrim, .cmdk-panel, .cmdk-skel span { animation: none; } .cmdk-trigger { transition: none; } }
        @@media print { .cmdk-scrim, .cmdk-panel, .cmdk-trigger { display: none !important; } }
    </style>

    @if (_open)
    {
        string dir = LangService.IsRtl ? "rtl" : "ltr";
        <div class="cmdk-scrim" aria-hidden="true" @onclick="() => CloseAsync(false)"></div>
        <div class="cmdk-panel" role="dialog" aria-modal="true" aria-label="@Tr("AIS_Title")" dir="@dir" @ref="_panel">
            <div class="cmdk-head">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="cmdk-search-icon" aria-hidden="true" />
                <input id="cmdk-input" class="cmdk-input" type="text" @ref="_input"
                       role="combobox" aria-expanded="@(_items.Count > 0 ? "true" : "false")" aria-controls="cmdk-list" aria-autocomplete="list"
                       aria-label="@Tr("AIS_Title")" placeholder="@Tr("AIS_Placeholder")"
                       autocomplete="off" spellcheck="false" maxlength="@AiSearchConst.MaxQueryChars" enterkeyhint="go"
                       @oninput="OnInput" />
                <button type="button" class="cmdk-close" aria-label="@Tr("AIS_Close")" title="@Tr("AIS_Close")" @onclick="() => CloseAsync(false)">
                    <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-hidden="true" />
                </button>
            </div>

            <div id="cmdk-list" class="cmdk-list" role="listbox" aria-label="@Tr("AIS_Title")" aria-busy="@(_showBusy ? "true" : "false")" @ref="_list">
                @foreach (var g in _groups)
                {
                    <div role="group" aria-labelledby="cmdk-grp-@g.Key">
                        @if (g.Clearable)
                        {
                            <div class="cmdk-group-head" role="presentation">
                                <div id="cmdk-grp-@g.Key" class="cmdk-group-label">@g.Label</div>
                                <button type="button" class="cmdk-clear" @onmousedown:preventDefault="true" @onclick="ClearRecentAsync">@Tr("AIS_ClearRecent")</button>
                            </div>
                        }
                        else
                        {
                            <div id="cmdk-grp-@g.Key" class="cmdk-group-label" role="presentation">@g.Label</div>
                        }
                        @foreach (var idx in g.Indexes)
                        {
                            var item = _items[idx];
                            <div id="cmdk-opt-@idx" class="cmdk-opt" role="option" data-idx="@idx"
                                 @onmousedown:preventDefault="true" @onclick="() => ActivateAsync(item)">
                                <span class="cmdk-opt-icon" aria-hidden="true"><MudIcon Icon="@item.Icon" Size="Size.Small" /></span>
                                <span class="cmdk-opt-text">
                                    <span class="cmdk-opt-title">@item.Title</span>
                                    @if (!string.IsNullOrEmpty(item.Subtitle))
                                    {
                                        <span class="cmdk-opt-sub">@item.Subtitle</span>
                                    }
                                </span>
                                @if (!string.IsNullOrEmpty(item.Trailing))
                                {
                                    <span class="cmdk-opt-trail cmdk-num">@item.Trailing</span>
                                }
                                <span class="cmdk-opt-enter" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.KeyboardReturn" Size="Size.Small" /></span>
                            </div>
                        }
                    </div>
                }
                @if (_showBusy)
                {
                    <div class="cmdk-note" role="presentation">@Tr("AIS_Searching")</div>
                    <div class="cmdk-skel" aria-hidden="true"><span class="b1"></span><span class="b2"></span></div>
                    <div class="cmdk-skel" aria-hidden="true"><span class="b1"></span><span class="b2 short"></span></div>
                }
                else if (_dataState == DataState.Slow)
                {
                    <div class="cmdk-note cmdk-warn" role="presentation">@Tr("AIS_DataSlow")</div>
                }
                else if (_dataState == DataState.Error)
                {
                    <div class="cmdk-note cmdk-warn" role="presentation">@Tr("AIS_DataError")</div>
                }
                @if (_items.Count == 0 && _dataState != DataState.Pending)
                {
                    <div class="cmdk-empty" role="presentation">@(string.IsNullOrWhiteSpace(_text) ? Tr("AIS_EmptyHint") : Tr("AIS_NoResults"))</div>
                }
            </div>

            <div class="cmdk-foot" aria-hidden="true">
                <span><kbd>↑</kbd><kbd>↓</kbd>@Tr("AIS_KeyNavigate")</span>
                <span><kbd>↵</kbd>@Tr("AIS_KeyOpen")</span>
                <span><kbd>Esc</kbd>@Tr("AIS_KeyClose")</span>
            </div>
            <div class="cmdk-sr" aria-live="polite" aria-atomic="true">@LiveText</div>
        </div>
    }
}

@code {
    private CommandPaletteService? _svc;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CommandPalette>? _self;
    private ElementReference _panel, _input, _list;
    private bool _open, _openedPending, _syncPending;
    private bool _syncKeep;
    private string _text = "";
    private List<PaletteItem> _items = new();

    // P8.2.4
    private enum DataState { None, Pending, Done, Slow, Error }
    private sealed record Group(string Key, string Label, List<int> Indexes, bool Clearable);
    private List<Group> _groups = new();
    private List<PaletteItem> _screens = new(), _data = new(), _recent = new();
    private List<AiSearchHit> _dataHits = new();
    private DataState _dataState;
    private bool _showBusy, _pendingEnter;
    private int _seq;
    private CancellationTokenSource? _cts;
    private UserPreferencesService? _prefs;
    private string _live = "";

    private string LiveText =>
        _live.Length > 0 ? _live :
        string.IsNullOrWhiteSpace(_text) ? "" :
        _dataState == DataState.Pending ? "" :
        _items.Count == 0 ? Tr("AIS_NoResults") : Tr("AIS_ResultsCount", _items.Count);

    protected override void OnInitialized()
    {
        _svc = ServiceProvider.GetService<CommandPaletteService>();
        if (_svc == null) return;
        _prefs = ServiceProvider.GetService<UserPreferencesService>();
        _svc.OpenRequested += OnOpenRequested;
        MenuState.OnAuthChanged += OnAuthChanged;
        LangService.OnLanguageChanged += OnLanguageChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_svc == null) return;
        try
        {
            if (firstRender)
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AccountERP.SharedUI/js/palette.js");
                _self = DotNetObjectReference.Create(this);
                bool isMac = await _module.InvokeAsync<bool>("init", _self, new { shortcuts = true });
                _svc.SetIsMac(isMac);
            }
            if (_module == null) return;
            if (_open && _openedPending)
            {
                _openedPending = false;
                _syncPending = false;
                await _module.InvokeVoidAsync("opened", _panel, _input, _list);
            }
            else if (_open && _syncPending)
            {
                _syncPending = false;
                bool keep = _syncKeep;
                _syncKeep = false;
                await _module.InvokeVoidAsync("sync", keep);
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    private void OnOpenRequested() => InvokeAsync(Open);

    private void Open()
    {
        if (_svc == null || !_svc.IsAvailable || _open) return;
        _open = true;
        _openedPending = true;
        _text = "";
        _live = "";
        _screens = new(); _data = new(); _recent = new(); _dataHits = new();
        _dataState = DataState.None;
        _showBusy = _pendingEnter = false;
        Rebuild();
        StateHasChanged();
        if (_svc.HasData) _ = LoadRecentAsync();
    }

    private async Task LoadRecentAsync()
    {
        if (_svc == null) return;
        List<AiSearchRecentRow> rows;
        try { rows = await _svc.RecentAsync(); }
        catch (Exception ex) { AccountModelsLib.operations.DataDictionaryLogerException(ex); return; }
        await InvokeAsync(() =>
        {
            if (!_open) return;
            _recent = rows.Select(RecentItem).ToList();
            // الكتابة سبقت التحميل: تُعاد الشاشات بدفعة التكرار مع إبقاء الصف النشط.
            if (!string.IsNullOrWhiteSpace(_text)) { _screens = _svc.SearchScreens(_text, _svc.HitCounts); _syncKeep = true; }
            Rebuild();
            _syncPending = true;
            StateHasChanged();
        });
    }

    private void OnInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? "";
        _live = "";
        _screens = _svc?.SearchScreens(_text, _svc.HitCounts) ?? new List<PaletteItem>();
        _data = new();
        _dataHits = new();
        _showBusy = false;
        _pendingEnter = false;
        _cts?.Cancel();
        _cts = null;
        int seq = ++_seq;

        var q = AiSearchText.Parse(_text);
        bool wantData = _svc != null && _svc.HasData && !q.AskOnly && q.HasDataText &&
                        (q.DocNumber != null || q.Tokens.Count > 0);
        _dataState = wantData ? DataState.Pending : DataState.None;
        Rebuild();
        _syncPending = true;
        if (wantData)
        {
            var cts = new CancellationTokenSource();
            _cts = cts;
            _ = RunDataSearchAsync(_text, seq, cts.Token);
        }
    }

    private async Task RunDataSearchAsync(string text, int seq, CancellationToken ct)
    {
        try
        {
            await Task.Delay(AiSearchConst.DebounceMs, ct);
            _ = ShowBusyLaterAsync(seq, ct);
            var r = await _svc!.SearchDataAsync(text, ct);
            await InvokeAsync(() =>
            {
                if (seq != _seq || !_open) return;   // نتيجة متأخرة لنص قديم
                _showBusy = false;
                if (r == null || r.Disabled) _dataState = DataState.None;
                else if (r.TimedOut) _dataState = DataState.Slow;
                else if (r.Error != null) _dataState = DataState.Error;
                else _dataState = DataState.Done;
                _dataHits = r?.Hits ?? new();
                _data = _dataHits.Select(HitItem).ToList();
                Rebuild();
                _syncPending = true;
                _syncKeep = true;
                StateHasChanged();
                if (_pendingEnter)
                {
                    _pendingEnter = false;
                    if (_items.Count > 0) _ = ActivateAsync(_items[0]);   // س29: Enter المؤجَّل
                }
            });
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            AccountModelsLib.operations.DataDictionaryLogerException(ex);
            await InvokeAsync(() =>
            {
                if (seq != _seq || !_open) return;
                _showBusy = false;
                _dataState = DataState.Error;
                Rebuild();
                StateHasChanged();
            });
        }
    }

    private async Task ShowBusyLaterAsync(int seq, CancellationToken ct)
    {
        try { await Task.Delay(150, ct); }
        catch (OperationCanceledException) { return; }
        await InvokeAsync(() =>
        {
            if (seq != _seq || !_open || _dataState != DataState.Pending) return;
            _showBusy = true;
            StateHasChanged();
        });
    }

    /// <summary>يبنى المجموعات والقائمة المسطحة بترتيب العرض (س2).</summary>
    private void Rebuild()
    {
        var items = new List<PaletteItem>();
        var groups = new List<Group>();
        void Add(string key, string label, IEnumerable<PaletteItem> src, bool clearable = false)
        {
            var idx = new List<int>();
            foreach (var it in src) { idx.Add(items.Count); items.Add(it); }
            if (idx.Count > 0) groups.Add(new Group(key, label, idx, clearable));
        }
        if (string.IsNullOrWhiteSpace(_text))
            Add("recent", Tr("AIS_GrpRecent"), _recent, clearable: true);
        else
        {
            Add("screens", Tr("AIS_GrpScreens"), _screens);
            Add("customers", Tr("AIS_GrpCustomers"), _data.Where(d => d.Kind == AiSearchKinds.Customer));
            Add("suppliers", Tr("AIS_GrpSuppliers"), _data.Where(d => d.Kind == AiSearchKinds.Supplier));
            Add("items", Tr("AIS_GrpItems"), _data.Where(d => d.Kind == AiSearchKinds.Item));
            Add("docs", Tr("AIS_GrpDocuments"), _data.Where(d => AiSearchKinds.IsDocument(d.Kind)));
        }
        _items = items;
        _groups = groups;
    }

    private PaletteItem HitItem(AiSearchHit h)
    {
        var culture = LangService.CurrentCultureInfo;
        if (AiSearchKinds.IsDocument(h.Kind))
        {
            var parts = new List<string> { KindLabel(h.Kind) };
            if (h.Date != null) parts.Add(h.Date.Value.ToString(_prefs?.DateFormat ?? "dd/MM/yyyy", CultureInfo.InvariantCulture));
            if (!string.IsNullOrEmpty(h.Party)) parts.Add(h.Party);
            if (!string.IsNullOrEmpty(h.Branch)) parts.Add(h.Branch);
            return new PaletteItem
            {
                Kind = h.Kind, Id = h.Id, Url = h.Url, RefKey = h.RefKey, Icon = KindIcon(h.Kind),
                Title = Tr("AIS_DocNo", h.Title),
                Subtitle = string.Join(" · ", parts),
                Trailing = h.Amount == null ? "" : h.Amount.Value.ToString("N2", culture),
            };
        }
        return new PaletteItem
        {
            Kind = h.Kind, Id = h.Id, Url = h.Url, RefKey = h.RefKey, Icon = KindIcon(h.Kind),
            Title = h.Title,
            Subtitle = string.IsNullOrEmpty(h.Code) || h.Code == "0" ? "" : Tr("AIS_Code", h.Code),
        };
    }

    private PaletteItem RecentItem(AiSearchRecentRow r)
    {
        string icon = r.Kind == AiSearchKinds.Screen ? (_svc?.ScreenIcon(r.RefKey) ?? "") : KindIcon(r.Kind);
        return new PaletteItem
        {
            Kind = r.Kind,
            RefKey = r.RefKey,
            Url = r.Url,
            Title = r.Title,
            Subtitle = r.Subtitle ?? "",
            Icon = icon.Length > 0 ? icon : Icons.Material.Filled.History,
        };
    }

    private string KindLabel(string kind) => kind switch
    {
        AiSearchKinds.Sale => Tr("AIS_KindSale"),
        AiSearchKinds.SaleReturn => Tr("AIS_KindSaleReturn"),
        AiSearchKinds.Purchase => Tr("AIS_KindPurchase"),
        AiSearchKinds.PurchaseReturn => Tr("AIS_KindPurchaseReturn"),
        _ => "",
    };

    private static string KindIcon(string kind) => kind switch
    {
        AiSearchKinds.Customer => Icons.Material.Filled.Person,
        AiSearchKinds.Supplier => Icons.Material.Filled.LocalShipping,
        AiSearchKinds.Item => Icons.Material.Filled.Inventory2,
        AiSearchKinds.Sale => Icons.Material.Filled.ReceiptLong,
        AiSearchKinds.SaleReturn => Icons.Material.Filled.AssignmentReturn,
        AiSearchKinds.Purchase => Icons.Material.Filled.ShoppingCart,
        AiSearchKinds.PurchaseReturn => Icons.Material.Filled.RemoveShoppingCart,
        _ => Icons.Material.Filled.History,
    };

    private async Task ClearRecentAsync()
    {
        if (_svc == null) return;
        if (!await _svc.ClearRecentAsync()) return;
        _recent = new();
        Rebuild();
        _live = Tr("AIS_RecentCleared");
        _syncPending = true;
        Snackbar.Add(Tr("AIS_RecentCleared"), Severity.Info);
        try { if (_module != null) await _module.InvokeVoidAsync("focusInput"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    private async Task CloseAsync(bool navigating)
    {
        if (!_open) return;
        _open = false;
        _openedPending = _syncPending = false;
        _cts?.Cancel();
        _cts = null;
        _seq++;
        _showBusy = _pendingEnter = false;
        try
        {
            if (_module != null)
            {
                if (navigating) await _module.InvokeVoidAsync("forgetRestore");
                await _module.InvokeVoidAsync("closed");
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
        StateHasChanged();
    }

    private async Task ActivateAsync(PaletteItem item)
    {
        if (item == null || !AiSearchText.IsSafeInternalUrl(item.Url)) return;   // س17
        _svc?.Touch(item);
        await CloseAsync(true);
        Nav.NavigateTo(item.Url);
    }

    [JSInvokable]
    public Task OpenFromShortcut() => InvokeAsync(Open);

    [JSInvokable]
    public Task CloseFromKeyboard() => InvokeAsync(() => CloseAsync(false));

    [JSInvokable]
    public Task ActivateFromKeyboard(int index) => InvokeAsync(async () =>
    {
        if (!_open) return;
        if (index >= 0 && index < _items.Count) { await ActivateAsync(_items[index]); return; }
        // س29: لا صفوف بعد والبيانات قيد البحث ⇒ يُنفَّذ Enter عند وصولها.
        if (_items.Count == 0 && _dataState == DataState.Pending) _pendingEnter = true;
    });

    private void OnAuthChanged() => InvokeAsync(() => CloseAsync(false));
    private void OnLanguageChanged() => InvokeAsync(() =>
    {
        if (_open)
        {
            _screens = _svc?.SearchScreens(_text, _svc.HitCounts) ?? new List<PaletteItem>();
            _data = _dataHits.Select(HitItem).ToList();
            Rebuild();
        }
        _syncPending = _open;
        StateHasChanged();
    });
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() => CloseAsync(true));

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_svc != null) _svc.OpenRequested -= OnOpenRequested;
        _cts?.Cancel();
        MenuState.OnAuthChanged -= OnAuthChanged;
        LangService.OnLanguageChanged -= OnLanguageChanged;
        Nav.LocationChanged -= OnLocationChanged;
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        _self?.Dispose();
    }
}
