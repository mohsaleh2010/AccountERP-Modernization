@* 🟢 محرر القيد اليدوى المشترك لشاشات القيود الثلاث، بثلاثة أنماط إدخال:
   Typed   = NewAccount_EntryFRM (472): نوع (مدين/دائن) + قيمة واحدة، تُعبَّأ القيمة والنوع تلقائياً بالفرق الجارى؛
   Columns = NewAccount_EntryMadinDa2nFRM (808): عمودا مدين ودائن (واحد منهما فقط) + نسخ قيد سابق؛
   Pair    = NewSimpleAccount_EntryMadinDa2nFRM (827): حسابان فى كل إضافة (لكل منهما مدين/دائن ومركز تكلفة وبيان).
   الحفظ/التعديل/الحذف عبر ManualEntryService ← AccountEntry_CLS نفسه + الحارس المركزى EntryValidator (عدم الاتزان يمنع الحفظ، والباقى تنبيهات).
   القيد المُرحَّل أو الآلى للقراءة فقط. تعديل السطر = حذفه وإضافته من جديد. التصميم حسب ui-ux-pro-max ونظام inv-* المشترك. *@
@using System.Data
@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.Models
@using AccountModelsLib.BusinessLibShared
@using AccountModelsLib.BusinessLibShared.GeneralLedger
@using AccountERP.SharedUI.Services
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@implements IDisposable

<InvoiceStyles />

<style>
    .me-totals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
    .me-tile { padding: 12px 16px; border-radius: 12px; border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .me-tile .k { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .me-tile .v { margin-top: 2px; font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .me-tile.bad .v { color: var(--mud-palette-error); }
    .me-tile.ok .v { color: var(--mud-palette-success); }
    .me-num { font-variant-numeric: tabular-nums; text-align: end; }
    .me-slot { padding: 12px; margin-bottom: 12px; border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; }
    .me-slot-title { font-weight: 600; margin-bottom: 4px; }
    .me-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    @@media (max-width: 599px) { .me-totals { grid-template-columns: minmax(0, 1fr); } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">

    <div class="inv-head inv-card">
        <h1 class="inv-title">@Title</h1>
        <div class="inv-badges">
            <span class="inv-chip primary"><MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />@(_head.EntryNo > 0 ? _head.EntryNo.ToString() : "")</span>
            <span class="inv-chip @(_head.Id > 0 ? "success" : "warn")">@(_head.Id > 0 ? Tr("InvoiceStatusSaved") : Tr("InvoiceStatusNew"))</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_busy" OnClick="NewEntryAsync">@Tr("MENew")</MudButton>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_error</MudAlert>
    }
    @if (_head.Id > 0 && !_head.IsEditable)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" role="note">@(_head.Posted ? Tr("MEPostedRO") : Tr("MEAutoRO"))</MudAlert>
    }

    <div class="inv-card">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.Article" />@Tr("MEHead")</h2>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="long" Value="_head.JournalCode" ValueChanged="OnJournalAsync" Label="@Tr("EPJournal")" Variant="Variant.Outlined" Disabled="@(_head.Id > 0)"
                           ToStringFunc="@(v => _journals.FirstOrDefault(j => j.Id == v)?.Name ?? "")">
                    @foreach (var j in _journals)
                    {
                        <MudSelectItem T="long" Value="@j.Id">@j.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="long" @bind-Value="_head.BranchId" Label="@Tr("EPBranch")" Variant="Variant.Outlined" Disabled="@(!_editable)"
                           ToStringFunc="@(v => _branches.FirstOrDefault(b => b.Id == v)?.Name ?? "")">
                    @foreach (var b in _branches)
                    {
                        <MudSelectItem T="long" Value="@b.Id">@b.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3"><MudDatePicker T="DateTime?" Date="_head.Date" DateChanged="OnDateAsync" Label="@Tr("DateColumn")" Variant="Variant.Outlined" Disabled="@(!_editable)" /></MudItem>
            <MudItem xs="6" md="1"><MudTextField T="string" Value="@(_head.EntryNo > 0 ? _head.EntryNo.ToString() : "")" Label="@Tr("MEEntryNo")" Variant="Variant.Outlined" ReadOnly="true" /></MudItem>
            <MudItem xs="6" md="2"><MudTextField T="string" @bind-Value="_head.DocNo" Label="@Tr("MEDocNo")" Variant="Variant.Outlined" Disabled="@(!_editable)" /></MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="long" Value="_head.EntryCurrencyId" ValueChanged="OnCurrencyAsync" Label="@Tr("MECurrency")" Variant="Variant.Outlined" Disabled="@(!_editable || _lines.Count > 0)"
                           ToStringFunc="@(v => _currencies.FirstOrDefault(c => c.Id == v)?.Name ?? "")">
                    @foreach (var c in _currencies)
                    {
                        <MudSelectItem T="long" Value="@c.Id">@c.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (_head.Factor != 1)
            {
                <MudItem xs="12" sm="6" md="2">
                    <MudNumericField T="decimal" @bind-Value="_head.Factor" Label="@Tr("MEFactor")" Variant="Variant.Outlined" HideSpinButtons="true" Format="0.####" Disabled="@(!_editable || _lines.Count > 0)" />
                </MudItem>
            }
            <MudItem xs="12" md="@(_head.Factor != 1 ? 7 : 9)"><MudTextField T="string" @bind-Value="_head.Notes" Label="@Tr("MENotes")" Variant="Variant.Outlined" Disabled="@(!_editable)" /></MudItem>
        </MudGrid>
    </div>

    @if (_editable)
    {
        <div class="inv-card">
            <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.AddCircle" />@Tr("MELinesTitle")</h2>
            @for (int si = 0; si < _slots.Count; si++)
            {
                var s = _slots[si];
                <div class="@(_slots.Count > 1 ? "me-slot" : "")">
                    @if (_slots.Count > 1) { <div class="me-slot-title">@Tr(si == 0 ? "MESlot1" : "MESlot2")</div> }
                    <AccountSelector @key="s.Key" AccountSelection="s.Selection" AccountSelectionChanged="@(v => OnSelectionChanged(s, v))"
                                     CustomerId="s.CustomerId" CustomerIdChanged="@(v => s.CustomerId = v)"
                                     SupplierId="s.SupplierId" SupplierIdChanged="@(v => s.SupplierId = v)"
                                     SubAccountId="s.SubId" SubAccountIdChanged="@(v => OnSubAccountChangedAsync(s, v))"
                                     SubAccountName="s.SubName" SubAccountNameChanged="@(v => s.SubName = v)"
                                     AccountTypeValue="s.AccountType" AccountTypeValueChanged="@(v => s.AccountType = v)"
                                     Balance="s.BalanceBefore" BalanceChanged="@(v => s.BalanceBefore = v)"
                                     BranchId="AccountModelsLib.Common.Branch_Id" />
                    <MudGrid Spacing="3" Class="mt-1">
                        @if (Mode == "Typed")
                        {
                            <MudItem xs="12" sm="4" md="2">
                                <MudSelect T="bool" @bind-Value="s.IsDebit" Label="@Tr("METype")" Variant="Variant.Outlined">
                                    <MudSelectItem T="bool" Value="true">@Tr("MEDebit")</MudSelectItem>
                                    <MudSelectItem T="bool" Value="false">@Tr("MECredit")</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="8" md="3">
                                <MudNumericField T="decimal" @bind-Value="s.Amount" Label="@Tr("CVAmountLabel")" Variant="Variant.Outlined" Immediate="true" HideSpinButtons="true" Format="0.##" />
                            </MudItem>
                        }
                        else
                        {
                            <MudItem xs="6" md="2"><MudNumericField T="decimal" @bind-Value="s.Debit" Label="@Tr("MEDebit")" Variant="Variant.Outlined" Immediate="true" HideSpinButtons="true" Format="0.##" /></MudItem>
                            <MudItem xs="6" md="2"><MudNumericField T="decimal" @bind-Value="s.Credit" Label="@Tr("MECredit")" Variant="Variant.Outlined" Immediate="true" HideSpinButtons="true" Format="0.##" /></MudItem>
                        }
                        <MudItem xs="12" md="3">
                            <MudSelect T="long" @bind-Value="s.CostCenterId" Label="@Tr("CVCostCenter")" Variant="Variant.Outlined" Disabled="@(s.SubId == 0)"
                                       ToStringFunc="@(v => s.CostCenters.FirstOrDefault(c => c.Id == v)?.Name ?? "")">
                                @foreach (var c in s.CostCenters)
                                {
                                    <MudSelectItem T="long" Value="@c.Id">@c.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="@(Mode == "Typed" ? 4 : 5)"><MudTextField T="string" @bind-Value="s.Notes" Label="@Tr("CVLineNotes")" Variant="Variant.Outlined" /></MudItem>
                    </MudGrid>
                </div>
            }
            @if (!string.IsNullOrEmpty(_lineError))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" role="alert">@_lineError</MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mt-3" OnClick="AddLine">@(_slots.Count > 1 ? Tr("MEAddPair") : Tr("CVAddLine"))</MudButton>
        </div>
    }

    <div class="inv-card">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@Tr("MELinesList")<span class="inv-count">@_lines.Count</span></h2>
        <MudTable Items="@_lines" T="ManualEntryService.Line" Hover="true" Striped="true" Bordered="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>#</MudTh>
                <MudTh>@Tr("AccountLabel")</MudTh>
                <MudTh>@Tr("CVCostCenter")</MudTh>
                <MudTh>@Tr("CVLineNotes")</MudTh>
                <MudTh Style="text-align:end">@Tr("MEDebit")</MudTh>
                <MudTh Style="text-align:end">@Tr("MECredit")</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="#">@(_lines.IndexOf(context) + 1)</MudTd>
                <MudTd DataLabel="@Tr("AccountLabel")"><b>@context.AccountName</b><br /><small class="mud-text-secondary">@context.AccountCode</small></MudTd>
                <MudTd DataLabel="@Tr("CVCostCenter")">@context.CostCenterName</MudTd>
                <MudTd DataLabel="@Tr("CVLineNotes")">@context.Notes</MudTd>
                <MudTd DataLabel="@Tr("MEDebit")" Class="me-num">@(context.IsDebit ? context.Amount.ToString("N2") : "")</MudTd>
                <MudTd DataLabel="@Tr("MECredit")" Class="me-num">@(context.IsDebit ? "" : context.Amount.ToString("N2"))</MudTd>
                <MudTd Style="white-space:nowrap">
                    @if (_editable)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Medium" Color="Color.Error" OnClick="@(() => RemoveLine(context))" aria-label="@Tr("DeleteItemLabel")" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><MudText Align="Align.Center" Class="py-4 mud-text-secondary">@Tr("MENoLines")</MudText></NoRecordsContent>
        </MudTable>

        <div class="me-totals">
            <div class="me-tile"><div class="k">@Tr("MEDebit")</div><div class="v">@_debit.ToString("N2")</div></div>
            <div class="me-tile"><div class="k">@Tr("MECredit")</div><div class="v">@_credit.ToString("N2")</div></div>
            <div class="me-tile @(_lines.Count == 0 ? "" : _balanced ? "ok" : "bad")"><div class="k">@(_balanced && _lines.Count > 0 ? Tr("MEBalanced") : Tr("MEDiff"))</div><div class="v">@((_debit - _credit).ToString("N2"))</div></div>
        </div>

        @if (_warnings.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="status">
                <b>@Tr("MEWarnings")</b>
                <ul style="margin:4px 0 0; padding-inline-start:20px">@foreach (var w in _warnings) { <li>@w</li> }</ul>
            </MudAlert>
        }

        <div class="me-btns">
            @if (_editable)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_busy || _lines.Count == 0)" OnClick="SaveAsync">@(_head.Id > 0 ? Tr("MEUpdate") : Tr("MESave"))</MudButton>
            }
            @if (_head.Id > 0)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Disabled="_busy" OnClick="CopyEntry">@Tr("MECopy")</MudButton>
            }
            @if (_head.Id > 0 && _head.IsEditable && _canDelete)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" Disabled="_busy" OnClick="DeleteAsync">@Tr("MEDelete")</MudButton>
            }
        </div>
    </div>
</div>
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public long? EntryId { get; set; }
    /// <summary>نسخ قيد سابق: يفتح محتوى هذا القيد كقيد جديد (تاريخ اليوم ورقم جديد).</summary>
    [Parameter] public long? CopyFromId { get; set; }
    /// <summary>نمط الإدخال: Typed | Columns | Pair (انظر أعلى الملف).</summary>
    [Parameter] public string Mode { get; set; } = "Columns";
    /// <summary>مسار الصفحة الحالية (للعودة لقيد جديد/النسخ).</summary>
    [Parameter] public string BasePath { get; set; } = "/accounts/journal-entry/madin-da2n";

    private record Opt(long Id, string Name);

    private class Slot
    {
        public int Selection = 2, AccountType, Key;
        public long CustomerId, SupplierId, SubId, CostCenterId;
        public string SubName = "", Notes = "";
        public decimal BalanceBefore, Amount, Debit, Credit;
        public bool IsDebit = true;
        public List<Opt> CostCenters = new();
        public (string Code, long CurrencyId, int AcceptCostCenter, int AccountType, long MainAccountId) Info;
    }

    private readonly ManualEntryService _svc = new();
    private readonly CashVouchersService _cv = new();
    private ManualEntryService.Head _head = new();
    private List<ManualEntryService.Line> _lines = new();
    private List<Opt> _journals = new(), _branches = new(), _currencies = new();
    private List<Slot> _slots = new();
    private List<string> _warnings = new();
    private string? _error, _lineError;
    private bool _busy, _canDelete;
    private int _keySeq;

    private bool _editable => _head.Id == 0 || _head.IsEditable;
    private decimal _debit => _lines.Where(l => l.IsDebit).Sum(l => l.Amount);
    private decimal _credit => _lines.Where(l => !l.IsDebit).Sum(l => l.Amount);
    private bool _balanced => Math.Abs(_debit - _credit) < 0.005m;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        try
        {
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                _canDelete = AccountModelsLib.Common.IsHavePermission(AccountModelsLib.Common.User_Id, 326, AccountModelsLib.Common.Project_ID, AccountModelsLib.Common.Branch_Id);
                var br = new Account_BrancheCLS().Get_DataUSER_DETAILES_Branches_Permission(false, AccountModelsLib.Common.User_Id);
                _branches = br.Rows.Cast<DataRow>().Select(r => new Opt(Convert.ToInt64(r["Id"]), r["Branch_Name"]?.ToString() ?? "")).ToList();
                _journals = _svc.GetJournals().Rows.Cast<DataRow>().Select(r => new Opt(Convert.ToInt64(r["Code"]), r["Journal_Name"]?.ToString() ?? "")).ToList();
                _currencies = _svc.GetCurrencies().Rows.Cast<DataRow>().Select(r => new Opt(Convert.ToInt64(r["ID"]), r["Currency_Name"]?.ToString() ?? "")).ToList();
            });
            if (EntryId is > 0) await LoadAsync(EntryId.Value);
            else if (CopyFromId is > 0) await CopyLoadAsync(CopyFromId.Value);
            else await ResetNewAsync();
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private async Task ResetNewAsync()
    {
        _head = new ManualEntryService.Head
        {
            Date = DateTime.Today,
            BranchId = _branches.Any(b => b.Id == AccountModelsLib.Common.Branch_Id) ? AccountModelsLib.Common.Branch_Id : _branches.FirstOrDefault()?.Id ?? 0,
            JournalCode = _journals.FirstOrDefault()?.Id ?? 0,
            EntryCurrencyId = AccountModelsLib.Common.Entry_Currency_Id,
            DocNo = "0"
        };
        _head.EntryCurrencyName = _currencies.FirstOrDefault(c => c.Id == _head.EntryCurrencyId)?.Name ?? "";
        _lines = new(); _warnings = new(); _error = null; _lineError = null;
        ResetSlots();
        await RefreshNumberAsync();
    }

    private async Task RefreshNumberAsync()
    {
        if (_head.Id > 0 || _head.JournalCode <= 0) return;
        var d = _head.Date; var j = _head.JournalCode;
        _head.EntryNo = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.NextEntryNo(d, j); });
    }

    private async Task LoadAsync(long id)
    {
        var (h, ls) = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Load(id); });
        if (h == null) { _error = Tr("MENotFound"); await ResetNewAsync(); return; }
        _head = h; _lines = ls; _warnings = new(); _error = null;
        ResetSlots();
    }

    private async Task CopyLoadAsync(long id)
    {
        var (h, ls) = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Load(id); });
        if (h == null) { _error = Tr("MENotFound"); await ResetNewAsync(); return; }
        h.Id = 0; h.EntryNo = 0; h.Date = DateTime.Today; h.Posted = false; h.ReferenceType = 0;
        foreach (var l in ls) l.DetailsId = 0;
        _head = h; _lines = ls; _warnings = new(); _error = null;
        ResetSlots();
        await RefreshNumberAsync();
    }

    private async Task OnJournalAsync(long j) { _head.JournalCode = j; await RefreshNumberAsync(); }
    private async Task OnDateAsync(DateTime? d) { _head.Date = (d ?? DateTime.Today).Date; await RefreshNumberAsync(); }

    private async Task OnCurrencyAsync(long id)
    {
        _head.EntryCurrencyId = id;
        _head.EntryCurrencyName = _currencies.FirstOrDefault(c => c.Id == id)?.Name ?? "";
        _head.Factor = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetFactor(id); });
    }

    private void OnSelectionChanged(Slot s, int value) { s.Selection = value; s.SubId = 0; s.SubName = ""; s.CustomerId = 0; s.SupplierId = 0; s.CostCenters = new(); s.CostCenterId = 0; }

    private async Task OnSubAccountChangedAsync(Slot s, long id)
    {
        s.SubId = id; s.CostCenters = new(); s.CostCenterId = 0; _lineError = null;
        if (id == 0) return;
        var none = Tr("CVNoCostCenter");
        var (info, ccs) = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var inf = _svc.AccountInfo(id);
            var dt = _cv.GetCostCenters(id, inf.AcceptCostCenter, none);
            return (inf, dt.Rows.Cast<DataRow>().Select(r => new Opt(Convert.ToInt64(r["Id"]), r["Name"]?.ToString() ?? "")).ToList());
        });
        s.Info = info; s.CostCenters = ccs; s.CostCenterId = ccs.FirstOrDefault()?.Id ?? 0;
    }

    private void ResetSlots()
    {
        int n = Mode == "Pair" ? 2 : 1;
        _slots = Enumerable.Range(0, n).Select(_ => new Slot { Key = ++_keySeq }).ToList();
        SuggestDifference();
    }

    // نمط Typed: القيمة والنوع المقترحان = الفرق الجارى بين المدين والدائن (كما فى الأصل).
    private void SuggestDifference()
    {
        if (Mode != "Typed" || _slots.Count == 0) return;
        var diff = _debit - _credit;
        if (Math.Abs(diff) < 0.005m) return;
        _slots[0].IsDebit = diff < 0;
        _slots[0].Amount = Math.Abs(diff);
    }

    // يستخرج (مدين؟، قيمة) من خانات الإدخال حسب النمط؛ false + رسالة عند الخطأ.
    private bool TryRead(Slot s, out bool isDebit, out decimal amount)
    {
        isDebit = s.IsDebit; amount = s.Amount;
        if (Mode != "Typed")
        {
            if (s.Debit > 0 && s.Credit > 0) { _lineError = Tr("MEOneSide"); return false; }
            isDebit = s.Debit > 0; amount = isDebit ? s.Debit : s.Credit;
        }
        if (amount <= 0) { _lineError = Tr("STInvoiceValueRequired"); return false; }
        return true;
    }

    private void AddLine()
    {
        _lineError = null;
        var toAdd = new List<ManualEntryService.Line>();
        foreach (var s in _slots)
        {
            if (s.SubId == 0) { _lineError = Tr("CVSelectAccount"); return; }
            var cc = s.CostCenters.FirstOrDefault(c => c.Id == s.CostCenterId);
            if (cc is null) { _lineError = Tr("CVCostCenterRequired"); return; }
            if (!TryRead(s, out var isDebit, out var amount)) return;
            toAdd.Add(new ManualEntryService.Line
            {
                SubAccountId = s.SubId, AccountName = s.SubName, AccountCode = s.Info.Code, AccountType = s.Info.AccountType, MainAccountId = s.Info.MainAccountId,
                AccountCurrencyId = s.Info.CurrencyId, IsDebit = isDebit, Amount = amount, CostCenterId = cc.Id, CostCenterName = cc.Name, Notes = s.Notes ?? ""
            });
        }
        _lines.AddRange(toAdd);
        ResetSlots();
    }

    private void RemoveLine(ManualEntryService.Line l) { _lines.Remove(l); SuggestDifference(); }

    private void CopyEntry() => Nav.NavigateTo(BasePath + "?copy=" + _head.Id);

    private async Task NewEntryAsync()
    {
        await ResetNewAsync();
        if (EntryId is > 0 || CopyFromId is > 0) Nav.NavigateTo(BasePath);
    }

    private async Task SaveAsync()
    {
        _error = null; _warnings = new();
        var ok = await DialogService.ShowMessageBoxAsync(Title, Tr("MEConfirmSave"), yesText: Tr("MESave"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _busy = true;
        var head = _head; var lines = _lines.ToList();
        try
        {
            var r = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return head.Id > 0 ? _svc.SaveEdit(head, lines) : _svc.SaveNew(head, lines); });
            if (!r.Ok) { _error = r.Message; return; }
            var warnings = r.Warnings.Select(w => w.ToString()).ToList();
            Snackbar.Add(Tr("MESaved", r.EntryNo), Severity.Success);
            // بعد الحفظ نعيد تحميل القيد من القاعدة (يعرض ما حُفظ فعلاً ويقفل الرأس).
            await LoadAsync(head.Id > 0 ? head.Id : r.EntryId);
            _warnings = warnings;
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("MEDelete"), Tr("MEDeleteConfirm"), yesText: Tr("MEDelete"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _busy = true; var id = _head.Id;
        try
        {
            var r = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Delete(id); });
            if (!r.Ok) { _error = r.Message; return; }
            Snackbar.Add(Tr("MEDeleted"), Severity.Success);
            await NewEntryAsync();
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        finally { _busy = false; }
    }

    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
