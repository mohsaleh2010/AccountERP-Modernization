@* 🟢 عقدة قائمة قابلة للتكرار الذاتي: تعرض أي عمق من القوائم الفرعية (فرع داخل فرع...)
   بدلاً من الاقتصار على مستويين فقط (قائمة رئيسية + فرعية مباشرة). إذا كان لدى العنصر
   أبناء يُعرض كـ MudNavGroup قابل للطي يحتوي على MenuNode لكل ابن (تكرار ذاتي حقيقي)،
   وإلا يُعرض كرابط MudNavLink نهائي يفتح شاشته مباشرة (إن كانت مبنية فعلاً) أو يعرض
   تنبيه "قيد الإنشاء" بدون أي تنقّل (راجع KnownRoutes.cs لسبب ذلك). *@
@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject NotificationCenterService NotificationCenter
@implements IDisposable

@if (Children.Any())
{
    <MudNavGroup Title="@Menu.GetLocalizedDescription(LangService.CurrentLanguage)" Icon="@GetGroupIcon(Menu.Description)" Expanded="@MenuState.IsMenuExpanded(Menu.Menu_ID)"
                 ExpandedChanged="@((bool v) => MenuState.SetMenuExpanded(Menu.Menu_ID, v))" Class="menu-node-group">
        @foreach (var child in Children)
        {
            <MenuNode Menu="@child" />
        }
    </MudNavGroup>
}
else
{
    var route = Menu.GetEffectiveRoute();
    var implemented = KnownRoutes.IsImplemented(route);
    @if (implemented)
    {
        <MudNavLink Href="@route" Match="NavLinkMatch.Prefix" Icon="@GetLeafIcon(Menu.Description)">
            @Menu.GetLocalizedDescription(LangService.CurrentLanguage)
        </MudNavLink>
    }
    else
    {
        @* 🟢 بدون Href إطلاقاً: يمنع أي محاولة تنقّل (وبالتالي دائرة/Circuit جديدة وإعادة تحميل القوائم
           من قاعدة البيانات من الصفر) لأي شاشة لم تُبنَ بعد بـ Blazor - راجع KnownRoutes.cs. *@
        <MudNavLink OnClick="@ShowNotImplemented" Icon="@GetLeafIcon(Menu.Description)" Class="menu-node-pending">
            @Menu.GetLocalizedDescription(LangService.CurrentLanguage)
            @* 🟢 Text="..." بدلاً من ChildContent: راجع نفس التعليق فى Home.razor - MudChip لا يُحدّث نص
               ChildContent بشكل موثوق عند تبديل اللغة فقط، بعكس خاصية Text العادية. *@
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ms-2 menu-node-pending-chip" Text="@Tr("ComingSoon")" />
        </MudNavLink>
    }
}

@code {
    [Parameter, EditorRequired]
    public MenuViewModel Menu { get; set; } = null!;

    // 🟢 حالة الطي/التوسيع لم تعد محلية هنا (كانت _expanded = false افتراضياً) بل مركزية فى
    // MenuState.ExpandedMenuIds - راجع MenuStateService فى SysConfigMenusCLS.cs. لا يزال السلوك الافتراضي
    // نفسه (كل القوائم مطوية بعد تسجيل الدخول لأن المجموعة فارغة فى البداية)، لكن الآن يمكن لزر "توسيع/طي
    // الكل" فى رأس القائمة الجانبية (MainLayoutMud) التحكم فى كل الأعماق دفعة واحدة بدلاً من عقدة واحدة فقط.
    protected override void OnInitialized()
    {
        // 🟢 اشتراك مباشر بدلاً من الاعتماد فقط على إعادة الرندرة المتتالية من الأب (NavMenuMud/MenuNode
        // الأعلى) - نفس السبب الموثّق فى NavMenuMud.razor: لوحظ أن الرندرة المتتالية داخل MudDrawer/
        // MudNavGroup غير موثوقة 100% من الوقت.
        MenuState.OnExpandCollapseAll += OnExpandCollapseAllHandler;
    }

    private void OnExpandCollapseAllHandler() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        MenuState.OnExpandCollapseAll -= OnExpandCollapseAllHandler;
    }

    private List<MenuViewModel> Children =>
        MenuState.UserAllowedMenus.Where(c => c.ParentId == Menu.Menu_ID).ToList();

    private void ShowNotImplemented()
    {
        var message = Tr("ScreenNotBuiltYet", Menu.GetLocalizedDescription(LangService.CurrentLanguage));
        Snackbar.Add(message, MudBlazor.Severity.Info);
        NotificationCenter.Add(message, MudBlazor.Severity.Info);
    }

    // 🟢 Tr(...) بدلاً من Lang[...] مباشرة (اسم مختلف عمداً عن "T" لتفادي أي تضارب مع خاصية النوع العام
    // T="string" على MudChip فى نفس الشجرة): راجع نفس التعليق فى NavMenuMud.razor - يضمن ترجمة "قيد الإنشاء"/
    // "قريباً" هنا بالثقافة الصحيحة بغض النظر عن ثقافة الخيط الفعلي وقت الرندرة (IStringLocalizer.
    // WithCulture(...) غير متاحة فى net10.0).
    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    // 🟢 أيقونة كل وحدة رئيسية/فرعية تحتوي على شاشات (Group) بنمط Outlined لتمييزها بصرياً عن الوحدات
    // الرئيسية (Filled)، وأيقونة كل شاشة نهائية (Leaf) بمطابقة أدق لطبيعة الشاشة نفسها (قائمة/إضافة/تقرير/
    // طباعة...) - كلتاهما فى MenuIcons.cs (Services) لتُستخدَما أيضاً من بطاقات الشاشة الرئيسية
    // (Home.razor) وشريط التبويبات (TabHost.razor) بدل تكرارهما نسخة خاصة هنا - نفس الأيقونة لأى شاشة
    // سواء ظهرت بالقائمة الجانبية أو كبطاقة أو كتبويب مفتوح.
    private static string GetGroupIcon(string? description) => MenuIcons.GetGroupIcon(description);

    private static string GetLeafIcon(string? description) => MenuIcons.GetLeafIcon(description);
}
