@* 🟢 مسار التنقّل الهرمي (Breadcrumb) أعلى كل شاشة حقيقية مفتوحة من القوائم: "الوحدات المتاحة لك > بيانات
   أساسية > العملاء > بيانات العملاء" - بطلب المستخدم صراحة لسهولة معرفة "أين أنا" والعودة لأي مستوى أعلى
   بضغطة واحدة، بدل الاعتماد فقط على القائمة الجانبية. يُعاد بناؤه من نفس بيانات SysConfigMenus المستخدَمة
   فى القائمة الجانبية (MenuState.UserAllowedMenus) عبر FindMenuForRoute/BuildAncestorPath (راجع
   MenuLocalization.cs) - وليس نصاً ثابتاً لكل شاشة، فيعمل تلقائياً لأي شاشة جديدة تُربَط بـ RazorPath مستقبلاً
   بدون أي تعديل هنا. يختفي تماماً على أي مسار لا يقابل عنصر قائمة (الرئيسية/الدخول/تغيير كلمة المرور...)،
   وبالكامل لو ألغى المستخدم إظهاره من إعدادات حسابه (راجع UserPreferencesService.cs وMainLayoutMud.razor).
   العنصر الجذر ("الوحدات المتاحة لك") والعناصر الوسيطة (الوحدات/المجموعات التى لا تفتح شاشة بنفسها) روابط
   تعيد المستخدم لنفس المستوى فى بطاقات الرئيسية الهرمية (Home.razor)، وعنصر الشاشة الحالية نص غير قابل للنقر.

   🟢 القوائم المنسدلة: أي عنصر فى المسار له أبناء (عناصر ParentId الخاصة بها = Menu_ID له) يظهر بجواره سهم
   يفتح قائمة تحت المسار مباشرة بأبنائه - وليس أشقاءه (كان هذا خطأ محاولة أولى صُحِّح بملاحظة المستخدم).
   الجذر حالة خاصة: أبناؤه هى الوحدات الرئيسية (ParentId == 0). أي ابن له أبناء بدوره يظهر كقائمة فرعية
   متداخلة (MudMenu داخل MudMenu) تتفتح بالوقوف عليها أو بالضغط/السهم من لوحة المفاتيح (للمس أيضاً)، حتى أعمق
   مستوى، والعنصر الأخير (بلا أبناء) يفتح شاشته مباشرة. عناصر المسار الحالى مميَّزة داخل القوائم.
   إعدادا المستخدم BreadcrumbMainMenus (سهم الجذر) وBreadcrumbSubMenus (أسهم باقى المستويات) يتحكمان فى
   ظهور الأسهم - راجع UserSettingsMenu.razor. الضغط على النص نفسه يبقى بنفس سلوكه (الانتقال لمستوى العنصر). *@

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject NotificationCenterService NotificationCenter
@inject UserPreferencesService Prefs
@implements IDisposable

@if (_ancestors.Count > 0)
{
    <nav class="page-breadcrumb mb-3" aria-label="@Tr("BreadcrumbAriaLabel")">
        <ol class="bc-list">
            <li class="bc-item">
                <a href="/" class="bc-link bc-home">
                    <MudIcon Icon="@Icons.Material.Outlined.Home" Size="Size.Small" aria-hidden="true" />
                    <span>@Tr("HomeQuickAccessTitle")</span>
                </a>
                @if (Prefs.BreadcrumbMainMenus)
                {
                    var rootChildren = GetTopLevelModules();
                    @if (rootChildren.Count > 0)
                    {
                        @ChildrenCaret(rootChildren, Tr("HomeQuickAccessTitle"), true)
                    }
                }
            </li>

            @for (var i = 0; i < _ancestors.Count; i++)
            {
                var node = _ancestors[i];
                var isLast = i == _ancestors.Count - 1;
                var title = node.GetLocalizedDescription(LangService.CurrentLanguage);

                <li class="bc-item">
                    <MudIcon Icon="@(LangService.IsRtl ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)"
                             Size="Size.Small" Class="bc-sep" aria-hidden="true" />
                    @if (isLast)
                    {
                        <span class="bc-current" aria-current="page">@title</span>
                    }
                    else
                    {
                        <a href="@("/?openMenu=" + node.Menu_ID)" class="bc-link">@title</a>
                    }
                    @if (Prefs.BreadcrumbSubMenus)
                    {
                        var children = GetChildrenOf(node);
                        @if (children.Count > 0)
                        {
                            @ChildrenCaret(children, title, false)
                        }
                    }
                </li>
            }
        </ol>
    </nav>
}

@code {
    // أقصى عمق للقوائم الفرعية المتداخلة - حماية من أى حلقة فى بيانات ParentId
    private const int MaxMenuDepth = 6;

    private List<MenuViewModel> _ancestors = new();
    private HashSet<long> _ancestorIds = new();

    protected override void OnInitialized()
    {
        Recompute();
        NavigationManager.LocationChanged += OnLocationChanged;
        MenuState.OnAuthChanged += OnStateChanged;
        MenuState.OnMainMenuChanged += OnStateChanged;
        LangService.OnLanguageChanged += OnStateChanged;
        Prefs.OnChanged += OnStateChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => OnStateChanged();

    private void OnStateChanged()
    {
        Recompute();
        InvokeAsync(StateHasChanged);
    }

    private void Recompute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var leaf = MenuState.UserAllowedMenus.FindMenuForRoute(relativePath);
        _ancestors = leaf == null ? new List<MenuViewModel>() : MenuState.UserAllowedMenus.BuildAncestorPath(leaf);
        _ancestorIds = _ancestors.Select(a => a.Menu_ID).ToHashSet();
    }

    // "أبناء" الجذر = الوحدات الرئيسية نفسها (ParentId == 0) - لا يوجد عنصر MenuViewModel حقيقي يمثّل الجذر
    private List<MenuViewModel> GetTopLevelModules() =>
        MenuState.UserAllowedMenus.Where(m => m != null && m.ParentId == 0).ToList();

    // أبناء أي عنصر آخر = كل عنصر ParentId الخاص به يساوي Menu_ID هذا العنصر (المستوى التالي، لا الأشقاء)
    private List<MenuViewModel> GetChildrenOf(MenuViewModel node) =>
        MenuState.UserAllowedMenus.Where(m => m != null && m.ParentId == node.Menu_ID).ToList();

    // 🟢 السهم + القائمة المنسدلة تحته مباشرة (BottomCenter→TopCenter)؛ زر حقيقى بحجم 28px واسم مقروء لقارئ الشاشة
    private RenderFragment ChildrenCaret(List<MenuViewModel> children, string ownerTitle, bool isModuleLevel) =>
        @<MudMenu Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Class="bc-caret"
                  AriaLabel="@Tr("BreadcrumbShowSubmenus", ownerTitle)" title="@Tr("BreadcrumbShowSubmenus", ownerTitle)"
                  Dense="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                  PopoverClass="bc-menu" MaxHeight="420">
            @MenuItems(children, isModuleLevel, 0)
        </MudMenu>;

    // 🟢 عنصر له أبناء = قائمة فرعية متداخلة تتفتح بالوقوف عليها، وإلا عنصر يفتح شاشته. عناصر المسار الحالى مميَّزة.
    private RenderFragment MenuItems(List<MenuViewModel> items, bool isModuleLevel, int depth) => __builder =>
    {
        foreach (var item in items)
        {
            var title = item.GetLocalizedDescription(LangService.CurrentLanguage);
            var kids = depth < MaxMenuDepth ? GetChildrenOf(item) : new List<MenuViewModel>();
            var cssClass = _ancestorIds.Contains(item.Menu_ID) ? "bc-menu-item bc-menu-item-active" : "bc-menu-item";

            if (kids.Count > 0)
            {
                @* القائمة الفرعية تتفتح فى اتجاه القراءة: يساراً فى العربية ويميناً فى اللغات اللاتينية *@
                <MudMenu Label="@title" Dense="true" PopoverClass="bc-menu" MaxHeight="420" Class="@cssClass"
                         AnchorOrigin="@(LangService.IsRtl ? Origin.TopLeft : Origin.TopRight)"
                         TransformOrigin="@(LangService.IsRtl ? Origin.TopRight : Origin.TopLeft)"
                         StartIcon="@(isModuleLevel ? MenuIcons.GetModuleIcon(item.Description) : MenuIcons.GetGroupIcon(item.Description))">
                    @MenuItems(kids, false, depth + 1)
                </MudMenu>
            }
            else
            {
                <MudMenuItem Class="@cssClass" OnClick="@(() => GoToMenuItem(item))"
                             Icon="@(isModuleLevel ? MenuIcons.GetModuleIcon(item.Description) : MenuIcons.GetLeafIcon(item.Description))">
                    @title
                </MudMenuItem>
            }
        }
    };

    // نفس منطق فتح عنصر قائمة المستخدَم فى NavMenuMud.razor/MenuNode.razor/Home.razor بالضبط: عنصر له أبناء
    // يفتح الرئيسية عند مستواه هو (وليس شاشة له بنفسه)، وإلا يُفتَح كشاشة حقيقية إن وُجدت أو "قيد الإنشاء".
    private void GoToMenuItem(MenuViewModel menu)
    {
        var hasChildren = MenuState.UserAllowedMenus.Any(c => c.ParentId == menu.Menu_ID);
        if (hasChildren)
        {
            NavigationManager.NavigateTo("/?openMenu=" + menu.Menu_ID);
            return;
        }

        var route = menu.GetEffectiveRoute();
        if (KnownRoutes.IsImplemented(route))
        {
            NavigationManager.NavigateTo(route);
        }
        else
        {
            var message = Tr("ScreenNotBuiltYet", menu.GetLocalizedDescription(LangService.CurrentLanguage));
            Snackbar.Add(message, MudBlazor.Severity.Info);
            NotificationCenter.Add(message, MudBlazor.Severity.Info);
        }
    }

    // 🟢 Tr(...) بدلاً من Lang[...] مباشرة: راجع نفس التعليق فى MainLayoutMud.razor/NavMenuMud.razor -
    // يضمن ترجمة "الوحدات المتاحة لك" بالثقافة الصحيحة بغض النظر عن ثقافة الخيط الفعلي وقت الرندرة.
    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        MenuState.OnAuthChanged -= OnStateChanged;
        MenuState.OnMainMenuChanged -= OnStateChanged;
        LangService.OnLanguageChanged -= OnStateChanged;
        Prefs.OnChanged -= OnStateChanged;
    }
}

<style>
    /* 🟢 شريط المسار: سطح خفيف بحد رفيع وزوايا مستديرة، يلتف على الشاشات الضيقة بدل تمرير أفقى */
    .page-breadcrumb {
        background: var(--mud-palette-surface);
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 10px;
        padding: 4px 8px;
    }

    .page-breadcrumb .bc-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 2px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .page-breadcrumb .bc-item {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        min-width: 0;
    }

    .page-breadcrumb .bc-sep {
        color: var(--mud-palette-text-disabled);
        margin-inline: 2px;
    }

    .page-breadcrumb .bc-link,
    .page-breadcrumb .bc-current {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 32px;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.875rem;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .page-breadcrumb .bc-link {
        color: var(--mud-palette-text-secondary);
        text-decoration: none;
        transition: background-color 150ms ease, color 150ms ease;
    }

    .page-breadcrumb .bc-link:hover {
        background: var(--mud-palette-action-default-hover);
        color: var(--mud-palette-primary);
    }

    .page-breadcrumb .bc-current {
        color: var(--mud-palette-text-primary);
        font-weight: 600;
    }

    /* 🟢 زر السهم (زر MudMenu الافتراضى - Class على غلاف القائمة): 28px (فوق حد WCAG 24px)، يدور 180° أثناء فتح قائمته */
    .page-breadcrumb .bc-caret .mud-icon-button {
        width: 28px;
        height: 28px;
        padding: 0;
        border-radius: 6px;
        color: var(--mud-palette-text-secondary);
        transition: background-color 150ms ease, color 150ms ease;
    }

    .page-breadcrumb .bc-caret .mud-icon-button:hover,
    .page-breadcrumb .bc-caret .mud-icon-button[aria-expanded="true"] {
        background: var(--mud-palette-action-default-hover);
        color: var(--mud-palette-primary);
    }

    .page-breadcrumb .bc-caret .mud-icon-root {
        font-size: 1.2rem;
        transition: transform 200ms ease;
    }

    .page-breadcrumb .bc-caret .mud-icon-button[aria-expanded="true"] .mud-icon-root {
        transform: rotate(180deg);
    }

    .page-breadcrumb .bc-link:focus-visible,
    .page-breadcrumb .bc-caret .mud-icon-button:focus-visible {
        outline: 2px solid var(--mud-palette-primary);
        outline-offset: 1px;
    }

    /* 🟢 القوائم المنسدلة (تُرسَم فى طبقة MudPopover خارج الشريط، فالمحدِّد عام بـ bc-menu) */
    .bc-menu.mud-popover {
        min-width: 240px;
        border-radius: 10px;
        border: 1px solid var(--mud-palette-lines-default);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .bc-menu .mud-list {
        padding: 6px;
    }

    .bc-menu .mud-menu-item {
        border-radius: 6px;
        min-height: 36px;
    }

    .bc-menu .mud-menu-item .mud-icon-root {
        color: var(--mud-palette-text-secondary);
    }

    .bc-menu .bc-menu-item-active,
    .bc-menu .bc-menu-item-active .mud-menu-item {
        color: var(--mud-palette-primary);
        font-weight: 600;
        background: var(--mud-palette-primary-hover);
    }

    .bc-menu .bc-menu-item-active .mud-icon-root {
        color: var(--mud-palette-primary);
    }

    @@media (prefers-reduced-motion: reduce) {
        .page-breadcrumb .bc-link,
        .page-breadcrumb .bc-caret .mud-icon-button,
        .page-breadcrumb .bc-caret .mud-icon-root {
            transition: none;
        }
    }
</style>
