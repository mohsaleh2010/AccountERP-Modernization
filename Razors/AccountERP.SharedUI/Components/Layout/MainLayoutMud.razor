 @inherits LayoutComponentBase
@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.Models
@using AccountERP.SharedUI
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using Microsoft.Extensions.DependencyInjection

@inject NavigationManager NavigationManager
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject ThemeService ThemeService
@inject IServiceProvider ServiceProvider
@inject IJSRuntime JSRuntime
@inject AppSettings Settings
@inject ISnackbar Snackbar
@inject TabWorkspaceService TabWorkspace
@inject UserPreferencesService Prefs
@implements IDisposable

@* 🟢 نمط عام (غير مُعزول Scoped) عمداً - وُضِع هنا كـ<style> صريح بدلاً من MainLayoutMud.razor.css لأن جرِّب
   فعلياً أن Blazor CSS Isolation لا يُلحِق سمة النطاق (scope attribute) بجذر <MudMainContent> نفسه (عنصر
   يُرسِمه مكوِّن MudBlazor داخلياً، وليس عنصر HTML مباشر فى ملف هذا المكوِّن) - فأى قاعدة "::deep" فى ملف
   .razor.css المرتبط بهذا المكوِّن لا تُطابِق شيئاً إطلاقاً وتبقى بلا أثر بصمت. .mud-selected-item الافتراضية
   من MudBlazor نفسها خافتة جداً (تراكب أسود بشفافية 4% فقط - تحقَّقنا مباشرة عبر getComputedStyle) فلا يتميّز
   الصف المُحدَّد فعلياً بأى لون واضح عند النقر عليه فى أى جدول MudTable بكامل التطبيق - هذا التنسيق العام
   يُطبَّق مرة واحدة هنا (المكوِّن الذى يُغلِّف كل صفحة) بدل تكراره فى كل شاشة قائمة على حدة. *@
<style>
    .mud-main-content .mud-table-row.mud-selected-item {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.18) !important;
    }

    .mud-main-content .mud-table-row.mud-selected-item:hover {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.26) !important;
    }

    /* 🟢 تنسيق موحَّد لكل جداول MudTable (بطلب المستخدم، معمَّم من جدول أصناف الفاتورة): هيدر بلون الثيم الأساسى مع خط أكبر وعريض،
       خط أكبر لخلايا الجسم، وتظليل خفيف بالتناوب. الصف المحدد يغلب التظليل لأن قاعدته أعلاه بـ!important. */
    .mud-main-content .mud-table-root .mud-table-head .mud-table-cell {
        background-color: var(--mud-palette-primary);
        color: var(--mud-palette-primary-text);
        font-size: 1rem;
        font-weight: 700;
        border-bottom: 1px solid var(--mud-palette-primary-darken);
    }

    .mud-main-content .mud-table-root .mud-table-head .mud-table-sort-label,
    .mud-main-content .mud-table-root .mud-table-head .mud-table-sort-label .mud-icon-root,
    .mud-main-content .mud-table-root .mud-table-head .mud-checkbox .mud-icon-root {
        color: inherit;
    }

    .mud-main-content .mud-table-root .mud-table-body .mud-table-cell {
        font-size: 1rem;
    }

    .mud-main-content .mud-table-root .mud-table-body .mud-table-row:nth-of-type(even) {
        background-color: color-mix(in srgb, var(--mud-palette-primary) 4%, var(--mud-palette-surface));
    }
</style>

@* 1. مزود الثيمات (فاتح/داكن) - يبقى خارج مزود الـ RTL (لا علاقة له باتجاه النص) *@
<MudThemeProvider Theme="_currentTheme" IsDarkMode="@ThemeService.IsDarkMode" />

@* 2. مزود الـ RTL الديناميكي يلتف حول التطبيق بالكامل ويقرأ مباشرة من الـ Service القائمة.
   🟢 MudPopoverProvider/MudDialogProvider/MudSnackbarProvider انتقلوا إلى داخل MudRTLProvider (كانوا خارجه
   تماماً قبل ذلك): هذه المزوّدات الثلاثة تعرض محتواها فعلياً (المودالات/القوائم المنبثقة/رسائل التنبيه) فى
   مكان DOM الخاص بها هى نفسها كـ"بوابة" (Portal) - وليس فى مكان استدعاء <MudDialog>/<MudMenu> داخل الصفحة -
   فكان أي مودال (مثل مودال "مجموعة جديدة" فى CustomerGroupsList.razor) يُرسم خارج نطاق dir="rtl" الذى يضبطه
   MudRTLProvider على شجرته فقط، فيظهر بترتيب LTR دائماً بغض النظر عن لغة الواجهة الحالية. *@
<MudRTLProvider RightToLeft="@LangService.IsRtl">
    <MudPopoverProvider />
    @* 🟢 MaxWidth=Small كافتراضي عام لكل المودالات (بدلاً من ExtraLarge القديم): كان يجعل أي مودال صغير
       (مثل مودال "مجموعة جديدة" بحقل نصي واحد فقط، أو أي MessageBox تأكيد) يمتد تقريباً بعرض الشاشة كاملة
       بلا داعٍ بدل أن يظهر فى المنتصف بحجم معقول. أي شاشة مودال تحتاج فعلياً عرضاً أكبر (نموذج بحقول كثيرة/
       جدول بيانات) تُحدِّد ذلك صراحة عبر DialogOptions الخاصة بها (MaxWidth أكبر) بدلاً من الاعتماد على هذا
       الافتراضي العام.
       🟢 FullWidth=true (وليس false): FullWidth=false يجعل عرض المودال "ينكمش" على عرض محتواه الفعلي فقط
       (Shrink-to-fit) - لمودال بحقل واحد فقط كان هذا يظهر ضيقاً جداً وغير طبيعي بصرياً رغم أن MaxWidth نفسه
       معقول. FullWidth=true يمدد المودال ليملأ عرض MaxWidth المحدد (600px هنا تقريباً ضعف العرض السابق)
       فيظهر بحجم طبيعي مريح للعين، مع بقاء MaxWidth نفسه هو الحد الأقصى (لا يتحول لعرض الشاشة كاملة).
       🟢 BackdropClick=false: بطلب المستخدم صراحة، لا يُغلَق أي مودال بالضغط فى أي مكان خارجه بالخطأ (قد
       يفقد المستخدم بيانات أدخلها فى نموذج لم يحفظه بعد) - الإغلاق فقط عبر زر X/الإغلاق الصريح، أو زر
       الإجراء نفسه (موافق/تعديل/إضافة...)، أو زر "إلغاء" الصريح فى كل مودال. *@
    <MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" BackdropClick="false" />
    <MudSnackbarProvider />

    <MudLayout>

        @* شريط الأدوات العلوي (Top Row / AppBar) - متجاوب تلقائياً (Responsive) عبر مكونات MudBlazor *@
        <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">

            <!-- زر فتح/إغلاق القائمة الجانبية -->
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@DrawerToggle" />

            <MudText Typo="Typo.h6" Class="mx-3 fw-bold d-none d-sm-block">@Lang["AppTitle"]</MudText>

            @* 🟢 كانت هنا روابط فرعية للوحدة المختارة مكررة خارج تصميم القائمة الجانبية تماماً (بلا أيقونات
               ولا تمييز للحالة النشطة ولا Href محمي)، رغم أن نفس الروابط تظهر فعلياً ومنسّقة بشكل صحيح
               داخل الـ Drawer نفسه (MudNavGroup الموسّع تلقائياً الآن). أُزيلت لأنها تكرار بلا فائدة
               ومصدر آخر لمشكلة "إعادة التحميل من قاعدة البيانات عند أي كليك" (KeysData غير محمي بـ KnownRoutes) -
               راجع MODERNIZATION_NOTES.md. *@

            <MudSpacer />

            <!-- إجراءات الشريط العلوي: من نحن، الإشعارات، الثيم، اللغة، وحالة المستخدم -->
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">

                <MudTooltip Text="@Lang["NavAbout"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Info" Color="Color.Inherit" Href="/about" />
                </MudTooltip>

                <NotificationsMenu />

                <MudTooltip Text="@Lang["ThemesTitle"]">
                    <MudIconButton Icon="@Icons.Material.Outlined.Palette" Color="Color.Inherit" OnClick="@(() => _themesMenuOpen = true)" />
                </MudTooltip>

                <LanguageSwitcher />

                @if (MenuState.IsAuthenticated)
                {
                    @* ⚙️ إعدادات الحساب: إظهار/إخفاء مسار التنقّل وتفعيل/إلغاء نظام التبويبات - راجع
                       UserSettingsMenu.razor وUserPreferencesService.cs. مرتبطة بـ IsAuthenticated (وليس
                       IsLoaded كباقي هذا الشريط) عمداً: مستخدم مسجَّل دخوله بلا أي صلاحيات قوائم يجب أن يظل
                       قادراً على الوصول لإعداداته الخاصة رغم عدم وجود أي عنصر قائمة له. *@
                    <MudTooltip Text="@Tr("AccountSettingsTooltip")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" OnClick="@(() => _userSettingsMenuOpen = true)" />
                    </MudTooltip>
                }

                @if (MenuState.IsLoaded)
                {
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                    <MudText Typo="Typo.body2" Class="d-none d-md-block px-1">@Common.FullUserName</MudText>

                    @* 🟢 قائمة حساب المستخدم: تجمع "تغيير كلمة المرور" و"تسجيل الخروج" معاً بدل زر خروج مباشر
                       وحيد كما كان سابقاً - مع فصل بصري واضح (Divider + لون تحذيري أحمر لتسجيل الخروج)
                       حتى لا يُضغط زر الخروج بالخطأ أثناء الوصول لتغيير كلمة المرور. *@
                    <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Size="Size.Medium"
                             AnchorOrigin="@(LangService.IsRtl ? Origin.BottomLeft : Origin.BottomRight)"
                             TransformOrigin="@(LangService.IsRtl ? Origin.TopLeft : Origin.TopRight)">
                        <MudMenuItem OnClick="@(() => NavigationManager.NavigateTo("/change-password"))">
                            <div class="d-flex align-items-center" style="gap:8px; min-width:180px;">
                                <MudIcon Icon="@Icons.Material.Filled.LockReset" Size="Size.Small" />
                                <span>@Tr("MenuChangePassword")</span>
                            </div>
                        </MudMenuItem>
                        <MudDivider Class="my-1" />
                        <MudMenuItem OnClick="@LogoutClick">
                            <div class="d-flex align-items-center" style="gap:8px; min-width:180px;">
                                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Color="Color.Error" />
                                <span style="color:var(--mud-palette-error);">@Tr("Logout")</span>
                            </div>
                        </MudMenuItem>
                    </MudMenu>
                }
            </MudStack>
        </MudAppBar>

        @* القائمة الجانبية (Sidebar / NavMenu) - Variant.Responsive يحوّلها تلقائياً لقائمة منزلقة فوق المحتوى على الموبايل *@
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Variant="@DrawerVariant.Responsive">
            <MudDrawerHeader Class="px-2 py-3 bg-light border-bottom">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="w-100" Spacing="1">
                    <MudText Typo="Typo.subtitle1" Class="fw-bold text-secondary">
                        @Lang["MainMenuTitle"]
                    </MudText>
                    @* 🟢 زرّان منفصلان (توسيع الكل / طي الكل) بدلاً من زر واحد يبدّل بينهما - بناءً على طلب المستخدم
                       صراحةً. كل زر يستدعي فعله مباشرة (ExpandAllMenus/CollapseAllMenus) بدون اعتماد على حالة
                       AllMenusExpanded لتحديد أيهما يظهر - كلاهما ظاهر دائماً معاً. راجع MenuStateService فى
                       SysConfigMenusCLS.cs. *@
                    @if (MenuState.IsLoaded)
                    {
                        <MudStack Row="true" Spacing="0">
                            <MudTooltip Text="@Tr("ExpandAllMenus")">
                                <MudIconButton Icon="@Icons.Material.Filled.UnfoldMore" Size="Size.Small" Color="Color.Default"
                                               OnClick="@(() => MenuState.ExpandAllMenus())" />
                            </MudTooltip>
                            <MudTooltip Text="@Tr("CollapseAllMenus")">
                                <MudIconButton Icon="@Icons.Material.Filled.UnfoldLess" Size="Size.Small" Color="Color.Default"
                                               OnClick="@(() => MenuState.CollapseAllMenus())" />
                            </MudTooltip>
                        </MudStack>
                    }
                </MudStack>
            </MudDrawerHeader>
            <NavMenuMud />
        </MudDrawer>

        @* منطقة محتوى الصفحة الرئيسي - Container متجاوب يعمل على الويب والموبايل والديسك توب.
           🟢 pa-2/pa-md-4 عمداً على الـ MudContainer الداخلي وليس على MudMainContent نفسه: تلك أصناف
           MudBlazor الجاهزة تُطبَّق بـ !important (راجع padding:...!important فى MudBlazor.min.css)،
           فكانت تكسر قاعدة MudBlazor الخاصة بمساحة إفلات الـ AppBar الثابت (.mud-main-content{padding-top:
           var(--mud-appbar-height)}) رغم أن الأخيرة بلا !important - أي محتوى الصفحة (ومنها "Hello, world!"
           سابقاً) كان يُرسم بمساحة 8px فقط أسفل الشريط العلوي بدلاً من ارتفاعه الكامل فيبدو ملتصقاً وغير
           واضح تحته. راجع MODERNIZATION_NOTES.md. *@
        <MudMainContent Class="bg-light" Style="min-height:100vh;">
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-2 pa-md-4 mt-3">
                @if (Prefs.ShowBreadcrumb)
                {
                    <MenuBreadcrumb />
                }
                @* 🟢 _showTabWorkspace: أي شاشة حقيقية (لها @page مطابق فعلياً - راجع RoutePageRegistry.cs)
                   تُعرض كتبويب عبر TabHost بدلاً من @Body مباشرة، فتبقى حالتها محفوظة عند التنقّل لتبويب آخر
                   والعودة إليها (نمط MDI) - راجع UpdateWorkspaceForCurrentRoute أدناه. الرئيسية/الدخول/
                   تغيير كلمة المرور/من نحن... تبقى خارج نظام التبويبات تماماً وتُعرض بـ @Body كالمعتاد. *@
                @* 🟢 شرط TabWorkspace.Tabs.Count > 0 هو شبكة أمان لحالة نادرة: إغلاق آخر تبويب مفتوح (وهو
                   الرئيسية نفسها) بينما المسار الحالي لا يزال "/" - التنقّل لنفس الرابط لا يُطلِق LocationChanged
                   من Blazor (لا تغيير فعلي فى الرابط)، فتبقى قائمة التبويبات فارغة مؤقتاً؛ الرجوع لـ @Body هنا
                   يعرض المسار الحالي مباشرة بدل شريط تبويبات فارغ بلا محتوى - راجع TabHost.OnCloseTab. *@
                @if (_showTabWorkspace && TabWorkspace.Tabs.Count > 0)
                {
                    <TabHost />
                }
                else
                {
                    @* 🟢 @key: نسخة صفحة جديدة لكل مفتاح شاشة (راجع UpdateWorkspaceForCurrentRoute) *@
                    <div @key="_bodyKey">@Body</div>
                }
            </MudContainer>
        </MudMainContent>

    </MudLayout>
</MudRTLProvider>

<ThemesMenu @bind-Open="_themesMenuOpen" />
<UserSettingsMenu @bind-Open="_userSettingsMenuOpen" />

@* واجهة الأخطاء العادية للمتصفح *@
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _themesMenuOpen = false;
    private bool _userSettingsMenuOpen = false;

    // ثيم موحّد لكل الشاشات (بما فيها شاشة تسجيل الدخول عبر AuthLayout)، يُعاد بناؤه كلما غيّر
    // المستخدم اللون الأساسي من ThemesMenu (راجع OnThemeChanged) - القيمة الافتراضية في Services/AppTheme.cs
    private MudTheme _currentTheme = AppTheme.Build(AppTheme.DefaultPrimaryColor);

    // 🔐 المسارات المتاحة بدون تسجيل دخول. أي مسار آخر (الرئيسية وكل شاشات الـ ERP القادمة) محمي.
    private static readonly string[] PublicPaths = { "login", "about" };

    // 🟢 مسارات "قشرة" التطبيق التى تبقى خارج نظام التبويبات دائماً (تُعرض بـ @Body كالمعتاد) - كل ما عداها
    // من مسارات لها @page حقيقي (راجع RoutePageRegistry.cs) يُعامَل كشاشة قابلة للتبويب تلقائياً بدون أي
    // تسجيل يدوي هنا لكل شاشة جديدة. الرئيسية ("") **ليست** هنا رغم أنها ليست شاشة قائمة عادية - راجع
    // التعليق على UpdateWorkspaceForCurrentRoute: هى نفسها أول تبويب دائماً حتى يبقى شريط التبويبات (وبالتالي
    // كل شاشة أخرى مفتوحة) ظاهراً ومتاحاً حتى أثناء تصفّح بطاقات الرئيسية، بدل أن يختفي الشريط بالكامل.
    private static readonly string[] NonTabbedPaths = { "login", "about", "change-password", "notfound", "error", "loading" };

    private bool _showTabWorkspace;
    private string _bodyKey = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _currentTheme = AppTheme.Build(ThemeService.PrimaryColor);
        ApplySnackbarPosition();

        // 🔄 الاشتراك في الأحداث
        MenuState.OnMainMenuChanged += OnMenuChanged;
        MenuState.OnAuthChanged += OnAuthChanged;
        LangService.OnLanguageChanged += OnLanguageChanged;
        ThemeService.OnThemeChanged += OnThemeChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        // 🟢 ضروري تحديداً لحالة إغلاق آخر تبويب مفتوح: TabHost يعيد رسم نفسه فارغاً بمجرد أن تصبح
        // TabWorkspace.Tabs فارغة، لكن القرار بين عرض <TabHost/> أو @Body نفسه يُتَّخذ هنا فى MainLayoutMud -
        // بدون هذا الاشتراك يبقى المحتوى فارغاً لحين أي رندرة تالية غير مرتبطة، بدل التبديل الفوري لـ @Body.
        TabWorkspace.OnChanged += OnTabWorkspaceChanged;
        Prefs.OnChanged += OnPrefsChanged;

        // 🟢 دائرة (Circuit) جديدة قد تحمل كوكي دخول موقّع من دخول سابق فعلي (مثلاً بعد إعادة تحميل كاملة
        // للصفحة عبر عنصر قائمة لشاشة لم تُبنَ بعد - راجع MODERNIZATION_NOTES.md) - نحاول استعادة الجلسة
        // منه قبل تطبيق بوابة الحماية، حتى لا يُعاد توجيه مستخدم مسجَّل دخوله فعلاً إلى شاشة الدخول من جديد.
        if (!MenuState.IsAuthenticated)
        {
            await TryRestoreSessionFromCookieAsync();
        }

        // ⚙️ تُغطّي حالتين معاً: (1) دخول طازج على AuthLayout ثم تنقّل لأول صفحة MainLayoutMud - Prefs
        // فارغة هنا وIsAuthenticated سبق ضبطها true قبل هذا التنقّل، فتُحمَّل بالفحص المباشر أدناه؛ (2) دائرة
        // جديدة استعادت جلسة من الكوكي للتو (السطر أعلاه) - نفس الفحص يغطيها أيضاً. الاشتراك فى OnAuthChanged
        // أسفل هذا الملف يغطي أي تغيير لاحق (دخول/خروج فعلي أثناء حياة هذه الدائرة).
        if (MenuState.IsAuthenticated)
        {
            Prefs.Load();
            ApplyLoadedLanguagePreference();
        }

        EnforceAuthGuard();
        UpdateWorkspaceForCurrentRoute();
    }

    // 🟢 يطبِّق لغة المستخدم المحفوظة لحسابه فى قاعدة البيانات (USER_DETAILES_Setting، عبر
    // UserPreferencesService.Language) بعد كل Prefs.Load() ناجح - يُستدعى من هنا (أول تحميل لهذه الدائرة)
    // ومن OnAuthChanged أدناه (دخول فعلي لاحق أثناء حياة نفس الدائرة). لو لم يُغيِّر المستخدم لغته يدوياً من
    // قبل (Prefs.Language لا يزال null) لا نغيّر شيئاً - يبقى الافتراضى الحالى (كوكي الويب، أو العربية
    // افتراضياً على الديسك توب/الموبايل) كما هو، حتى لا نستبدل اختياراً صريحاً بلا داعٍ.
    private void ApplyLoadedLanguagePreference()
    {
        if (!string.IsNullOrWhiteSpace(Prefs.Language) &&
            !string.Equals(Prefs.Language, LangService.CurrentLanguage, StringComparison.OrdinalIgnoreCase))
        {
            LangService.SetCulture(Prefs.Language);
        }
    }

    // 🟢 يقرر لكل تنقّل: هل المسار الحالي شاشة حقيقية قابلة للتبويب (@page فعلي وليس من NonTabbedPaths)؟
    // لو كذلك، يفتح/يفعّل تبويبها فى TabWorkspace (بعنوان/أيقونة من نفس عنصر القائمة المطابق - راجع
    // MenuLocalization.FindMenuForRoute) قبل الرندرة، حتى يجد TabHost التبويب جاهزاً فوراً.
    private void UpdateWorkspaceForCurrentRoute()
    {
        var relativeWithQuery = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var relativePath = relativeWithQuery.Split('?')[0].Trim('/');

        // 🟢 عناصر قائمة تشترك فى شاشة واحدة وتختلف بـ query (sales-invoice?agile=1 / ?kta3y=1 ...) يجب أن يكون لكل منها
        // نسخة مكوّنها الخاصة (وتبويبها): مفتاح الشاشة = المسار + query عنصر القائمة المطابق. بدون ذلك يُعيد Blazor استخدام نفس
        // نسخة الصفحة عند التنقّل بين مسارين لنفس المكوّن، فتبقى الشاشة على وضع أول ما فُتحت (نقدى بدل آجل مثلاً) لأن التهيئة
        // تجرى مرة واحدة فقط. المسارات بلا query تبقى مفتاحها المسار وحده.
        MenuViewModel? menu = null;
        var screenKey = "/" + relativePath;
        if (relativePath.Length > 0)
        {
            menu = MenuState.UserAllowedMenus.FindMenuForRoute(relativeWithQuery);
            var menuRoute = menu?.GetEffectiveRoute();
            if (!string.IsNullOrWhiteSpace(menuRoute) && menuRoute.Contains('?'))
            {
                screenKey += "?" + menuRoute.Split('?', 2)[1];
            }
        }
        _bodyKey = screenKey;

        // ⚙️ المستخدم ألغى نظام التبويبات من إعداداته (راجع UserSettingsMenu.razor) - كل شاشة تُعرض بـ
        // @Body مباشرة كأنها لم تُبنَ فى نظام تبويبات إطلاقاً (شاشة واحدة، بلا شريط تبويبات). أي تبويبات
        // كانت مفتوحة بالفعل قبل الإلغاء تُفرَّغ من OnPrefsChanged فور تبديل المفتاح، لا هنا.
        if (!Prefs.ShowTabs)
        {
            _showTabWorkspace = false;
            return;
        }

        if (NonTabbedPaths.Contains(relativePath, StringComparer.OrdinalIgnoreCase))
        {
            _showTabWorkspace = false;
            return;
        }

        if (!RoutePageRegistry.TryMatch(relativePath, out var pageType, out var routeValues, out _) || pageType == null)
        {
            _showTabWorkspace = false;
            return;
        }

        _showTabWorkspace = true;

        string title;
        string icon;
        if (relativePath.Length == 0)
        {
            // 🟢 الرئيسية ليست شاشة مرتبطة بعنصر قائمة (لا تطابق أي SysConfigMenus.RazorPath) - عنوان/أيقونة
            // ثابتان بدلاً من الاعتماد على FindMenuForRoute الذى يعيد null هنا دائماً.
            title = Tr("NavHome");
            icon = Icons.Material.Filled.Home;
        }
        else
        {
            title = menu?.GetLocalizedDescription(LangService.CurrentLanguage);
            if (string.IsNullOrWhiteSpace(title))
            {
                title = relativePath.Split('/').LastOrDefault(s => !string.IsNullOrWhiteSpace(s)) ?? relativePath;
            }
            icon = MenuIcons.GetLeafIcon(menu?.Description);
        }

        TabWorkspace.OpenOrActivate(screenKey, pageType, routeValues, title, icon);
    }

    private async Task TryRestoreSessionFromCookieAsync()
    {
        try
        {
            // 🟢 غير مسجَّلة إطلاقاً على الديسك توب/الموبايل (لا كوكي/متصفح هناك أصلاً) - GetService (وليس
            // GetRequiredService) يعيد null بأمان فى تلك الحالة فنتجاهل الاستعادة بصمت.
            var sessionReader = ServiceProvider.GetService<IPersistedSessionReader>();
            var userId = sessionReader?.TryReadUserId();
            if (userId is null) return;

            var authService = ServiceProvider.GetService<IAuthService>();
            if (authService == null) return;

            await authService.RestoreSessionAsync(userId.Value);
        }
        catch
        {
            // غير حرج: أي فشل هنا يعني ببساطة عدم استعادة الجلسة - EnforceAuthGuard سيوجّه لشاشة الدخول كالمعتاد
        }
    }

    // 🟢 فى Blazor Server قد تُنفَّذ رندرات نفس الدائرة (Circuit) على خيوط فعلية مختلفة من الـ ThreadPool
    // المشترك بين كل المستخدمين، و IStringLocalizer (خاصية Lang[...]) يقرأ الثقافة من الخيط الحالي وقت
    // الرندرة. إعادة ضبطها هنا قبل كل رندرة (بغض النظر عن الحدث الذى تسبب فيها) يضمن ترجمة صحيحة دائماً
    // بدلاً من أن يبدو تبديل اللغة "بلا استجابة" أحياناً بحسب الخيط الذى نفَّذ الرندرة تحديداً.
    protected override bool ShouldRender()
    {
        LangService.ApplyToCurrentThread();
        return true;
    }

    // 🟢 Tr(...) خاصة بمحتوى قائمة حساب المستخدم (MudMenu) فقط: لوحظ أن نصوص Lang[...] العادية فى هذا
    // الملف (مثل MainMenuTitle فى رأس الـ Drawer) تتحدّث بشكل صحيح مع تبديل اللغة فى نفس الدائرة لأنها
    // جزء من الرندرة المتزامنة لهذا المكوّن نفسه، لكن محتوى MudMenu (MudMenuItem) يُرسم عبر MudPopoverProvider
    // (شجرة رندرة منفصلة فعلياً) فيبقى بلغته القديمة بدون هذا - نفس السبب والحل المُستخدَمين فى
    // LanguageSwitcher.razor/ThemesMenu.razor لقوائمهما المنبثقة - راجع MODERNIZATION_NOTES.md.
    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        EnforceAuthGuard();
        UpdateWorkspaceForCurrentRoute();
        InvokeAsync(StateHasChanged);
    }

    // بوابة الحماية: أي مسار غير موجود في PublicPaths يتطلب MenuState.IsAuthenticated == true،
    // وإلا تتم إعادة التوجيه فوراً لشاشة تسجيل الدخول. لا تعتمد على قاعدة بيانات، فقط على حالة الجلسة الحالية.
    private void EnforceAuthGuard()
    {
        if (MenuState.IsAuthenticated) return;

        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].TrimEnd('/');
        var isPublic = PublicPaths.Any(p => string.Equals(p, relativePath, StringComparison.OrdinalIgnoreCase));

        if (!isPublic)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ApplyHtmlDirection();
        }
    }

    private void OnTabWorkspaceChanged() => InvokeAsync(StateHasChanged);

    private void OnMenuChanged()
    {
        // 🟢 القوائم (ومن ثم عنوان/أيقونة أي تبويب مفتوح بالفعل قبل اكتمال تحميلها) قد تصل بعد أول رندرة -
        // إعادة الحساب هنا تلتقط العنوان الصحيح بدل أن يبقى التبويب عالقاً على العنوان الاحتياطي المؤقت.
        UpdateWorkspaceForCurrentRoute();
        InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged() => InvokeAsync(() =>
    {
        _currentTheme = AppTheme.Build(ThemeService.PrimaryColor);
        StateHasChanged();
    });

    private void OnAuthChanged() => InvokeAsync(() =>
    {
        // ⚙️ نفس الحدث المستخدَم بالفعل لتحميل/تفريغ القوائم (MenuState.UserAllowedMenus فى AuthService) -
        // تفضيلات الواجهة تتبع دورة حياة الجلسة نفسها بالضبط: تُحمَّل عند نجاح دخول/استعادة جلسة، وتعود
        // لقيمها الافتراضية عند الخروج، بدون أي تعديل على AuthService.cs نفسه فى AccountModelsLib.
        if (MenuState.IsAuthenticated)
        {
            Prefs.Load();
            ApplyLoadedLanguagePreference();
        }
        else
        {
            Prefs.ResetToDefaults();
        }

        EnforceAuthGuard();
        StateHasChanged();
    });

    // ⚙️ يُستدعى عند أي تبديل فى لوحة إعدادات الحساب (UserSettingsMenu.razor). إلغاء التبويبات تحديداً
    // يُفرِّغ أي تبويبات مفتوحة بالفعل فوراً (لا فائدة من إبقائها حيّة فى الذاكرة وهى غير قابلة للعرض أصلاً
    // بينما الإعداد معطَّل) بدل تركها معلَّقة حتى يُعيد المستخدم تفعيل التبويبات لاحقاً.
    private void OnPrefsChanged() => InvokeAsync(() =>
    {
        if (!Prefs.ShowTabs && TabWorkspace.Tabs.Count > 0)
        {
            TabWorkspace.Clear();
        }

        UpdateWorkspaceForCurrentRoute();
        StateHasChanged();
    });

    private async void OnLanguageChanged()
    {
        // إجبار الـ Layout على إعادة الرندرة لقلب الـ dir وتحديث ترجمة القوائم فوراً،
        // وتحديث عنصر <html> مباشرة للمنصات التي لا تُعيد تحميل الصفحة عند تبديل اللغة (الديسك توب/الموبايل)
        ApplySnackbarPosition();
        await InvokeAsync(StateHasChanged);
        await ApplyHtmlDirection();
    }

    // 🟢 MudSnackbarProvider يستخدم إحداثيات فيزيائية ثابتة (left/right بالبكسل عبر CSS classes مثل
    // mud-snackbar-location-top-right) ولا يلتف تلقائياً مع MudRTLProvider/dir="rtl" - نفس مشكلة
    // AnchorOrigin/TransformOrigin فى MudMenu (راجع NotificationsMenu.razor/LanguageSwitcher.razor)،
    // لذا يجب قلب الزاوية يدوياً هنا كلما تغيّرت اللغة حتى لا تبقى رسائل التنبيه (مثل "الشاشة قيد الإنشاء")
    // ظاهرة فى أعلى اليمين الفيزيائي حتى فى الوضع العربي RTL.
    private void ApplySnackbarPosition()
    {
        Snackbar.Configuration.PositionClass = LangService.IsRtl
            ? Defaults.Classes.Position.TopLeft
            : Defaults.Classes.Position.TopRight;
    }

    private async Task ApplyHtmlDirection()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("accountErpInterop.setDirection",
                LangService.IsRtl ? "rtl" : "ltr", LangService.CurrentLanguage);
        }
        catch
        {
            // يُتجاهل بأمان: قد لا يكون الـ JS Runtime جاهزاً بعد أثناء الـ Prerendering على الويب
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task LogoutClick()
    {
        // 🟢 يُحلّ IAuthService كسولاً (وليس عبر @inject) عمداً: @inject يُنشئ الخدمة فوراً عند تحميل
        // الـ Layout نفسه - أي على كل صفحة بما فيها الصفحات العامة - وهو ما يعني بناء My_DbContext
        // (ومحاولة الاتصال الفعلي بقاعدة البيانات) حتى لو لم يضغط المستخدم زر الخروج إطلاقاً.
        var authService = ServiceProvider.GetRequiredService<IAuthService>();
        await authService.LogoutAsync();
        TabWorkspace.Clear();

        // 🟢 وإلا ستعيد الدائرة التالية (بعد forceLoad أسفل هذا السطر) استعادة نفس الجلسة تلقائياً من الكوكي
        if (Settings.IsWeb)
        {
            try { await JSRuntime.InvokeVoidAsync("accountErpInterop.clearLoginCookie"); }
            catch { /* غير حرج */ }
        }

        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    public void Dispose()
    {
        // إلغاء كافة الاشتراكات لحماية الذاكرة من الـ Memory Leak
        MenuState.OnMainMenuChanged -= OnMenuChanged;
        MenuState.OnAuthChanged -= OnAuthChanged;
        LangService.OnLanguageChanged -= OnLanguageChanged;
        ThemeService.OnThemeChanged -= OnThemeChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
        TabWorkspace.OnChanged -= OnTabWorkspaceChanged;
        Prefs.OnChanged -= OnPrefsChanged;
    }
}
