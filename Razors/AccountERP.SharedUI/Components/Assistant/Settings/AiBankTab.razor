@* 🤖 P8.12.4 (ai-assistant-p812-plan.md ب12): تبويب «المطابقة البنكية» فى /settings/ai — التفعيل، أيام التسامح، أقصى عناصر التجميع، واستعمال النموذج. *@
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using Microsoft.Extensions.DependencyInjection
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IServiceProvider ServiceProvider

<div dir="@(LangService.IsRtl ? "rtl" : "ltr")" style="display:flex;flex-direction:column;gap:16px">
    @if (_svc == null || !_svc.HasGateway)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("AIN_NotAvailable")</MudAlert>
    }
    else if (!_svc.CanManage)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@Tr("AIN_ErrNotAdmin")</MudAlert>
    }
    else if (_s != null)
    {
        <section style="border:1px solid var(--mud-palette-lines-default);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:14px;background:var(--mud-palette-surface)" aria-label="@Tr("AIN_Set_Tab")">
            <h3 style="margin:0;font-size:1rem;font-weight:700;display:flex;gap:8px;align-items:center"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Primary" aria-hidden="true" />@Tr("AIN_Set_Tab")</h3>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Tr("AIN_Set_Intro")</MudText>
            <MudSwitch T="bool" @bind-Value="_s.Enabled" Color="Color.Primary" Label="@Tr("AIN_Set_Enabled")" />
            <MudSwitch T="bool" @bind-Value="_s.UseModel" Color="Color.Primary" Label="@Tr("AIN_Set_UseModel")" />
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
                <MudNumericField T="int" @bind-Value="_s.MatchDays" Label="@Tr("AIN_Set_Days")" Min="0" Max="15" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField T="int" @bind-Value="_s.GroupMaxItems" Label="@Tr("AIN_Set_Group")" Min="2" Max="6" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_busy" OnClick="SaveAsync" Style="min-height:44px">@Tr("AIN_Set_Save")</MudButton>
                <MudButton Variant="Variant.Outlined" Href="@AiBankConst.Route" Style="min-height:44px">@Tr("AIN_Title")</MudButton>
            </div>
        </section>
    }
</div>

@code {
    private AiBankRecUiService? _svc;
    private AiBankSettings? _s;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _svc = ServiceProvider.GetService<AiBankRecUiService>();
        if (_svc == null || !_svc.HasGateway || !_svc.CanManage) return;
        try { _s = await _svc.GetSettingsAsync(); }
        catch (Exception ex) { Snackbar.Add(_svc.ErrorText(ex), Severity.Error); }
    }

    private async Task SaveAsync()
    {
        if (_svc == null || _s == null) return;
        _busy = true;
        try { await _svc.SaveSettingsAsync(_s); Snackbar.Add(Tr("AIN_Set_Saved"), Severity.Success); }
        catch (Exception ex) { Snackbar.Add(_svc.ErrorText(ex), Severity.Error); }
        finally { _busy = false; }
    }

    private string Tr(string key, params object[] args) => AiBriefText.T(Lang, LangService.CurrentCultureInfo, key, args);
}
