    private RenderFragment Kpi(string label, string value, string cls) => __builder =>
    {
        <div class="@("aie-kpi " + cls)"><div class="l">@label</div><div class="v">@value</div></div>
    };

    /// <summary>نسبة النجاح لتصنيف (بلا المتخطاة)؛ 0 إن لم تُحكم حالة.</summary>
    internal static decimal CatRate(IEnumerable<AiEvalResultRow> rows, string cat)
    {
        var judged = rows.Where(r => r.Category == cat && r.Outcome != AiEvalOutcomes.Skipped).ToList();
        return judged.Count == 0 ? 0 : Math.Round(judged.Count(r => r.Outcome == AiEvalOutcomes.Pass) * 100m / judged.Count, 1);
    }

