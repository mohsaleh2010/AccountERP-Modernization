            <div class="aie-form">
                <MudTextField T="string" @bind-Value="_edit.Question" Label="@Tr("AIE_Question")" Variant="Variant.Outlined" Required="true" Lines="2" MaxLength="2000" Counter="2000" Class="wide" />
                <MudSelect T="string" @bind-Value="_edit.Category" Label="@Tr("AIE_Category")" Variant="Variant.Outlined">
                    @foreach (var c in AiEvalCategories.All) { <MudSelectItem Value="@c">@Tr(CatKey(c))</MudSelectItem> }
