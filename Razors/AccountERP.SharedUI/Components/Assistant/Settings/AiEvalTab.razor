                    <MudSelectItem Value="@("eg")">@Tr("AIE_DEg")</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" @bind-Value="_edit.CheckType" Label="@Tr("AIE_CheckType")" Variant="Variant.Outlined" HelperText="@Tr(CheckHelpKey(_edit.CheckType))">
                    @foreach (var c in AiEvalCheckTypes.All) { <MudSelectItem Value="@c">@Tr(CheckKey(c))</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_edit.ExpectedTools" Label="@Tr("AIE_ExpectedTools")" Variant="Variant.Outlined" Class="ltr" HelperText="@Tr("AIE_ToolsHelp")" />
                <MudTextField T="string" @bind-Value="_edit.ForbiddenTools" Label="@Tr("AIE_ForbiddenTools")" Variant="Variant.Outlined" Class="ltr" HelperText="@Tr("AIE_ToolsHelp")" />
                @if (_edit.CheckType == AiEvalCheckTypes.Result)
                {
                    <MudTextField T="string" @bind-Value="_edit.ReferenceSql" Label="@Tr("AIE_RefSql")" Variant="Variant.Outlined" Lines="6" Required="true" Class="wide ltr" HelperText="@Tr("AIE_RefSqlHelp")" />
