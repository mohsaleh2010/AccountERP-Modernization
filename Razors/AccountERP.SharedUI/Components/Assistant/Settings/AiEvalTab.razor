@* 🤖 المساعد الذكى — P7.5 (.claude/docs/ai-assistant-p7-plan.md): تبويب «التقييم» فى /settings/ai (م-380، م-381، م-431…م-436).
   «التشغيلات»: تقدّم حى للتشغيل الجارى مع «إيقاف»، سجل التشغيلات (اختيار تشغيلين للمقارنة)، تفاصيل تشغيل (مؤشرات، رسم النجاح لكل تصنيف،
   جدول الحالات وتفاصيل كل حالة: الرد وسبب الفشل والأدوات)، ومقارنة تشغيلين (AiEvalCompareView).
   «الحالات»: القائمة بالفلاتر، إضافة/تعديل (يُتحقق على الخادم)، تفعيل/تعطيل، وتشغيل حالة واحدة.
   كل التشغيل عبر IAiEvalGateway (AccountERP.AI)؛ نافذة التشغيل AiEvalRunDialog تطلب الموافقة على العدد والتكلفة. التصميم حسب ui-ux-pro-max ونظام inv-* / ai-*. *@

@using System.Globalization
@using System.Text.Json
@using Microsoft.Extensions.DependencyInjection
@using AccountERP.SharedUI.Services
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IServiceProvider ServiceProvider
@implements IDisposable

<style>
    .aie-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
    .aie-head .body { flex: 1 1 280px; min-width: 0; }
    .aie-head .mud-button-root, .aie-tools .mud-button-root, .aie-form-actions .mud-button-root, .aie-back .mud-button-root { min-height: 44px; }
    .aie-seg { display: inline-flex; border: 1px solid var(--mud-palette-lines-default); border-radius: 12px; overflow: hidden; }
    .aie-seg button { min-height: 44px; padding: 0 16px; border: 0; background: transparent; color: var(--mud-palette-text-primary); cursor: pointer; font: inherit;
                      display: inline-flex; align-items: center; gap: 6px; }
    .aie-seg button[aria-pressed="true"] { background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); font-weight: 600; }
    .aie-seg button:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }
    .aie-live { display: grid; gap: 12px; }
    .aie-live .run { display: grid; gap: 4px; }
    .aie-live .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; font-size: .875rem; }
    .aie-live .cur { font-size: .8125rem; color: var(--mud-palette-text-secondary); overflow-wrap: anywhere; }
    .aie-kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
    .aie-kpi { padding: 12px 14px; border-radius: 12px; border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); min-width: 0; }
    .aie-kpi .l { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .aie-kpi .v { font-size: 1.25rem; font-weight: 700; margin-top: 2px; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .aie-kpi.good .v { color: var(--mud-palette-success); } .aie-kpi.bad .v { color: var(--mud-palette-error); }
    .aie-meta { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .aie-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .aie-tools .grow { flex: 1 1 220px; min-width: 0; }
    .aie-tools .sel { min-width: 150px; max-width: 210px; }
    .aie-q { overflow-wrap: anywhere; max-width: 520px; }
    .aie-n { font-variant-numeric: tabular-nums; direction: ltr; unicode-bidi: isolate; white-space: nowrap; }
    .aie-detail { display: grid; gap: 10px; padding: 12px 4px; }
    .aie-detail .lbl { font-size: .8125rem; font-weight: 600; color: var(--mud-palette-text-secondary); }
    .aie-detail .ans { white-space: pre-wrap; overflow-wrap: anywhere; padding: 10px 12px; border-radius: 10px; background: var(--mud-palette-background-gray); max-height: 260px; overflow-y: auto; }
    .aie-tl { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
    .aie-tl li { padding: 8px 10px; border-radius: 10px; border: 1px solid var(--mud-palette-lines-default); }
    .aie-tl .sql { direction: ltr; text-align: left; font-family: Consolas, 'Courier New', monospace; font-size: .75rem; white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 4px; }
    .aie-tl .err { color: var(--mud-palette-error); font-size: .8125rem; overflow-wrap: anywhere; margin-top: 4px; }
    .aie-form { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px 16px; align-items: start; }
    .aie-form .wide { grid-column: 1 / -1; }
    .aie-form .ltr textarea, .aie-form .ltr input { direction: ltr; text-align: left; font-family: Consolas, 'Courier New', monospace; }
    .aie-form-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
    .aie-row-acts { display: flex; gap: 2px; justify-content: flex-end; }
    .aie-off { opacity: .6; }
    .aie-sel { background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent); }
    .aie-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 28px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    @@media (prefers-reduced-motion: reduce) { .aie-live * { transition: none !important; } }
</style>

@if (_eval == null)
{
    <div class="inv-card"><div class="aie-empty"><MudIcon Icon="@Icons.Material.Filled.CloudOff" Size="Size.Large" />@Tr("AI_NotAvailable")</div></div>
    return;
}

@if (!string.IsNullOrEmpty(_error))
{
    <MudAlert Severity="Severity.Warning" Class="mb-3" role="alert" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert>
}

@* ───────────── الرأس ───────────── *@
<section class="inv-card" aria-labelledby="aie-h">
    <div class="aie-head">
        <div class="body">
            <h2 class="inv-card-title" id="aie-h" style="margin:0;"><MudIcon Icon="@Icons.Material.Filled.Science" />@Tr("AIE_Title")</h2>
            <div class="ai-sub">@Tr("AIE_Sub")</div>
        </div>
        <div class="aie-seg" role="group" aria-label="@Tr("AIE_Title")">
            <button type="button" aria-pressed="@(_view == "runs" ? "true" : "false")" @onclick="@(() => _view = "runs")"><MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />@Tr("AIE_ViewRuns")</button>
            <button type="button" aria-pressed="@(_view == "cases" ? "true" : "false")" @onclick="ShowCasesAsync"><MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" />@Tr("AIE_ViewCases", _cases.Count(c => c.IsActive))</button>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow" Disabled="@(_busy || IsActive)" OnClick="@(() => OpenRunDialogAsync(null))">@Tr("AIE_RunNew")</MudButton>
    </div>
    @* بقايا ب2، ب3: خيارات تُفعَّل بعد دليل من التقييم *@
    <div style="display:flex;flex-wrap:wrap;gap:4px 24px;margin-top:8px">
        <div>
            <MudSwitch T="bool" Value="_llmJudge" ValueChanged="@(v => SetFlagAsync(AccountModelsLib.AiSettingKeys.EvalLlmJudge, v))" Color="Color.Primary" Label="@Tr("AIU_LlmJudge")" />
            <div class="ai-sub" style="margin:0">@Tr("AIU_LlmJudgeHint")</div>
        </div>
        <div>
            <MudSwitch T="bool" Value="_screenChunks" ValueChanged="@(v => SetFlagAsync(AccountModelsLib.AiSettingKeys.KnowledgeScreenChunks, v))" Color="Color.Primary" Label="@Tr("AIU_ScreenChunks")" />
            <div class="ai-sub" style="margin:0">@Tr("AIU_ScreenChunksHint")</div>
        </div>
    </div>
</section>

@* ───────────── التشغيل الجارى ───────────── *@
@if (_progress != null && _progress.Active)
{
    <section class="inv-card ai-gap" aria-labelledby="aie-live-h">
        <div class="aie-head">
            <h2 class="inv-card-title" id="aie-live-h" style="margin:0;flex:1 1 auto;"><MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Class="me-2" />@Tr("AIE_Running")</h2>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.StopCircle" Disabled="_stopping" OnClick="StopAsync">@Tr("AIE_Stop")</MudButton>
        </div>
        <div class="aie-live mt-3" aria-live="polite">
            @foreach (var r in _progress.Runs)
            {
                <div class="run">
                    <div class="row"><b>@r.ModelName</b><span class="aie-n">@Tr("AIE_LiveCounts", r.DoneCases, r.TotalCases, r.PassedCases, r.FailedCases, r.ErrorCases)</span></div>
                    <MudProgressLinear Color="Color.Primary" Rounded="true" Size="Size.Medium" Value="@(r.TotalCases == 0 ? 0 : 100.0 * r.DoneCases / r.TotalCases)"
                                       aria-label="@Tr("AIE_LiveCounts", r.DoneCases, r.TotalCases, r.PassedCases, r.FailedCases, r.ErrorCases)" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_progress.CurrentCase)) { <div class="cur">@Tr("AIE_CurrentCase", _progress.CurrentCase)</div> }
            <div class="ai-sub" style="margin:0;">@Tr("AIE_LiveHint")</div>
        </div>
    </section>
}

@if (_view == "runs")
{
    @* ───────────── المقارنة ───────────── *@
    @if (_cmpA != null && _cmpB != null)
    {
        <section class="inv-card ai-gap" aria-labelledby="aie-cmp-h">
            <div class="aie-head mb-3 aie-back">
                <h2 class="inv-card-title" id="aie-cmp-h" style="margin:0;flex:1 1 auto;"><MudIcon Icon="@Icons.Material.Filled.CompareArrows" />@Tr("AIE_CompareTitle")</h2>
                <MudButton Variant="Variant.Text" StartIcon="@(LangService.IsRtl ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)" OnClick="CloseCompare">@Tr("AIE_Back")</MudButton>
            </div>
            <AiEvalCompareView A="_cmpA" B="_cmpB" ResultsA="_cmpResA" ResultsB="_cmpResB" />
        </section>
    }
    @* ───────────── تفاصيل تشغيل ───────────── *@
    else if (_run != null)
    {
        <section class="inv-card ai-gap" aria-labelledby="aie-run-h">
            <div class="aie-head mb-3 aie-back">
                <div class="body">
                    <h2 class="inv-card-title" id="aie-run-h" style="margin:0;"><MudIcon Icon="@Icons.Material.Filled.Assessment" />@Tr("AIE_RunDetails", _run.ModelName)</h2>
                    <div class="aie-meta">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(_run.Status)">@Tr(StatusKey(_run.Status))</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Schedule">@When(_run)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Person">@UserText(_run)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Hub">@_run.ProviderName</MudChip>
                        @if (!string.IsNullOrEmpty(_run.Effort)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Tr("AIE_Effort", _run.Effort)</MudChip> }
                        <MudTooltip Text="@Tr("AIE_PromptHashHelp")"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Fingerprint">@Short(_run.PromptHash)</MudChip></MudTooltip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.School">@AutoExText(_run)</MudChip>
                    </div>
                </div>
                @if (Siblings(_run) is { } sib)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CompareArrows" OnClick="@(() => CompareAsync(_run, sib))">@Tr("AIE_CompareWith", sib.ModelName)</MudButton>
                }
                <MudButton Variant="Variant.Text" StartIcon="@(LangService.IsRtl ? Icons.Material.Filled.ArrowForward : Icons.Material.Filled.ArrowBack)" OnClick="@(() => { _run = null; _openResult = 0; })">@Tr("AIE_Back")</MudButton>
            </div>
            @if (!string.IsNullOrEmpty(_run.ErrorText)) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_run.ErrorText</MudAlert> }

            <div class="aie-kpis">
                @Kpi(Tr("AIE_KPassRate"), _run.PassRate == null ? "—" : _run.PassRate.Value.ToString("0.#", CultureInfo.InvariantCulture) + "%", _run.PassRate >= 80 ? "good" : _run.PassRate < 50 ? "bad" : "")
                @Kpi(Tr("AIE_OPass"), N(_run.PassedCases), "good")
                @Kpi(Tr("AIE_OFail"), N(_run.FailedCases), _run.FailedCases > 0 ? "bad" : "")
                @Kpi(Tr("AIE_OError"), N(_run.ErrorCases), _run.ErrorCases > 0 ? "bad" : "")
                @Kpi(Tr("AIE_OSkipped"), N(_run.SkippedCases), "")
                @Kpi(Tr("AIE_KToolOk"), $"{N(_run.ToolOkCases)} / {N(_run.DoneCases)}", "")
                @Kpi(Tr("AIE_KTokens"), N((_run.InputTokens ?? 0) + (_run.OutputTokens ?? 0)), "")
                @Kpi(Tr("AIE_KCost"), Money(_run.CostEstimate), "")
                @Kpi(Tr("AIE_KDuration"), Secs(_run.DurationMs), "")
            </div>

            <h3 class="inv-card-title ai-gap" style="font-size:1rem;"><MudIcon Icon="@Icons.Material.Filled.BarChart" />@Tr("AIE_ByCategory")</h3>
            <AiChart Section="RunChart" Rtl="LangService.IsRtl" EmptyText="@Tr("AIE_NoResults")" DataText="@Tr("AIE_ChartData")" />

            <div class="aie-tools ai-gap">
                <MudSelect T="string" @bind-Value="_resOutcome" Label="@Tr("AIE_Outcome")" Variant="Variant.Outlined" Dense="true" Class="sel">
                    <MudSelectItem Value="@("")">@Tr("AIE_All", _results.Count)</MudSelectItem>
                    @foreach (var o in new[] { AiEvalOutcomes.Fail, AiEvalOutcomes.Error, AiEvalOutcomes.Pass, AiEvalOutcomes.Skipped })
                    {
                        <MudSelectItem Value="@o">@($"{Tr(OutcomeKey(o))} ({_results.Count(r => r.Outcome == o)})")</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" @bind-Value="_resCat" Label="@Tr("AIE_Category")" Variant="Variant.Outlined" Dense="true" Class="sel">
                    <MudSelectItem Value="@("")">@Tr("AIE_AllCats")</MudSelectItem>
                    @foreach (var c in AiEvalCategories.All.Where(c => _results.Any(r => r.Category == c))) { <MudSelectItem Value="@c">@Tr(CatKey(c))</MudSelectItem> }
                </MudSelect>
                <MudTextField T="string" @bind-Value="_resSearch" Label="@Tr("AIE_Search")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" DebounceInterval="250"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="grow" />
            </div>
            <MudTable Items="@FilteredResults" T="AiEvalResultRow" Hover="true" Elevation="0" Class="inv-table mt-3" Dense="true" Breakpoint="Breakpoint.Md" RowsPerPage="25"
                      Loading="_resLoading" LoadingProgressColor="Color.Primary" OnRowClick="@(e => { if (e.Item != null) ToggleResult(e.Item); })" RowClassFunc="@((r, _) => r.Id == _openResult ? "aie-sel" : "")"
                      RowStyle="cursor:pointer;">
                <HeaderContent>
                    <MudTh>@Tr("AIE_Outcome")</MudTh>
                    <MudTh>@Tr("AIE_Category")</MudTh>
                    <MudTh>@Tr("AIE_Question")</MudTh>
                    <MudTh>@Tr("AIE_CheckType")</MudTh>
                    <MudTh>@Tr("AIE_KTools")</MudTh>
                    <MudTh>@Tr("AIE_Time")</MudTh>
                    <MudTh>@Tr("AIU_JudgeCol")</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Tr("AIE_Outcome")"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@OutcomeColor(context.Outcome)" Icon="@OutcomeIcon(context.Outcome)">@Tr(OutcomeKey(context.Outcome))</MudChip></MudTd>
                    <MudTd DataLabel="@Tr("AIE_Category")">@Tr(CatKey(context.Category))</MudTd>
                    <MudTd DataLabel="@Tr("AIE_Question")">
                        <button type="button" class="aie-q" style="all:unset;cursor:pointer;" aria-expanded="@(context.Id == _openResult ? "true" : "false")"
                                aria-label="@Tr("AIE_ShowCase", context.Question)">@context.Question</button>
                        @if (!string.IsNullOrEmpty(context.FailReason) && context.Outcome != AiEvalOutcomes.Pass) { <div class="ai-sub" style="margin:2px 0 0;">@context.FailReason</div> }
                    </MudTd>
                    <MudTd DataLabel="@Tr("AIE_CheckType")">@Tr(CheckKey(context.CheckType))</MudTd>
                    <MudTd DataLabel="@Tr("AIE_KTools")">
                        <MudIcon Icon="@(context.ToolOk ? Icons.Material.Filled.CheckCircleOutline : Icons.Material.Filled.HighlightOff)" Color="@(context.ToolOk ? Color.Success : Color.Default)" Size="Size.Small"
                                 aria-label="@Tr(context.ToolOk ? "AIE_ToolOkYes" : "AIE_ToolOkNo")" />
                    </MudTd>
                    <MudTd DataLabel="@Tr("AIE_Time")"><span class="aie-n">@Secs(context.DurationMs)</span></MudTd>
                    <MudTd DataLabel="@Tr("AIU_JudgeCol")"><span class="aie-n" title="@context.JudgeReason">@(context.JudgeScore?.ToString("0.0", CultureInfo.InvariantCulture) ?? "—")</span></MudTd>
                </RowTemplate>
                <ChildRowContent>
                    @if (context.Id == _openResult)
                    {
                        <tr class="aie-sel"><td colspan="6">
                            <div class="aie-detail">
                                <div class="aie-meta" style="margin:0;">
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@context.CaseKey · v@(context.CaseVersion)</MudChip>
                                    @if (context.Rounds is int rd) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Tr("AIE_Rounds", rd)</MudChip> }
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text">@Tr("AIE_CaseTokens", N((context.InputTokens ?? 0) + (context.OutputTokens ?? 0)), Money(context.CostEstimate))</MudChip>
                                </div>
                                @if (!string.IsNullOrEmpty(context.FailReason))
                                {
                                    <div><div class="lbl">@Tr("AIE_FailReason")</div><div>@context.FailReason</div></div>
                                }
                                <div><div class="lbl">@Tr("AIE_Answer")</div><div class="ans">@(string.IsNullOrWhiteSpace(context.AnswerText) ? "—" : context.AnswerText)</div></div>
                                <div>
                                    <div class="lbl">@Tr("AIE_ToolsUsed")</div>
                                    @if (ParseTools(context.ToolsJson) is { Count: > 0 } tl)
                                    {
                                        <ol class="aie-tl">
                                            @foreach (var t in tl)
                                            {
                                                <li>
                                                    <div class="d-flex flex-wrap align-center" style="gap:6px;">
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(t.Outcome is "ok" or "asked" ? Color.Success : Color.Error)">@t.Outcome</MudChip>
                                                        <b>@(string.IsNullOrEmpty(t.Title) ? t.Name : t.Title)</b><span class="aik-key">@t.Name</span>
                                                        @if (t.Rows is int n) { <span class="ai-sub" style="margin:0;">@Tr("AIE_ToolRows", n)</span> }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(t.Sql)) { <div class="sql">@t.Sql</div> }
                                                    @if (!string.IsNullOrEmpty(t.Error)) { <div class="err">@t.Error</div> }
                                                </li>
                                            }
                                        </ol>
                                    }
                                    else { <div class="ai-sub" style="margin:0;">@Tr("AIE_NoTools")</div> }
                                </div>
                            </div>
                        </td></tr>
                    }
                </ChildRowContent>
                <NoRecordsContent><div class="aie-empty"><MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Large" />@Tr("AIE_NoResults")</div></NoRecordsContent>
                <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
            </MudTable>
        </section>
    }

    @* ───────────── سجل التشغيلات ───────────── *@
    <section class="inv-card ai-gap" aria-labelledby="aie-ls-h">
        <div class="aie-tools">
            <h2 class="inv-card-title" id="aie-ls-h" style="margin:0;flex:1 1 auto;"><MudIcon Icon="@Icons.Material.Filled.History" />@Tr("AIE_History")</h2>
            <span class="ai-sub" style="margin:0;">@Tr("AIE_SelectHint")</span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CompareArrows" Disabled="@(_selected.Count != 2)" OnClick="CompareSelectedAsync">@Tr("AIE_CompareSelected", _selected.Count)</MudButton>
        </div>
        <MudTable Items="@_runs" T="AiEvalRunRow" Hover="true" Elevation="0" Class="inv-table mt-3" Dense="true" Breakpoint="Breakpoint.Md" RowsPerPage="25"
                  Loading="_loading" LoadingProgressColor="Color.Primary" RowClassFunc="@((r, _) => _run?.Id == r.Id ? "aie-sel" : "")">
            <HeaderContent>
                <MudTh Style="width:48px;"><span class="sr-only">@Tr("AIE_Select")</span></MudTh>
                <MudTh>@Tr("AIE_Started")</MudTh>
                <MudTh>@Tr("AIE_Model")</MudTh>
                <MudTh>@Tr("AIE_Status")</MudTh>
                <MudTh>@Tr("AIE_Cases")</MudTh>
                <MudTh>@Tr("AIE_KPassRate")</MudTh>
                <MudTh>@Tr("AIE_KToolOk")</MudTh>
                <MudTh>@Tr("AIE_KCost")</MudTh>
                <MudTh>@Tr("AIE_User")</MudTh>
                <MudTh Style="text-align:end;">@Tr("AIE_Actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("AIE_Select")">
                    <MudCheckBox T="bool" Value="@_selected.Contains(context.Id)" ValueChanged="@(v => ToggleSelect(context.Id, v))" Color="Color.Primary"
                                 Disabled="@(!_selected.Contains(context.Id) && _selected.Count >= 2)" aria-label="@Tr("AIE_SelectAria", context.ModelName, When(context))" />
                </MudTd>
                <MudTd DataLabel="@Tr("AIE_Started")"><span class="aie-n">@When(context)</span></MudTd>
                <MudTd DataLabel="@Tr("AIE_Model")"><div style="font-weight:600;">@context.ModelName</div><div class="ai-sub" style="margin:0;">@context.ProviderName@(AiEvalConfig.AutoExamplesOf(context.ConfigJson) > 0 ? " · " + AutoExText(context) : "")</div></MudTd>
                <MudTd DataLabel="@Tr("AIE_Status")"><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@StatusColor(context.Status)">@Tr(StatusKey(context.Status))</MudChip></MudTd>
                <MudTd DataLabel="@Tr("AIE_Cases")"><span class="aie-n">@context.DoneCases / @context.TotalCases</span></MudTd>
                <MudTd DataLabel="@Tr("AIE_KPassRate")"><b class="aie-n">@(context.PassRate == null ? "—" : context.PassRate.Value.ToString("0.#", CultureInfo.InvariantCulture) + "%")</b></MudTd>
                <MudTd DataLabel="@Tr("AIE_KToolOk")"><span class="aie-n">@context.ToolOkCases</span></MudTd>
                <MudTd DataLabel="@Tr("AIE_KCost")"><span class="aie-n">@Money(context.CostEstimate)</span></MudTd>
                <MudTd DataLabel="@Tr("AIE_User")">@UserText(context)</MudTd>
                <MudTd DataLabel="@Tr("AIE_Actions")">
                    <div class="aie-row-acts">
                        <MudTooltip Text="@Tr("AIE_Details")">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" aria-label="@Tr("AIE_DetailsAria", context.ModelName, When(context))" OnClick="@(() => OpenRunAsync(context))" />
                        </MudTooltip>
                        @if (Siblings(context) is { } sib)
                        {
                            <MudTooltip Text="@Tr("AIE_CompareWith", sib.ModelName)">
                                <MudIconButton Icon="@Icons.Material.Filled.CompareArrows" aria-label="@Tr("AIE_CompareWith", sib.ModelName)" OnClick="@(() => CompareAsync(context, sib))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><div class="aie-empty"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" />@Tr("AIE_NoRuns")</div></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
        </MudTable>
    </section>
}
else
{
    @* ───────────── نموذج الحالة ───────────── *@
    @if (_edit != null)
    {
        <section class="inv-card ai-gap" aria-labelledby="aie-ed-h">
            <h2 class="inv-card-title" id="aie-ed-h"><MudIcon Icon="@Icons.Material.Filled.EditNote" />@(_edit.Id == 0 ? Tr("AIE_AddCase") : Tr("AIE_EditCase"))</h2>
            @if (_editIsSeed)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">@Tr("AIE_SeedEditNote")</MudAlert>
