                }
                <MudTextField T="string" @bind-Value="_edit.ExpectedText" Label="@Tr("AIE_ExpectedText")" Variant="Variant.Outlined" HelperText="@Tr("AIE_ExpectedTextHelp")" />
                <MudTextField T="string" @bind-Value="_edit.Tags" Label="@Tr("AIE_Tags")" Variant="Variant.Outlined" />
                <MudTextField T="string" @bind-Value="_edit.Notes" Label="@Tr("AIE_Notes")" Variant="Variant.Outlined" Lines="2" Class="wide" />
            </div>
            @if (!string.IsNullOrEmpty(_editError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert">@_editError</MudAlert> }
            <div class="aie-form-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_busy" OnClick="SaveCaseAsync">@Tr("Save")</MudButton>
                <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="@(() => { _edit = null; _editError = null; })">@Tr("AI_Cancel")</MudButton>
            </div>
        </section>
    }

    @* ───────────── قائمة الحالات ───────────── *@
    <section class="inv-card ai-gap" aria-labelledby="aie-cs-h">
        <h2 class="inv-card-title" id="aie-cs-h"><MudIcon Icon="@Icons.Material.Filled.Checklist" />@Tr("AIE_CasesTitle")</h2>
        <div class="aie-tools">
            <MudSelect T="string" @bind-Value="_caseCat" Label="@Tr("AIE_Category")" Variant="Variant.Outlined" Dense="true" Class="sel">
                <MudSelectItem Value="@("")">@Tr("AIE_All", _cases.Count)</MudSelectItem>
                @foreach (var c in AiEvalCategories.All) { <MudSelectItem Value="@c">@($"{Tr(CatKey(c))} ({_cases.Count(x => x.Category == c)})")</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_caseCheck" Label="@Tr("AIE_CheckType")" Variant="Variant.Outlined" Dense="true" Class="sel">
                <MudSelectItem Value="@("")">@Tr("AIE_AllChecks")</MudSelectItem>
                @foreach (var c in AiEvalCheckTypes.All) { <MudSelectItem Value="@c">@Tr(CheckKey(c))</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_caseState" Label="@Tr("AIE_State")" Variant="Variant.Outlined" Dense="true" Class="sel">
                <MudSelectItem Value="@("")">@Tr("AIE_SAll")</MudSelectItem>
                <MudSelectItem Value="@("on")">@Tr("AIE_SActive")</MudSelectItem>
                <MudSelectItem Value="@("off")">@Tr("AIE_SInactive")</MudSelectItem>
                <MudSelectItem Value="@("mine")">@Tr("AIE_SMine")</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="_caseSearch" Label="@Tr("AIE_Search")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Immediate="true" DebounceInterval="250"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="grow" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_busy" OnClick="BeginAdd">@Tr("AIE_AddCase")</MudButton>
        </div>
        <MudTable Items="@FilteredCases" T="AiEvalCaseRow" Hover="true" Elevation="0" Class="inv-table mt-3" Dense="true" Breakpoint="Breakpoint.Md" RowsPerPage="25"
                  Loading="_casesLoading" LoadingProgressColor="Color.Primary" RowClassFunc="@((r, _) => r.IsActive ? "" : "aie-off")">
            <HeaderContent>
                <MudTh>@Tr("AIE_Category")</MudTh>
                <MudTh>@Tr("AIE_Question")</MudTh>
                <MudTh>@Tr("AIE_CheckType")</MudTh>
                <MudTh>@Tr("AIE_Source")</MudTh>
                <MudTh>@Tr("AIE_Active")</MudTh>
                <MudTh Style="text-align:end;">@Tr("AIE_Actions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("AIE_Category")">@Tr(CatKey(context.Category))</MudTd>
                <MudTd DataLabel="@Tr("AIE_Question")">
                    <div class="aie-q">@context.Question</div>
                    <div class="aik-key">@context.CaseKey · v@(context.Version) · @(context.Dialect == "eg" ? Tr("AIE_DEg") : Tr("AIE_DMsa"))</div>
                </MudTd>
                <MudTd DataLabel="@Tr("AIE_CheckType")">@Tr(CheckKey(context.CheckType))</MudTd>
                <MudTd DataLabel="@Tr("AIE_Source")"><MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.IsEdited ? Color.Warning : Color.Default)">@Tr(SourceKey(context))</MudChip></MudTd>
                <MudTd DataLabel="@Tr("AIE_Active")">
                    <MudSwitch T="bool" Value="context.IsActive" ValueChanged="@(v => ToggleCaseAsync(context, v))" Color="Color.Primary" Disabled="_busy" aria-label="@Tr("AIE_ToggleAria", context.Question)" />
                </MudTd>
                <MudTd DataLabel="@Tr("AIE_Actions")">
                    <div class="aie-row-acts">
                        <MudTooltip Text="@Tr("AIE_EditCase")">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@Tr("AIE_EditAria", context.Question)" Disabled="_busy" OnClick="@(() => BeginEdit(context))" />
                        </MudTooltip>
                        <MudTooltip Text="@Tr("AIE_RunCase")">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayCircleOutline" aria-label="@Tr("AIE_RunCaseAria", context.Question)" Disabled="@(_busy || IsActive || !context.IsActive)"
                                           OnClick="@(() => OpenRunDialogAsync(new List<long> { context.Id }))" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent><div class="aie-empty"><MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Large" />@Tr("AIE_NoCases")</div></NoRecordsContent>
            <PagerContent><MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" /></PagerContent>
        </MudTable>
    </section>
}

@code {
    [Parameter, EditorRequired] public IAiAdminGateway Admin { get; set; } = default!;
    [Parameter] public long UserId { get; set; }

    private IAiEvalGateway? _eval;
    private AssistantSessionService? _chat;
    private string _view = "runs";
    private List<AiEvalRunRow> _runs = new();
    private List<AiEvalCaseRow> _cases = new();
    private AiEvalProgress? _progress;
    private CancellationTokenSource? _pollCts;
    private readonly HashSet<long> _selected = new();
    // تفاصيل تشغيل
    private AiEvalRunRow? _run;
    private List<AiEvalResultRow> _results = new();
    private AiReportSection RunChart = new();
    private string _resOutcome = "", _resCat = "";
    private string? _resSearch;
    private long _openResult;
    // مقارنة
    private AiEvalRunRow? _cmpA, _cmpB;
    private List<AiEvalResultRow> _cmpResA = new(), _cmpResB = new();
    // الحالات
    private AiEvalCaseSaveRequest? _edit;
    private bool _editIsSeed;
    private string _caseCat = "", _caseCheck = "", _caseState = "";
    private string? _caseSearch, _error, _editError;
    private bool _loading, _resLoading, _casesLoading, _busy, _stopping, _loaded;

    private bool IsActive => _progress?.Active == true;

    protected override void OnInitialized()
    {
        _eval = ServiceProvider.GetService<IAiEvalGateway>();
        _chat = ServiceProvider.GetService<AssistantSessionService>();
        LangService.OnLanguageChanged += OnLang;
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLang;
        _pollCts?.Cancel();
    }

    private void OnLang() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first && !_loaded) await LoadAsync();
    }

    // بقايا ب2، ب3
    private bool _llmJudge, _screenChunks;

    private async Task SetFlagAsync(string key, bool on)
    {
        if (_eval == null) return;
        var ev = _eval; long uid = UserId;
        try
        {
            await Bg(() => { ev.SetFlag(key, on, uid); return 0; });
            if (key == AccountModelsLib.AiSettingKeys.EvalLlmJudge) _llmJudge = on; else _screenChunks = on;
            Snackbar.Add(Tr("AIU_FlagSaved"), Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(Err(ex), Severity.Error); }
    }

    /// <summary>يُستدعى من الصفحة عند «إعادة التحميل» ومن أول عرض.</summary>
    public async Task LoadAsync()
    {
        if (_eval == null || _loading) return;
        _loading = true;
        StateHasChanged();
        try
        {
            var ev = _eval;
            (_runs, _cases, var active) = await Bg(() => (ev.GetRuns(100), ev.GetCases(), ev.ActiveGroupId()));
            (_llmJudge, _screenChunks) = await Bg(() => (ev.GetFlag(AccountModelsLib.AiSettingKeys.EvalLlmJudge), ev.GetFlag(AccountModelsLib.AiSettingKeys.KnowledgeScreenChunks)));
            _selected.IntersectWith(_runs.Select(r => r.Id));
            _loaded = true;
            if (active is long g && (_progress == null || _progress.GroupId != g || !_progress.Active)) StartPolling(g);
        }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); }
        finally { _loading = false; StateHasChanged(); }
    }

    // ───────────── التشغيل والمتابعة ─────────────

    /// <summary>P7.7: عدد الأمثلة التلقائية فى التشغيل (من ConfigJson).</summary>
    internal string AutoExText(AiEvalRunRow r) => AiEvalConfig.AutoExamplesOf(r.ConfigJson) is int n && n > 0 ? Tr("AIE_RunAutoEx", n) : Tr("AIE_RunAutoExOff");

    private async Task OpenRunDialogAsync(List<long>? caseIds)
    {
        if (_eval == null || _chat == null) { _error = Tr("AI_NotAvailable"); return; }
        List<AiModelRow> models;
        List<AiTaskRoutingRow> routing;
        Dictionary<string, string> settings;
        try
        {
            var gw = Admin;
            (models, routing, settings) = await Bg(() => (gw.GetModels(), gw.GetRouting(), gw.GetSettings()));
        }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); return; }
        models = models.Where(m => m.IsEnabled && m.SupportsTools).OrderBy(m => m.DisplayName).ToList();
        if (models.Count == 0) { _error = Tr("AIE_NoModels"); return; }
        long def = routing.Where(r => r.TaskKey == AiTaskKeys.Chat).OrderBy(r => r.Priority).Select(r => r.Model_Id).FirstOrDefault(id => models.Any(m => m.Id == id));
        var p = new DialogParameters<AiEvalRunDialog>
        {
            { x => x.Eval, _eval }, { x => x.User, _chat.BuildUser() }, { x => x.Models, models }, { x => x.DefaultModelId, def },
            { x => x.PresetCaseIds, caseIds ?? new List<long>() },
            { x => x.CurrentAutoExamples, settings.TryGetValue(AiSettingKeys.KnowledgeAutoExamples, out var ax) && int.TryParse(ax, out int axn) ? axn : 0 },
        };
        var o = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true, BackdropClick = false };
        var dlg = await DialogService.ShowAsync<AiEvalRunDialog>(Tr("AIE_RunTitle"), p, o);
        var res = await dlg.Result;
        if (res is { Canceled: false, Data: AiEvalStartResult started })
        {
            Snackbar.Add(Tr("AIE_StartedMsg", started.CaseCount, started.RunIds.Count), Severity.Success);
            _view = "runs";
            _run = null; _cmpA = _cmpB = null;
            StartPolling(started.GroupId);
            await LoadAsync();
        }
    }

    private void StartPolling(long groupId)
    {
        _pollCts?.Cancel();
        var cts = _pollCts = new CancellationTokenSource();
        _progress = new AiEvalProgress { GroupId = groupId, Active = true };
        _ = PollAsync(groupId, cts.Token);
    }

    /// <summary>متابعة كل ثانيتين حتى ينتهى التشغيل، ثم إعادة تحميل السجل وفتح تفاصيله/مقارنته.</summary>
    private async Task PollAsync(long groupId, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            do
            {
                var ev = _eval!;
                var pr = await Bg(() => ev.GetProgress(groupId));
                if (ct.IsCancellationRequested) return;
                _progress = pr;
                await InvokeAsync(StateHasChanged);
                if (!pr.Active)
                {
                    await InvokeAsync(async () =>
                    {
                        Snackbar.Add(Tr("AIE_Finished"), Severity.Info);
                        await LoadAsync();
                        var runs = _runs.Where(r => r.Group_Id == groupId).ToList();
                        if (runs.Count == 2) await CompareAsync(runs[0], runs[1]);
                        else if (runs.Count == 1) await OpenRunAsync(runs[0]);
                    });
                    return;
                }
            } while (await timer.WaitForNextTickAsync(ct));
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); await InvokeAsync(StateHasChanged); }
    }

    private async Task StopAsync()
    {
        if (_progress == null || _eval == null) return;
        bool? ok = await DialogService.ShowMessageBoxAsync(Tr("AIE_Stop"), Tr("AIE_ConfirmStop"), yesText: Tr("AIE_Stop"), cancelText: Tr("AI_Cancel"));
        if (ok != true) return;
        _stopping = true;
        try
        {
            var ev = _eval; long g = _progress.GroupId, uid = UserId;
            await Bg(() => ev.Cancel(g, uid));
            Snackbar.Add(Tr("AIE_Stopping"), Severity.Info);
        }
        catch (Exception ex) { _error = Err(ex); }
        finally { _stopping = false; }
    }

    // ───────────── التفاصيل والمقارنة ─────────────

    private async Task OpenRunAsync(AiEvalRunRow r)
    {
        _cmpA = _cmpB = null;
        _run = r;
        _openResult = 0;
        _resOutcome = _resCat = "";
        _resSearch = null;
        _resLoading = true;
        StateHasChanged();
        try
        {
            var ev = _eval!; long id = r.Id;
            _results = await Bg(() => ev.GetResults(id));
            var cats = AiEvalCategories.All.Where(c => _results.Any(x => x.Category == c)).ToList();
            RunChart = new AiReportSection
            {
                Kind = "chart", ChartKind = AiChartKinds.Bar, ValueFormat = AiReportFormats.Percent,
                ChartLabels = cats.Select(c => Tr(CatKey(c))).ToList(),
                Series = new() { new AiChartSeries { Name = Tr("AIE_KPassRate"), Values = cats.Select(c => CatRate(_results, c)).ToList() } },
            };
        }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); }
        finally { _resLoading = false; }
    }

    private async Task CompareAsync(AiEvalRunRow a, AiEvalRunRow b)
    {
        // الأقدم A، والأحدث B (فى نفس المجموعة: بترتيب الإنشاء).
        if ((a.StartedAt ?? DateTime.MinValue) > (b.StartedAt ?? DateTime.MinValue) || (a.StartedAt == b.StartedAt && a.Id > b.Id)) (a, b) = (b, a);
        try
        {
            var ev = _eval!; long ia = a.Id, ib = b.Id;
            (_cmpResA, _cmpResB) = await Bg(() => (ev.GetResults(ia), ev.GetResults(ib)));
            _cmpA = a; _cmpB = b;
            _run = null;
        }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); }
    }

    private async Task CompareSelectedAsync()
    {
        var pick = _runs.Where(r => _selected.Contains(r.Id)).ToList();
        if (pick.Count == 2) await CompareAsync(pick[0], pick[1]);
    }

    private void CloseCompare() { _cmpA = _cmpB = null; }

    private void ToggleSelect(long id, bool on)
    {
        if (on) { if (_selected.Count < 2) _selected.Add(id); }
        else _selected.Remove(id);
    }

    private void ToggleResult(AiEvalResultRow r) => _openResult = _openResult == r.Id ? 0 : r.Id;

    /// <summary>التشغيل الآخر فى نفس المجموعة (نموذجان على نفس الحالات) أو null.</summary>
    private AiEvalRunRow? Siblings(AiEvalRunRow r) => _runs.FirstOrDefault(x => x.Group_Id == r.Group_Id && x.Id != r.Id);

    private IEnumerable<AiEvalResultRow> FilteredResults
    {
        get
        {
            IEnumerable<AiEvalResultRow> q = _results;
            if (_resOutcome.Length > 0) q = q.Where(r => r.Outcome == _resOutcome);
            if (_resCat.Length > 0) q = q.Where(r => r.Category == _resCat);
            if (!string.IsNullOrWhiteSpace(_resSearch))
            {
                string f = _resSearch.Trim();
                q = q.Where(r => r.Question.Contains(f, StringComparison.OrdinalIgnoreCase) || r.CaseKey.Contains(f, StringComparison.OrdinalIgnoreCase)
                              || (r.FailReason ?? "").Contains(f, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    private sealed record ToolLine(string Name, string Title, string Outcome, string? Sql, int? Rows, string? Error);

    private static List<ToolLine> ParseTools(string? json)
    {
        var list = new List<ToolLine>();
        if (string.IsNullOrWhiteSpace(json)) return list;
        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Array) return list;
            foreach (var e in doc.RootElement.EnumerateArray())
            {
                string? S(string p) => e.TryGetProperty(p, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;
                int? rows = e.TryGetProperty("rows", out var rv) && rv.ValueKind == JsonValueKind.Number && rv.TryGetInt32(out int n) ? n : null;
                list.Add(new ToolLine(S("name") ?? "", S("title") ?? "", S("outcome") ?? "", S("sql"), rows, S("error")));
            }
        }
        catch (JsonException) { }
        return list;
    }

    // ───────────── الحالات ─────────────

    private async Task ShowCasesAsync()
    {
        _view = "cases";
        await LoadCasesAsync();
    }

    private async Task LoadCasesAsync()
    {
        if (_eval == null) return;
        _casesLoading = true;
        StateHasChanged();
        try { var ev = _eval; _cases = await Bg(() => ev.GetCases()); }
        catch (Exception ex) { _error = Tr("SystemError", Err(ex)); }
        finally { _casesLoading = false; }
    }

    private IEnumerable<AiEvalCaseRow> FilteredCases
    {
        get
        {
            IEnumerable<AiEvalCaseRow> q = _cases;
            if (_caseCat.Length > 0) q = q.Where(c => c.Category == _caseCat);
            if (_caseCheck.Length > 0) q = q.Where(c => c.CheckType == _caseCheck);
            q = _caseState switch
            {
                "on" => q.Where(c => c.IsActive),
                "off" => q.Where(c => !c.IsActive),
                "mine" => q.Where(c => c.Source != "seed" || c.IsEdited),
                _ => q,
            };
            if (!string.IsNullOrWhiteSpace(_caseSearch))
            {
                string f = _caseSearch.Trim();
                q = q.Where(c => c.Question.Contains(f, StringComparison.OrdinalIgnoreCase) || c.CaseKey.Contains(f, StringComparison.OrdinalIgnoreCase)
                              || (c.Tags ?? "").Contains(f, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    private void BeginAdd()
    {
        _edit = new AiEvalCaseSaveRequest { Category = _caseCat.Length > 0 ? _caseCat : AiEvalCategories.Sales, CheckType = _caseCheck.Length > 0 ? _caseCheck : AiEvalCheckTypes.Result };
        _editIsSeed = false;
        _editError = null;
    }

    private void BeginEdit(AiEvalCaseRow c)
    {
        _edit = new AiEvalCaseSaveRequest
        {
            Id = c.Id, Question = c.Question, Category = c.Category, Dialect = c.Dialect, CheckType = c.CheckType,
            ExpectedTools = c.ExpectedTools ?? "", ForbiddenTools = c.ForbiddenTools ?? "", ReferenceSql = c.ReferenceSql ?? "",
            ReferenceArgsJson = c.ReferenceArgsJson ?? "", ExpectedText = c.ExpectedText ?? "", Tags = c.Tags ?? "", Notes = c.Notes ?? "",
            Source = c.Source, Source_Ref_Id = c.Source_Ref_Id,
        };
        _editIsSeed = c.Source == "seed";
        _editError = null;
    }

    private async Task SaveCaseAsync()
    {
        if (_edit == null || _eval == null) return;
        _busy = true;
        _editError = null;
        try
        {
            var ev = _eval; var req = _edit; long uid = UserId;
            await Bg(() => ev.SaveCase(req, uid));
            Snackbar.Add(Tr("AIE_CaseSaved"), Severity.Success);
            _edit = null;
        }
        catch (Exception ex) { _editError = Err(ex); }
        finally { _busy = false; }
        if (_edit == null) await LoadCasesAsync();
    }

    private async Task ToggleCaseAsync(AiEvalCaseRow c, bool active)
    {
        if (_eval == null) return;
        _busy = true;
        try
        {
            var ev = _eval; long uid = UserId, id = c.Id;
            await Bg(() => ev.SetCaseActive(id, active, uid));
            c.IsActive = active;
            Snackbar.Add(Tr(active ? "AIE_CaseOn" : "AIE_CaseOff"), Severity.Success);
        }
        catch (Exception ex) { _error = Err(ex); }
        finally { _busy = false; }
    }

