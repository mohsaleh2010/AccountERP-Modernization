@* 🤖 المساعد الذكى P1 (ai-assistant-plan.md §7.2): الأيقونة العائمة (FAB 56px) ونافذة المحادثة 400×600 (ملء الشاشة تحت 600px) بنفس AssistantChat
   ونفس AssistantSessionService، فالمحادثة واحدة بين النافذة والصفحة. تُخفى: قبل الدخول، لمن لا يملك صلاحية «المساعد الذكى»، فى صفحة /assistant نفسها،
   إن أخفاها المستخدم من «إعدادات الحساب»، وعلى مضيف بلا خدمة المساعد (MAUI). الموضع start/end من التفضيلات (منطقى، يتبع اتجاه اللغة).
   تمرر سياق الشاشة الحالية (المسار والعنوان) ليفهم المساعد «هذه الشاشة». Escape يغلق النافذة ويعيد التركيز للأيقونة. *@
@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.Models
@using AccountERP.SharedUI.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject UserPreferencesService Prefs
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Visible)
{
    <style>
        .aiw-fab { position: fixed; bottom: 24px; z-index: 1250; width: 56px; height: 56px; border-radius: 50%; border: 0; cursor: pointer;
                   display: grid; place-items: center; background: var(--mud-palette-primary); color: var(--mud-palette-primary-text);
                   box-shadow: var(--mud-elevation-6); transition: transform .15s ease-out, box-shadow .15s ease-out; }
        .aiw-fab:hover { transform: translateY(-2px); box-shadow: var(--mud-elevation-10); }
        .aiw-fab:focus-visible { outline: 3px solid var(--mud-palette-primary); outline-offset: 3px; }
        .aiw-fab .mud-icon-root { font-size: 1.6rem; }
        .aiw-badge { position: absolute; top: 2px; inset-inline-end: 2px; width: 14px; height: 14px; border-radius: 50%;
                     background: var(--mud-palette-error); border: 2px solid var(--mud-palette-surface); }
        /* النافذة مكان الأيقونة (الأيقونة تختفى وهى مفتوحة)، وارتفاعها لا يتجاوز المساحة تحت شريط التطبيق العلوى فيبقى رأسها ظاهراً */
        .aiw-panel { position: fixed; bottom: 24px; z-index: 1250; width: 400px; height: min(640px, calc(100dvh - var(--mud-appbar-height, 64px) - 40px));
                     display: flex; flex-direction: column; border-radius: 16px; overflow: hidden;
                     background: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default); box-shadow: var(--mud-elevation-12);
                     animation: aiw-in .18s ease-out; }
        @@keyframes aiw-in { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
        @@media (prefers-reduced-motion: reduce) { .aiw-panel { animation: none; } .aiw-fab { transition: none; } }
        .aiw-head { flex: none; display: flex; align-items: center; gap: 4px; min-height: 52px; padding: 4px 6px 4px 12px;
                    border-bottom: 1px solid var(--mud-palette-lines-default); }
        .aiw-head .title { flex: 1; min-width: 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .aiw-body { flex: 1; min-height: 0; }
        .aiw-start { inset-inline-start: 24px; } .aiw-end { inset-inline-end: 24px; }
        @@media (max-width: 600px) {
            .aiw-fab { bottom: 16px; } .aiw-start { inset-inline-start: 16px; } .aiw-end { inset-inline-end: 16px; }
            .aiw-panel { inset: var(--mud-appbar-height, 64px) 0 0 0; width: auto; height: auto; border-radius: 0; border: 0; }
        }
        @@media print { .aiw-fab, .aiw-panel { display: none !important; } }
    </style>

    @if (_open)
    {
        <div class="aiw-panel @SideClass" role="dialog" aria-modal="false" aria-label="@Tr("AIC_Title")" dir="@(LangService.IsRtl ? "rtl" : "ltr")" @ref="_panel">
            <div class="aiw-head">
                <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" Size="Size.Small" aria-hidden="true" />
                <div class="title">@(_chat!.ConversationId == 0 || string.IsNullOrWhiteSpace(_chat.ConversationTitle) ? Tr("AIC_Title") : _chat.ConversationTitle)</div>
                <MudTooltip Text="@Tr("AIC_NewChat")">
                    <MudIconButton Icon="@Icons.Material.Filled.Add" aria-label="@Tr("AIC_NewChat")" Disabled="_chat.IsSending" OnClick="NewChatAsync" />
                </MudTooltip>
                <MudTooltip Text="@Tr("AIC_OpenFull")">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInFull" aria-label="@Tr("AIC_OpenFull")" OnClick="OpenFullPage" />
                </MudTooltip>
                <MudTooltip Text="@Tr("AIC_Minimize")">
                    <MudIconButton Icon="@Icons.Material.Filled.Remove" aria-label="@Tr("AIC_Minimize")" OnClick="CloseAsync" />
                </MudTooltip>
            </div>
            <div class="aiw-body">
                <AssistantChat @ref="_chatView" Compact="true" ContextProvider="CurrentContext" OnNavigated="CloseAsync" />
            </div>
        </div>
    }

    else
    {
        @* الأيقونة تظهر فقط والنافذة مغلقة؛ الإغلاق من زر «تصغير» فى رأس النافذة أو Escape *@
        <button type="button" class="aiw-fab @SideClass" @ref="_fab" @onclick="ToggleAsync"
                aria-label="@Tr("AIC_OpenAssistant")" aria-expanded="false" title="@Tr("AIC_OpenAssistant")">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" />
            @if (_unseen)
            {
                <span class="aiw-badge" aria-hidden="true"></span>
                <span class="aic-sr" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);">@Tr("AIC_NewReply")</span>
            }
        </button>
    }
}

@code {
    private AssistantSessionService? _chat;
    private AssistantChat? _chatView;
    private ElementReference _fab, _panel;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AssistantWidget>? _self;
    private bool _open, _unseen, _focusOnRender, _escBound, _focusFab;

    private string SideClass => Prefs.AiAssistantIconPosition == "start" ? "aiw-start" : "aiw-end";

    private bool OnAssistantPage
    {
        get
        {
            string rel = Nav.ToBaseRelativePath(Nav.Uri);
            int q = rel.IndexOfAny(new[] { '?', '#' });
            if (q >= 0) rel = rel[..q];
            return rel.TrimEnd('/').Equals("assistant", StringComparison.OrdinalIgnoreCase);
        }
    }

    private bool Visible => _chat != null && MenuState.IsAuthenticated && _chat.HasAccess && Prefs.ShowAiAssistantIcon && !OnAssistantPage;

    protected override void OnInitialized()
    {
        _chat = ServiceProvider.GetService<AssistantSessionService>();
        Prefs.OnChanged += OnChanged;
        MenuState.OnAuthChanged += OnAuthChanged;
        LangService.OnLanguageChanged += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (_chat != null)
        {
            _chat.OnChanged += OnChanged;
            _chat.OnReplyCompleted += OnReplyCompleted;
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnAuthChanged() => InvokeAsync(() => { _open = false; _unseen = false; StateHasChanged(); });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        if (OnAssistantPage) { _open = false; _unseen = false; }
        StateHasChanged();
    });

    private void OnReplyCompleted() => InvokeAsync(() =>
    {
        if (!_open && !OnAssistantPage) { _unseen = true; StateHasChanged(); }
    });

    /// <summary>سياق الشاشة المفتوحة: مسارها وعنوانها كما فى القائمة (بلا معاملات الاستعلام حتى لا تتسرب أرقام مستندات).</summary>
    private AiScreenContext CurrentContext()
    {
        string rel = Nav.ToBaseRelativePath(Nav.Uri);
        string path = rel.Split('?', '#')[0];
        string title = "";
        try { title = MenuState.UserAllowedMenus.FindMenuForRoute(rel)?.GetLocalizedDescription(LangService.CurrentLanguage) ?? ""; }
        catch { }
        if (path.Length == 0) title = Tr("NavHome");
        return new AiScreenContext { Route = "/" + path, Title = title, Language = LangService.CurrentCultureInfo.Name };
    }

    private async Task ToggleAsync()
    {
        if (_open) { await CloseAsync(); return; }
        _open = true;
        _unseen = false;
        _focusOnRender = true;
        if (_chat != null && !_chat.AvailabilityLoaded) await _chat.RefreshAsync();
    }

    private async Task CloseAsync()
    {
        _open = false;
        _escBound = false;
        _focusFab = true;   // الأيقونة تُرسم من جديد بعد الإغلاق؛ التركيز يعود لها بعد العرض
        StateHasChanged();
        await Task.CompletedTask;
    }

    [JSInvokable]
    public Task CloseFromKeyboard() => InvokeAsync(CloseAsync);

    private async Task NewChatAsync()
    {
        _chat?.NewConversation();
        if (_chatView != null) await _chatView.FocusInputAsync();
    }

    private void OpenFullPage()
    {
        _open = false;
        Nav.NavigateTo("/assistant");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open)
        {
            if (_focusFab)
            {
                _focusFab = false;
                try { await _fab.FocusAsync(); } catch { }
            }
            return;
        }
        try
        {
            if (!_escBound)
            {
                _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AccountERP.SharedUI/js/assistant.js");
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("bindEscape", _panel, _self);
                _escBound = true;
            }
            if (_focusOnRender && _chatView != null)
            {
                _focusOnRender = false;
                await _chatView.FocusInputAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Prefs.OnChanged -= OnChanged;
        MenuState.OnAuthChanged -= OnAuthChanged;
        LangService.OnLanguageChanged -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
        if (_chat != null)
        {
            _chat.OnChanged -= OnChanged;
            _chat.OnReplyCompleted -= OnReplyCompleted;
        }
        try { if (_module != null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
