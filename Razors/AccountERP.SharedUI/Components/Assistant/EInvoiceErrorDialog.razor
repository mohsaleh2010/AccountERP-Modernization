@* 🤖 P8.3.3 (ف16): حوار «شرح خطأ الفاتورة الإلكترونية». شريط حالة الرفع + لصق نص الخطأ + «اشرح» (مطابقة ثابتة بلا نموذج — ف3)
   + بطاقة لكل سبب مطابق بشارة نوع المطابقة + «لم نجد له شرحاً» + «شرح مفصّل من المساعد» (ف17) + «نسخ الشرح» + تنبيه دائم.
   لا تعديل للفاتورة ولا إعادة إرسال (ف24). يملأ الشاشة تحت 600px. *@
@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject LanguageService LangService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IAsyncDisposable

<style>
    .eiv-dialog { width: min(820px, 96vw); }
    @@media (max-width: 600px) {
        .eiv-dialog { width: 100vw !important; max-width: 100vw !important; height: 100dvh; max-height: 100dvh !important; margin: 0 !important; border-radius: 0 !important; }
    }
    .eiv { display: flex; flex-direction: column; gap: 14px; }
    .eiv-uuid { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-top: 4px; font-size: .85rem; }
    .eiv-uuid code { direction: ltr; unicode-bidi: isolate; font-family: ui-monospace, Consolas, monospace; background: var(--mud-palette-background-gray); padding: 2px 6px; border-radius: 4px; word-break: break-all; }
    .eiv-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .eiv-actions .mud-button-root { min-height: 44px; }
    .eiv-card { border: 1px solid var(--mud-palette-lines-default); border-inline-start: 4px solid var(--mud-palette-primary); border-radius: 8px; padding: 12px 14px; background: var(--mud-palette-surface); }
    .eiv-card.approx { border-inline-start-color: var(--mud-palette-warning); }
    .eiv-card h3 { margin: 0 0 6px; font-size: 1rem; font-weight: 700; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .eiv-card .body { white-space: pre-wrap; line-height: 1.7; font-size: .92rem; color: var(--mud-palette-text-primary); }
    .eiv-unmatched { margin: 0; padding-inline-start: 20px; font-size: .88rem; color: var(--mud-palette-text-secondary); }
    .eiv-unmatched li { direction: ltr; unicode-bidi: plaintext; text-align: start; word-break: break-word; }
    .eiv-count { font-weight: 600; color: var(--mud-palette-text-secondary); }
</style>

<MudDialog Class="eiv-dialog" ContentStyle="max-height: calc(100dvh - 150px); overflow-y: auto;">
    <TitleContent>
        <div style="display:flex;align-items:center;gap:8px;">
            <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Color="Color.Primary" aria-hidden="true" />
            <span style="font-weight:700;">@(InvoiceNo is > 0 ? Tr("AIEI_TitleFor", InvoiceNo.Value) : Tr("AIEI_Title"))</span>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="eiv">
            @* ───── شريط الحالة ───── *@
            @if (_statusLoading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@Tr("AIEI_Explaining")" />
            }
            else
            {
                <MudAlert Severity="@StateSeverity" Variant="Variant.Outlined" Dense="true" Icon="@StateIcon">
                    <div>@StateText</div>
                    @if (_status is { Found: true, Attempts: > 0 })
                    {
                        <div style="font-size:.85rem;">@Tr("AIEI_Attempts", _status.Attempts)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_status?.Uuid))
                    {
                        <div class="eiv-uuid">
                            <span>@Tr("AIEI_Uuid"):</span>
                            <code>@_status!.Uuid</code>
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" aria-label="@Tr("AIEI_Uuid")" OnClick="@(() => CopyAsync(_status!.Uuid!, false))" />
                        </div>
                    }
                </MudAlert>
            }

            @* ───── لصق نص الخطأ ───── *@
            <MudTextField T="string" @bind-Value="_text" Immediate="true" Label="@Tr("AIEI_PasteLabel")" Variant="Variant.Outlined"
                          Lines="6" MaxLength="@AiEInvoiceConst.MaxErrorChars" Counter="@AiEInvoiceConst.MaxErrorChars"
                          HelperText="@(_storedUsed ? Tr("AIEI_StoredErrorNote") : Tr("AIEI_PasteHint"))" InputMode="InputMode.text"
                          UserAttributes="@(new Dictionary<string, object> { ["dir"] = "auto", ["spellcheck"] = "false" })" />

            <div class="eiv-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="@(_busy || !CanExplain)"
                           OnClick="ExplainAsync" aria-busy="@(_busy ? "true" : "false")">
                    @(_busy ? Tr("AIEI_Explaining") : Tr("AIEI_Explain"))
                </MudButton>
                @if (_result != null && (_result.Matches.Count > 0 || _result.Unmatched.Count > 0))
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="@(() => CopyAsync(PlainText(), true))">@Tr("AIEI_CopyExplanation")</MudButton>
                }
                @if (_result != null && _svc != null && _svc.CanAskAssistant)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.AutoAwesome" Disabled="_busy" OnClick="AskAssistant">@Tr("AIEI_AskAssistant")</MudButton>
                }
            </div>

            @* ───── النتائج ───── *@
            <div aria-live="polite">
                @if (_error != null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
                }
                else if (_result != null)
                {
                    @if (_result.Matches.Count > 0)
                    {
                        <div class="eiv-count mb-2">@Tr("AIEI_ResultsCount", _result.Matches.Count)</div>
                        <div class="eiv">
                            @foreach (var m in _result.Matches)
                            {
                                <article class="@("eiv-card" + (m.MatchType == AiEtaMatchTypes.Approx ? " approx" : ""))">
                                    <h3>
                                        <span>@m.Title</span>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(m.MatchType == AiEtaMatchTypes.Approx ? Color.Warning : Color.Primary)">@TypeLabel(m.MatchType)</MudChip>
                                    </h3>
                                    <div class="body">@m.Content</div>
                                </article>
                            }
                        </div>
                    }
                    else if (_result.NoErrorText)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">@Tr("AIEI_PasteHint")</MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true">@Tr("AIEI_NoMatch")</MudAlert>
                    }
                    @if (_result.Unmatched.Count > 0)
                    {
                        <div class="mt-3">
                            <div class="eiv-count mb-1">@Tr("AIEI_Unmatched")</div>
                            <ul class="eiv-unmatched">
                                @foreach (var u in _result.Unmatched) { <li>@u</li> }
                            </ul>
                        </div>
                    }
                }
            </div>

            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Style="vertical-align:middle" aria-hidden="true" /> @Tr("AIEI_Disclaimer")
            </MudText>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog.Close())">@Tr("AI_Close")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public long SaleId { get; set; }
    [Parameter] public long? InvoiceNo { get; set; }
    [Parameter] public string DocKind { get; set; } = AiEInvoiceConst.DocInvoice;
    [Parameter] public string Route { get; set; } = "";

    private AiEInvoiceService? _svc;
    private AiEInvoiceStatus? _status;
    private bool _statusLoading = true;
    private string _text = "";
    private bool _busy;
    private bool _storedUsed;
    private AiEInvoiceExplainResult? _result;
    private string? _error;
    private IJSObjectReference? _module;

    private bool CanExplain => _text.Trim().Length > 0 || !string.IsNullOrWhiteSpace(_status?.ErrorsText);

    protected override async Task OnInitializedAsync()
    {
        _svc = ServiceProvider.GetService<AiEInvoiceService>();
        if (_svc == null || !_svc.IsAvailable) { _statusLoading = false; _error = Tr("AIEI_Error"); return; }
        try
        {
            _status = await _svc.GetStatusAsync(SaleId, DocKind);
            if (!string.IsNullOrWhiteSpace(_status?.ErrorsText)) { _text = _status!.ErrorsText!; _storedUsed = true; }
        }
        catch { _status = null; }
        finally { _statusLoading = false; }
    }

    private async Task ExplainAsync()
    {
        if (_svc == null || _busy) return;
        _busy = true; _error = null;
        try
        {
            var r = await _svc.ExplainAsync(_text, SaleId > 0 ? SaleId : null, DocKind);
            if (!string.IsNullOrEmpty(r.Error)) { _error = Tr("AIEI_Error"); _result = null; }
            else
            {
                _result = r;
                if (r.Status != null) _status = r.Status;
                _storedUsed = r.UsedStoredError;
            }
        }
        catch { _error = Tr("AIEI_Error"); _result = null; }
        finally { _busy = false; }
    }

    private void AskAssistant()
    {
        if (_svc == null) return;
        var ok = _svc.TryAskAssistant(_result?.ErrorText ?? _text, SaleId, InvoiceNo, DocKind, Route, Tr("AIEI_Title"), LangService.CurrentLanguage);
        if (!ok) { Snackbar.Add(Tr("AIS_AssistantBusy"), Severity.Warning); return; }
        MudDialog.Close();
        Nav.NavigateTo("/assistant");
    }

    private string PlainText() => _result == null ? "" : AiEInvoiceService.PlainText(_result, TypeLabel, Tr("AIEI_Unmatched"));

    private async Task CopyAsync(string text, bool explanation)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AccountERP.SharedUI/js/assistant.js");
            await _module.InvokeAsync<bool>("copyText", text);
            if (explanation) Snackbar.Add(Tr("AIEI_Copied"), Severity.Success);
        }
        catch { }
    }

    private string TypeLabel(string t) => t switch
    {
        AiEtaMatchTypes.Code => Tr("AIEI_MatchCode"),
        AiEtaMatchTypes.Path => Tr("AIEI_MatchPath"),
        AiEtaMatchTypes.Step => Tr("AIEI_MatchStep"),
        AiEtaMatchTypes.Phrase => Tr("AIEI_MatchPhrase"),
        _ => Tr("AIEI_MatchApprox"),
    };

    private string StateText
    {
        get
        {
            if (_status == null || !_status.Found) return Tr("AIEI_StateUnknown");
            return _status.UploadState switch
            {
                AiEInvoiceStates.NotSent => Tr("AIEI_StateNotSent"),
                AiEInvoiceStates.Sent => Tr("AIEI_StateSent", _status.SentDate?.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture) ?? "—"),
                AiEInvoiceStates.Superseded => Tr("AIEI_StateSuperseded"),
                AiEInvoiceStates.FlagOnly => Tr("AIEI_StateFlagOnly"),
                _ => Tr("AIEI_StateUnknown"),
            };
        }
    }

    private Severity StateSeverity => (_status?.Found ?? false) ? _status!.UploadState switch
    {
        AiEInvoiceStates.Sent => Severity.Success,
        AiEInvoiceStates.NotSent => Severity.Info,
        _ => Severity.Warning,
    } : Severity.Normal;

    private string StateIcon => (_status?.UploadState) switch
    {
        AiEInvoiceStates.Sent => Icons.Material.Outlined.CloudDone,
        AiEInvoiceStates.NotSent => Icons.Material.Outlined.CloudOff,
        _ => Icons.Material.Outlined.CloudSync,
    };

    private string Tr(string key, params object[] args) => AiBriefText.T(Lang, LangService.CurrentCultureInfo, key, args);

    public async ValueTask DisposeAsync()
    {
        if (_module != null) { try { await _module.DisposeAsync(); } catch { } }
    }
}
