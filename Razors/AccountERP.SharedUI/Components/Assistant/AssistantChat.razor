@* 🤖 المساعد الذكى P1 (ai-assistant-plan.md §7.1-7.2): منطقة المحادثة المشتركة بين صفحة /assistant والنافذة العائمة - الرسائل، البث الحى،
   بطاقات الاقتراح عند الفراغ، وحقل الكتابة (Enter يرسل، Shift+Enter سطر جديد) مع زر الإيقاف. الحالة كلها فى AssistantSessionService (Scoped)
   فتبقى المحادثة واحدة بين الصفحة والنافذة. ردود المساعد Markdown تُعرض عبر AiMarkdown (HTML الخام معطّل، الروابط منقّاة، لا صور). *@
@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@inject AssistantSessionService Chat
@inject LanguageService LangService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IAsyncDisposable

<style>
    .aic { display: flex; flex-direction: column; height: 100%; min-height: 0; background: var(--mud-palette-background); }
    .aic-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 16px; scroll-behavior: smooth; }
    @@media (prefers-reduced-motion: reduce) { .aic-scroll { scroll-behavior: auto; } .aic-cursor, .aic-dots span { animation: none !important; } }
    .aic-list { display: flex; flex-direction: column; gap: 16px; max-width: 860px; margin-inline: auto; }
    .aic-row { display: flex; gap: 10px; align-items: flex-start; min-width: 0; }
    .aic-row.user { flex-direction: row-reverse; }
    .aic-avatar { flex: none; width: 32px; height: 32px; border-radius: 10px; display: grid; place-items: center;
                  background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .aic-avatar .mud-icon-root { font-size: 1.15rem; }
    .aic-bubble { min-width: 0; max-width: min(100%, 720px); font-size: .95rem; line-height: 1.7; overflow-wrap: anywhere; }
    .aic-row.user .aic-bubble { padding: 10px 14px; border-radius: 16px; border-start-end-radius: 4px; white-space: pre-wrap;
                                background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .aic-row.asst .aic-bubble { padding: 4px 2px; color: var(--mud-palette-text-primary); flex: 1; }
    .aic-md > :first-child { margin-top: 0; } .aic-md > :last-child { margin-bottom: 0; }
    .aic-md p { margin: 0 0 .6em; } .aic-md ul, .aic-md ol { margin: 0 0 .6em; padding-inline-start: 1.4em; }
    .aic-md h1, .aic-md h2, .aic-md h3, .aic-md h4 { font-size: 1.02rem; font-weight: 700; margin: .9em 0 .4em; }
    .aic-md code { font-family: Consolas, 'Courier New', monospace; font-size: .85em; padding: 1px 5px; border-radius: 6px;
                   background: var(--mud-palette-background-gray); direction: ltr; unicode-bidi: embed; }
    .aic-md pre { padding: 10px 12px; border-radius: 10px; overflow-x: auto; background: var(--mud-palette-background-gray); direction: ltr; text-align: left; }
    .aic-md pre code { padding: 0; background: none; }
    .aic-md blockquote { margin: 0 0 .6em; padding-inline-start: 12px; border-inline-start: 3px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-secondary); }
    .aic-md a { color: var(--mud-palette-primary); text-decoration: underline; }
    .aic-md .ai-md-table { border-collapse: collapse; margin: 0 0 .8em; display: block; overflow-x: auto; max-width: 100%; font-size: .875rem; }
    .aic-md .ai-md-table th, .aic-md .ai-md-table td { border: 1px solid var(--mud-palette-lines-default); padding: 6px 10px; text-align: start; white-space: nowrap; }
    .aic-md .ai-md-table th { background: var(--mud-palette-background-gray); font-weight: 600; }
    .aic-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: 6px; font-size: .75rem; color: var(--mud-palette-text-secondary); }
    .aic-meta .mud-icon-button { padding: 6px; }
    .aic-cursor { display: inline-block; width: .5em; height: 1.1em; vertical-align: text-bottom; margin-inline-start: 2px;
                  background: var(--mud-palette-primary); border-radius: 2px; animation: aic-blink 1s steps(2) infinite; }
    @@keyframes aic-blink { 50% { opacity: 0; } }
    .aic-dots { display: inline-flex; gap: 4px; padding: 10px 2px; } .aic-dots span { width: 7px; height: 7px; border-radius: 50%; background: var(--mud-palette-text-secondary); animation: aic-dot 1.2s infinite ease-in-out; }
    .aic-dots span:nth-child(2) { animation-delay: .15s; } .aic-dots span:nth-child(3) { animation-delay: .3s; }
    @@keyframes aic-dot { 0%, 80%, 100% { opacity: .25; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }
    .aic-empty { max-width: 680px; margin: 0 auto; padding: 24px 4px; text-align: center; }
    .aic-empty .ico { width: 56px; height: 56px; margin: 0 auto 10px; border-radius: 16px; display: grid; place-items: center;
                      background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .aic-empty .ico .mud-icon-root { font-size: 1.9rem; }
    .aic-empty h2 { font-size: 1.15rem; font-weight: 700; margin: 0 0 4px; }
    .aic-empty p { margin: 0 0 16px; color: var(--mud-palette-text-secondary); font-size: .9rem; }
    .aic-sugg { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; text-align: start; }
    .aic.compact .aic-sugg { grid-template-columns: 1fr; }
    .aic-sugg button { display: flex; gap: 10px; align-items: flex-start; min-height: 44px; padding: 12px; border-radius: 12px; cursor: pointer; text-align: start;
                       border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); color: var(--mud-palette-text-primary);
                       font: inherit; font-size: .875rem; line-height: 1.5; transition: border-color .15s, background-color .15s; }
    .aic-sugg button:hover { border-color: var(--mud-palette-primary); background: color-mix(in srgb, var(--mud-palette-primary) 6%, var(--mud-palette-surface)); }
    .aic-sugg button:focus-visible, .aic-send:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 2px; }
    .aic-sugg .mud-icon-root { color: var(--mud-palette-primary); flex: none; }
    .aic-composer { flex: none; padding: 10px 16px 14px; border-top: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .aic-box { display: flex; align-items: flex-end; gap: 8px; max-width: 860px; margin-inline: auto; padding: 6px 6px 6px 12px; border-radius: 16px;
               border: 1px solid var(--mud-palette-lines-inputs); background: var(--mud-palette-background); }
    .aic-box:focus-within { border-color: var(--mud-palette-primary); box-shadow: 0 0 0 1px var(--mud-palette-primary); }
    .aic-box textarea { flex: 1; min-width: 0; resize: none; border: 0; outline: 0; background: transparent; color: var(--mud-palette-text-primary);
                        font: inherit; font-size: 1rem; line-height: 1.5; padding: 8px 4px; max-height: 200px; }
    .aic-box textarea::placeholder { color: var(--mud-palette-text-secondary); }
    .aic-send { flex: none; width: 44px; height: 44px; border-radius: 12px; border: 0; cursor: pointer; display: grid; place-items: center;
                background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); transition: opacity .15s; }
    .aic-send.stop { background: var(--mud-palette-error); color: var(--mud-palette-error-text); }
    .aic-send:disabled { opacity: .45; cursor: not-allowed; }
    .aic-hint { max-width: 860px; margin: 6px auto 0; font-size: .72rem; color: var(--mud-palette-text-secondary); text-align: center; }
    .aic-state { max-width: 560px; margin: 32px auto; padding: 0 16px; }
    .aic-setup { padding: 16px; border-radius: 14px; border: 1px solid var(--mud-palette-primary); background: color-mix(in srgb, var(--mud-palette-primary) 5%, var(--mud-palette-surface)); }
    .aic-setup .t { display: flex; align-items: center; gap: 8px; font-weight: 700; }
    .aic-setup p { margin: 6px 0 12px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .aic-setup .mud-button-root { min-height: 44px; }
    .aic-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    [dir="rtl"] .aic-send .mud-icon-root.flip { transform: scaleX(-1); }
</style>

<div class="aic @(Compact ? "compact" : "")" dir="@(LangService.IsRtl ? "rtl" : "ltr")">
    @if (!Chat.IsAvailable)
    {
        <div class="aic-state"><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("AIC_NotAvailable")</MudAlert></div>
    }
    else if (!Chat.HasAccess)
    {
        <div class="aic-state"><MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@Tr("AIC_NoAccess")</MudAlert></div>
    }
    else if (!Chat.AvailabilityLoaded)
    {
        <div class="aic-state" style="text-align:center;"><MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" /></div>
    }
    else
    {
        <div class="aic-scroll" @ref="_scroll">
            @if (!Chat.Availability.Ready)
            {
                <div class="aic-state">
                    @if (Chat.CanQuickSetup && _setupModels is { Count: > 0 })
                    {
                        @* إعداد سريع للمدير: اختيار نموذج المحادثة بالبحث ثم البدء مباشرة *@
                        <div class="aic-setup">
                            <div class="t"><MudIcon Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" aria-hidden="true" /> @Tr("AIC_SetupTitle")</div>
                            <p>@Tr("AIC_SetupSub", _setupModels.Count)</p>
                            <MudAutocomplete T="AiModelRow" @bind-Value="_setupPick" SearchFunc="SearchSetupModels"
                                             ToStringFunc="@(m => m == null ? "" : $"{m.ProviderName} · {m.ModelId}")"
                                             Label="@Tr("AIC_SetupModel")" Placeholder="@Tr("AIC_SetupSearch")" Variant="Variant.Outlined"
                                             MaxItems="60" CoerceText="true" Clearable="true" />
                            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Disabled="@(_setupPick == null || _setupSaving)" OnClick="SaveSetupAsync">
                                @(_setupSaving ? Tr("AIC_SetupSaving") : Tr("AIC_SetupSave"))
                            </MudButton>
                            <div class="aic-hint" style="margin-top:8px;">@Tr("AIC_SetupHint")</div>
                        </div>
                    }
                    <MudAlert Severity="@(Chat.CanQuickSetup && _setupModels is { Count: > 0 } ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Class="mt-3">
                        <div>@(Chat.CanQuickSetup && _setupModels is { Count: > 0 } ? Tr("AIC_SetupMore") : Chat.Availability.Message)</div>
                        @if (Chat.CanOpenSettings)
                        {
                            <MudButton Class="mt-2" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings"
                                       Href="/settings/ai">@Tr("AIC_OpenSettings")</MudButton>
                        }
                        else
                        {
                            <div class="mt-1">@Tr("AIC_AskAdmin")</div>
                        }
                    </MudAlert>
                </div>
            }

            @if (Chat.IsLoading)
            {
                <div style="text-align:center;padding:24px;"><MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" /></div>
            }
            else if (Chat.Messages.Count == 0 && Chat.PendingUserText == null && Chat.Availability.Ready)
            {
                <div class="aic-empty">
                    <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></div>
                    <h2>@Tr("AIC_EmptyTitle")</h2>
                    <p>@Tr("AIC_EmptySub")</p>
                    <div class="aic-sugg">
                        @foreach (var (icon, key) in Suggestions)
                        {
                            <button type="button" @onclick="() => UseSuggestion(key)">
                                <MudIcon Icon="@icon" Size="Size.Small" aria-hidden="true" />
                                <span>@Tr(key)</span>
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="aic-list">
                    @foreach (var m in Chat.Messages)
                    {
                        @if (m.Role == "user")
                        {
                            <div class="aic-row user" @key="m.Id"><div class="aic-bubble">@m.Text</div></div>
                        }
                        else
                        {
                            <div class="aic-row asst" @key="m.Id">
                                <div class="aic-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></div>
                                <div class="aic-bubble">
                                    @if (!string.IsNullOrEmpty(m.Text))
                                    {
                                        <div class="aic-md">@AiMarkdown.Render(m.Text)</div>
                                    }
                                    @if (m.Status == AiMessageStatus.Error)
                                    {
                                        <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mt-1">@(string.IsNullOrEmpty(m.ErrorText) ? Tr("AIC_ReplyFailed") : m.ErrorText)</MudAlert>
                                    }
                                    else if (!string.IsNullOrEmpty(m.ErrorText))
                                    {
                                        <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mt-1">@m.ErrorText</MudAlert>
                                    }
                                    <div class="aic-meta">
                                        @if (m.Status == AiMessageStatus.Stopped)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@Tr("AIC_Stopped")</MudChip>
                                        }
                                        @if (!string.IsNullOrEmpty(m.ModelName))
                                        {
                                            <span>@m.ModelName</span>
                                        }
                                        @if (m.OutputTokens.HasValue)
                                        {
                                            <span title="@Tr("AIC_TokensTip")">@Tr("AIC_Tokens", (m.InputTokens ?? 0).ToString("N0", CultureInfo.InvariantCulture), m.OutputTokens.Value.ToString("N0", CultureInfo.InvariantCulture))</span>
                                        }
                                        @if (!string.IsNullOrEmpty(m.Text))
                                        {
                                            <MudTooltip Text="@Tr("AIC_Copy")">
                                                <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" aria-label="@Tr("AIC_Copy")" OnClick="() => CopyAsync(m.Text)" />
                                            </MudTooltip>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @if (Chat.PendingUserText != null)
                    {
                        <div class="aic-row user"><div class="aic-bubble">@Chat.PendingUserText</div></div>
                        <div class="aic-row asst">
                            <div class="aic-avatar" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></div>
                            <div class="aic-bubble">
                                @{ var live = Chat.StreamingText; }
                                @if (live.Length == 0)
                                {
                                    <span class="aic-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                                }
                                else
                                {
                                    <div class="aic-md">@AiMarkdown.Render(live)</div><span class="aic-cursor" aria-hidden="true"></span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Chat.Error))
            {
                <div class="aic-list mt-3">
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" ShowCloseIcon="true" CloseIconClicked="Chat.ClearError">@Chat.Error</MudAlert>
                </div>
            }
        </div>

        <div class="aic-sr" role="status" aria-atomic="true">@_status</div>

        <div class="aic-composer">
            <div class="aic-box">
                <textarea @ref="_input" rows="1" maxlength="8000" aria-label="@Tr("AIC_InputLabel")" placeholder="@Tr("AIC_Placeholder")"
                          disabled="@(!Chat.Availability.Ready)"></textarea>
                @if (Chat.IsSending)
                {
                    <button type="button" class="aic-send stop" @onclick="Chat.Stop" aria-label="@Tr("AIC_Stop")" title="@Tr("AIC_Stop")">
                        <MudIcon Icon="@Icons.Material.Filled.Stop" />
                    </button>
                }
                else
                {
                    <button type="button" class="aic-send" @onclick="SendFromButtonAsync" aria-label="@Tr("AIC_Send")" title="@Tr("AIC_Send")"
                            disabled="@(!Chat.Availability.Ready)">
                        <MudIcon Icon="@Icons.Material.Filled.Send" Class="flip" />
                    </button>
                }
            </div>
            <div class="aic-hint">@Tr("AIC_Hint")</div>
        </div>
    }
</div>

@code {
    /// <summary>وضع النافذة العائمة (اقتراحات فى عمود واحد).</summary>
    [Parameter] public bool Compact { get; set; }
    /// <summary>سياق الشاشة الحالية (النافذة العائمة تمرر مسار الشاشة وعنوانها).</summary>
    [Parameter] public Func<AiScreenContext>? ContextProvider { get; set; }

    private static readonly (string Icon, string Key)[] Suggestions =
    {
        (Icons.Material.Outlined.Receipt, "AIC_Sugg1"),
        (Icons.Material.Outlined.Percent, "AIC_Sugg2"),
        (Icons.Material.Outlined.School, "AIC_Sugg3"),
        (Icons.Material.Outlined.Mail, "AIC_Sugg4"),
    };

    private ElementReference _scroll, _input;
    private IJSObjectReference? _module;
    private DotNetObjectReference<AssistantChat>? _self;
    private bool _bound, _forceScroll = true, _wasSending;
    private int _lastCount = -1;
    private string _status = "";

    protected override async Task OnInitializedAsync()
    {
        Chat.OnChanged += OnChatChanged;
        LangService.OnLanguageChanged += OnChatChanged;
        if (Chat.HasAccess && !Chat.AvailabilityLoaded) await Chat.RefreshAsync();
    }

    // ───── الإعداد السريع (المدير بلا نموذج محادثة) ─────
    private List<AiModelRow>? _setupModels;
    private AiModelRow? _setupPick;
    private bool _setupSaving, _setupLoading;

    private async Task EnsureSetupModelsAsync()
    {
        if (_setupModels != null || _setupLoading || !Chat.AvailabilityLoaded || Chat.Availability.Ready || !Chat.CanQuickSetup) return;
        _setupLoading = true;
        try
        {
            _setupModels = await Chat.GetChatModelsAsync();
            // الافتراضى الموصى به فى الخطة: Claude Opus 5.5 إن كان مضافاً (مباشرة أو عبر OpenRouter)
            // (OpenRouter يكتبه anthropic/claude-opus-5.5، ونسخ «:batch» ليست للمحادثة الحية)
            static string Norm(string id) => id.Replace('.', '-').ToLowerInvariant();
            _setupPick = _setupModels.FirstOrDefault(m => !m.ModelId.Contains(':') && Norm(m.ModelId).EndsWith("claude-opus-5-5"));
            StateHasChanged();
        }
        catch { _setupModels = new(); }
        finally { _setupLoading = false; }
    }

    private Task<IEnumerable<AiModelRow>> SearchSetupModels(string? q, CancellationToken ct)
    {
        IEnumerable<AiModelRow> list = _setupModels ?? new();
        if (!string.IsNullOrWhiteSpace(q))
        {
            var words = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            list = list.Where(m => words.All(w => m.ModelId.Contains(w, StringComparison.OrdinalIgnoreCase)
                                               || m.DisplayName.Contains(w, StringComparison.OrdinalIgnoreCase)
                                               || m.ProviderName.Contains(w, StringComparison.OrdinalIgnoreCase)));
        }
        return Task.FromResult(list.Take(60));
    }

    private async Task SaveSetupAsync()
    {
        if (_setupPick == null) return;
        _setupSaving = true;
        try
        {
            await Chat.SetChatModelAsync(_setupPick.Id);
            if (Chat.Availability.Ready)
            {
                Snackbar.Add(Tr("AIC_SetupDone", Chat.Availability.ModelName), Severity.Success);
                _setupModels = null;
                _bound = false;   // حقل الكتابة يُعاد تفعيله
            }
        }
        finally { _setupSaving = false; }
    }

    private void OnChatChanged() => InvokeAsync(() =>
    {
        if (Chat.IsSending != _wasSending)
        {
            _status = Chat.IsSending ? Tr("AIC_StatusWriting") : Tr("AIC_StatusDone");
            _wasSending = Chat.IsSending;
        }
        if (Chat.Messages.Count != _lastCount) { _forceScroll = true; _lastCount = Chat.Messages.Count; }
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Chat.HasAccess || !Chat.AvailabilityLoaded) return;
        await EnsureSetupModelsAsync();
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AccountERP.SharedUI/js/assistant.js");
            if (!_bound)
            {
                _self ??= DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("bindComposer", _input, _self);
                _bound = true;
                await _module.InvokeVoidAsync("focus", _input);
            }
            await _module.InvokeVoidAsync("scrollToBottom", _scroll, _forceScroll);
            _forceScroll = false;
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }   // أثناء العرض المسبق
    }

    [JSInvokable]
    public Task SubmitFromKeyboard(string text) => SubmitAsync(text);

    private async Task SendFromButtonAsync()
    {
        if (_module == null) return;
        string text = await _module.InvokeAsync<string>("getValue", _input) ?? "";
        await SubmitAsync(text);
    }

    private async Task SubmitAsync(string? text)
    {
        text = (text ?? "").Trim();
        if (text.Length == 0 || Chat.IsSending || !Chat.Availability.Ready) return;
        if (_module != null) await _module.InvokeVoidAsync("clearComposer", _input);
        _forceScroll = true;
        await Chat.SendAsync(text, ContextProvider?.Invoke() ?? new AiScreenContext { Language = LangService.CurrentCultureInfo.Name });
        // رُفض قبل الحفظ (رسالة طويلة، محادثة حُذفت...): نعيد النص لحقل الكتابة حتى لا يضيع.
        if (!string.IsNullOrEmpty(Chat.Error) && _module != null)
        {
            try { await _module.InvokeVoidAsync("setComposer", _input, text); }
            catch (JSDisconnectedException) { }
        }
    }

    private async Task UseSuggestion(string key)
    {
        if (_module != null) await _module.InvokeVoidAsync("setComposer", _input, Tr(key));
    }

    private async Task CopyAsync(string text)
    {
        if (_module == null) return;
        bool ok = await _module.InvokeAsync<bool>("copyText", text);
        Snackbar.Add(Tr(ok ? "AIC_Copied" : "AIC_CopyFailed"), ok ? Severity.Success : Severity.Warning);
    }

    /// <summary>للصفحة والنافذة: نقل التركيز لحقل الكتابة (بعد فتح النافذة أو محادثة جديدة).</summary>
    public async Task FocusInputAsync()
    {
        try { if (_module != null) await _module.InvokeVoidAsync("focus", _input); }
        catch (JSDisconnectedException) { }
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public async ValueTask DisposeAsync()
    {
        Chat.OnChanged -= OnChatChanged;
        LangService.OnLanguageChanged -= OnChatChanged;
        try { if (_module != null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        _self?.Dispose();
    }
}
