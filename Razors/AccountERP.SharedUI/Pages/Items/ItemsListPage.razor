@* 🟢 خطة 04 — المرحلة 2: قائمة الأصناف الموحَّدة (بديل ItemsListGridFrm/ItemsListViewFrm/قائمة الخدمات). بحث بالاسم/الكود/الباركود،
   تصفية بالفئة والنوع (أصناف/خدمات) والحالة، والرصيد الإجمالى بالوحدتين للعرض فقط. الصف يفتح شاشة الصنف. التصميم حسب ui-ux-pro-max.
   المرحلة 3: /items/p/{Profile} قائمة بملف ثابت (general، services، pharmacy، pharmacy-retail) بأعمدته، والصف يفتح الصنف بنفس الملف.
   خطة 05 بند 18: «صنف جديد حسب النوع» يفتح شاشة الإضافة المخصصة لكل ملف، وقائمة النسيج بشرائح نوع الصنف (نوع المخزن).
   خطة 05 بند 21: /items/stores/{type} عرض «أصناف مخازن نوع» (بدل Mitems_List و ItemDataProduction/Purchase_ListFRM) بمخزن اختيارى والرصيد فيه.
   خطة 05 بند 16: «إضافة سريعة» فى حوار (الاسم، الفئة، الكود، الوحدة، سعرا البيع والشراء) برصيد صفر فى المخزن الافتراضى، مع إضافة متعددة. *@
@page "/items"
@page "/items/p/{Profile}"
@page "/items/stores/{StoreType:int}"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.ItemEditorService
@inject LanguageService LangService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@Tr(TitleKey)</PageTitle>

<InvoiceStyles />

<style>
    .it-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .it-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .it-head .ico .mud-icon-root { font-size: 2rem; }
    .it-head .titles { flex: 1 1 260px; }
    .it-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .it-head .mud-button-root { min-height: 44px; }
    .it-gap { margin-top: 16px; }
    .it-filters { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1.4fr) minmax(0, 1fr); gap: 12px 16px; align-items: start; }
    .it-kinds { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .it-chip { min-height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface);
               color: var(--mud-palette-text-primary); font: inherit; font-size: .875rem; cursor: pointer; transition: background .15s, border-color .15s; }
    .it-chip:hover { border-color: var(--mud-palette-primary); }
    .it-chip:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 2px; }
    .it-chip[aria-pressed="true"] { background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); border-color: var(--mud-palette-primary);
                                    color: var(--mud-palette-primary); font-weight: 600; }
    .it-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .it-code { font-family: ui-monospace, Consolas, monospace; font-size: .85rem; color: var(--mud-palette-text-secondary); }
    .it-row { cursor: pointer; }
    .it-stores { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 16px; margin-top: 12px; }
    .it-stores .mud-input-control { flex: 0 1 320px; }
    a.it-chip { display: inline-flex; align-items: center; text-decoration: none; }
    .it-muted { color: var(--mud-palette-text-secondary); font-size: .8rem; }
    .it-neg { color: var(--mud-palette-error); }
    .it-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 40px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    .it-empty .mud-icon-root { opacity: .5; }
    .it-qform { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 16px; align-items: start; }
    .it-qform .full { grid-column: 1 / -1; }
    .it-hint { margin-top: 4px; font-size: .8rem; color: var(--mud-palette-text-secondary); }
    @@media (max-width: 899px) { .it-filters { grid-template-columns: minmax(0, 1fr); } }
    @@media (max-width: 599px) { .it-qform { grid-template-columns: minmax(0, 1fr); } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">
    <div class="inv-card it-head">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@(_pharm ? Icons.Material.Filled.Medication : _profile == "cars" ? Icons.Material.Filled.CarRepair : _profile == "glass" ? Icons.Material.Filled.Window : _profile == "ceramics" ? Icons.Material.Filled.GridOn : _profile == "textile" ? Icons.Material.Filled.Texture : Icons.Material.Filled.Inventory2)" /></div>
        <div class="titles">
            <h1 class="inv-title">@Tr(TitleKey)</h1>
            <div class="sub">@Tr(_pharm ? "IT_PhListSub" : "IT_ListSub")</div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt" OnClick="OpenQuick" Disabled="@(_lk is null)">@Tr("IT_QuickAdd")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="@NewHref">@Tr(_f.Kind == 2 ? "IT_NewService" : _pharm ? "IT_NewMedicine" : _profile == "cars" ? "IT_NewCarPart" : "IT_NewItem")</MudButton>
        @if (_profile.Length == 0)
        {
            @* شاشة إضافة مخصصة لكل نوع صنف (/items/p/{profile}/new) *@
            <MudMenu Label="@Tr("IT_NewByType")" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Category" EndIcon="@Icons.Material.Filled.ArrowDropDown"
                     AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" aria-label="@Tr("IT_NewByType")">
                @foreach (var (p, key, icon) in NewTypes)
                {
                    <MudMenuItem Href="@($"/items/p/{p}/new")" Icon="@icon">@Tr(key)</MudMenuItem>
                }
            </MudMenu>
        }
    </div>

    <div class="inv-card it-gap">
        <div class="it-filters">
            <MudTextField T="string" Value="_f.Text" ValueChanged="OnTextAsync" Label="@Tr("IT_Search")" Variant="Variant.Outlined" Immediate="true" DebounceInterval="300"
                          Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" AutoFocus="true" />
            <MudSelect T="long" Value="_f.Category_Id" ValueChanged="OnCategoryAsync" Label="@Tr("IC_CatName")" Variant="Variant.Outlined"
                       ToStringFunc="@(id => id == 0 ? Tr("IC_AllCats") : _lk?.Categories.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                <MudSelectItem T="long" Value="0L">@Tr("IC_AllCats")</MudSelectItem>
                @foreach (var c in _lk?.Categories ?? new()) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="int" Value="_f.Active" ValueChanged="OnActiveAsync" Label="@Tr("IT_Status")" Variant="Variant.Outlined">
                <MudSelectItem T="int" Value="1">@Tr("IT_ActiveOnly")</MudSelectItem>
                <MudSelectItem T="int" Value="0">@Tr("IT_InactiveOnly")</MudSelectItem>
                <MudSelectItem T="int" Value="-1">@Tr("IT_AllStatus")</MudSelectItem>
            </MudSelect>
        </div>
        @if (!_fixedKind)
        {
        <div class="it-kinds" role="group" aria-label="@Tr("IC_Kind")">
            @foreach (var (k, key) in new[] { (0, "IT_KindAll"), (1, "IC_Items"), (2, "IC_Services") })
            {
                <button type="button" class="it-chip" aria-pressed="@(_f.Kind == k ? "true" : "false")" @onclick="@(() => OnKindAsync(k))">@Tr(key)</button>
            }
        </div>
        }
        @if (_storeType > 0)
        {
        @* خطة 05 بند 21: أصناف مخازن نوع واحد (منتجات المصنع / المشتريات ...) مع اختيار مخزن بعينه، والرصيد فى هذه المخازن فقط *@
        <div class="it-stores">
            <div class="it-kinds" role="group" aria-label="@Tr("IT_StoreTypeLabel")">
                @for (int t = 1; t <= 4; t++)
                {
                    var k = t;
                    <a class="it-chip" href="@($"/items/stores/{k}")" aria-current="@(_storeType == k ? "page" : null)" aria-pressed="@(_storeType == k ? "true" : "false")">@Tr("IT_TT" + k)</a>
                }
            </div>
            <MudSelect T="long" Value="_f.Store_Id" ValueChanged="OnStoreAsync" Label="@Tr("IT_Store")" Variant="Variant.Outlined" Margin="Margin.Dense"
                       HelperText="@(TypeStores.Count == 0 ? Tr("IT_NoStoreOfType") : null)" Error="@(TypeStores.Count == 0)"
                       ToStringFunc="@(id => id == 0 ? Tr("IT_AllTypeStores") : TypeStores.FirstOrDefault(s => s.Id == id)?.Name ?? string.Empty)">
                <MudSelectItem T="long" Value="0L">@Tr("IT_AllTypeStores")</MudSelectItem>
                @foreach (var st in TypeStores) { <MudSelectItem T="long" Value="st.Id">@st.Name</MudSelectItem> }
            </MudSelect>
        </div>
        }
        @if (_profile == "textile")
        {
        <div class="it-kinds" role="group" aria-label="@Tr("IT_TextileType")">
            @for (int t = 0; t <= 4; t++)
            {
                var k = t;
                <button type="button" class="it-chip" aria-pressed="@(_f.Store_Used_Type == k ? "true" : "false")" @onclick="@(() => OnTextileTypeAsync(k))">@Tr(k == 0 ? "IT_AllTypes" : "IT_TT" + k)</button>
            }
        </div>
        }
    </div>

    <div class="inv-card it-gap">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@Tr(TitleKey)<span class="inv-count">@_rows.Count</span>
            @if (_rows.Count >= _f.Top) { <span class="it-muted" style="margin-inline-start:8px">@Tr("IT_TopNote", _f.Top)</span> }
        </h2>
        <MudTable Items="@_rows" T="ListRow" Hover="true" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Loading="_loading" LoadingProgressColor="Color.Primary"
                  OnRowClick="@((TableRowClickEventArgs<ListRow> e) => Nav.NavigateTo(ItemHref(e.Item!.Id)))" RowClass="it-row">
            <HeaderContent>
                <MudTh>@Tr("IT_Code")</MudTh>
                <MudTh>@Tr("IT_Name")</MudTh>
                <MudTh>@Tr("IC_CatName")</MudTh>
                @if (_specs) { <MudTh>@Tr(_profile == "cars" ? "IT_FactoryCode" : _profile == "textile" ? "IT_SizeDesc" : "IT_Specs")</MudTh> }
                <MudTh>@Tr("IT_Unit")</MudTh>
                <MudTh Style="text-align:end">@Tr("IT_SalePrice")</MudTh>
                <MudTh Style="text-align:end">@Tr("IT_PurchasePrice")</MudTh>
                @if (_pharm) { <MudTh Style="text-align:end">@Tr("IT_RetailPrice")</MudTh> }
                <MudTh Style="text-align:end">@Tr(_storeType > 0 ? "IT_BalanceInStores" : "IT_Balance")</MudTh>
                <MudTh>@Tr("IT_Status")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("IT_Code")"><span class="it-code">@context.Code</span></MudTd>
                <MudTd DataLabel="@Tr("IT_Name")">
                    <a href="@ItemHref(context.Id)" @onclick:stopPropagation="true" style="color:inherit;font-weight:600;text-decoration:none">@context.Name</a>
                    @if (context.Item_Or_Service == 2 || context.Without_Balance) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Class="ms-1">@Tr(context.Item_Or_Service == 2 ? "IC_Services" : "IT_NoBalance")</MudChip> }
                    @if (_pharm && !string.IsNullOrEmpty(context.Scientific_Name)) { <div class="it-muted">@context.Scientific_Name</div> }
                </MudTd>
                <MudTd DataLabel="@Tr("IC_CatName")">@context.Category</MudTd>
                @if (_specs) { <MudTd DataLabel="@Tr("IT_Specs")"><span class="it-muted">@context.Spec_Text</span></MudTd> }
                <MudTd DataLabel="@Tr("IT_Unit")">@context.Unit @if (context.Factor != 1) { <span class="it-muted">× @Num(context.Factor)</span> }</MudTd>
                <MudTd DataLabel="@Tr("IT_SalePrice")" Style="text-align:end"><span class="it-num">@Money(context.Sale_Price)</span></MudTd>
                <MudTd DataLabel="@Tr("IT_PurchasePrice")" Style="text-align:end"><span class="it-num">@Money(context.Purchase_Price)</span></MudTd>
                @if (_pharm)
                {
                    <MudTd DataLabel="@Tr("IT_RetailPrice")" Style="text-align:end">@if (context.Is_Retail) { <span class="it-num">@Money(context.Retail_Price)</span> } else { <span class="it-muted">—</span> }</MudTd>
                }
                <MudTd DataLabel="@Tr("IT_Balance")" Style="text-align:end">
                    @if (context.Without_Balance || context.Item_Or_Service == 2) { <span class="it-muted">—</span> }
                    else { <span class="it-num @(context.Balance_Small < 0 ? "it-neg" : "")">@BalanceText(context.Balance_Small, context.Factor)</span> }
                </MudTd>
                <MudTd DataLabel="@Tr("IT_Status")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.Is_Active ? Color.Success : Color.Default)">@Tr(context.Is_Active ? "ILActive" : "IT_Inactive")</MudChip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="it-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /><span>@Tr("IT_NoItems")</span></div>
            </NoRecordsContent>
        </MudTable>
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="alert">@_error</MudAlert> }
    </div>
</div>
</MudContainer>

@* ===== الإضافة السريعة: الاسم والفئة والكود والوحدة والسعرين فقط؛ الرصيد صفر فى المخزن الافتراضى ===== *@
<MudDialog @bind-Visible="_qOpen"
           Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false })">
    <TitleContent>@Tr("IT_QuickAddTitle")</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_qError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_qError</MudAlert> }
        <div class="it-qform">
            <MudTextField T="string" @bind-Value="_q.Name" Label="@Tr("IT_Name")" Variant="Variant.Outlined" Required="true" MaxLength="500" Class="full"
                          Immediate="true" @ref="_qNameField" OnKeyDown="OnQuickKeyDown" />
            <MudSelect T="long" Value="_q.Category_Id" ValueChanged="OnQuickCategory" Label="@Tr("IC_CatName")" Variant="Variant.Outlined" Required="true"
                       ToStringFunc="@(id => QuickCategories.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                @foreach (var c in QuickCategories) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_q.Code" Label="@Tr("IT_Code")" Variant="Variant.Outlined" MaxLength="50" Style="direction:ltr"
                          Disabled="@(_lk?.Auto_Code == true)" Placeholder="@(_lk?.Auto_Code == true ? Tr("IT_AutoCode") : null)"
                          HelperText="@(_lk?.Auto_Code == true ? Tr("IT_AutoCodeHelp") : null)" OnKeyDown="OnQuickKeyDown" Immediate="true" />
            <MudSelect T="long" @bind-Value="_q.Unit_Id" Label="@Tr("IT_Unit")" Variant="Variant.Outlined" Required="true" Class="full"
                       ToStringFunc="@(id => _lk?.Units.FirstOrDefault(u => u.Id == id)?.Name ?? string.Empty)">
                @foreach (var u in _lk?.Units ?? new()) { <MudSelectItem T="long" Value="u.Id">@u.Name (1 @u.Big_Unit = @Num(u.Factor) @u.Small_Unit)</MudSelectItem> }
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="_q.Sale_Price_Large" Label="@Tr("IT_SalePrice")" Variant="Variant.Outlined" Min="0" Format="0.####"
                             Immediate="true" OnKeyDown="OnQuickKeyDown" />
            <MudNumericField T="decimal" @bind-Value="_q.Purchase_Price_Large" Label="@Tr("IT_PurchasePrice")" Variant="Variant.Outlined" Min="0" Format="0.####"
                             Immediate="true" OnKeyDown="OnQuickKeyDown" />
            <div class="full it-hint">@Tr("IT_QuickHint")</div>
            <div class="full">
                <MudCheckBox T="bool" @bind-Value="_qMulti" Label="@Tr("MultipleAddLabel")" Color="Color.Primary" Dense="true" />
                @if (_qMulti) { <div class="it-hint">@Tr("IT_QuickMultiHint")</div> }
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _qOpen = false)">@Tr("Close")</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Disabled="@(_qBusy || !QuickReady)" OnClick="@(() => SaveQuickAsync(true))">@Tr("IT_SaveOpen")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_qBusy || !QuickReady)" OnClick="@(() => SaveQuickAsync(false))">
            @if (_qBusy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
            @Tr("Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? KindQuery { get; set; }
    [Parameter] public string? Profile { get; set; }
    /// <summary>/items/stores/{type}: نوع المخزن (1 منتجات تامة، 2 مشتريات وخامات، 3 غير مكتمل، 4 تحت التشغيل).</summary>
    [Parameter] public int? StoreType { get; set; }

    private readonly ItemEditorService _svc = new();
    private Lookups? _lk;
    private List<ListRow> _rows = new();
    private readonly ListFilter _f = new();
    private string? _error;
    private bool _loading = true, _pharm, _fixedKind;
    private string _profile = "";
    private int _storeType;
    private List<Option> TypeStores => _lk?.Stores.Where(s => _lk.Store_Types.GetValueOrDefault(s.Id, 1) == _storeType).ToList() ?? new();

    private string TitleKey => _profile switch { "pharmacy" => "IT_ListPharmacy", "pharmacy-retail" => "IT_ListPharmacyRetail", "services" => "IT_ListServices",
        "cars" => "IT_ListCars", "ceramics" => "IT_ListCeramics", "glass" => "IT_ListGlass", "textile" => "IT_ListTextile", _ => _storeType > 0 ? "IT_ListStoreType" + _storeType : "IT_ListTitle" };
    private bool _specs;
    private string ProfilePrefix => _profile.Length > 0 ? $"/items/p/{_profile}" : "/items";
    private string ItemHref(long id) => $"{ProfilePrefix}/{id}";
    private string NewHref => _profile.Length > 0 ? $"{ProfilePrefix}/new{(_profile == "textile" && _f.Store_Used_Type > 0 ? $"?type={_f.Store_Used_Type}" : "")}"
        : _storeType > 0 ? $"/items/new?type={_storeType}" : $"/items/new{(_f.Kind == 2 ? "?kind=services" : "")}";
    private static readonly (string, string, string)[] NewTypes =
    {
        ("general", "IC_ProfileGeneral", Icons.Material.Filled.Inventory2), ("services", "IC_Services", Icons.Material.Filled.MiscellaneousServices),
        ("pharmacy", "IC_ProfilePharmacy", Icons.Material.Filled.Medication), ("cars", "IC_ProfileCars", Icons.Material.Filled.CarRepair),
        ("ceramics", "IC_ProfileCeramics", Icons.Material.Filled.GridOn), ("glass", "IC_ProfileGlass", Icons.Material.Filled.Window),
        ("textile", "IC_ProfileTextile", Icons.Material.Filled.Texture),
    };

    protected override void OnInitialized() => LangService.OnLanguageChanged += OnLanguageChangedHandler;

    protected override async Task OnParametersSetAsync()
    {
        string p = (Profile ?? "").Trim().ToLowerInvariant();
        _profile = ItemEditorService.RouteProfiles.Contains(p) ? p : "";
        _pharm = ItemEditorService.IsPharmacy(_profile);
        _specs = _profile is "cars" or "ceramics" or "glass" or "textile";
        _f.Store_Used_Type = 0;
        _storeType = _profile.Length == 0 && StoreType is >= 1 and <= 4 ? StoreType.Value : 0;
        _f.Store_Type = _storeType; _f.Store_Id = 0;
        _fixedKind = _profile is "services" || _pharm || _specs;
        _f.Profile = _profile;
        _f.Kind = _profile == "services" ? 2 : _pharm || _specs ? 1 : KindQuery == "services" ? 2 : KindQuery == "items" ? 1 : 0;
        _f.Category_Id = 0;
        try { _lk ??= await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetLookups(); }); }
        catch (Exception ex) { _error = Inner(ex); }
        await LoadAsync();
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private async Task LoadAsync()
    {
        _loading = true;
        var f = new ListFilter { Text = _f.Text, Category_Id = _f.Category_Id, Kind = _f.Kind, Active = _f.Active, Top = _f.Top, Profile = _f.Profile, Store_Used_Type = _f.Store_Used_Type,
                              Store_Type = _f.Store_Type, Store_Id = _f.Store_Id };
        try { _rows = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.List(f); }); _error = null; }
        catch (Exception ex) { _error = Inner(ex); _rows = new(); }
        finally { _loading = false; }
    }

    // ===== الإضافة السريعة =====
    private ItemForm _q = new();
    private bool _qOpen, _qBusy, _qMulti, _qRefocus;
    private string? _qError;
    private MudTextField<string>? _qNameField;

    /// <summary>فئات الإضافة السريعة: حسب نوع القائمة (أصناف/خدمات) وملفها إن كان لها فئات بنفس الملف.</summary>
    private List<CategoryOption> QuickCategories
    {
        get
        {
            var all = _lk?.Categories ?? new();
            int kind = _f.Kind;
            var byKind = all.Where(c => kind == 0 || (kind == 2 ? c.Item_Or_Service != 1 : c.Item_Or_Service != 2)).ToList();
            string prof = _pharm ? "pharmacy" : _profile;
            if (prof is "pharmacy" or "cars" or "ceramics" or "glass" or "textile" && byKind.Any(c => c.Profile == prof)) return byKind.Where(c => c.Profile == prof).ToList();
            return byKind;
        }
    }

    /// <summary>صنف النسيج السريع: نوعه من شريحة القائمة (منتج تام افتراضياً)، ومخزنه أول مخزن من نفس النوع.</summary>
    private int QuickStoreType => _storeType > 0 ? _storeType : _profile == "textile" && _f.Store_Used_Type > 0 ? _f.Store_Used_Type : 1;
    private long QuickStoreId => _storeType > 0 && _f.Store_Id != 0 ? _f.Store_Id
        : _profile != "textile" && _storeType == 0 ? _lk?.Default_Store_Id ?? 0
        : _lk?.Stores.FirstOrDefault(s => _lk.Store_Types.GetValueOrDefault(s.Id, 1) == QuickStoreType)?.Id ?? 0;

    private bool QuickReady => !string.IsNullOrWhiteSpace(_q.Name) && _q.Category_Id != 0 && _q.Unit_Id != 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_qRefocus && _qNameField is not null) { _qRefocus = false; await Task.Delay(60); await _qNameField.FocusAsync(); }
    }

    // AutoFocus لا يعمل داخل MudDialog (مصيدة التركيز تأخذه)؛ ننتظر رسم الحوار ثم نركّز على الاسم
    private async Task FocusQuickSoonAsync()
    {
        for (int i = 0; i < 10; i++)
        {
            await Task.Delay(80);
            if (_qNameField is null) continue;
            try { await Task.Delay(120); await _qNameField.FocusAsync(); } catch { }
            return;
        }
    }

    private void OpenQuick()
    {
        var cats = QuickCategories;
        long cat = _f.Category_Id != 0 && cats.Any(c => c.Id == _f.Category_Id) ? _f.Category_Id
            : cats.FirstOrDefault(c => c.Id == (_f.Kind == 2 ? _lk!.Default_Category_Service : _lk!.Default_Category_Item))?.Id ?? cats.FirstOrDefault()?.Id ?? 0;
        long unit = _lk!.Units.FirstOrDefault(u => u.Is_Default)?.Id ?? _lk.Units.FirstOrDefault()?.Id ?? 0;
        _q = new ItemForm { Category_Id = cat, Unit_Id = unit };
        _qError = null;
        _qNameField = null; _qOpen = true;
        _ = FocusQuickSoonAsync();
    }

    private void OnQuickCategory(long id) => _q.Category_Id = id;

    private async Task OnQuickKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _qBusy) return;
        await Task.Delay(150); // يترك آخر حرف مكتوب (Immediate) يصل للخادم قبل الحفظ
        if (QuickReady) await SaveQuickAsync(false);
    }

    private async Task SaveQuickAsync(bool open)
    {
        if (QuickStoreId == 0) { _qError = Tr(_profile == "textile" || _storeType > 0 ? "IT_NoStoreOfType" : "IT_NoStore"); return; }
        var unit = _lk.Units.FirstOrDefault(u => u.Id == _q.Unit_Id);
        decimal factor = unit?.Factor is > 0 and var fc ? fc : 1;
        var cat = _lk.Categories.FirstOrDefault(c => c.Id == _q.Category_Id);
        int kind = _profile == "services" || _f.Kind == 2 || cat?.Item_Or_Service == 2 ? 2 : 1;
        var f = new ItemForm
        {
            Name = _q.Name, Code = _lk.Auto_Code ? null : _q.Code, Category_Id = _q.Category_Id, Unit_Id = _q.Unit_Id,
            Item_Or_Service = kind, Without_Balance = kind == 2, Store_Id = QuickStoreId, Store_Used_Type = QuickStoreType,
            Sale_Price_Large = _q.Sale_Price_Large, Sale_Price_Small = Math.Round(_q.Sale_Price_Large / factor, 4),
            Purchase_Price_Large = _q.Purchase_Price_Large, Purchase_Price_Small = Math.Round(_q.Purchase_Price_Large / factor, 4),
            // قائمة التجزئة: يُعلَّم الصنف تجزئة إن كانت وحدته تقبل التجزئة (وإلا يكمل المستخدم من الشاشة الكاملة)
            Is_Retail = _profile == "pharmacy-retail" && unit?.Retail_Parts > 1,
        };
        _qBusy = true; _qError = null;
        try
        {
            long id = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Save(f); });
            Snackbar.Add(Tr("IT_Added"), Severity.Success);
            if (open) { _qOpen = false; Nav.NavigateTo(ItemHref(id)); return; }
            if (_qMulti)
            {
                // تبقى الفئة والوحدة للصنف التالي
                _q = new ItemForm { Category_Id = f.Category_Id, Unit_Id = f.Unit_Id };
                _qRefocus = true;
            }
            else _qOpen = false;
            await LoadAsync();
        }
        catch (Exception ex) { _qError = Inner(ex); }
        finally { _qBusy = false; }
    }

    private async Task OnTextAsync(string? s) { _f.Text = s; await LoadAsync(); }
    private async Task OnCategoryAsync(long c) { _f.Category_Id = c; await LoadAsync(); }
    private async Task OnActiveAsync(int a) { _f.Active = a; await LoadAsync(); }
    private async Task OnKindAsync(int k) { _f.Kind = k; await LoadAsync(); }
    private async Task OnTextileTypeAsync(int t) { _f.Store_Used_Type = t; await LoadAsync(); }
    private async Task OnStoreAsync(long id) { _f.Store_Id = id; await LoadAsync(); }

    /// <summary>الرصيد بالوحدة الصغرى معروض بالوحدتين: «5 + 2».</summary>
    private static string BalanceText(decimal small, decimal factor)
    {
        if (factor <= 1) return Num(small);
        decimal large = Math.Truncate(small / factor), rest = small - large * factor;
        return rest == 0 ? Num(large) : $"{Num(large)} + {Num(rest)}";
    }

    private static string Num(decimal v) => v.ToString("#,0.####", CultureInfo.InvariantCulture);
    private static string Money(decimal v) => v.ToString("#,0.00", CultureInfo.InvariantCulture);
    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try { CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo; return Lang[key, args]; }
        finally { CultureInfo.CurrentUICulture = previousCulture; }
    }
}
