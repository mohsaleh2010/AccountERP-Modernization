@* 🟢 خطة 04 — المرحلة 2: شاشة الصنف الموحَّدة (ملفا «عام» و«خدمات»): البيانات الأساسية، الوحدة والأسعار، المخازن والرصيد.
   الإضافة: رصيد ابتدائى اختيارى يُرحَّل كأول مدة عبر المحرك. التعديل لا يغيّر الرصيد أبداً، والوحدة مقفولة لصنف له رصيد أو حركات.
   الصلاحيات 916/917 فى الخدمة. التصميم حسب ui-ux-pro-max ونظام inv-* المشترك.
   المرحلة 3: ملف النشاط من فئة الصنف (الشاشة الموحَّدة) أو ثابت من المسار /items/p/{Profile}؛ قسم الدواء (ملف أدوية)،
   قسم الفاتورة الإلكترونية (كل الملفات)، والتشغيلات والصلاحية للعرض فقط.
   خطة 05 بند 18: ملف النسيج (نوع الصنف = نوع المخزن، ووصف المقاس) والمخزن الرئيسى من مخازن نفس النوع.
   المرحلة 4: قسم المواصفات لملفات قطع غيار السيارات والسيراميك والزجاج (القيم من القوائم المرجعية، والاسم المقترح للزجاج).
   خطة 05 بند 17: بيانات القوائم المرجعية (المجموعة والطبيعة وقوائم المواصفات) تظهر لأصناف السيراميك فقط؛ السيارات رقم القطعة ونوع السيارة، والزجاج الأبعاد. *@
@page "/items/new"
@page "/items/{Id:long}"
@page "/items/p/{Profile}/new"
@page "/items/p/{Profile}/{Id:long}"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.ItemEditorService
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject TabWorkspaceService TabWorkspace
@implements IDisposable

<PageTitle>@(_isNew ? Tr(NewTitleKey) : _f.Name)</PageTitle>

<InvoiceStyles />

<style>
    .ie-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
    .ie-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .ie-head .ico .mud-icon-root { font-size: 2rem; }
    .ie-head .titles { flex: 1 1 260px; min-width: 0; }
    .ie-head .sub { margin-top: 4px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .ie-head .acts { display: flex; flex-wrap: wrap; gap: 8px; }
    .ie-head .acts .mud-button-root { min-height: 44px; }
    .ie-gap { margin-top: 16px; }
    .ie-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 16px; align-items: start; }
    .ie-grid .span2 { grid-column: span 2; }
    .ie-grid .full { grid-column: 1 / -1; }
    .ie-row { display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; min-height: 56px; }
    .ie-prices { display: grid; grid-template-columns: 140px repeat(2, minmax(0, 1fr)); gap: 10px 16px; align-items: center; }
    .ie-prices .h { font-size: .8rem; font-weight: 600; color: var(--mud-palette-text-secondary); }
    .ie-prices .lbl { font-weight: 600; }
    .ie-conv { margin-top: 4px; padding: 10px 14px; border-radius: 10px; font-size: .9rem; background: color-mix(in srgb, var(--mud-palette-primary) 8%, transparent); }
    .ie-note { font-size: .85rem; color: var(--mud-palette-text-secondary); margin-top: 8px; }
    .ie-num { font-variant-numeric: tabular-nums; }
    .ie-neg { color: var(--mud-palette-error); }
    .ie-addstore { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-top: 12px; }
    .ie-addstore .mud-input-control { flex: 0 1 320px; }
    .ie-addstore .mud-button-root { min-height: 44px; }
    .ie-sub { font-size: 1rem; margin-top: 16px; }
    .ie-retail { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 16px; align-items: center; margin-top: 8px; }
    .ie-warn { color: var(--mud-palette-warning-darken, var(--mud-palette-warning)); }
    @@media (max-width: 649px) { .ie-retail { grid-template-columns: minmax(0, 1fr); } }
    @@media (max-width: 1099px) { .ie-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 649px) { .ie-grid { grid-template-columns: minmax(0, 1fr); } .ie-grid .span2 { grid-column: auto; }
                                 .ie-prices { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .ie-prices .h0, .ie-prices .lbl { grid-column: 1 / -1; } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">
    @if (_loading)
    {
        <div class="inv-card"><MudProgressLinear Color="Color.Primary" Indeterminate="true" /></div>
    }
    else
    {
    <div class="inv-card ie-head">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@(_f.Item_Or_Service == 2 ? Icons.Material.Filled.MiscellaneousServices : Pharm ? Icons.Material.Filled.Medication : Icons.Material.Filled.Inventory2)" /></div>
        <div class="titles">
            <h1 class="inv-title">@(_isNew ? Tr(NewTitleKey) : _f.Name)</h1>
            <div class="sub">
                @if (!_isNew)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Tr("IT_Code"): @_f.Code</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_f.Is_Active ? Color.Success : Color.Default)">@Tr(_f.Is_Active ? "ILActive" : "IT_Inactive")</MudChip>
                }
                else { <span>@Tr("IT_NewSub")</span> }
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Icon="@(Pharm ? Icons.Material.Filled.Medication : Icons.Material.Filled.Category)">@Tr("IC_Profile"): @Tr(ProfileKey(EffectiveProfile))</MudChip>
            </div>
        </div>
        <div class="acts">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.List" Href="@ListHref">@Tr("IT_BackToList")</MudButton>
            @if (_isNew) { <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddTask" Disabled="_busy" OnClick="@(() => SaveAsync(true))">@Tr("IT_SaveNew")</MudButton> }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="_busy" OnClick="@(() => SaveAsync(false))">@Tr("Save")</MudButton>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Warning" Class="ie-gap" role="alert" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert> }

    @* ===== البيانات الأساسية ===== *@
    <section class="inv-card ie-gap" aria-labelledby="ie-basic">
        <h2 class="inv-card-title" id="ie-basic"><MudIcon Icon="@Icons.Material.Filled.Badge" />@Tr("IT_Basic")</h2>
        <div class="ie-grid">
            <MudTextField T="string" @bind-Value="_f.Name" Label="@Tr("IT_Name")" Variant="Variant.Outlined" Required="true" MaxLength="500" Class="span2" AutoFocus="@_isNew" />
            <MudTextField T="string" @bind-Value="_f.Code" Label="@Tr("IT_Code")" Variant="Variant.Outlined" MaxLength="50"
                          Disabled="@(_isNew && _lk!.Auto_Code)" Placeholder="@(_isNew && _lk!.Auto_Code ? Tr("IT_AutoCode") : null)"
                          HelperText="@(_isNew && _lk!.Auto_Code ? Tr("IT_AutoCodeHelp") : null)" />
            <MudTextField T="string" @bind-Value="_f.Name_On_Invoice" Label="@Tr("IT_NameOnInvoice")" Variant="Variant.Outlined" MaxLength="500" HelperText="@Tr("IT_NameOnInvoiceHelp")" />
            <MudTextField T="string" @bind-Value="_f.Other_Name" Label="@Tr("IT_OtherName")" Variant="Variant.Outlined" MaxLength="500" />
            <MudSelect T="long" @bind-Value="_f.Category_Id" Label="@Tr("IC_CatName")" Variant="Variant.Outlined" Required="true"
                       ToStringFunc="@(id => _lk!.Categories.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                @foreach (var c in _lk!.Categories) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            @if (Lookups)
            {
            <MudSelect T="long" @bind-Value="_f.Group_Id" Label="@Tr("IL_groups")" Variant="Variant.Outlined" Clearable="true"
                       ToStringFunc="@(id => _lk!.Groups.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                @foreach (var c in _lk!.Groups) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="long" @bind-Value="_f.Nature_Id" Label="@Tr("IL_natures")" Variant="Variant.Outlined" Clearable="true"
                       ToStringFunc="@(id => _lk!.Natures.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                @foreach (var c in _lk!.Natures) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            }
            <MudTextField T="string" @bind-Value="_f.Barcode2" Label="@Tr("IT_Barcode2")" Variant="Variant.Outlined" MaxLength="100" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.QrCode2" />
            <MudTextField T="string" @bind-Value="_f.Barcode3" Label="@Tr("IT_Barcode3")" Variant="Variant.Outlined" MaxLength="100" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.QrCode2" />
            <div class="ie-row full">
                <MudRadioGroup T="int" Value="_f.Item_Or_Service" ValueChanged="OnKindChanged" aria-label="@Tr("IC_Kind")">
                    <MudRadio T="int" Value="1" Color="Color.Primary" Disabled="@(!_isNew && _locked)">@Tr("IC_Items")</MudRadio>
                    <MudRadio T="int" Value="2" Color="Color.Primary" Disabled="@(!_isNew && _locked)">@Tr("IC_Services")</MudRadio>
                </MudRadioGroup>
                <MudSwitch T="bool" @bind-Value="_f.Without_Balance" Color="Color.Primary" Label="@Tr("IT_NoBalanceLabel")" Disabled="@(_f.Item_Or_Service == 2 || (!_isNew && _locked))" />
                <MudSwitch T="bool" @bind-Value="_f.Is_Active" Color="Color.Primary" Label="@Tr("ILActive")" />
            </div>
            <MudTextField T="string" @bind-Value="_f.Description" Label="@Tr("IT_Description")" Variant="Variant.Outlined" Lines="2" MaxLength="2000" Class="full" />
        </div>
    </section>

    @* ===== الوحدة والأسعار ===== *@
    <section class="inv-card ie-gap" aria-labelledby="ie-unit">
        <h2 class="inv-card-title" id="ie-unit"><MudIcon Icon="@Icons.Material.Filled.Sell" />@Tr("IT_UnitPrices")</h2>
        <div class="ie-grid">
            <MudSelect T="long" Value="_f.Unit_Id" ValueChanged="OnUnitChanged" Label="@Tr("IT_Unit")" Variant="Variant.Outlined" Required="true" Disabled="@(!_isNew && _locked)"
                       HelperText="@(!_isNew && _locked ? Tr("IT_UnitLocked") : null)"
                       ToStringFunc="@(id => _lk!.Units.FirstOrDefault(u => u.Id == id)?.Name ?? string.Empty)">
                @foreach (var u in _lk!.Units) { <MudSelectItem T="long" Value="u.Id">@u.Name (1 @u.Big_Unit = @Num(u.Factor) @u.Small_Unit)</MudSelectItem> }
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="_f.Reorder_Level" Label="@Tr("IT_Reorder")" Variant="Variant.Outlined" Min="0" HelperText="@Tr("IT_ReorderHelp")" />
            @if (Unit is { } u)
            {
                <div class="ie-conv" aria-live="polite"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Style="vertical-align:middle" /> 1 @u.Big_Unit = @Num(u.Factor) @u.Small_Unit</div>
            }
        </div>
        <div class="ie-prices ie-gap" role="group" aria-label="@Tr("IT_Prices")">
            <span class="h h0"></span>
            <span class="h">@Tr("IT_PerLarge", Unit?.Big_Unit ?? "")</span>
            <span class="h">@Tr("IT_PerSmall", Unit?.Small_Unit ?? "")</span>

            <span class="lbl">@Tr("IT_SalePrice")</span>
            <MudNumericField T="decimal" Value="_f.Sale_Price_Large" ValueChanged="@(v => { _f.Sale_Price_Small = Suggest(_f.Sale_Price_Small, _f.Sale_Price_Large, v); _f.Sale_Price_Large = v; })"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="0.####" aria-label="@Tr("IT_SalePrice")" />
            <MudNumericField T="decimal" @bind-Value="_f.Sale_Price_Small" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="0.####" Disabled="@(Factor == 1)" aria-label="@Tr("IT_SalePrice")" />

            <span class="lbl">@Tr("IT_PurchasePrice")</span>
            <MudNumericField T="decimal" Value="_f.Purchase_Price_Large" ValueChanged="@(v => { _f.Purchase_Price_Small = Suggest(_f.Purchase_Price_Small, _f.Purchase_Price_Large, v); _f.Purchase_Price_Large = v; })"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="0.####" aria-label="@Tr("IT_PurchasePrice")" />
            <MudNumericField T="decimal" @bind-Value="_f.Purchase_Price_Small" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Format="0.####" Disabled="@(Factor == 1)" aria-label="@Tr("IT_PurchasePrice")" />

            <span class="lbl">@Tr("IT_DefaultUnit")</span>
            <MudSelect T="int" @bind-Value="_f.Default_Sale_Unit" Label="@Tr("IT_ForSale")" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int" Value="1">@(Unit?.Big_Unit ?? Tr("IU_Big"))</MudSelectItem>
                <MudSelectItem T="int" Value="2">@(Unit?.Small_Unit ?? Tr("IU_Small"))</MudSelectItem>
            </MudSelect>
            <MudSelect T="int" @bind-Value="_f.Default_Purchase_Unit" Label="@Tr("IT_ForPurchase")" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="int" Value="1">@(Unit?.Big_Unit ?? Tr("IU_Big"))</MudSelectItem>
                <MudSelectItem T="int" Value="2">@(Unit?.Small_Unit ?? Tr("IU_Small"))</MudSelectItem>
            </MudSelect>
        </div>
        @if (Factor > 1) { <div class="ie-note">@Tr("IT_SmallPriceHelp")</div> }
    </section>

    @* ===== بيانات الدواء (ملف أدوية) ===== *@
    @if (Pharm)
    {
    <section class="inv-card ie-gap" aria-labelledby="ie-pharm">
        <h2 class="inv-card-title" id="ie-pharm"><MudIcon Icon="@Icons.Material.Filled.Medication" />@Tr("IT_Pharmacy")</h2>
        <div class="ie-grid">
            <MudTextField T="string" @bind-Value="_f.Scientific_Name" Label="@Tr("IT_ScientificName")" Variant="Variant.Outlined" MaxLength="500" Class="span2" />
            <MudTextField T="string" @bind-Value="_f.Pharmacology" Label="@Tr("IT_Pharmacology")" Variant="Variant.Outlined" MaxLength="500" />
            <MudTextField T="string" @bind-Value="_f.Mark" Label="@Tr("IT_Mark")" Variant="Variant.Outlined" MaxLength="500" />
            <MudTextField T="string" @bind-Value="_f.Licensing" Label="@Tr("IT_Licensing")" Variant="Variant.Outlined" MaxLength="500" />
            <MudNumericField T="decimal?" @bind-Value="_f.Storage_Temp" Label="@Tr("IT_StorageTemp")" Variant="Variant.Outlined" Min="-80" Max="80" Clearable="true"
                             Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Thermostat" />
        </div>
        <h3 class="inv-card-title ie-sub"><MudIcon Icon="@Icons.Material.Filled.ViewModule" Size="Size.Small" />@Tr("IT_Location")</h3>
        <div class="ie-grid">
            <MudNumericField T="int" @bind-Value="_f.Block_No" Label="@Tr("IT_BlockNo")" Variant="Variant.Outlined" Min="0" />
            <MudNumericField T="int" @bind-Value="_f.Shelf_No" Label="@Tr("IT_ShelfNo")" Variant="Variant.Outlined" Min="0" />
            <MudNumericField T="int" @bind-Value="_f.Order_On_Shelf" Label="@Tr("IT_OrderOnShelf")" Variant="Variant.Outlined" Min="0" />
        </div>
        <div class="ie-row">
            <MudSwitch T="bool" @bind-Value="_f.Is_Print_Barcode" Color="Color.Primary" Label="@Tr("IT_PrintBarcode")" />
            <MudSwitch T="bool" @bind-Value="_f.Is_Stop_Buying" Color="Color.Warning" Label="@Tr("IT_StopBuying")" />
            <MudSwitch T="bool" Value="_f.Is_Retail" ValueChanged="OnRetailChanged" Color="Color.Primary" Label="@Tr("IT_RetailSale")" />
        </div>
        @if (_f.Is_Retail)
        {
            <div class="ie-retail">
                <MudNumericField T="decimal" @bind-Value="_f.Retail_Price" Label="@Tr("IT_RetailPrice")" Variant="Variant.Outlined" Min="0" Format="0.####"
                                 HelperText="@(RetailParts > 1 ? Tr("IT_RetailHelp", Money(SuggestedRetail)) : null)" Style="max-width:260px" />
                @if (RetailParts > 1)
                {
                    <div class="ie-conv" aria-live="polite"><MudIcon Icon="@Icons.Material.Filled.ContentCut" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_RetailParts", Unit?.Big_Unit ?? "", RetailParts)</div>
                }
                else
                {
                    <div class="ie-note ie-warn" role="alert"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_RetailNoParts")</div>
                }
            </div>
        }
    </section>
    }

    @* ===== المواصفات (سيارات / سيراميك / زجاج) ===== *@
    @if (Specs)
    {
    <section class="inv-card ie-gap" aria-labelledby="ie-specs">
        <h2 class="inv-card-title" id="ie-specs"><MudIcon Icon="@SpecIcon" />@Tr(EffectiveProfile == "cars" ? "IT_CarPart" : "IT_Specs")</h2>
        <div class="ie-grid">
            @if (EffectiveProfile == "cars")
            {
                <MudTextField T="string" @bind-Value="_f.Factory_Code" Label="@Tr("IT_FactoryCode")" Variant="Variant.Outlined" MaxLength="100" Style="direction:ltr"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Tag" />
                <MudSelect T="long" @bind-Value="_f.Car_Type_Id" Label="@Tr("IT_CarType")" Variant="Variant.Outlined" Clearable="true"
                           HelperText="@(_lk!.Car_Types.Count == 0 ? Tr("IT_NoCarTypes") : null)"
                           ToStringFunc="@(id => id == 0 ? string.Empty : _lk!.Car_Types.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty)">
                    @foreach (var c in _lk!.Car_Types) { <MudSelectItem T="long" Value="c.Id">@c.Name</MudSelectItem> }
                </MudSelect>
            }
            else if (EffectiveProfile == "ceramics")
            {
                @SpecSelect("types", "IT_SpecType", _f.Type_Id, v => _f.Type_Id = v)
                @SpecSelect("factories", "IT_SpecFactory", _f.Factory_Id, v => _f.Factory_Id = v)
                @SpecSelect("sizes", "IT_SpecSize", _f.Size_Id, v => _f.Size_Id = v)
                @SpecSelect("colors", "IT_SpecColor", _f.Color_Id, v => _f.Color_Id = v)
                @SpecSelect("degrees", "IT_SpecDegree", _f.Degree_Id, v => _f.Degree_Id = v)
                @SpecSelect("descriptions", "IT_SpecDesc", _f.Description_Id, v => _f.Description_Id = v)
                @SpecSelect("other-names", "IT_SpecOther", _f.Other_Description_Id, v => _f.Other_Description_Id = v)
            }
        </div>
        @if (EffectiveProfile != "cars")
        {
            <h3 class="inv-card-title ie-sub"><MudIcon Icon="@Icons.Material.Filled.Straighten" Size="Size.Small" />@Tr("IT_Dimensions")</h3>
            <div class="ie-grid">
                <MudNumericField T="decimal" @bind-Value="_f.Width" Label="@Tr("IT_Width")" Variant="Variant.Outlined" Min="0" Format="0.####" />
                <MudNumericField T="decimal" @bind-Value="_f.Height" Label="@Tr("IT_Height")" Variant="Variant.Outlined" Min="0" Format="0.####" />
                <div style="display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:8px">
                    <MudNumericField T="decimal" @bind-Value="_f.Thickness" Label="@Tr("IT_Thickness")" Variant="Variant.Outlined" Min="0" Format="0.####" />
                    <MudTextField T="string" @bind-Value="_f.Thickness_Unit" Label="@Tr("IT_ThicknessUnit")" Variant="Variant.Outlined" MaxLength="20" />
                </div>
            </div>
            @if (EffectiveProfile == "glass" && !string.IsNullOrWhiteSpace(GlassName))
            {
                <div class="ie-addstore">
                    <span class="ie-conv"><MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Small" Style="vertical-align:middle" /> @GlassName</span>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline"
                               Disabled="@string.IsNullOrWhiteSpace(GlassName)" OnClick="@(() => _f.Name = GlassName)">@Tr("IT_SuggestName")</MudButton>
                </div>
            }
        }
        @if (EffectiveProfile == "cars")
        {
            <div class="ie-row"><MudSwitch T="bool" @bind-Value="_f.Hide_On_Invoice" Color="Color.Primary" Label="@Tr("IT_HideOnInvoice")" /></div>
        }
        @if (EffectiveProfile != "glass")
        {
        <div class="ie-note">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_SpecsHelp")
            <MudLink Href="@(EffectiveProfile == "cars" && _lk!.Car_Types.Count == 0 ? "/cars/types" : "/items/lookups/types")" Class="ms-1">@Tr("IT_ManageLists")</MudLink>
        </div>
        }
    </section>
    }

    @* ===== النسيج: نوع الصنف حسب نوع المخزن ووصف المقاس ===== *@
    @if (EffectiveProfile == "textile")
    {
    <section class="inv-card ie-gap" aria-labelledby="ie-textile">
        <h2 class="inv-card-title" id="ie-textile"><MudIcon Icon="@Icons.Material.Filled.Texture" />@Tr("IT_Textile")</h2>
        <div class="ie-grid">
            <MudSelect T="int" Value="_f.Store_Used_Type" ValueChanged="OnTextileTypeChanged" Label="@Tr("IT_TextileType")" Variant="Variant.Outlined" Required="true"
                       Disabled="@(!_isNew && _locked)" HelperText="@(!_isNew && _locked ? Tr("IT_TextileLocked") : null)" ToStringFunc="@(t => Tr("IT_TT" + t))">
                @for (int t = 1; t <= 4; t++) { var k = t; <MudSelectItem T="int" Value="k">@Tr("IT_TT" + k)</MudSelectItem> }
            </MudSelect>
            <MudTextField T="string" @bind-Value="_f.Size_Description" Label="@Tr("IT_SizeDesc")" Variant="Variant.Outlined" MaxLength="1000" Class="span2"
                          HelperText="@Tr("IT_SizeDescHelp")" />
        </div>
        <div class="ie-note"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_TextileHelp")</div>
    </section>
    }

    @* ===== الفاتورة الإلكترونية ===== *@
    <section class="inv-card ie-gap" aria-labelledby="ie-einv">
        <h2 class="inv-card-title" id="ie-einv"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />@Tr("IT_EInvoice")
            @if (!_isNew) { <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(_taxUploaded ? Color.Success : Color.Default)" Class="ms-2">@Tr(_taxUploaded ? "IT_TaxUploaded" : "IT_TaxNotUploaded")</MudChip> }
        </h2>
        <div class="ie-grid">
            <MudSelect T="string" @bind-Value="_f.Tax_Code_Type" Label="@Tr("IT_TaxCodeType")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => string.IsNullOrEmpty(v) ? Tr("IT_TaxCodeNone") : v)">
                <MudSelectItem T="string" Value="@("")">@Tr("IT_TaxCodeNone")</MudSelectItem>
                <MudSelectItem T="string" Value="@("EGS")">EGS</MudSelectItem>
                <MudSelectItem T="string" Value="@("GS1")">GS1</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="_f.Tax_Item_Code" Label="@Tr("IT_TaxItemCode")" Variant="Variant.Outlined" MaxLength="100" Class="span2"
                          HelperText="@Tr("IT_TaxItemCodeHelp")" Disabled="@string.IsNullOrEmpty(_f.Tax_Code_Type)" Style="direction:ltr" />
            <MudTextField T="string" @bind-Value="_f.Tax_Unit_Code" Label="@Tr("IT_TaxUnitCode")" Variant="Variant.Outlined" MaxLength="10" HelperText="@Tr("IT_TaxUnitHelp")" Style="direction:ltr" />
            <MudTextField T="string" @bind-Value="_f.Country_Of_Origin" Label="@Tr("IT_Country")" Variant="Variant.Outlined" MaxLength="2" HelperText="@Tr("IT_CountryHelp")" Style="direction:ltr" />
        </div>
        <div class="ie-note"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_EInvoiceNote")</div>
    </section>

    @* ===== المخازن والرصيد ===== *@
    <section class="inv-card ie-gap" aria-labelledby="ie-stock">
        <h2 class="inv-card-title" id="ie-stock"><MudIcon Icon="@Icons.Material.Filled.Warehouse" />@Tr("IT_StoresBalance")</h2>
        @if (_isNew)
        {
            <div class="ie-grid">
                <MudSelect T="long" @bind-Value="_f.Store_Id" Label="@Tr("IT_MainStore")" Variant="Variant.Outlined" Required="true"
                           HelperText="@(FormStores.Count == 0 ? Tr("IT_NoStoreOfType") : _lk!.All_Stores ? Tr("IT_AllStoresNote") : null)" Error="@(FormStores.Count == 0)"
                           ToStringFunc="@(id => _lk!.Stores.FirstOrDefault(s => s.Id == id)?.Name ?? string.Empty)">
                    @foreach (var s in FormStores) { <MudSelectItem T="long" Value="s.Id">@s.Name</MudSelectItem> }
                </MudSelect>
            </div>
            @if (!_f.Without_Balance && _f.Item_Or_Service != 2)
            {
                <h3 class="inv-card-title ie-gap" style="font-size:1rem"><MudIcon Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Small" />@Tr("IT_Opening")</h3>
                <div class="ie-grid">
                    <MudNumericField T="decimal" @bind-Value="_f.Opening_Large" Label="@Tr("IT_QtyIn", Unit?.Big_Unit ?? Tr("IU_Big"))" Variant="Variant.Outlined" Min="0" />
                    <MudNumericField T="decimal" @bind-Value="_f.Opening_Small" Label="@Tr("IT_QtyIn", Unit?.Small_Unit ?? Tr("IU_Small"))" Variant="Variant.Outlined" Min="0" Disabled="@(Factor == 1)" />
                    <MudNumericField T="decimal" @bind-Value="_f.Opening_Cost_Large" Label="@Tr("IT_CostPer", Unit?.Big_Unit ?? Tr("IU_Big"))" Variant="Variant.Outlined" Min="0" Format="0.####" />
                </div>
                <div class="ie-note">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Style="vertical-align:middle" />
                    @(string.IsNullOrEmpty(_lk!.Period_Name) ? Tr("IT_NoPeriod") : Tr("IT_OpeningNote", _lk!.Period_Name))
                    @if (_f.Opening_Large > 0 || _f.Opening_Small > 0) { <strong> — @Tr("IT_OpeningValue", Money(OpeningValue))</strong> }
                </div>
            }
        }
        else
        {
            <MudTable Items="@_stores" T="StoreLine" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Dense="true">
                <HeaderContent>
                    <MudTh>@Tr("IT_Store")</MudTh>
                    <MudTh Style="text-align:end">@Tr("IT_Balance")</MudTh>
                    <MudTh Style="text-align:end">@Tr("IT_AvgCost")</MudTh>
                    <MudTh Style="text-align:end">@Tr("IT_Movements")</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Tr("IT_Store")">@context.Store_Name</MudTd>
                    <MudTd DataLabel="@Tr("IT_Balance")" Style="text-align:end">
                        @if (_f.Without_Balance) { <span>—</span> }
                        else { <span class="ie-num @(context.Full_Qua < 0 || context.D_Qua < 0 ? "ie-neg" : "")">@Num(context.Full_Qua) @Unit?.Big_Unit @if (context.D_Qua != 0) { <text> + @Num(context.D_Qua) @Unit?.Small_Unit</text> }</span> }
                    </MudTd>
                    <MudTd DataLabel="@Tr("IT_AvgCost")" Style="text-align:end"><span class="ie-num">@Money(context.Avg_Cost)</span></MudTd>
                    <MudTd DataLabel="@Tr("IT_Movements")" Style="text-align:end"><span class="ie-num">@context.Movements</span></MudTd>
                    <MudTd Style="white-space:nowrap">
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ReceiptLong" Href="@($"/store/item-card?line={context.Unit_Item_Id}")">@Tr("IT_ItemCard")</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <div class="ie-note"><MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="vertical-align:middle" /> @Tr("IT_BalanceReadOnly")</div>
            @if (Pharm || _batches.Count > 0)
            {
                <h3 class="inv-card-title ie-sub"><MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Small" />@Tr("IT_Batches")<span class="inv-count">@_batches.Count</span></h3>
                @if (_batches.Count == 0)
                {
                    <div class="ie-note">@Tr("IT_NoBatches") @if (!_lk!.Expiry_Tracked) { <span>@Tr("IT_ExpiryOff")</span> }</div>
                }
                else
                {
                    <MudTable Items="@_batches" T="BatchRow" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Dense="true">
                        <HeaderContent>
                            <MudTh>@Tr("IT_Store")</MudTh>
                            <MudTh>@Tr("IT_Batch")</MudTh>
                            <MudTh>@Tr("IT_Expiry")</MudTh>
                            <MudTh Style="text-align:end">@Tr("IT_Qty")</MudTh>
                            <MudTh>@Tr("IT_Status")</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="@Tr("IT_Store")">@context.Store_Name</MudTd>
                            <MudTd DataLabel="@Tr("IT_Batch")"><span class="ie-num">@(string.IsNullOrEmpty(context.Batch) ? "—" : context.Batch)</span></MudTd>
                            <MudTd DataLabel="@Tr("IT_Expiry")"><span class="ie-num">@(context.Expire_Date?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "—")</span></MudTd>
                            <MudTd DataLabel="@Tr("IT_Qty")" Style="text-align:end"><span class="ie-num">@Num(context.Qty_Large) @Unit?.Big_Unit @if (context.Qty_Small != 0) { <text> + @Num(context.Qty_Small) @Unit?.Small_Unit</text> }</span></MudTd>
                            <MudTd DataLabel="@Tr("IT_Status")">
                                @{ var (key, color) = ExpiryState(context.Expire_Date); }
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="color">@Tr(key)</MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                <div class="ie-note">@Tr("IT_BatchesNote")</div>
            }
            @if (AvailableStores.Count > 0)
            {
                <div class="ie-addstore">
                    <MudSelect T="long" @bind-Value="_addStoreId" Label="@Tr("IT_AddToStore")" Variant="Variant.Outlined" Margin="Margin.Dense"
                               ToStringFunc="@(id => _lk!.Stores.FirstOrDefault(s => s.Id == id)?.Name ?? string.Empty)">
                        @foreach (var s in AvailableStores) { <MudSelectItem T="long" Value="s.Id">@s.Name</MudSelectItem> }
                    </MudSelect>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" Disabled="@(_busy || _addStoreId == 0)" OnClick="AddToStoreAsync">@Tr("IT_AddStoreButton")</MudButton>
                </div>
            }
        }
    </section>
    }
</div>
</MudContainer>

@code {
    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? KindQuery { get; set; }
    /// <summary>نوع صنف النسيج من القائمة (?type=1..4).</summary>
    [SupplyParameterFromQuery(Name = "type")] public int? TypeQuery { get; set; }
    [Parameter] public string? Profile { get; set; }

    private readonly ItemEditorService _svc = new();
    private Lookups? _lk;
    private ItemForm _f = new();
    private List<StoreLine> _stores = new();
    private List<BatchRow> _batches = new();
    private bool _isNew = true, _locked, _loading = true, _busy, _taxUploaded;
    private string _routeProfile = "";
    private long _addStoreId;
    private string? _error;

    private UnitOption? Unit => _lk?.Units.FirstOrDefault(u => u.Id == _f.Unit_Id);
    private decimal Factor => Unit?.Factor is > 0 and var f ? f : 1;
    private decimal OpeningValue => (_f.Opening_Large + (Factor > 0 ? _f.Opening_Small / Factor : 0)) * _f.Opening_Cost_Large;
    private List<Option> AvailableStores => _lk?.Stores.Where(s => _stores.All(x => x.Store_Id != s.Id)).ToList() ?? new();

    /// <summary>الملف الفعلى: الثابت من المسار، وإلا من فئة الصنف المختارة (يتغير فوراً مع تغيير الفئة).</summary>
    private string EffectiveProfile => _routeProfile.Length > 0 && _f.Item_Or_Service != 2 ? _routeProfile
        : ResolveProfile(_lk?.Categories.FirstOrDefault(c => c.Id == _f.Category_Id)?.Profile, _f.Item_Or_Service);
    private bool Pharm => IsPharmacy(EffectiveProfile);
    /// <summary>مخازن الصنف الجديد: لصنف النسيج المخازن من نفس نوعه فقط (كالديسك توب Store_DataByStoreUsed_Type)، وإلا كل المخازن.</summary>
    private List<Option> FormStores => EffectiveProfile == "textile"
        ? _lk!.Stores.Where(s => _lk.Store_Types.GetValueOrDefault(s.Id, 1) == _f.Store_Used_Type).ToList() : _lk!.Stores;
    private bool Specs => EffectiveProfile is "cars" or "ceramics" or "glass";
    /// <summary>بيانات القوائم المرجعية (/items/lookups: المجموعة والطبيعة والمواصفات) لأصناف السيراميك فقط؛ القيم المحفوظة لغيرها تبقى كما هى عند الحفظ.</summary>
    private bool Lookups => EffectiveProfile == "ceramics";
    private string SpecIcon => EffectiveProfile switch { "cars" => Icons.Material.Filled.CarRepair, "glass" => Icons.Material.Filled.Window, _ => Icons.Material.Filled.GridOn };
    private string GlassName => SuggestGlassName(_f.Thickness, _f.Thickness_Unit, SpecName("types", _f.Type_Id), _f.Width, _f.Height);
    private string SpecName(string kind, long id) => id == 0 ? "" : _lk?.Specs.GetValueOrDefault(kind)?.FirstOrDefault(o => o.Id == id)?.Name ?? "";

    /// <summary>قائمة مواصفة من جدول مرجعى (فارغ = بدون).</summary>
    private RenderFragment SpecSelect(string kind, string labelKey, long value, Action<long> set) =>
        @<MudSelect T="long" Value="value" ValueChanged="@((long v) => set(v))" Label="@Tr(labelKey)" Variant="Variant.Outlined" Clearable="true"
                    ToStringFunc="@(id => SpecName(kind, id))">
            @foreach (var o in _lk!.Specs.GetValueOrDefault(kind) ?? new()) { <MudSelectItem T="long" Value="o.Id">@o.Name</MudSelectItem> }
        </MudSelect>;
    private string NewTitleKey => _f.Item_Or_Service == 2 ? "IT_NewService" : Pharm ? "IT_NewMedicine" : EffectiveProfile == "cars" ? "IT_NewCarPart" : "IT_NewItem";
    private int RetailParts => Unit?.Retail_Parts ?? 1;
    private decimal SuggestedRetail => RetailParts > 1 ? Math.Round(_f.Sale_Price_Large / RetailParts, 4) : 0;
    private string Prefix => _routeProfile.Length > 0 ? $"/items/p/{_routeProfile}" : "/items";
    private string ListHref => _routeProfile.Length > 0 ? Prefix : $"/items{(_f.Item_Or_Service == 2 ? "?kind=services" : "")}";

    private static string ProfileKey(string p) => p switch { "pharmacy" or "pharmacy-retail" => "IC_ProfilePharmacy", "services" => "IC_Services",
        "cars" => "IC_ProfileCars", "ceramics" => "IC_ProfileCeramics", "glass" => "IC_ProfileGlass", "textile" => "IC_ProfileTextile", _ => "IC_ProfileGeneral" };

    private static (string, Color) ExpiryState(DateTime? d)
    {
        if (d == null) return ("IT_NoExpiry", Color.Default);
        double days = (d.Value.Date - DateTime.Today).TotalDays;
        return days < 0 ? ("IT_Expired", Color.Error) : days <= 90 ? ("IT_NearExpiry", Color.Warning) : ("IT_ValidExpiry", Color.Success);
    }

    protected override void OnInitialized() => LangService.OnLanguageChanged += OnLanguageChangedHandler;
    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _error = null;
        string rp = (Profile ?? "").Trim().ToLowerInvariant();
        _routeProfile = RouteProfiles.Contains(rp) ? rp : "";
        try
        {
            _lk ??= await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetLookups(); });
            if (Id is long id and > 0)
            {
                var d = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Get(id); });
                _f = d.Form; _stores = d.Stores; _batches = d.Batches; _taxUploaded = d.Tax_Uploaded; _locked = d.Unit_Locked; _isNew = false;
            }
            else NewForm(_routeProfile == "services" || KindQuery == "services" ? 2 : 1);
        }
        catch (Exception ex) { _error = Inner(ex); }
        finally { _loading = false; }
    }

    private void NewForm(int kind)
    {
        _isNew = true; _locked = false; _stores = new(); _batches = new(); _taxUploaded = false;
        _f = new ItemForm
        {
            Item_Or_Service = kind, Without_Balance = kind == 2,
            Unit_Id = _lk!.Units.FirstOrDefault(u => u.Is_Default)?.Id ?? _lk.Units.FirstOrDefault()?.Id ?? 0,
            Category_Id = kind == 2 && _lk.Default_Category_Service != 0 ? _lk.Default_Category_Service : _lk.Default_Category_Item,
            Store_Id = _lk.Default_Store_Id,
            Is_Retail = _routeProfile == "pharmacy-retail",
        };
        // ملف أدوية ثابت: الفئة الافتراضية الأولى ذات ملف أدوية إن وُجدت
        string catProfile = IsPharmacy(_routeProfile) ? "pharmacy" : _routeProfile;
        if (catProfile is "pharmacy" or "cars" or "ceramics" or "glass" or "textile" && _lk.Categories.FirstOrDefault(c => c.Profile == catProfile) is { } pc) _f.Category_Id = pc.Id;
        // لا فئة افتراضية: أول فئة من نفس النوع (أصناف/خدمات)، كالإضافة السريعة
        if (_f.Category_Id == 0) _f.Category_Id = _lk.Categories.FirstOrDefault(c => kind == 2 ? c.Item_Or_Service != 1 : c.Item_Or_Service != 2)?.Id ?? 0;
        if (_routeProfile == "glass") _f.Thickness_Unit = "مم";
        if (_routeProfile == "textile") OnTextileTypeChanged(TypeQuery is >= 1 and <= 4 ? TypeQuery.Value : 1);
    }

    /// <summary>تغيير نوع صنف النسيج يعيد اختيار المخزن الرئيسى من مخازن نفس النوع.</summary>
    private void OnTextileTypeChanged(int t)
    {
        _f.Store_Used_Type = t;
        if (_isNew && FormStores.All(s => s.Id != _f.Store_Id)) _f.Store_Id = FormStores.FirstOrDefault()?.Id ?? 0;
    }

    private void OnRetailChanged(bool v)
    {
        _f.Is_Retail = v;
        if (v && _f.Retail_Price == 0) _f.Retail_Price = SuggestedRetail;
    }

    private void OnKindChanged(int k)
    {
        _f.Item_Or_Service = k;
        if (k == 2) { _f.Without_Balance = true; _f.Opening_Large = _f.Opening_Small = 0; }
        else if (_isNew) _f.Without_Balance = false;
        if (_isNew)
        {
            long def = k == 2 ? _lk!.Default_Category_Service : _lk!.Default_Category_Item;
            if (def != 0) _f.Category_Id = def;
        }
    }

    private void OnUnitChanged(long id)
    {
        _f.Unit_Id = id;
        _f.Sale_Price_Small = Math.Round(_f.Sale_Price_Large / Factor, 4);
        _f.Purchase_Price_Small = Math.Round(_f.Purchase_Price_Large / Factor, 4);
        if (Factor == 1) _f.Opening_Small = 0;
    }

    /// <summary>سعر الصغرى المقترح = الكبرى ÷ المعامل، ما لم يكن المستخدم غيّره يدوياً عن الاقتراح السابق.</summary>
    private decimal Suggest(decimal currentSmall, decimal oldLarge, decimal newLarge)
    {
        decimal oldSuggestion = Math.Round(oldLarge / Factor, 4);
        return currentSmall == 0 || currentSmall == oldSuggestion ? Math.Round(newLarge / Factor, 4) : currentSmall;
    }

    private async Task SaveAsync(bool andNew)
    {
        _busy = true; _error = null;
        var f = _f; bool isNew = _isNew;
        try
        {
            long id = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Save(f); });
            Snackbar.Add(isNew ? Tr("IT_Added") : Tr("IU_Saved"), Severity.Success);
            if (isNew && andNew) { NewForm(f.Item_Or_Service); }
            else if (isNew)
            {
                // تبويب «صنف جديد» يبقى حياً (KeepPanelsAlive) ببياناته؛ نغلقه حتى لا يُحفظ نفس الصنف مرتين منه (كالفواتير)
                var oldRelative = Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"{Prefix}/{id}", replace: true);
                CloseStaleNewTab(oldRelative);
            }
            else
            {
                var d = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Get(id); });
                _f = d.Form; _stores = d.Stores; _batches = d.Batches; _taxUploaded = d.Tax_Uploaded; _locked = d.Unit_Locked;
            }
        }
        catch (Exception ex) { _error = Inner(ex); }
        finally { _busy = false; }
    }

    private void CloseStaleNewTab(string relativeWithQuery)
    {
        var parts = relativeWithQuery.Split('?', 2);
        var key = "/" + parts[0].Trim('/');
        TabWorkspace.Close(key);
        if (parts.Length > 1 && parts[1].Length > 0) TabWorkspace.Close(key + "?" + parts[1]);
    }

    private async Task AddToStoreAsync()
    {
        _busy = true; _error = null;
        long itemId = _f.Id, storeId = _addStoreId;
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.AddToStore(itemId, storeId); });
            var d = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.Get(itemId); });
            _stores = d.Stores; _addStoreId = 0;
            Snackbar.Add(Tr("IT_StoreAdded"), Severity.Success);
        }
        catch (Exception ex) { _error = Inner(ex); }
        finally { _busy = false; }
    }

    private static string Num(decimal v) => v.ToString("#,0.####", CultureInfo.InvariantCulture);
    private static string Money(decimal v) => v.ToString("#,0.00", CultureInfo.InvariantCulture);
    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try { CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo; return Lang[key, args]; }
        finally { CultureInfo.CurrentUICulture = previousCulture; }
    }
}
