@* تعديل أسعار مبيعات الأصناف (بدل Edit_Prices_List_Values — عنصر القائمة menuItemEditPrices). ثلاثة تبويبات كالشاشة القديمة:
   1) tabPage1 / BtnEditValue: تعديل سعر البيع (وخصم البيع) للأصناف المحددة فى نوع سعر ± نسبة أو قيمة.
   2) tabPage2 / BtnEditByType: نوع سعر = نوع سعر آخر ± نسبة أو قيمة لكل أصناف المصدر (بلا عرض أصناف).
      قائمة «المطلوب تعديله» تحمل كل الأنواع كالديسك توب؛ النوع المشتق يحتاج تأكيد «تعديل القائمة المشتقة».
   3) tabPage3 / BtnEditByType_Item: فلاتر البحث فئة الصنف ونوع السعر (= المصدر) فقط، وأسفل الجدول نفس خانات التبويب 2؛ يطبَّق على المحدد فقط.
      قائمة «المطلوب تعديله» تحمل كل الأنواع متاحة (لا يُعطَّل أى نوع، ولا حتى المصدر نفسه = تعديله بنفسه ± التعديل).
   القواعد فى PriceListService (EditSellValues / CopySellValues): التقريب بخطوة يختارها المستخدم، المشتقة يُعاد حسابها، الصلاحية 917.
   عمود «السعر الجديد» يُحسب بنفس دالة الخادم (PriceListService.Adjust). التصميم حسب ui-ux-pro-max ونظام inv-*.
   التبويبان 1 و3: الفلاتر لا تبحث تلقائياً (زر «بحث» أو Enter)، وخيار «عرض الأصناف بدون سعر أيضاً» يعرضها للاطلاع فقط (لا تُحدَّد ولا تُعدَّل).
   قائمة نوع السعر تعرض تحت الاسم «عدد الأصناف التى لها سعر» بدل الرقم المجرد. *@
@page "/items/sales-prices/edit"
@page "/items/sales-prices/edit/{Tab:int}"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.PriceListService
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@Tr("EPV_Title")</PageTitle>

<InvoiceStyles />

<style>
    .epv-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
    .epv-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                     background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .epv-head .ico .mud-icon-root { font-size: 2rem; }
    .epv-head .titles { flex: 1 1 260px; min-width: 0; }
    .epv-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .epv-head .acts { display: flex; flex-wrap: wrap; gap: 8px; }
    .epv-head .acts .mud-button-root { min-height: 44px; }
    .epv-gap { margin-top: 16px; }
    .epv-filters { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.1fr) minmax(0, 1.8fr) auto; gap: 12px; align-items: center; }
    .epv-filters.no-type { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.8fr) auto; }
    .epv-filters.basic { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto; }
    .epv-filters .go { min-height: 56px; min-width: 120px; }
    .epv-pair { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 12px; align-items: start; }
    .epv-pair .eq { font-size: 1.75rem; font-weight: 700; line-height: 56px; color: var(--mud-palette-primary); text-align: center; min-width: 24px; }
    .epv-opts { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin-top: 4px; }
    .epv-opts .help { font-size: .8rem; color: var(--mud-palette-text-secondary); }
    .epv-dirty { display: inline-flex; align-items: center; gap: 6px; font-size: .85rem; color: var(--mud-palette-warning-darken); }
    .epv-unpriced { background: color-mix(in srgb, var(--mud-palette-warning) 6%, transparent); }
    .epv-titem { display: flex; flex-direction: column; min-width: 0; line-height: 1.3; }
    .epv-titem .meta { font-size: .78rem; color: var(--mud-palette-text-secondary); }
    .epv-adj { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px 14px; align-items: start; }
    .epv-adj .full { grid-column: 1 / -1; }
    .epv-adj .half { grid-column: span 2; }
    .epv-step { display: flex; align-items: center; gap: 8px; margin: 0 0 10px; font-weight: 600; font-size: .95rem; }
    .epv-step .n { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: .8rem;
                   background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); }
    .epv-sum { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 24px; margin-top: 12px; padding: 10px 16px; border-radius: 10px;
               background: color-mix(in srgb, var(--mud-palette-primary) 8%, transparent); font-size: .9rem; }
    .epv-sum b { font-variant-numeric: tabular-nums; }
    .epv-sum .grow { flex: 1 1 auto; }
    .epv-sum .mud-button-root { min-height: 44px; }
    .epv-formula { padding: 10px 14px; border-radius: 10px; border: 1px dashed var(--mud-palette-lines-default); font-size: .9rem; }
    .epv-formula b { color: var(--mud-palette-primary); }
    .epv-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .epv-code { font-family: ui-monospace, Consolas, monospace; font-size: .8rem; color: var(--mud-palette-text-secondary); }
    .epv-muted { color: var(--mud-palette-text-secondary); font-size: .8rem; }
    .epv-up { color: var(--mud-palette-success-darken); font-weight: 600; }
    .epv-down { color: var(--mud-palette-error); font-weight: 600; }
    .epv-bad { color: var(--mud-palette-error); font-weight: 700; }
    .epv-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 32px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    @@media (max-width: 899px) { .epv-filters, .epv-adj { grid-template-columns: repeat(2, minmax(0, 1fr)); } .epv-filters .wide, .epv-filters .go { grid-column: 1 / -1; } }
    @@media (max-width: 599px) { .epv-filters, .epv-filters.no-type, .epv-filters.basic, .epv-adj, .epv-pair { grid-template-columns: minmax(0, 1fr); } .epv-adj .half { grid-column: 1 / -1; } .epv-pair .eq { line-height: 1; } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">
    <div class="inv-card">
        <div class="epv-head">
            <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.PriceChange" /></div>
            <div class="titles">
                <h1 class="inv-title">@Tr("EPV_Title")</h1>
                <div class="sub">@Tr("EPV_Sub")</div>
            </div>
            <div class="acts">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sell" Href="/items/sales-prices">@Tr("SPV_Title")</MudButton>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Warning" Class="epv-gap" role="alert" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert> }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4" Class="epv-gap"
             ActivePanelIndex="_tab" ActivePanelIndexChanged="@((int i) => _tab = i)">

        @* ======================= التبويب 1: تعديل الأصناف المحددة فى نوع سعر ======================= *@
        <MudTabPanel Text="@Tr("EPV_Tab1")" Icon="@Icons.Material.Filled.Checklist">
            <section class="inv-card" aria-labelledby="epv-t1-h">
                <h2 class="epv-step" id="epv-t1-h"><span class="n">1</span>@Tr("EPV_PickItems")</h2>
                @FilterBar(_t1, "SPV_PriceType", Search1Async)
                @if (!_t1.Searched)
                {
                    <div class="epv-empty"><MudIcon Icon="@(_t1.Type == 0 ? Icons.Material.Filled.TouchApp : Icons.Material.Filled.ManageSearch)" Size="Size.Large" />
                        <span>@Tr(_t1.Type == 0 ? "EPV_PickTypeFirst" : "SPV_SearchHint")</span></div>
                }
                else
                {
                    @PricesTable(_t1, _a1, null)
                }
            </section>

            <section class="inv-card epv-gap" aria-labelledby="epv-t1-a">
                <h2 class="epv-step" id="epv-t1-a"><span class="n">2</span>@Tr("EPV_HowToChange")</h2>
                @AdjPanel(_a1, true)
                @if (Type(_t1.AType) is { Master_Id: > 0 } dt1)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Tr("SPV_DerivedWarn", dt1.Master_Name ?? "")</MudAlert>
                    <MudSwitch T="bool" @bind-Value="_allowDerived" Color="Color.Warning" Label="@Tr("EPV_AllowDerived")" />
                }
                <div class="epv-sum" aria-live="polite">
                    <span>@Tr("EPV_Selected") <b>@_t1.SelN</b> / <b>@_t1.Rows.Count</b></span>
                    @if (Children(_t1.AType) > 0) { <span class="epv-muted">@Tr("SPV_CascadeNote", Children(_t1.AType))</span> }
                    <span class="grow"></span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt"
                               Disabled="@(_busy || _t1.SelN == 0 || (Type(_t1.AType)?.Master_Id > 0 && !_allowDerived))" OnClick="ApplyEditAsync">
                        @if (_busy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
                        @Tr("EPV_ApplyN", _t1.SelN)
                    </MudButton>
                </div>
            </section>
        </MudTabPanel>

        @* ======================= التبويب 2: نوع = نوع آخر (كل الأصناف) ======================= *@
        <MudTabPanel Text="@Tr("EPV_Tab2")" Icon="@Icons.Material.Filled.ContentCopy">
            <section class="inv-card" aria-labelledby="epv-t2-h">
                <h2 class="epv-step" id="epv-t2-h"><span class="n">1</span>@Tr("EPV_Types")</h2>
                <div class="epv-pair">
                    <MudSelect T="long" Value="_t2Target" ValueChanged="@(async (long v) => { _t2Target = v; _allowDer2 = false; if (_t2Source == v) { _t2Source = 0; await Count2Async(); } })" Label="@Tr("EPV_Target")" Variant="Variant.Outlined"
                               Required="true" ToStringFunc="@TypeName" HelperText="@Tr("EPV_TargetHelp")">
                        @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                    </MudSelect>
                    <span class="eq" aria-hidden="true">=</span>
                    <MudSelect T="long" Value="_t2Source" ValueChanged="@(async (long v) => { _t2Source = v; if (_t2Target == v) _t2Target = 0; await Count2Async(); })" Label="@Tr("EPV_SourceType")" Variant="Variant.Outlined"
                               Required="true" ToStringFunc="@TypeName">
                        @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                    </MudSelect>
                </div>
                @DerivedTarget(_t2Target, _allowDer2, v => _allowDer2 = v)
            </section>
            <section class="inv-card epv-gap" aria-labelledby="epv-t2-a">
                <h2 class="epv-step" id="epv-t2-a"><span class="n">2</span>@Tr("EPV_HowToChange")</h2>
                @AdjPanel(_a2, false)
                <div class="epv-formula mt-3">@((MarkupString)Formula(_t2Target, _t2Source, _a2))</div>
                <div class="epv-sum" aria-live="polite">
                    <span>@Tr("EPV_SourceCount") <b>@_t2Count</b></span>
                    @if (Children(_t2Target) > 0) { <span class="epv-muted">@Tr("SPV_CascadeNote", Children(_t2Target))</span> }
                    <span class="grow"></span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt"
                               Disabled="@(_busy || _t2Target == 0 || _t2Source == 0 || _t2Target == _t2Source || _t2Count == 0 || (IsDerived(_t2Target) && !_allowDer2))" OnClick="ApplyCopyAllAsync">
                        @if (_busy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
                        @Tr("EPV_ApplyN", _t2Count)
                    </MudButton>
                </div>
            </section>
        </MudTabPanel>

        @* ======================= التبويب 3: نوع = نوع آخر (أصناف محددة) ======================= *@
        <MudTabPanel Text="@Tr("EPV_Tab3")" Icon="@Icons.Material.Filled.FactCheck">
            <section class="inv-card" aria-labelledby="epv-t3-h">
                <h2 class="epv-step" id="epv-t3-h"><span class="n">1</span>@Tr("EPV_PickItems")</h2>
                @* فلاتر البحث كالديسك توب (itemCategory1_11 + price_Type_List1_11): فئة الصنف ونوع السعر فقط — نوع الفلتر هو المصدر *@
                @FilterBar(_t3, "SPV_PriceType", Search3Async, basic: true)
                @if (!_t3.Searched)
                {
                    <div class="epv-empty"><MudIcon Icon="@(_t3.Type == 0 ? Icons.Material.Filled.TouchApp : Icons.Material.Filled.ManageSearch)" Size="Size.Large" />
                        <span>@Tr(_t3.Type == 0 ? "EPV_PickSourceFirst" : "SPV_SearchHint")</span></div>
                }
                else
                {
                    @PricesTable(_t3, _a3, _t3Target)
                }
            </section>
            @* أسفل الجدول نفس خانات تبويب «كل الأصناف» (groupBox4 فى الديسك توب): المطلوب = المصدر ± التعديل *@
            <section class="inv-card epv-gap" aria-labelledby="epv-t3-t">
                <h2 class="epv-step" id="epv-t3-t"><span class="n">2</span>@Tr("EPV_Types")</h2>
                <div class="epv-pair">
                    <MudSelect T="long" Value="_t3Target" ValueChanged="@(async (long v) => { _t3Target = v; _allowDer3 = false; await LoadTargetAsync(); })" Label="@Tr("EPV_Target")" Variant="Variant.Outlined"
                               Required="true" ToStringFunc="@TypeName" HelperText="@Tr("EPV_TargetHelp")">
                        @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                    </MudSelect>
                    <span class="eq" aria-hidden="true">=</span>
                    @* المصدر هو نوع الجدول المعروض: تغييره هنا يغيّر فلتر نوع السعر ويعيد البحث حتى تتطابق المعاينة مع التنفيذ *@
                    <MudSelect T="long" Value="_t3.AType" ValueChanged="@(async (long v) => { _t3.Type = v; await Search3Async(); })" Label="@Tr("EPV_SourceType")" Variant="Variant.Outlined"
                               Required="true" ToStringFunc="@TypeName">
                        @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                    </MudSelect>
                </div>
                @DerivedTarget(_t3Target, _allowDer3, v => _allowDer3 = v)
            </section>
            <section class="inv-card epv-gap" aria-labelledby="epv-t3-a">
                <h2 class="epv-step" id="epv-t3-a"><span class="n">3</span>@Tr("EPV_HowToChange")</h2>
                @AdjPanel(_a3, false)
                <div class="epv-formula mt-3">@((MarkupString)Formula(_t3Target, _t3.AType, _a3))</div>
                <div class="epv-sum" aria-live="polite">
                    <span>@Tr("EPV_Selected") <b>@_t3.SelN</b> / <b>@_t3.Rows.Count</b></span>
                    <span class="epv-muted">@Tr("EPV_OthersUntouched")</span>
                    <span class="grow"></span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Bolt"
                               Disabled="@(_busy || _t3Target == 0 || _t3.AType == 0 || _t3.SelN == 0 || (IsDerived(_t3Target) && !_allowDer3))" OnClick="ApplyCopySelAsync">
                        @if (_busy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
                        @Tr("EPV_ApplyN", _t3.SelN)
                    </MudButton>
                </div>
            </section>
        </MudTabPanel>
    </MudTabs>
</div>
</MudContainer>

@code {
    private const int Top = 2000;

    private sealed record Filters(long Type, long Cat, string Text, bool Unpriced);

    /// <summary>حالة جدول أصناف (التبويب 1 أو 3). الفلاتر لا تبحث تلقائياً: زر «بحث» يثبّتها فى Applied،
    /// والتنفيذ يستخدم نوع السعر المطبَّق (AType) لا المختار حالياً — حتى لا تُعدَّل أصناف نوع بقائمة نوع آخر.</summary>
    private sealed class Grid
    {
        public long Type, Cat;
        public string? Text;
        public bool Unpriced, Loading, Searched;
        public Filters Applied = new(0, 0, "", false);
        public Filters Current => new(Type, Cat, (Text ?? "").Trim(), Unpriced);
        public bool Dirty => Searched && Current != Applied;
        public long AType => Searched ? Applied.Type : 0;
        public List<SellValue> Rows = new();
        public HashSet<SellValue> Sel = new();
        /// <summary>المحدد الفعلى: الأصناف التى لها سعر فقط (الصفوف بلا سعر معطَّلة، وقد يضمها «تحديد الكل» فى رأس الجدول).</summary>
        public int SelN => Sel.Count(r => r.Has_Price);
    }

    /// <summary>طريقة التعديل: ± نسبة/قيمة، التقريب، والخصم (null = بدون تغيير).</summary>
    private sealed class Adj
    {
        public bool IsPlus = true, IsRate = true, SetDiscount;
        public decimal Value, Discount;
        public decimal Rounding = 0.01m;
        public decimal? DiscountOrNull => SetDiscount ? Discount : null;
    }

    [Parameter] public int? Tab { get; set; }

    private readonly PriceListService _svc = new();
    private List<PriceType> _types = new();
    private List<CategoryPick> _cats = new();
    private readonly Grid _t1 = new(), _t3 = new();
    private readonly Adj _a1 = new(), _a2 = new() { Value = 0 }, _a3 = new();
    private long _t2Target, _t2Source, _t3Target;
    private int _t2Count, _tab;
    private Dictionary<long, decimal> _t3TargetPrices = new();
    private bool _busy, _allowDerived, _allowDer2, _allowDer3;
    private string? _error;

    protected override void OnInitialized() => LangService.OnLanguageChanged += OnLanguageChangedHandler;
    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    protected override void OnParametersSet() { if (Tab is int t && t >= 1 && t <= 3) _tab = t - 1; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _types = await Bg(() => _svc.ListTypes());
            _cats = await Bg(() => _svc.ListCategories(1));
        }
        catch (Exception ex) { _error = Inner(ex); }
    }

    private Task<T> Bg<T>(Func<T> f) => Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return f(); });

    // ---------- العرض ----------

    /// <summary>عنصر نوع السعر فى القائمة: الاسم، وتحته عدد الأصناف التى لها سعر فيه (بدل الرقم المجرد القديم).</summary>
    private RenderFragment TypeItem(PriceType t) => __builder =>
    {
        <div class="epv-titem">
            <span>@t.Name@(t.Is_Active ? "" : $" ({Tr("SPV_Inactive")})")@(t.Master_Id > 0 ? $" · {Tr("SPV_Derived")}" : "")</span>
            <span class="meta">@Tr("EPV_PricedCount", t.Priced_Items)</span>
        </div>
    };

    /// <summary>فلاتر الجدول: نوع السعر (typeKey = null: يُختار خارجها)، الفئة، مربع البحث (Enter يبحث)، زر «بحث»، وخيار الأصناف بدون سعر.
    /// basic (التبويب 3): فئة الصنف ثم نوع السعر فقط + زر «بحث».</summary>
    private RenderFragment FilterBar(Grid g, string? typeKey, Func<Task> search, bool basic = false) => __builder =>
    {
        <div class="epv-filters@(basic ? " basic" : typeKey == null ? " no-type" : "")">
            @if (basic)
            {
                <MudSelect T="long" @bind-Value="g.Cat" Label="@Tr("SPV_Category")" Variant="Variant.Outlined" ToStringFunc="@CatName">
                    <MudSelectItem T="long" Value="0L">@Tr("IC_AllCats")</MudSelectItem>
                    @foreach (var c in _cats) { <MudSelectItem T="long" Value="c.Id">@CatLabel(c)</MudSelectItem> }
                </MudSelect>
                <MudSelect T="long" @bind-Value="g.Type" Label="@Tr(typeKey ?? "SPV_PriceType")" Variant="Variant.Outlined" Required="true" ToStringFunc="@TypeName">
                    @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                </MudSelect>
                <MudButton Class="go" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                           Disabled="@(g.Loading || g.Type == 0)" OnClick="search">
                    @if (g.Loading) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
                    @Tr("SPV_Search")
                </MudButton>
            }
            else
            {
            @if (typeKey != null)
            {
                <MudSelect T="long" @bind-Value="g.Type" Label="@Tr(typeKey)" Variant="Variant.Outlined" Required="true" ToStringFunc="@TypeName">
                    @foreach (var t in _types) { <MudSelectItem T="long" Value="t.Id">@TypeItem(t)</MudSelectItem> }
                </MudSelect>
            }
            <MudSelect T="long" @bind-Value="g.Cat" Label="@Tr("SPV_Category")" Variant="Variant.Outlined" ToStringFunc="@CatName">
                <MudSelectItem T="long" Value="0L">@Tr("IC_AllCats")</MudSelectItem>
                @foreach (var c in _cats) { <MudSelectItem T="long" Value="c.Id">@CatLabel(c)</MudSelectItem> }
            </MudSelect>
            <MudTextField T="string" @bind-Value="g.Text" Label="@Tr("IT_Search")" Placeholder="@Tr("SPV_SearchBoxHelp")" Class="wide"
                          Variant="Variant.Outlined" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.ManageSearch"
                          OnKeyDown="@(async (KeyboardEventArgs e) => { if (e.Key is "Enter" or "NumpadEnter") await search(); })" />
            <MudButton Class="go" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search"
                       Disabled="@(g.Loading || g.Type == 0)" OnClick="search">
                @if (g.Loading) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
                @Tr("SPV_Search")
            </MudButton>
            }
        </div>
        <div class="epv-opts">
            @if (!basic)
            {
                <MudCheckBox T="bool" @bind-Value="g.Unpriced" Color="Color.Primary" Label="@Tr("SPV_ShowUnpriced")" />
                <span class="help">@Tr("SPV_ShowUnpricedHelp")</span>
            }
            @if (g.Dirty) { <span class="epv-dirty" role="status"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />@Tr("SPV_FiltersChanged")</span> }
        </div>
    };

    /// <summary>جدول الأصناف بتحديد متعدد وعمود «السعر الجديد» (معاينة). targetType: للتبويب 3 لعرض السعر الحالى فى الهدف.</summary>
    private RenderFragment PricesTable(Grid g, Adj a, long? targetType) => __builder =>
    {
        <div class="epv-sum" aria-live="polite">
            <span>@Tr("SPV_Count") <b>@g.Rows.Count</b></span>
            @if (g.Applied.Unpriced)
            {
                <span>@Tr("SPV_Priced") <b>@g.Rows.Count(r => r.Has_Price)</b></span>
                <span>@Tr("SPV_NoPrice") <b>@g.Rows.Count(r => !r.Has_Price)</b></span>
            }
            <span>@Tr("EPV_Selected") <b>@g.SelN</b></span>
            @if (g.Rows.Count >= Top) { <span class="epv-muted">@Tr("SPV_TopNote", Top)</span> }
            @if (g.Rows.Any(r => !r.Has_Price)) { <span class="epv-muted">@Tr("EPV_UnpricedSkipped")</span> }
            <span class="grow"></span>
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.DoneAll" Disabled="@(!g.Rows.Any(r => r.Has_Price))"
                       OnClick="@(() => { g.Sel = g.Rows.Where(r => r.Has_Price).ToHashSet(); })">@Tr("EPV_SelectAll")</MudButton>
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.RemoveDone" Disabled="@(g.SelN == 0)"
                       OnClick="@(() => { g.Sel = new HashSet<SellValue>(); })">@Tr("EPV_ClearSel")</MudButton>
        </div>
        <MudTable Items="@g.Rows" T="SellValue" Hover="true" Elevation="0" Class="inv-table epv-gap" Breakpoint="Breakpoint.Sm" Dense="true"
                  MultiSelection="true" SelectOnRowClick="true" @bind-SelectedItems="g.Sel" RowDisabledFunc="@(r => !r.Has_Price)"
                  RowClassFunc="@((r, _) => r.Has_Price ? "" : "epv-unpriced")"
                  Loading="g.Loading" LoadingProgressColor="Color.Primary" FixedHeader="true" Height="480px">
            <HeaderContent>
                <MudTh>@Tr("SPV_Category")</MudTh>
                <MudTh>@Tr("IT_Name")</MudTh>
                <MudTh Style="text-align:end">@Tr(targetType == null ? "SPV_SalePrice" : "EPV_SourcePrice")</MudTh>
                <MudTh Style="text-align:end">@Tr("SPV_Discount")</MudTh>
                @if (targetType != null) { <MudTh Style="text-align:end">@Tr("EPV_TargetPrice")</MudTh> }
                <MudTh Style="text-align:end">@Tr("EPV_NewPrice")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("SPV_Category")">@(string.IsNullOrEmpty(context.Category) ? "—" : context.Category)</MudTd>
                <MudTd DataLabel="@Tr("IT_Name")">@context.Name<div class="epv-code">@context.Code@(string.IsNullOrEmpty(context.Unit) ? "" : $" · {context.Unit}")</div></MudTd>
                @if (context.Has_Price)
                {
                    <MudTd DataLabel="@Tr(targetType == null ? "SPV_SalePrice" : "EPV_SourcePrice")" Style="text-align:end"><span class="epv-num">@Money(context.Price)</span></MudTd>
                    <MudTd DataLabel="@Tr("SPV_Discount")" Style="text-align:end"><span class="epv-num epv-muted">@Money(context.Discount)</span></MudTd>
                }
                else
                {
                    <MudTd DataLabel="@Tr(targetType == null ? "SPV_SalePrice" : "EPV_SourcePrice")" Style="text-align:end">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">@Tr("SPV_NoPrice")</MudChip></MudTd>
                    <MudTd DataLabel="@Tr("SPV_Discount")" Style="text-align:end"><span class="epv-muted">—</span></MudTd>
                }
                @if (targetType != null)
                {
                    <MudTd DataLabel="@Tr("EPV_TargetPrice")" Style="text-align:end">
                        <span class="epv-num epv-muted">@(_t3TargetPrices.TryGetValue(context.Item_Id, out var tp) ? Money(tp) : Tr("EPV_NoPrice"))</span>
                    </MudTd>
                }
                <MudTd DataLabel="@Tr("EPV_NewPrice")" Style="text-align:end">
                    @if (context.Has_Price && g.Sel.Contains(context))
                    {
                        var np = PriceListService.Adjust(context.Price, a.IsRate, a.IsPlus, a.Value, a.Rounding);
                        var basis = targetType == null ? context.Price : (_t3TargetPrices.TryGetValue(context.Item_Id, out var bp) ? bp : (decimal?)null);
                        var nd = a.SetDiscount ? a.Discount : (targetType == null ? context.Discount : (_t3TargetPrices.ContainsKey(context.Item_Id) ? (decimal?)null : 0));
                        <span class="epv-num @(np < 0 || (nd is decimal d && d > np) ? "epv-bad" : basis == null ? "" : np > basis ? "epv-up" : np < basis ? "epv-down" : "")"
                              title="@(nd is decimal d2 && d2 > np ? Tr("EPV_DiscOverPrice") : "")">@Money(np)</span>
                    }
                    else { <span class="epv-muted">—</span> }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="epv-empty"><MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" /><span>@Tr("EPV_NoPrices")</span></div>
            </NoRecordsContent>
        </MudTable>
    };

    /// <summary>حقول طريقة التعديل (زيادة/نقص، نسبة/قيمة، القيمة، التقريب، الخصم).</summary>
    private RenderFragment AdjPanel(Adj a, bool keepDiscountOwn) => __builder =>
    {
        <div class="epv-adj">
            <MudSelect T="bool" @bind-Value="a.IsPlus" Label="@Tr("EPV_Required")" Variant="Variant.Outlined" ToStringFunc="@(b => Tr(b ? "PR_Plus" : "PR_Minus"))">
                <MudSelectItem T="bool" Value="true">@Tr("PR_Plus") (+)</MudSelectItem>
                <MudSelectItem T="bool" Value="false">@Tr("PR_Minus") (−)</MudSelectItem>
            </MudSelect>
            <MudSelect T="bool" @bind-Value="a.IsRate" Label="@Tr("EPV_RateOrValue")" Variant="Variant.Outlined" ToStringFunc="@(b => Tr(b ? "EPV_ByRate" : "EPV_ByValue"))">
                <MudSelectItem T="bool" Value="true">@Tr("EPV_ByRate")</MudSelectItem>
                <MudSelectItem T="bool" Value="false">@Tr("EPV_ByValue")</MudSelectItem>
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="a.Value" Label="@Tr(a.IsRate ? "EPV_RatePct" : "EPV_Amount")" Variant="Variant.Outlined" Min="0" Format="0.####" Immediate="true"
                             Adornment="Adornment.End" AdornmentText="@(a.IsRate ? "%" : "")" HelperText="@Tr("EPV_ZeroHelp")" />
            <MudSelect T="decimal" @bind-Value="a.Rounding" Label="@Tr("PR_Rounding")" Variant="Variant.Outlined" ToStringFunc="@(r => r.ToString("0.##", CultureInfo.InvariantCulture))">
                @foreach (var r in PriceListService.Roundings) { <MudSelectItem T="decimal" Value="r">@r.ToString("0.##", CultureInfo.InvariantCulture)</MudSelectItem> }
            </MudSelect>
            <MudSwitch T="bool" @bind-Value="a.SetDiscount" Color="Color.Primary" Class="half" Label="@Tr("EPV_SetDiscount")" />
            @if (a.SetDiscount)
            {
                <MudNumericField T="decimal" @bind-Value="a.Discount" Label="@Tr("SPV_Discount")" Variant="Variant.Outlined" Min="0" Format="0.##" Immediate="true" Class="half"
                                 HelperText="@Tr("EPV_DiscountHelp")" />
            }
            else
            {
                <div class="epv-muted half" style="align-self:center">@Tr(keepDiscountOwn ? "EPV_KeepDiscount" : "EPV_KeepDiscountTarget")</div>
            }
        </div>
    };

    /// <summary>تحذير الهدف المشتق + مفتاح التأكيد (التبويبان 2 و3).</summary>
    private RenderFragment DerivedTarget(long target, bool allow, Action<bool> set) => __builder =>
    {
        @if (Type(target) is { Master_Id: > 0 } dt)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">@Tr("SPV_DerivedWarn", dt.Master_Name ?? "")</MudAlert>
            <MudSwitch T="bool" Value="allow" ValueChanged="set" Color="Color.Warning" Label="@Tr("EPV_AllowDerived")" />
        }
    };

    private string Formula(long target, long source, Adj a)
    {
        string T(long id) => System.Net.WebUtility.HtmlEncode(id == 0 ? "…" : TypeName(id));
        string op = a.IsPlus ? "+" : "−";
        string v = a.Value.ToString("0.####", CultureInfo.InvariantCulture) + (a.IsRate ? "%" : "");
        return Tr("EPV_Formula", $"<b>{T(target)}</b>", $"<b>{T(source)}</b>", $"{op} {v}");
    }

    // ---------- التحميل ----------

    /// <summary>يحمّل الجدول بالفلاتر المطبَّقة (آخر «بحث») — يُستدعى أيضاً بعد التنفيذ.</summary>
    private async Task LoadGrid(Grid g)
    {
        g.Sel = new HashSet<SellValue>();
        var f = g.Applied;
        if (!g.Searched || f.Type == 0) { g.Rows = new(); return; }
        g.Loading = true; _error = null;
        try { g.Rows = await Bg(() => _svc.ListSellValues(f.Type, f.Cat, f.Text, Top, f.Unpriced)); }
        catch (Exception ex) { _error = Inner(ex); }
        finally { g.Loading = false; }
    }

    /// <summary>زر «بحث»: يثبّت الفلاتر الحالية ثم يحمّل.</summary>
    private Task SearchGrid(Grid g)
    {
        if (g.Loading || g.Type == 0) return Task.CompletedTask;
        g.Applied = g.Current; g.Searched = true;
        return LoadGrid(g);
    }

    private Task Search1Async()
    {
        if (_t1.Type != _t1.AType) _allowDerived = false;
        return SearchGrid(_t1);
    }

    private async Task Search3Async()
    {
        if (_t3.Type == 0) return;
        await SearchGrid(_t3);
    }

    /// <summary>أسعار الهدف الحالية (للمقارنة فى التبويب 3).</summary>
    private async Task LoadTargetAsync()
    {
        _t3TargetPrices = new();
        if (_t3Target == 0) return;
        long t = _t3Target;
        try { _t3TargetPrices = (await Bg(() => _svc.ListSellValues(t, 0, null, 5000))).GroupBy(r => r.Item_Id).ToDictionary(g => g.Key, g => g.First().Price); }
        catch (Exception ex) { _error = Inner(ex); }
    }

    private async Task Count2Async()
    {
        long s = _t2Source;
        try { _t2Count = await Bg(() => _svc.CountPricedItems(s)); }
        catch (Exception ex) { _error = Inner(ex); }
    }

    // ---------- التنفيذ ----------

    private async Task<bool> ConfirmAsync(string msg)
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("EPV_ConfirmTitle"), msg, yesText: Tr("EPV_Execute"), cancelText: Tr("Cancel"));
        return ok == true;
    }

    private string AdjText(Adj a) => $"{(a.IsPlus ? "+" : "−")} {a.Value.ToString("0.####", CultureInfo.InvariantCulture)}{(a.IsRate ? "%" : "")}"
        + (a.SetDiscount ? " · " + Tr("SPV_Discount") + " " + Money(a.Discount) : "");

    /// <summary>BtnEditValue: الأصناف المحددة فى نوع السعر.</summary>
    private async Task ApplyEditAsync()
    {
        if (_a1.Value == 0 && !_a1.SetDiscount) { _error = Tr("EPV_NothingToChange"); return; }
        if (!await ConfirmAsync(Tr("EPV_Confirm1", _t1.SelN, TypeName(_t1.AType), AdjText(_a1)))) return;
        var ids = _t1.Sel.Where(r => r.Has_Price).Select(r => r.Item_Id).ToList();
        long t = _t1.AType; var a = _a1; bool der = _allowDerived;
        await RunAsync(() => _svc.EditSellValues(t, ids, a.IsRate, a.IsPlus, a.Value, a.DiscountOrNull, a.Rounding, der), () => LoadGrid(_t1));
    }

    /// <summary>BtnEditByType: كل أصناف المصدر.</summary>
    private async Task ApplyCopyAllAsync()
    {
        if (!await ConfirmAsync(Tr("EPV_Confirm2", TypeName(_t2Target), TypeName(_t2Source), AdjText(_a2), _t2Count))) return;
        long s = _t2Source, t = _t2Target; var a = _a2; bool der = _allowDer2;
        await RunAsync(() => _svc.CopySellValues(s, t, null, a.IsRate, a.IsPlus, a.Value, a.DiscountOrNull, a.Rounding, der), () => Task.CompletedTask);
    }

    /// <summary>BtnEditByType_Item: الأصناف المحددة فقط.</summary>
    private async Task ApplyCopySelAsync()
    {
        if (!await ConfirmAsync(Tr("EPV_Confirm3", TypeName(_t3Target), TypeName(_t3.AType), AdjText(_a3), _t3.SelN))) return;
        var ids = _t3.Sel.Where(r => r.Has_Price).Select(r => r.Item_Id).ToList();
        long s = _t3.AType, t = _t3Target; var a = _a3; bool der = _allowDer3;
        await RunAsync(() => _svc.CopySellValues(s, t, ids, a.IsRate, a.IsPlus, a.Value, a.DiscountOrNull, a.Rounding, der), async () => { await LoadTargetAsync(); _t3.Sel = new(); });
    }

    private async Task RunAsync(Func<int> action, Func<Task> reload)
    {
        _busy = true; _error = null;
        try
        {
            int n = await Bg(action);
            Snackbar.Add(Tr("PR_Applied", n), Severity.Success);
            _types = await Bg(() => _svc.ListTypes());
            await reload();
        }
        catch (Exception ex) { _error = Inner(ex); }
        finally { _busy = false; }
    }

    // ---------- مساعدات ----------

    private PriceType? Type(long id) => _types.FirstOrDefault(x => x.Id == id);
    private bool IsDerived(long id) => Type(id)?.Master_Id > 0;
    private int Children(long id) => id == 0 ? 0 : _types.Count(x => x.Master_Id == id);
    private string TypeName(long id) => Type(id)?.Name ?? string.Empty;
    private string CatName(long id) => id == 0 ? Tr("IC_AllCats") : _cats.FirstOrDefault(c => c.Id == id)?.Name ?? string.Empty;
    private string CatLabel(CategoryPick c) => $"{c.Name} · {CatType(c.Type_Id)}";
    private static string CatType(int t) => t >= 0 && t < ItemUnitCategoryService.CategoryTypes.Length ? ItemUnitCategoryService.CategoryTypes[t] : ItemUnitCategoryService.CategoryTypes[0];

    private static string Money(decimal v) => v.ToString("#,0.00", CultureInfo.InvariantCulture);
    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try { CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo; return Lang[key, args]; }
        finally { CultureInfo.CurrentUICulture = previousCulture; }
    }
}
