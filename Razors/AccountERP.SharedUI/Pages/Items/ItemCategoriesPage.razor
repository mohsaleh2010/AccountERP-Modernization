@* 🟢 خطة 04 — المرحلة 1: أنواع الفئات والفئات فى صفحة واحدة (بدل ItemMainCategoryFRM + ItemCategoryFRM وشاشتى الإضافة).
   يسار: الأنواع الرئيسية (اختيار نوع يصفّى الفئات). يمين: جدول الفئات. فئة افتراضية واحدة لكل (أصناف/خدمات)،
   الإيقاف لا يمس الأصناف، والحذف لغير المستعمل فقط. التصميم حسب ui-ux-pro-max.
   ملاحظات الاختبار (المرحلة 5): الإضافة والتعديل للأنواع والفئات من نافذة منبثقة مثل شركات الشحن، مع إضافة متعددة
   (يبقى الحوار مفتوحاً ويُفرَّغ الاسم فقط ويعود التركيز له؛ Enter يحفظ، Esc يغلق). *@
@page "/items/categories"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.ItemUnitCategoryService
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@Tr("IC_Title")</PageTitle>

<InvoiceStyles />

<style>
    .ic-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .ic-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .ic-head .ico .mud-icon-root { font-size: 2rem; }
    .ic-head .titles { flex: 1 1 260px; }
    .ic-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .ic-grid { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(0, 2.2fr); gap: 16px; margin-top: 16px; align-items: start; }
    .ic-bar { display: flex; flex-wrap: wrap; gap: 8px 12px; align-items: center; justify-content: space-between; }
    .ic-bar .tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; flex: 0 1 auto; }
    .ic-bar .mud-button-root { min-height: 44px; }
    .ic-mains { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; max-height: 70vh; overflow-y: auto; }
    .ic-main { display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 6px 10px; border-radius: 10px; border: 1px solid transparent;
               background: none; font: inherit; color: var(--mud-palette-text-primary); text-align: start; cursor: pointer; width: 100%; transition: background .15s; }
    .ic-main:hover { background: var(--mud-palette-action-default-hover); }
    .ic-main:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: 1px; }
    .ic-main[aria-pressed="true"] { background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); border-color: var(--mud-palette-primary); }
    .ic-main .nm { flex: 1; font-weight: 500; }
    .ic-main .meta { font-size: .78rem; color: var(--mud-palette-text-secondary); }
    .ic-main .cnt { font-variant-numeric: tabular-nums; min-width: 28px; text-align: center; border-radius: 999px; padding: 1px 8px; font-size: .78rem;
                    background: var(--mud-palette-background-gray); }
    .ic-dform { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; align-items: start; }
    .ic-dform .full { grid-column: 1 / -1; }
    .ic-dform .switches { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px 24px; align-items: center; }
    .ic-hint { font-size: .8rem; color: var(--mud-palette-text-secondary); margin-top: 2px; }
    .ic-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 32px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    .ic-empty .mud-icon-root { opacity: .5; }
    @@media (max-width: 1099px) { .ic-grid { grid-template-columns: minmax(0, 1fr); } .ic-mains { max-height: none; } }
    @@media (max-width: 599px) { .ic-dform { grid-template-columns: minmax(0, 1fr); } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">
    <div class="inv-card ic-head">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AccountTree" /></div>
        <div class="titles">
            <h1 class="inv-title">@Tr("IC_Title")</h1>
            <div class="sub">@Tr("IC_Sub")</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="alert" ShowCloseIcon="true" CloseIconClicked="@(() => _error = null)">@_error</MudAlert> }

    <div class="ic-grid">
        @* ===== الأنواع الرئيسية ===== *@
        <section class="inv-card" aria-labelledby="ic-mains-title">
            <div class="ic-bar">
                <h2 class="inv-card-title" id="ic-mains-title" style="margin:0"><MudIcon Icon="@Icons.Material.Filled.FolderOpen" />@Tr("IC_Mains")<span class="inv-count">@_mains.Count</span></h2>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenNewMain">@Tr("IC_NewMain")</MudButton>
            </div>
            <div class="ic-mains" role="list">
                <button type="button" class="ic-main" role="listitem" aria-pressed="@(_selMain == 0 ? "true" : "false")" @onclick="@(() => SelectMainAsync(0))">
                    <MudIcon Icon="@Icons.Material.Filled.SelectAll" Size="Size.Small" /><span class="nm">@Tr("IC_AllMains")</span><span class="cnt">@_mains.Sum(m => m.Sub_Count)</span>
                </button>
                @foreach (var m in _mains)
                {
                    <div style="display:flex;align-items:center;gap:2px" role="listitem">
                        <button type="button" class="ic-main" aria-pressed="@(_selMain == m.Id ? "true" : "false")" @onclick="@(() => SelectMainAsync(m.Id))">
                            <span class="nm">@m.Name<div class="meta">@TypeName(m.Type_Id) · @Tr("IC_ItemsCount", m.Used_Count)</div></span><span class="cnt">@m.Sub_Count</span>
                        </button>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@Tr("IU_EditAria", m.Name)" OnClick="@(() => OpenEditMain(m))" />
                    </div>
                }
            </div>
        </section>

        @* ===== الفئات ===== *@
        <section class="inv-card">
            <div class="ic-bar">
                <h2 class="inv-card-title" style="margin:0"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@(_selMain == 0 ? Tr("IC_AllCats") : _mains.FirstOrDefault(m => m.Id == _selMain)?.Name)<span class="inv-count">@_cats.Count</span></h2>
                <div class="tools">
                    <div style="flex:0 1 280px"><MudTextField T="string" Value="_search" ValueChanged="OnSearchAsync" Label="@Tr("ILSearch")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" DebounceInterval="300" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" /></div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(_mains.Count == 0)" OnClick="OpenNewCat">@Tr("IC_NewCat")</MudButton>
                </div>
            </div>
            <MudTable Items="@_cats" T="CategoryRow" Hover="true" Elevation="0" Class="inv-table mt-3" Breakpoint="Breakpoint.Sm" Loading="_loading" LoadingProgressColor="Color.Primary">
                <HeaderContent>
                    <MudTh>@Tr("IC_CatName")</MudTh>
                    @if (_selMain == 0) { <MudTh>@Tr("IC_Main")</MudTh> }
                    <MudTh>@Tr("IC_Nature")</MudTh>
                    <MudTh>@Tr("IC_Kind")</MudTh>
                    <MudTh Style="text-align:end">@Tr("ILUsed")</MudTh>
                    <MudTh>@Tr("ILActive")</MudTh>
                    <MudTh Style="width:110px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@Tr("IC_CatName")">
                        <span style="@(context.Is_Active ? "" : "opacity:.55")">@context.Name</span>
                        @if (context.Is_Default) { <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ms-2">@Tr("IU_DefaultChip")</MudChip> }
                    </MudTd>
                    @if (_selMain == 0) { <MudTd DataLabel="@Tr("IC_Main")">@context.Main_Name</MudTd> }
                    <MudTd DataLabel="@Tr("IC_Nature")">@TypeName(context.Type_Id)</MudTd>
                    <MudTd DataLabel="@Tr("IC_Kind")">@KindName(context.Item_Or_Service)
                        @if (!string.IsNullOrEmpty(context.Profile)) { <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" Class="ms-1">@Tr(ProfileKey(context.Profile))</MudChip> }
                    </MudTd>
                    <MudTd DataLabel="@Tr("ILUsed")" Style="text-align:end">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@(context.Used_Count > 0 ? Color.Primary : Color.Default)">@context.Used_Count</MudChip>
                    </MudTd>
                    <MudTd DataLabel="@Tr("ILActive")">
                        <MudSwitch T="bool" Value="context.Is_Active" ValueChanged="@(v => SetActiveAsync(context, v))" Color="Color.Primary" aria-label="@Tr("ILActive")" />
                    </MudTd>
                    <MudTd Style="white-space:nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@Tr("IU_EditAria", context.Name)" OnClick="@(() => OpenEditCat(context))" />
                        <MudTooltip Text="@(context.Used_Count > 0 ? Tr("IC_UsedNoDelete") : Tr("Delete"))">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" aria-label="@Tr("Delete")" Disabled="@(_busy || context.Used_Count > 0)" OnClick="@(() => DeleteCatAsync(context))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="ic-empty"><MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" /><span>@Tr("ILEmpty")</span></div>
                </NoRecordsContent>
            </MudTable>
        </section>
    </div>
</div>
</MudContainer>

@* ===== حوار النوع الرئيسى ===== *@
<MudDialog @bind-Visible="_mainOpen"
           Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false })">
    <TitleContent>@(_main.Id == 0 ? Tr("IC_NewMain") : Tr("IC_EditMain"))</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_dlgError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_dlgError</MudAlert> }
        <div class="ic-dform">
            <MudTextField T="string" @bind-Value="_main.Name" Label="@Tr("NameColumn")" Variant="Variant.Outlined" Required="true" MaxLength="200"
                          AutoFocus="true" Immediate="true" @ref="_mainNameField" OnKeyDown="OnMainKeyDown" />
            <MudSelect T="int" @bind-Value="_main.Type_Id" Label="@Tr("IC_Nature")" Variant="Variant.Outlined">
                @for (int i = 0; i < ItemUnitCategoryService.CategoryTypes.Length; i++) { var k = i; <MudSelectItem T="int" Value="k">@TypeName(k)</MudSelectItem> }
            </MudSelect>
            @if (_main.Id == 0)
            {
                <div class="full">
                    <MudCheckBox T="bool" @bind-Value="_mainMulti" Label="@Tr("MultipleAddLabel")" Color="Color.Primary" Dense="true" />
                    @if (_mainMulti) { <div class="ic-hint">@Tr("IC_MultiHint")</div> }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_main.Id != 0)
        {
            <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteOutline" Class="me-auto"
                       Disabled="@(_busy || _mains.FirstOrDefault(m => m.Id == _main.Id)?.Sub_Count > 0)" OnClick="DeleteMainAsync">@Tr("Delete")</MudButton>
        }
        <MudButton OnClick="@(() => _mainOpen = false)">@Tr("Close")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_busy || string.IsNullOrWhiteSpace(_main.Name))" OnClick="SaveMainAsync">
            @if (_busy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
            @Tr("Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@* ===== حوار الفئة ===== *@
<MudDialog @bind-Visible="_catOpen"
           Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false })">
    <TitleContent>@(_cat.Id == 0 ? Tr("IC_NewCat") : Tr("IU_Edit", _catTitle))</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_dlgError)) { <MudAlert Severity="Severity.Error" Dense="true" Class="mb-3" role="alert">@_dlgError</MudAlert> }
        <div class="ic-dform">
            <MudTextField T="string" @bind-Value="_cat.Name" Label="@Tr("IC_CatName")" Variant="Variant.Outlined" Required="true" MaxLength="200" Class="full"
                          AutoFocus="true" Immediate="true" @ref="_catNameField" OnKeyDown="OnCatKeyDown" />
            <MudSelect T="long" @bind-Value="_cat.Main_Id" Label="@Tr("IC_Main")" Variant="Variant.Outlined" Required="true" ToStringFunc="@(id => _mains.FirstOrDefault(m => m.Id == id)?.Name ?? string.Empty)">
                @foreach (var m in _mains) { <MudSelectItem T="long" Value="m.Id">@m.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="int" @bind-Value="_cat.Type_Id" Label="@Tr("IC_Nature")" Variant="Variant.Outlined">
                @for (int i = 0; i < ItemUnitCategoryService.CategoryTypes.Length; i++) { var k = i; <MudSelectItem T="int" Value="k">@TypeName(k)</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="_cat.Profile" Label="@Tr("IC_Profile")" Variant="Variant.Outlined" HelperText="@Tr("IC_ProfileHelp")" Class="full"
                       Disabled="@(_cat.Item_Or_Service == 2)" ToStringFunc="@(v => Tr(ProfileKey(v)))">
                <MudSelectItem T="string" Value="@("")">@Tr("IC_ProfileGeneral")</MudSelectItem>
                @foreach (var pr in new[] { "pharmacy", "cars", "ceramics", "glass", "textile" }) { <MudSelectItem T="string" Value="@pr">@Tr(ProfileKey(pr))</MudSelectItem> }
            </MudSelect>
            <div class="switches">
                <MudRadioGroup T="int" @bind-Value="_cat.Item_Or_Service" aria-label="@Tr("IC_Kind")">
                    <MudRadio T="int" Value="1" Color="Color.Primary">@Tr("IC_Items")</MudRadio>
                    <MudRadio T="int" Value="2" Color="Color.Primary">@Tr("IC_Services")</MudRadio>
                    <MudRadio T="int" Value="0" Color="Color.Primary">@Tr("IC_Unspecified")</MudRadio>
                </MudRadioGroup>
            </div>
            <div class="switches">
                <MudSwitch T="bool" @bind-Value="_cat.Is_Default" Color="Color.Primary" Label="@Tr("IC_Default")" Disabled="@(_cat.Item_Or_Service == 0)" />
                <MudSwitch T="bool" @bind-Value="_cat.Is_Active" Color="Color.Primary" Label="@Tr("ILActive")" />
            </div>
            @if (_cat.Id == 0)
            {
                <div class="full">
                    <MudCheckBox T="bool" @bind-Value="_catMulti" Label="@Tr("MultipleAddLabel")" Color="Color.Primary" Dense="true" />
                    @if (_catMulti) { <div class="ic-hint">@Tr("IC_MultiHint")</div> }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _catOpen = false)">@Tr("Close")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(_busy || string.IsNullOrWhiteSpace(_cat.Name))" OnClick="SaveCatAsync">
            @if (_busy) { <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" /> }
            @Tr("Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly ItemUnitCategoryService _svc = new();
    private List<MainCategoryRow> _mains = new();
    private List<CategoryRow> _cats = new();
    private MainCategoryRow _main = new();
    private CategoryRow _cat = new() { Is_Active = true, Item_Or_Service = 1, Type_Id = 1, Profile = "" };
    private long _selMain;
    private string? _search, _error, _dlgError;
    private string _catTitle = "";
    private bool _loading = true, _busy;

    // الحواران والإضافة المتعددة
    private bool _mainOpen, _catOpen, _mainMulti, _catMulti, _refocusMain, _refocusCat;
    private MudTextField<string>? _mainNameField, _catNameField;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        await LoadMainsAsync();
        await LoadCatsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_refocusMain && _mainNameField is not null) { _refocusMain = false; await Task.Delay(60); await _mainNameField.FocusAsync(); }
        if (_refocusCat && _catNameField is not null) { _refocusCat = false; await Task.Delay(60); await _catNameField.FocusAsync(); }
    }

    // AutoFocus لا يعمل داخل MudDialog (مصيدة التركيز تأخذه)؛ ننتظر رسم الحوار ثم نركّز على الاسم
    private async Task FocusSoonAsync(Func<MudTextField<string>?> field)
    {
        for (int i = 0; i < 10; i++)
        {
            await Task.Delay(80);
            var f = field();
            if (f is null) continue;
            try { await Task.Delay(120); await f.FocusAsync(); } catch { }
            return;
        }
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private string TypeName(int t) => t switch { 1 => Tr("IC_T1"), 2 => Tr("IC_T2"), 3 => Tr("IC_T3"), _ => Tr("IC_T0") };
    private string KindName(int k) => k switch { 1 => Tr("IC_Items"), 2 => Tr("IC_Services"), _ => Tr("IC_Unspecified") };

    private async Task LoadMainsAsync()
    {
        try { _mains = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.ListMainCategories(); }); }
        catch (Exception ex) { _error = Inner(ex); }
    }

    private async Task LoadCatsAsync()
    {
        _loading = true;
        long m = _selMain; string s = _search ?? "";
        try { _cats = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.ListCategories(m, s); }); }
        catch (Exception ex) { _error = Inner(ex); _cats = new(); }
        finally { _loading = false; }
    }

    private async Task SelectMainAsync(long id)
    {
        _selMain = id;
        await LoadCatsAsync();
    }

    private async Task OnSearchAsync(string? s) { _search = s; await LoadCatsAsync(); }

    private static string ProfileKey(string? p) => p switch { "pharmacy" => "IC_ProfilePharmacy", "cars" => "IC_ProfileCars", "ceramics" => "IC_ProfileCeramics", "glass" => "IC_ProfileGlass", "textile" => "IC_ProfileTextile", _ => "IC_ProfileGeneral" };

    // ===== النوع الرئيسى =====

    private void OpenNewMain()
    {
        _main = new MainCategoryRow { Type_Id = 1 };
        _dlgError = null;
        _mainNameField = null; _mainOpen = true;
        _ = FocusSoonAsync(() => _mainNameField);
    }

    private void OpenEditMain(MainCategoryRow m)
    {
        _main = new MainCategoryRow { Id = m.Id, Name = m.Name, Type_Id = m.Type_Id };
        _dlgError = null;
        _mainNameField = null; _mainOpen = true;
        _ = FocusSoonAsync(() => _mainNameField);
    }

    private async Task OnMainKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy) return;
        await Task.Delay(150); // يترك آخر حرف مكتوب (Immediate) يصل للخادم قبل الحفظ
        if (!string.IsNullOrWhiteSpace(_main.Name)) await SaveMainAsync();
    }

    private async Task SaveMainAsync()
    {
        _busy = true; _dlgError = null;
        var m = _main; bool isNew = m.Id == 0;
        try
        {
            long id = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.SaveMainCategory(m); });
            Snackbar.Add(isNew ? Tr("ILAdded") : Tr("IU_Saved"), Severity.Success);
            await LoadMainsAsync();
            if (isNew && _mainMulti)
            {
                _main = new MainCategoryRow { Type_Id = m.Type_Id };
                _refocusMain = true;
            }
            else
            {
                _mainOpen = false;
                if (isNew) await SelectMainAsync(id); else await LoadCatsAsync();
            }
        }
        catch (Exception ex) { _dlgError = Inner(ex); }
        finally { _busy = false; }
    }

    private async Task DeleteMainAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("Delete"), Tr("ILDeleteConfirm", _main.Name ?? ""), yesText: Tr("Delete"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _busy = true; _dlgError = null;
        long id = _main.Id;
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); _svc.DeleteMainCategory(id); });
            Snackbar.Add(Tr("ILDeleted"), Severity.Success);
            _mainOpen = false;
            if (_selMain == id) _selMain = 0;
            await LoadMainsAsync();
            await LoadCatsAsync();
        }
        catch (Exception ex) { _dlgError = Inner(ex); }
        finally { _busy = false; }
    }

    // ===== الفئة =====

    private void OpenNewCat()
    {
        long main = _selMain != 0 ? _selMain : _mains.FirstOrDefault()?.Id ?? 0;
        int type = _mains.FirstOrDefault(x => x.Id == main)?.Type_Id ?? 1;
        _cat = new CategoryRow { Is_Active = true, Item_Or_Service = 1, Type_Id = type, Main_Id = main, Profile = "" };
        _dlgError = null;
        _catNameField = null; _catOpen = true;
        _ = FocusSoonAsync(() => _catNameField);
    }

    private void OpenEditCat(CategoryRow c)
    {
        _cat = new CategoryRow { Id = c.Id, Name = c.Name, Main_Id = c.Main_Id, Type_Id = c.Type_Id, Item_Or_Service = c.Item_Or_Service, Is_Default = c.Is_Default, Is_Active = c.Is_Active, Profile = c.Profile ?? "" };
        _catTitle = c.Name ?? "";
        _dlgError = null;
        _catNameField = null; _catOpen = true;
        _ = FocusSoonAsync(() => _catNameField);
    }

    private async Task OnCatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _busy) return;
        await Task.Delay(150);
        if (!string.IsNullOrWhiteSpace(_cat.Name)) await SaveCatAsync();
    }

    private async Task SaveCatAsync()
    {
        _busy = true; _dlgError = null;
        var c = _cat; bool isNew = c.Id == 0;
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.SaveCategory(c); });
            Snackbar.Add(isNew ? Tr("ILAdded") : Tr("IU_Saved"), Severity.Success);
            if (isNew && _catMulti)
            {
                // يبقى النوع والطبيعة والملف كما هى للفئة التالية؛ الافتراضية واحدة فقط فلا تُنقل
                _cat = new CategoryRow { Main_Id = c.Main_Id, Type_Id = c.Type_Id, Item_Or_Service = c.Item_Or_Service, Is_Active = c.Is_Active, Profile = c.Profile ?? "" };
                _refocusCat = true;
            }
            else _catOpen = false;
            await LoadMainsAsync();
            await LoadCatsAsync();
        }
        catch (Exception ex) { _dlgError = Inner(ex); }
        finally { _busy = false; }
    }

    private async Task SetActiveAsync(CategoryRow row, bool v)
    {
        long id = row.Id;
        try { await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); _svc.SetCategoryActive(id, v); }); row.Is_Active = v; }
        catch (Exception ex) { _error = Inner(ex); }
    }

    private async Task DeleteCatAsync(CategoryRow row)
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("Delete"), Tr("ILDeleteConfirm", row.Name), yesText: Tr("Delete"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _busy = true; _error = null;
        long id = row.Id;
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); _svc.DeleteCategory(id); });
            Snackbar.Add(Tr("ILDeleted"), Severity.Success);
            await LoadMainsAsync();
            await LoadCatsAsync();
        }
        catch (Exception ex) { _error = Inner(ex); }
        finally { _busy = false; }
    }

    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try { CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo; return Lang[key, args]; }
        finally { CultureInfo.CurrentUICulture = previousCulture; }
    }
}
