@* 🤖 المساعد الذكى P1 (ai-assistant-plan.md §7.1): صفحة /assistant - عمود جانبى بالمحادثات (بحث، مجمّعة اليوم/هذا الأسبوع/أقدم، إعادة تسمية وحذف)
   ومنطقة المحادثة المشتركة AssistantChat. على الشاشات الضيقة يتحول العمود الجانبى لقائمة منبثقة. الصلاحية: عنصر القائمة menuItemAiAssistant.
   نفس الحالة مع النافذة العائمة عبر AssistantSessionService (Scoped). التصميم حسب ui-ux-pro-max (أهداف لمس 44px، تركيز ظاهر، فاتح/داكن، RTL/LTR). *@
@page "/assistant"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Assistant
@using Microsoft.Extensions.DependencyInjection
@inject LanguageService LangService
@inject IServiceProvider ServiceProvider
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@Tr("AIC_Title")</PageTitle>

<style>
    .aip { display: flex; height: calc(100dvh - 170px); min-height: 480px; border-radius: 16px; overflow: hidden; position: relative;
           border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .aip-side { flex: none; width: 290px; display: flex; flex-direction: column; min-height: 0;
                border-inline-end: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .aip-side-head { flex: none; display: flex; flex-direction: column; gap: 10px; padding: 14px; }
    .aip-side-head .mud-button-root { min-height: 44px; }
    .aip-list { flex: 1; min-height: 0; overflow-y: auto; padding: 0 8px 12px; }
    .aip-group { margin: 12px 8px 4px; font-size: .72rem; font-weight: 700; letter-spacing: .02em; color: var(--mud-palette-text-secondary); }
    .aip-item { display: flex; align-items: center; gap: 2px; border-radius: 10px; min-height: 44px; }
    .aip-item:hover { background: var(--mud-palette-action-default-hover); }
    .aip-item.active { background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); }
    .aip-item > button.title { flex: 1; min-width: 0; min-height: 44px; padding: 8px 10px; border: 0; background: transparent; cursor: pointer; text-align: start;
                                font: inherit; font-size: .875rem; color: var(--mud-palette-text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-radius: 10px; }
    .aip-item.active > button.title { font-weight: 600; color: var(--mud-palette-primary); }
    .aip-item > button.title:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }
    .aip-item .mud-input-control { margin: 4px 6px; }
    .aip-none { padding: 24px 12px; text-align: center; font-size: .85rem; color: var(--mud-palette-text-secondary); }
    .aip-main { flex: 1; min-width: 0; display: flex; flex-direction: column; min-height: 0; }
    .aip-top { flex: none; display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 6px 12px;
               border-bottom: 1px solid var(--mud-palette-lines-default); }
    .aip-top .title { flex: 1; min-width: 0; font-weight: 600; font-size: 1rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .aip-toggle { display: none !important; }
    .aip-body { flex: 1; min-height: 0; }
    .aip-scrim { display: none; }
    .aip-reports { flex: none; max-height: 38%; overflow-y: auto; border-top: 1px solid var(--mud-palette-lines-default); padding: 4px 8px 8px; }
    .aip-report-row { display: flex; align-items: center; gap: 2px; }
    .aip-report-row .aip-report { flex: 1 1 auto; min-width: 0; }
    .aip-share { flex: none; }
    .aip-owner { font-size: .75rem; color: var(--mud-palette-text-secondary); margin-inline-start: auto; }
    .aip-report { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 10px; border-radius: 10px; font-size: .85rem;
                  color: var(--mud-palette-text-primary); text-decoration: none; }
    .aip-report span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .aip-report .mud-icon-root { color: var(--mud-palette-primary); flex: none; }
    .aip-report:hover { background: color-mix(in srgb, var(--mud-palette-primary) 8%, transparent); }
    .aip-report:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }
    @@media (max-width: 900px) {
        .aip { height: calc(100dvh - 130px); }
        .aip-toggle { display: inline-flex !important; }
        .aip-side { position: absolute; inset-block: 0; inset-inline-start: 0; z-index: 3; width: min(320px, 86%); transform: translateX(-105%);
                    transition: transform .2s ease-out; box-shadow: var(--mud-elevation-8); }
        [dir="rtl"] .aip-side { transform: translateX(105%); }
        .aip.side-open .aip-side { transform: none; }
        .aip.side-open .aip-scrim { display: block; position: absolute; inset: 0; z-index: 2; background: rgba(0,0,0,.35); }
    }
    @@media (prefers-reduced-motion: reduce) { .aip-side { transition: none; } }
</style>

<div class="aip @(_sideOpen ? "side-open" : "")" dir="@(LangService.IsRtl ? "rtl" : "ltr")">
    @if (_chat?.HasAccess == true)
    {
        <aside class="aip-side" aria-label="@Tr("AIC_Conversations")">
            <div class="aip-side-head">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_chat.IsSending" OnClick="NewChatAsync">@Tr("AIC_NewChat")</MudButton>
                <MudTextField T="string" Value="_search" ValueChanged="OnSearchChanged" Immediate="true" DebounceInterval="350"
                              Placeholder="@Tr("AIC_Search")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" aria-label="@Tr("AIC_Search")" />
                @* مدة الاحتفاظ: المحادثات الخاملة تُؤرشف (لا تُحذف) وتُستعاد من هنا *@
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="@(_chat.ShowArchived ? Color.Primary : Color.Default)" FullWidth="true"
                           StartIcon="@(_chat.ShowArchived ? Icons.Material.Filled.ArrowBack : Icons.Material.Outlined.Inventory2)"
                           aria-pressed="@(_chat.ShowArchived ? "true" : "false")" OnClick="ToggleArchivedAsync">
                    @Tr(_chat.ShowArchived ? "AIC_BackToChats" : "AIC_ShowArchived")
                </MudButton>
            </div>
            <nav class="aip-list">
                @if (_chat.ShowArchived)
                {
                    <div class="aip-group">@Tr("AIC_ArchivedTitle")</div>
                    <div class="aip-none" style="padding:4px 10px 8px;text-align:start;">@(_chat.Availability.ChatRetentionDays > 0 ? Tr("AIC_ArchivedHint", _chat.Availability.ChatRetentionDays) : Tr("AIC_ArchivedHintManual"))</div>
                }
                @if (_chat.Conversations.Count == 0)
                {
                    <div class="aip-none">@Tr(!string.IsNullOrEmpty(_search) ? "AIC_NoSearchResults" : _chat.ShowArchived ? "AIC_NoArchived" : "AIC_NoConversations")</div>
                }
                @foreach (var g in Groups())
                {
                    <div class="aip-group">@g.Title</div>
                    @foreach (var c in g.Items)
                    {
                        <div class="aip-item @(c.Id == _chat.ConversationId ? "active" : "")" @key="c.Id">
                            @if (_renamingId == c.Id)
                            {
                                <MudTextField T="string" @bind-Value="_renameText" Variant="Variant.Outlined" Margin="Margin.Dense" AutoFocus="true" MaxLength="200"
                                              aria-label="@Tr("AIC_Rename")" OnKeyDown="e => OnRenameKey(e, c.Id)" OnBlur="() => SaveRenameAsync(c.Id)" />
                            }
                            else
                            {
                                <button type="button" class="title" title="@c.Title" aria-current="@(c.Id == _chat.ConversationId ? "page" : null)"
                                        @onclick="() => OpenAsync(c.Id)">@(string.IsNullOrWhiteSpace(c.Title) ? Tr("AIC_Untitled") : c.Title)</button>
                                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AriaLabel="@Tr("AIC_ConvActions")" Dense="true">
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Edit" OnClick="() => StartRename(c)">@Tr("AIC_Rename")</MudMenuItem>
                                    @if (c.IsArchived)
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Unarchive" OnClick="() => _chat.SetArchivedAsync(c.Id, false)">@Tr("AIC_Unarchive")</MudMenuItem>
                                    }
                                    else
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Archive" Disabled="@(_chat.IsSending && c.Id == _chat.ConversationId)" OnClick="() => _chat.SetArchivedAsync(c.Id, true)">@Tr("AIC_Archive")</MudMenuItem>
                                    }
                                    <MudMenuItem Icon="@Icons.Material.Outlined.Delete" IconColor="Color.Error" OnClick="() => DeleteAsync(c)">@Tr("AIC_Delete")</MudMenuItem>
                                </MudMenu>
                            }
                        </div>
                    }
                }
            </nav>
            @* P3: «تقاريرى» - التقارير المحفوظة من المحادثات (المثبّتة أولاً) *@
            @if (_chat.SavedReports.Count > 0)
            {
                <div class="aip-reports" role="region" aria-label="@Tr("AIR_MyReports")">
                    <div class="aip-group">@Tr("AIR_MyReports")</div>
                    @foreach (var r in _chat.SavedReports.Take(12))
                    {
                        <div class="aip-report-row" @key="r.Id">
                            <a class="aip-report" href="@($"/assistant/report/{r.Id}")" title="@r.Title">
                                <MudIcon Icon="@(r.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.Assessment)" Size="Size.Small" aria-hidden="true" />
                                <span>@r.Title</span>
                            </a>
                            @* بقايا ب1: مشاركة مع الشركة (صاحب التقرير فقط) *@
                            <MudIconButton Class="aip-share" Size="Size.Small" Icon="@(r.IsShared ? Icons.Material.Filled.Group : Icons.Material.Outlined.GroupAdd)"
                                           Color="@(r.IsShared ? Color.Primary : Color.Default)" aria-pressed="@(r.IsShared ? "true" : "false")"
                                           title="@(r.IsShared ? Tr("AIU_Unshare") : Tr("AIU_Share"))" aria-label="@(r.IsShared ? Tr("AIU_Unshare") : Tr("AIU_Share"))"
                                           OnClick="@(() => ToggleShareAsync(r))" />
                        </div>
                    }
                </div>
            }
            @if (_chat.SharedReports.Count > 0)
            {
                <div class="aip-reports" role="region" aria-label="@Tr("AIU_SharedReports")">
                    <div class="aip-group">@Tr("AIU_SharedReports")</div>
                    @foreach (var r in _chat.SharedReports.Take(12))
                    {
                        <button type="button" class="aip-report" style="border:0;background:none;width:100%;text-align:start;cursor:pointer;font:inherit;color:inherit"
                                title="@Tr("AIU_OpenSharedHint")" disabled="@_opening" @onclick="@(() => OpenSharedAsync(r.Id))" @key="r.Id">
                            <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" aria-hidden="true" />
                            <span>@r.Title</span>
                            <span class="aip-owner">@r.OwnerName</span>
                        </button>
                    }
                </div>
            }
        </aside>
        <div class="aip-scrim" @onclick="() => _sideOpen = false"></div>
    }

    <section class="aip-main">
        <div class="aip-top">
            @if (_chat?.HasAccess == true)
            {
                <MudIconButton Class="aip-toggle" Icon="@Icons.Material.Filled.Menu" aria-label="@Tr("AIC_Conversations")" OnClick="() => _sideOpen = !_sideOpen" />
            }
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" aria-hidden="true" />
            <h1 class="title" style="margin:0;">@(_chat == null || _chat.ConversationId == 0 || string.IsNullOrWhiteSpace(_chat.ConversationTitle) ? Tr("AIC_Title") : _chat.ConversationTitle)</h1>
            @if (_chat?.Availability.Ready == true && !string.IsNullOrEmpty(_chat.Availability.ModelName))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Outlined.Memory" title="@Tr("AIC_ModelTip")">@_chat.Availability.ModelName</MudChip>
            }
        </div>
        <div class="aip-body">
            @if (_chat == null)
            {
                <div style="padding:24px;"><MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("AIC_NotAvailable")</MudAlert></div>
            }
            else
            {
                <AssistantChat @ref="_chatView" />
            }
        </div>
    </section>
</div>

@code {
    private AssistantSessionService? _chat;
    private AssistantChat? _chatView;
    private bool _sideOpen;
    private string? _search;
    private long _renamingId;
    private string _renameText = "";

    protected override async Task OnInitializedAsync()
    {
        _chat = ServiceProvider.GetService<AssistantSessionService>();
        LangService.OnLanguageChanged += OnChanged;
        if (_chat != null)
        {
            _chat.OnChanged += OnChanged;
            _search = _chat.Search;
            if (_chat.HasAccess)
            {
                await _chat.RefreshAsync();
                await _chat.RefreshSavedReportsAsync();
                await _chat.RefreshSharedReportsAsync();   // بقايا ب1
            }
        }
    }

    // ───────────── بقايا ب1: مشاركة التقارير ─────────────
    private bool _opening;

    private async Task ToggleShareAsync(AiSavedReportView r)
    {
        if (_chat == null) return;
        try
        {
            bool ok = await _chat.ShareReportAsync(r.Id, !r.IsShared);
            if (ok) Snackbar.Add(Tr(r.IsShared ? "AIU_Unshared" : "AIU_Shared"), Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task OpenSharedAsync(long id)
    {
        if (_chat == null || _opening) return;
        _opening = true;
        try
        {
            long copy = await _chat.OpenSharedReportAsync(id);
            Nav.NavigateTo($"/assistant/report/{copy}");
        }
        catch (InvalidOperationException ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _opening = false; }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private sealed record Group(string Title, List<AiConversationView> Items);

    /// <summary>تجميع المحادثات: اليوم / آخر 7 أيام / أقدم.</summary>
    private IEnumerable<Group> Groups()
    {
        if (_chat == null) yield break;
        var today = DateTime.Today;
        var list = _chat.Conversations;
        DateTime When(AiConversationView c) => c.LastMessageAt ?? c.CreatedAt;
        var g1 = list.Where(c => When(c) >= today).ToList();
        var g2 = list.Where(c => When(c) < today && When(c) >= today.AddDays(-7)).ToList();
        var g3 = list.Where(c => When(c) < today.AddDays(-7)).ToList();
        if (g1.Count > 0) yield return new Group(Tr("AIC_GroupToday"), g1);
        if (g2.Count > 0) yield return new Group(Tr("AIC_GroupWeek"), g2);
        if (g3.Count > 0) yield return new Group(Tr("AIC_GroupOlder"), g3);
    }

    private async Task NewChatAsync()
    {
        if (_chat == null) return;
        _chat.NewConversation();
        _sideOpen = false;
        if (_chatView != null) await _chatView.FocusInputAsync();
    }

    private async Task OpenAsync(long id)
    {
        if (_chat == null) return;
        _sideOpen = false;
        await _chat.OpenAsync(id);
    }

    private async Task ToggleArchivedAsync()
    {
        if (_chat == null) return;
        await _chat.SetShowArchivedAsync(!_chat.ShowArchived);
    }

    private async Task OnSearchChanged(string? text)
    {
        _search = text;
        if (_chat != null) await _chat.SetSearchAsync(text);
    }

    private void StartRename(AiConversationView c)
    {
        _renamingId = c.Id;
        _renameText = c.Title;
    }

    private async Task OnRenameKey(KeyboardEventArgs e, long id)
    {
        if (e.Key == "Enter") await SaveRenameAsync(id);
        else if (e.Key == "Escape") _renamingId = 0;
    }

    private async Task SaveRenameAsync(long id)
    {
        if (_renamingId != id || _chat == null) return;
        _renamingId = 0;
        string title = (_renameText ?? "").Trim();
        var current = _chat.Conversations.FirstOrDefault(c => c.Id == id);
        if (title.Length == 0 || current == null || title == current.Title) return;
        await _chat.RenameAsync(id, title);
    }

    private async Task DeleteAsync(AiConversationView c)
    {
        if (_chat == null) return;
        bool? ok = await DialogService.ShowMessageBoxAsync(Tr("AIC_DeleteTitle"), Tr("AIC_DeleteConfirm", string.IsNullOrWhiteSpace(c.Title) ? Tr("AIC_Untitled") : c.Title),
            yesText: Tr("AIC_Delete"), cancelText: Tr("AIC_Cancel"));
        if (ok == true) await _chat.DeleteAsync(c.Id);
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnChanged;
        if (_chat != null) _chat.OnChanged -= OnChanged;
    }
}
