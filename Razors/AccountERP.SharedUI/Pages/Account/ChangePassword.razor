@page "/change-password"

@* 🟢 شاشة تغيير كلمة المرور الخاصة بحساب المستخدم المسجّل دخوله حالياً - مضافة بجانب زر "تسجيل الخروج"
   فى القائمة الجانبية العلوية (راجع MainLayoutMud.razor). محمية تلقائياً بنفس بوابة الحماية العامة
   (EnforceAuthGuard فى MainLayoutMud) لأنها ليست ضمن PublicPaths.
   المنطق نفسه (التحقق من كلمة المرور القديمة، رفض كلمة مرور جديدة مستخدمة بالفعل، ثم التحديث) منقول
   حرفياً من LoginPro.ChangePassword (شاشة الويندوز فورمز الأصلية) إلى AuthService.ChangePasswordAsync
   فى AccountModelsLib، لأن LoginPro مشروع ويندوز فورمز غير متاح من مشاريع Blazor إطلاقاً - راجع
   MODERNIZATION_NOTES.md لتفاصيل القرار. *@

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using AccountModelsLib.Models
@using AccountERP.SharedUI.Services
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider ServiceProvider
@inject LanguageService LangService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject NotificationCenterService NotificationCenter
@implements IDisposable

<PageTitle>@Tr("ChangePasswordTitle")</PageTitle>

<div class="d-flex justify-content-center">
    <MudPaper Elevation="1" Class="pa-6 pa-md-8 rounded-lg" Style="width:100%; max-width:480px;">
        <div class="d-flex align-items-center mb-1" style="gap:12px;">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h5" Class="fw-bold">@Tr("ChangePasswordTitle")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Tr("ChangePasswordSubtitle")</MudText>
            </div>
        </div>

        <MudDivider Class="my-4" />

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@errorMessage</MudAlert>
        }

        <EditForm Model="@model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <MudTextField T="string" @bind-Value="model.OldPassword" Label="@Tr("OldPassword")"
                          Placeholder="@Tr("EnterOldPassword")" Variant="Variant.Outlined"
                          InputType="@(_showOld ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showOld ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showOld = !_showOld)"
                          Class="mb-4" FullWidth="true" For="@(() => model.OldPassword)"
                          UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "current-password" })" />

            <MudTextField T="string" @bind-Value="model.NewPassword" Label="@Tr("NewPassword")"
                          Placeholder="@Tr("EnterNewPassword")" Variant="Variant.Outlined"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showNew = !_showNew)"
                          Class="mb-4" FullWidth="true" For="@(() => model.NewPassword)"
                          UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "new-password" })" />

            <MudTextField T="string" @bind-Value="model.ConfirmNewPassword" Label="@Tr("ConfirmNewPassword")"
                          Placeholder="@Tr("EnterConfirmNewPassword")" Variant="Variant.Outlined"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showConfirm = !_showConfirm)"
                          Class="mb-2" FullWidth="true" For="@(() => model.ConfirmNewPassword)"
                          UserAttributes="@(new Dictionary<string, object> { ["autocomplete"] = "new-password" })" />

            <div class="d-flex align-items-center mt-4" style="gap:12px;">
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Large" Disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
                        @Tr("SavingPassword")
                    }
                    else
                    {
                        @Tr("SaveNewPassword")
                    }
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Large"
                           Disabled="@isProcessing" OnClick="@(() => NavigationManager.NavigateTo("/"))">
                    @Tr("BackToHome")
                </MudButton>
            </div>
        </EditForm>
    </MudPaper>
</div>

@code {
    private ChangePasswordModel model = new();
    private string errorMessage = string.Empty;
    private bool isProcessing = false;
    private bool _showOld = false;
    private bool _showNew = false;
    private bool _showConfirm = false;

    protected override void OnInitialized()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);

    // 🟢 Tr(...) بدلاً من Lang[...] مباشرة: نفس السبب والحل المُستخدَمين فى Login.razor/Home.razor -
    // راجع MODERNIZATION_NOTES.md.
    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;

        // 🟢 تحقق عاجل قبل استدعاء الخادم أصلاً: لو ساوت كلمة المرور الجديدة القديمة، AuthService.
        // ChangePasswordAsync سترفضها فعلاً (لأن صف المستخدم لا يزال يحمل القيمة القديمة وقت الفحص)
        // لكن برسالة "مستخدمة بالفعل" المُربكة فى هذه الحالة تحديداً - هذا الفحص هنا رسالة أوضح فقط،
        // لا يغيّر منطق الخادم نفسه.
        if (model.OldPassword == model.NewPassword)
        {
            errorMessage = Tr("NewPasswordMustDiffer");
            return;
        }

        isProcessing = true;
        try
        {
            // 🟢 يُحلّ IAuthService كسولاً هنا فقط عند الحفظ الفعلي - نفس نمط Login.razor (يتجنب بناء
            // My_DbContext ومحاولة اتصال حقيقي بقاعدة البيانات بمجرد فتح الشاشة).
            var authService = ServiceProvider.GetRequiredService<IAuthService>();
            var result = await authService.ChangePasswordAsync(model.OldPassword, model.NewPassword);

            switch (result)
            {
                case ChangePasswordResult.Success:
                    {
                        var message = Tr("ChangePasswordSuccess");
                        Snackbar.Add(message, MudBlazor.Severity.Success);
                        NotificationCenter.Add(message, MudBlazor.Severity.Success);
                        model = new ChangePasswordModel();
                        break;
                    }
                case ChangePasswordResult.InvalidOldPassword:
                    errorMessage = Tr("InvalidOldPassword");
                    break;
                case ChangePasswordResult.PasswordAlreadyUsed:
                    errorMessage = Tr("NewPasswordAlreadyUsed");
                    break;
            }
        }
        catch (Exception ex)
        {
            errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            isProcessing = false;
        }
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
    }

    private class ChangePasswordModel
    {
        [Required(ErrorMessage = "Required / مطلوب")]
        public string OldPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required / مطلوب")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Required / مطلوب")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match / كلمتا المرور غير متطابقتين")]
        public string ConfirmNewPassword { get; set; } = string.Empty;
    }
}
