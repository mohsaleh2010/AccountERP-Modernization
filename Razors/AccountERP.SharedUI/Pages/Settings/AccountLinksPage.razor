        _busy = true;
        var kind = Kind;
        long party = row.PartyId;
        string err = await RunAsync(() => { int e = 0; string m = ""; _svc.Unlink(ref e, ref m, kind, party); return (e, m); });
        _busy = false;
        if (err != "") { _error = err; return; }
        Snackbar.Add(Tr("AL_Unlinked", row.PartyName), Severity.Success);
        await LoadAsync();
    }

    // ---------- إنشاء حساب ----------
    private async Task CreateAsync(AccountLinkRow row)
    {
        _busy = true;
