    private async Task CreateAllAsync()
    {
        var targets = VisibleUnlinked;
        if (targets.Count == 0) return;
        bool? ok = await DialogService.ShowMessageBoxAsync(Tr("AL_CreateAll", targets.Count), Tr("AL_CreateAllConfirm", targets.Count),
                                                          yesText: Tr("AL_CreateAll", targets.Count), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _busy = true;
        var kind = Kind;
        long branch = Common.Branch_Id;
        var ids = targets.Select(r => r.PartyId).ToList();
        var (done, firstError) = await Bg(() =>
        {
            int n = 0;
            string first = "";
            foreach (long id in ids)
            {
                int e = 0; string m = "";
                _svc.CreateAccount(ref e, ref m, kind, id, branch);
                if (e == 0) n++;
                else if (first == "") first = m;
                if (e == 2 && m.Contains("الحساب الرئيسى")) break;   // لا أب للنوع: باقى المحاولات ستفشل بنفس السبب
            }
            return (n, first);
        });
        _busy = false;
        if (firstError != "") _error = firstError;
        Snackbar.Add(Tr("AL_CreatedN", done), done > 0 ? Severity.Success : Severity.Info);
        await LoadAsync();
    }

    // ---------- المطابقة بالاسم ----------
    private async Task OpenMatchesAsync()
    {
        try
        {
            var kind = Kind;
            long branch = Common.Branch_Id;
            _matches = await Bg(() => _svc.SuggestMatches(kind, branch));
            _matchOpen = true;
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
    }

    private async Task ApplyMatchesAsync()
    {
        _busy = true;
        var kind = Kind;
        var pairs = _matches.Select(m => (m.PartyId, m.SubAccount_Id)).ToList();
        var (done, firstError) = await Bg(() =>
        {
            int n = 0;
            string first = "";
            foreach (var (party, account) in pairs)
            {
                int e = 0; string m = "";
                _svc.Link(ref e, ref m, kind, party, account);
                if (e == 0) n++;
                else if (first == "") first = m;
            }
            return (n, first);
        });
        _busy = false;
        _matchOpen = false;
        if (firstError != "") _error = firstError;
        Snackbar.Add(Tr("AL_LinkedN", done), done > 0 ? Severity.Success : Severity.Info);
        await LoadAsync();
    }

    // ---------- الحسابات الرئيسية ----------
    private void OpenParentPicker(AccountLinkParentRow row)
    {
        _parentRow = row;
        _treeNode = null;
        _dialogError = null;
        _parentOpen = true;
    }

    private async Task OnParentPicked(AccountTreeNodeViewModel? node)
    {
        _treeNode = node;
        if (node == null || _parentRow == null) return;
        _busy = true;
        long branch = Common.Branch_Id, account = node.Id;
        int type = _parentRow.Account_Type_Value;
        bool general = _parentRow.GeneralCustomer;
        string err = await RunAsync(() => { int e = 0; string m = ""; _svc.SaveParent(ref e, ref m, branch, type, general, account); return (e, m); });
        _busy = false;
        if (err != "") { _dialogError = err; return; }
        _parentOpen = false;
        Snackbar.Add(Tr("AL_ParentSaved", TypeName(type)), Severity.Success);
        await LoadAsync();
    }
