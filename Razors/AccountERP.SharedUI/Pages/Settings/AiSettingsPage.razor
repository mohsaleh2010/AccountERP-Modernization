    }

    private async Task StartSignInAsync(long providerId, string providerName)
    {
        if (_gw == null) return;
        _error = null;
        _edit = null;
        _fetched = null;
        _busy = true;
        try
        {
            var gw = _gw; long uid = _userId; string origin = Nav.BaseUri;
            var start = await Bg(() => gw.StartSignIn(providerId, origin, uid));
            _pollCts?.Cancel();
            _signIn = start;
            _signInStatus = null;
            _signInCode = null;
            _signInProviderId = providerId;
            _signInProviderName = providerName;
            _pollCts = new CancellationTokenSource();
            _ = PollAsync(start.Handle, _pollCts.Token);
        }
        catch (Exception ex) { _error = Err(ex); }
        finally { _busy = false; }
    }

    /// <summary>استعلام كل ثانيتين عن نتيجة الربط (يكتمل من نقطة الرجوع فى تبويب آخر).</summary>
    private async Task PollAsync(string handle, CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var gw = _gw; long uid = _userId;
                if (gw == null) return;
                var st = gw.GetSignInStatus(handle, uid);
                if (st.State == "pending") continue;
                await InvokeAsync(async () => await OnSignInFinishedAsync(st));
                return;
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { await InvokeAsync(() => { _error = Err(ex); StateHasChanged(); }); }
    }

    private async Task CompleteWithCodeAsync()
    {
        if (_gw == null || _signIn == null) return;
        _busy = true;
        try
        {
            var gw = _gw; long uid = _userId; string handle = _signIn.Handle, code = _signInCode ?? "";
            var st = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return gw.CompleteSignInWithCodeAsync(handle, code, uid); });
            _busy = false;
            await OnSignInFinishedAsync(st);
        }
        catch (Exception ex) { _error = Err(ex); }
        finally { _busy = false; }
    }

    private async Task OnSignInFinishedAsync(AiSignInStatus st)
    {
        _pollCts?.Cancel();
        _signInStatus = st;
        _signInCode = null;
        if (st.State == "done")
        {
            Snackbar.Add(Tr("AI_SignInDone"), Severity.Success);
            _signIn = null;
            _signInStatus = null;
            await LoadAsync();
            var p = _providers.FirstOrDefault(x => x.Id == _signInProviderId);
            if (p is { IsEnabled: true }) await TestAsync(p);
        }
        StateHasChanged();
    }

    private void CloseSignIn()
    {
        _pollCts?.Cancel();
        _signIn = null;
        _signInStatus = null;
        _signInCode = null;
    }

