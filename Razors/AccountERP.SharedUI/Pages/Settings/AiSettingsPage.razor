    // ───────────── ربط المهام ─────────────

    private string _savedRouting = "";

    private static string RoutingSnapshot(IEnumerable<AiTaskRoutingRow> rows) =>
        string.Join("|", rows.OrderBy(r => r.TaskKey).ThenBy(r => r.Priority)
            .Select(r => $"{r.TaskKey}:{r.Priority}:{r.Model_Id}:{r.Effort}:{r.MaxTokens}:{r.Temperature}"));

    private bool RoutingDirty => RoutingSnapshot(_routing) != _savedRouting;

    /// <summary>بحث النماذج المفعّلة بالمزوّد أو المعرّف أو الاسم (أول 60)، مع إبقاء النموذج المختار حالياً.</summary>
    private Task<IEnumerable<AiModelRow>> SearchModels(string? q, long currentId)
    {
        var list = _models.Where(m => m.IsEnabled || m.Id == currentId);
        if (!string.IsNullOrWhiteSpace(q))
        {
            var words = q.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            list = list.Where(m => words.All(w => m.ModelId.Contains(w, StringComparison.OrdinalIgnoreCase)
                                               || m.DisplayName.Contains(w, StringComparison.OrdinalIgnoreCase)
                                               || m.ProviderName.Contains(w, StringComparison.OrdinalIgnoreCase)));
        }
        return Task.FromResult(list.OrderBy(m => m.ModelId, StringComparer.OrdinalIgnoreCase).Take(60).AsEnumerable());
    }

    private void AddRoute(string task)
    {
        int next = _routing.Where(r => r.TaskKey == task).Select(r => r.Priority).DefaultIfEmpty(0).Max() + 1;
        var preferred = _models.FirstOrDefault(m => m.IsEnabled && (task == AiTaskKeys.Embedding ? m.SupportsEmbeddings : task == AiTaskKeys.Vision ? m.SupportsVision : !m.SupportsEmbeddings))
                        ?? _models.First();
        _routing.Add(new AiTaskRoutingRow { TaskKey = task, Priority = next, Model_Id = preferred.Id, Effort = task == AiTaskKeys.Fast ? "low" : "" });
    }

    private void RemoveRoute(AiTaskRoutingRow r)
    {
        _routing.Remove(r);
        int i = 1;
        foreach (var x in _routing.Where(x => x.TaskKey == r.TaskKey).OrderBy(x => x.Priority)) x.Priority = i++;
    }

