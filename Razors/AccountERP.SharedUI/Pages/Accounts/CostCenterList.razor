@* 🟢 شاشة "مراكز التكلفة" (الشجرة) - النسخة Blazor من Account_Common_LIB.Cost_CenterTree.
   Cost_Center_TreeFrm.cs (WinForms، تُفتَح من MainFrm_AccountUpdate.ToolStripMenuItemCostTree_Click).
   نفس شكل شجرة الحسابات بالضبط (Parent_Id ذاتي المرجعية) لكن بلا فلترة فرع (Cost_Center_Tree لا يحتوي
   Branch_Id) - راجع CostCenterTreePicker.razor لتفاصيل قرار عدم تعميم AccountTreePicker.

   كل القراءة/الإضافة/التعديل/الحذف تمر عبر AccountModelsLib.CostCenterCLS (موجودة بالفعل فى AccountModelsLib،
   لم تحتج نقل كـ CurrencyCLS) - بدون أي منطق أعمال جديد هنا، فقط واجهة Blazor فوق نفس الاستدعاءات بالضبط.
   حقول Code_Str/Name/Notes فقط قابلة للتعديل (نفس CostCenterCLS.Edit_CostCenter بالضبط) - FirstSubCode/
   Cost_Level للعرض فقط لأن الأصل لا يحفظهما عند التعديل إطلاقاً (راجع MODERNIZATION_NOTES.md). *@

@page "/accounts/cost-centers"

@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.BusinessLibShared.CostCenters
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.ViewModels
@using AccountERP.SharedUI.Components.Shared
@inject LanguageService LangService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@Tr("CostCentersTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")}; height: calc(100vh - 100px); display:flex; flex-direction:column; min-height:0;")">

    <MudPaper Class="pa-4 mb-4" Elevation="1" Style="flex: 0 0 auto;">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@Tr("CostCentersTitle")</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.AccountTree"
                           OnClick="OpenAddRootDialog" Disabled="@_isBusy">
                    @Tr("AddRootCostCenterButton")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddDialog" Disabled="@(_selected == null || _isBusy)">
                    @Tr("AddCostCenterButton")
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4" Style="flex: 0 0 auto;" ContentAlignment="HorizontalAlignment.Left">@_errorMessage</MudAlert>
    }

    <MudGrid Spacing="3" Style="flex: 1 1 auto; min-height: 0;">
        <MudItem xs="12" md="5" Style="height:100%;">
            <MudPaper Class="pa-3" Elevation="1" Style="height:100%; overflow:hidden;">
                <CostCenterTreePicker @ref="_treePicker" SelectedValue="_selected"
                                       SelectedValueChanged="OnNodeSelected" Height="100%" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7" Style="height:100%;">
            <MudPaper Class="pa-4" Elevation="1" Style="height:100%; overflow-y:auto;">
                @if (_selected == null)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("NoCostCenterSelected")</MudAlert>
                }
                else
                {
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3" AlignItems="AlignItems.Center">
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor()" Variant="Variant.Filled">@Tr("CostCenterStatus" + (_detail?.Status ?? 1))</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(_detail?.IsLeaf == false ? Tr("CostCenterNotLeaf") : Tr("CostCenterIsLeaf"))</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Tr("CostCenterEntryLines"): @(_usage?.EntryLines ?? 0)</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Tr("CostCenterAccountLinks"): @(_usage?.AccountLinks ?? 0)</MudChip>
                    </MudStack>

                    <MudGrid Spacing="3">
                        <MudItem xs="12" sm="7">
                            <MudTextField T="string" @bind-Value="_selected.Name" Label="@Tr("CostCenterNameLabel")" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField T="string" Value="_selected.Code_Str" Label="@Tr("CostCenterCodeLabel")" ReadOnly="true" />
                        </MudItem>
                        <MudItem xs="12" sm="7">
                            <MudTextField T="string" @bind-Value="_nameE" Label="@Tr("CostCenterNameELabel")" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudSelect T="int" @bind-Value="_type" Label="@Tr("CostCenterTypeLabel")">
                                @for (var t = 0; t <= 6; t++)
                                {
                                    <MudSelectItem T="int" Value="@t">@Tr("CostCenterType" + t)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Tr("AccountLevelLabel"): @_selected.Cost_Level</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@Tr("FirstSubCodeLabel"): @_selected.FirstSubCode</MudText>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="_selected.Notes" Label="@Tr("NotesLabel")" Lines="2" />
                        </MudItem>
                    </MudGrid>

                    <MudDivider Class="my-4" />

                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveEditAsync" Disabled="_isBusy">
                            @Tr("SaveEditButton")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.DriveFileMove"
                                   OnClick="OpenMoveDialog" Disabled="_isBusy">
                            @Tr("MoveCostCenterButton")
                        </MudButton>
                        @if (_detail?.IsOpen == false)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.LockOpen"
                                       OnClick="() => SetStatusAsync(1)" Disabled="_isBusy">@Tr("ReopenCostCenterButton")</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Lock"
                                       OnClick="() => SetStatusAsync(3)" Disabled="_isBusy">@Tr("CloseCostCenterButton")</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                                   OnClick="DeleteAsync" Disabled="_isBusy">
                            @Tr("DeleteAccountButton")
                        </MudButton>
                    </MudStack>

                    @if (_type == 1)
                    {
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.h6" Class="mb-3">@Tr("CostCenterProjectCard")</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="12" sm="6">
                                <MudAutocomplete T="CostCenterService.CustomerRow" Value="_customer" ValueChanged="c => _customer = c"
                                                 SearchFunc="SearchCustomersAsync" ToStringFunc="@(c => c?.Name)" Label="@Tr("ProjectCustomerLabel")"
                                                 Clearable="true" ResetValueOnEmptyText="true" CoerceText="false" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" @bind-Value="_project.ContractValue" Label="@Tr("ProjectContractValueLabel")" Min="0" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Date="_project.StartDate" DateChanged="d => _project.StartDate = d" Label="@Tr("ProjectStartDateLabel")" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudDatePicker Date="_project.EndDate" DateChanged="d => _project.EndDate = d" Label="@Tr("ProjectEndDateLabel")" Clearable="true" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int" @bind-Value="_project.Status" Label="@Tr("ProjectStatusLabel")">
                                    @for (var s = 1; s <= 4; s++)
                                    {
                                        <MudSelectItem T="int" Value="@s">@Tr("ProjectStatus" + s)</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField T="decimal" @bind-Value="_project.RetentionPercent" Label="@Tr("ProjectRetentionLabel")" Min="0" Max="100" HideSpinButtons="true" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string" @bind-Value="_project.Notes" Label="@Tr("NotesLabel")" Lines="2" />
                            </MudItem>
                        </MudGrid>
                        <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="SaveProjectAsync" Disabled="_isBusy">@Tr("SaveProjectButton")</MudButton>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<AddCostCenterDialog @bind-Visible="_addDialogOpen" ParentNode="_selected" OnCostCenterAdded="OnCostCenterAddedAsync" />
<AddCostCenterDialog @bind-Visible="_addRootDialogOpen" ParentNode="_selected" IsRoot="true" OnCostCenterAdded="OnRootCostCenterAddedAsync" />

<MudDialog @bind-Visible="_moveDialogOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true })">
    <TitleContent>@Tr("MoveCostCenterTitle")</TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@_selected?.Code_Str &nbsp; @_selected?.Name</MudText>
        <div style="height:360px;">
            <CostCenterTreePicker SelectedValue="_moveTarget" SelectedValueChanged="n => _moveTarget = n" Height="100%" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _moveDialogOpen = false">@Tr("Cancel")</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="() => MoveAsync(0)">@Tr("MoveToRootButton")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_moveTarget == null)" OnClick="() => MoveAsync(_moveTarget!.Id)">@Tr("MoveHereButton")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private CostCenterTreePicker? _treePicker;
    private CostCenterNodeViewModel? _selected;
    private bool _addDialogOpen;
    private bool _addRootDialogOpen;
    private bool _isBusy;
    private string? _errorMessage;
    private bool _moveDialogOpen;
    private CostCenterNodeViewModel? _moveTarget;
    private CostCenterService.Node? _detail;
    private CostCenterService.Usage? _usage;
    private string _nameE = "";
    private int _type;
    private CostCenterService.ProjectInfo _project = new();
    private CostCenterService.CustomerRow? _customer;

    protected override void OnInitialized()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);

    private async Task OnNodeSelected(CostCenterNodeViewModel? node)
    {
        _selected = node;
        _errorMessage = null;
        await LoadDetailAsync();
    }

    // تفاصيل العقدة المختارة (الحالة/الورقية/الاستخدام/NameE/النوع/بطاقة المشروع) من الخدمة المشتركة.
    private async Task LoadDetailAsync()
    {
        _detail = null; _usage = null; _customer = null; _project = new();
        if (_selected == null) return;
        var id = _selected.Id;
        try
        {
            var r = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var opp = new operations();
                var d = CostCenterService.Get(opp, id);
                return (d, CostCenterService.GetUsage(opp, id), d != null && d.CostType == 1 ? CostCenterService.GetProject(opp, id) : new CostCenterService.ProjectInfo());
            });
            _detail = r.d; _usage = r.Item2; _project = r.Item3;
            _nameE = _detail?.NameE ?? "";
            _type = (int)(_detail?.CostType ?? 0);
            if (_project.CustomerId > 0) _customer = new CostCenterService.CustomerRow { Id = _project.CustomerId, Name = _project.CustomerName };
        }
        catch (Exception ex) { _errorMessage = Tr("SystemError", ex.Message); }
    }

    private Color StatusColor() => (_detail?.Status ?? 1) switch { 3 => Color.Error, 2 => Color.Warning, _ => Color.Success };

    private async Task<IEnumerable<CostCenterService.CustomerRow>> SearchCustomersAsync(string value, CancellationToken token) =>
        await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return (IEnumerable<CostCenterService.CustomerRow>)CostCenterService.SearchCustomers(new operations(), value); });

    private void OpenMoveDialog() { _moveTarget = null; _moveDialogOpen = true; }

    private async Task RefreshAfterChangeAsync(long id)
    {
        if (_treePicker != null)
        {
            await _treePicker.ReloadAsync();
            await _treePicker.SelectAndRevealAsync(id);
        }
    }

    private async Task MoveAsync(long newParentId)
    {
        if (_selected == null) return;
        _isBusy = true; _errorMessage = null;
        var id = _selected.Id; var first = string.IsNullOrEmpty(_selected.FirstSubCode) ? "1" : _selected.FirstSubCode;
        try
        {
            var res = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return CostCenterService.Move(new operations(), id, newParentId, first); });
            if (res.Ok) { _moveDialogOpen = false; Snackbar.Add(Tr("CostCenterMoved"), Severity.Success); await RefreshAfterChangeAsync(id); }
            else _errorMessage = res.Message;
        }
        catch (Exception ex) { _errorMessage = Tr("SystemError", ex.Message); }
        finally { _isBusy = false; }
    }

    private async Task SetStatusAsync(int status)
    {
        if (_selected == null) return;
        _isBusy = true; _errorMessage = null;
        var id = _selected.Id;
        try
        {
            var res = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return CostCenterService.SetStatus(new operations(), id, (CostCenterStatus)status, Common.User_Id); });
            if (res.Ok) { Snackbar.Add(Tr("CostCenterStatusChanged"), Severity.Success); await LoadDetailAsync(); }
            else _errorMessage = res.Message;
        }
        catch (Exception ex) { _errorMessage = Tr("SystemError", ex.Message); }
        finally { _isBusy = false; }
    }

    private async Task SaveProjectAsync()
    {
        if (_selected == null) return;
        _isBusy = true; _errorMessage = null;
        var id = _selected.Id; _project.CustomerId = _customer?.Id ?? 0; var p = _project;
        try
        {
            var res = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return CostCenterService.SaveProject(new operations(), id, p, Common.User_Id); });
            if (res.Ok) Snackbar.Add(Tr("ProjectSaved"), Severity.Success);
            else _errorMessage = res.Message;
        }
        catch (Exception ex) { _errorMessage = Tr("SystemError", ex.Message); }
        finally { _isBusy = false; }
    }

    private void OpenAddDialog()
    {
        if (_selected == null) return;
        _addDialogOpen = true;
    }

    private void OpenAddRootDialog()
    {
        _addRootDialogOpen = true;
    }

    private async Task OnCostCenterAddedAsync(long newCode)
    {
        Snackbar.Add(Tr("CostCenterAdded"), Severity.Success);
        if (_treePicker != null)
        {
            var reselectId = _selected?.Id;
            await _treePicker.ReloadAsync();
            if (reselectId.HasValue)
            {
                await _treePicker.SelectAndRevealAsync(reselectId.Value);
            }
        }
    }

    private async Task OnRootCostCenterAddedAsync(long newCode)
    {
        Snackbar.Add(Tr("RootCostCenterAdded"), Severity.Success);
        if (_treePicker != null)
        {
            await _treePicker.ReloadAsync();
            await _treePicker.SelectAndRevealAsync(newCode);
        }
    }

    // 🟢 يقابل BtnEdit_Click فى الأصل: نفس الاستدعاء بالضبط CostCenterCLS.Edit_CostCenter (Name/Code_Str/
    // Notes فقط - لا يوجد FirstSubCode/Cost_Level ضمن الأعمدة القابلة للحفظ فى الأصل).
    private async Task SaveEditAsync()
    {
        if (_selected == null) return;
        if (string.IsNullOrWhiteSpace(_selected.Name)) { _errorMessage = Tr("CostCenterNameRequired"); return; }

        _isBusy = true;
        _errorMessage = null;
        var node = _selected; var nameE = _nameE; var type = (CostCenterType)_type;
        CostCenterService.Result res = null!;
        try
        {
            res = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return CostCenterService.Update(new operations(), node.Id, node.Name, nameE, type, node.Notes ?? "", Common.User_Id);
            });

            if (res.Ok)
            {
                Snackbar.Add(Tr("AccountUpdated"), Severity.Success);
                var selectedId = node.Id;
                if (_treePicker != null)
                {
                    await _treePicker.ReloadAsync();
                    await _treePicker.SelectAndRevealAsync(selectedId);
                }
            }
            else
            {
                _errorMessage = string.IsNullOrEmpty(res.Message) ? Tr("SystemError", "") : res.Message;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    // 🟢 يقابل btnDelete_Click فى الأصل: نفس فحص الأمان بالضبط (Check_Account_No_Found_OnSubAccount يمنع
    // حذف عقدة لها أبناء) قبل استدعاء CostCenterCLS.Delete_CostCenter.
    private async Task DeleteAsync()
    {
        if (_selected == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Tr("DeleteCostCenterTitle"),
            Tr("DeleteCostCenterConfirm", _selected.Name),
            yesText: Tr("Yes"), cancelText: Tr("No"));

        if (confirmed != true) return;

        _isBusy = true;
        _errorMessage = null;
        var id = _selected.Id;
        try
        {
            var res = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return CostCenterService.Delete(new operations(), id); });
            int excp = res.Ok ? 0 : 1; string msg = res.Message ?? "";
            if (excp == 0)
            {
                Snackbar.Add(Tr("AccountDeleted"), Severity.Success);
                _selected = null;
                if (_treePicker != null)
                {
                    await _treePicker.ReloadAsync();
                }
            }
            else
            {
                _errorMessage = string.IsNullOrEmpty(msg) ? Tr("AccountCannotDelete") : msg;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
    }
}
