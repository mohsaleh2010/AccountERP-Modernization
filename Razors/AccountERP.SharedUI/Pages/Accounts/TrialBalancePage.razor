@* 🟢 «ميزان المراجعة» (بدل Mezan_Morgaa_ByPeriod وMezan_Morgaa_ByPeriodByAccountDeletePrevious وطباعتيهما RDLC): صفحة واحدة بوضعين.
   mode=totals: مجاميع الحركة ورصيد الفترة (Mezan_Morgaa_ByPeriod(false))؛ mode=closing: رصيد أول المدة + الحركة + الرصيد الختامى (النسخة الكاملة).
   الحساب نفسه فى الاثنين: FinalAccountsService.GetTrialBalance ⇒ LedgerBalanceEngine (ف3 من financial-statements-review-plan.md): قراءة فقط من القيود
   + الافتتاحى المخزَّن، بلا جداول مؤقتة ولا قفل؛ شريط الاتزان يفحص الافتتاحى والحركة والختامى.
   «ترحيل الرصيد الختامى» و«تحديث رصيد أول المدة» (صلاحيتا 317/318) لا تُنقلان هنا: تعيدان كتابة Account_Entry_Master_Balance وتنتظران قراراً (خطة final-accounts-razor-plan.md §3.4).
   الطباعة بـ window.print مع CSS للطباعة بدل تقرير RDLC. التصميم حسب ui-ux-pro-max ونظام inv-* المشترك. *@
@page "/accounts/final/trial-balance"

@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.BusinessLibShared.GeneralLedger
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@inject LanguageService LangService
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IServiceProvider ServiceProvider
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@Title</PageTitle>

<InvoiceStyles />

<style>
    .tb-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .tb-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .tb-head .ico .mud-icon-root { font-size: 2rem; }
    .tb-head .titles { flex: 1 1 260px; min-width: 0; }
    .tb-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .tb-gap { margin-top: 16px; }
    .tb-filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: start; }
    .tb-btns { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; align-items: center; }
    .tb-wrap { overflow-x: auto; }
    table.tb { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    table.tb th, table.tb td { padding: 6px 10px; border-bottom: 1px solid var(--mud-palette-lines-default); white-space: nowrap; }
    table.tb thead th { position: sticky; top: 0; background: var(--mud-palette-surface); font-weight: 700; text-align: center; z-index: 1; }
    table.tb td.num { text-align: end; }
    table.tb td.name { white-space: normal; min-width: 220px; }
    table.tb tr.grp td { background: color-mix(in srgb, var(--mud-palette-primary) 10%, transparent); font-weight: 700; }
    table.tb tr.sub td { font-weight: 700; border-top: 1px solid var(--mud-palette-text-secondary); }
    table.tb tr.grand td { font-weight: 800; background: color-mix(in srgb, var(--mud-palette-primary) 16%, transparent); border-top: 2px solid var(--mud-palette-primary); }
    .tb-status { margin-top: 12px; }
    .tb-print-title { display: none; }
    /* P8.9.2: اختيار صف لشرح رصيده (حين المساعد متاح فقط) */
    table.tb tr.selectable { cursor: pointer; }
    table.tb tr.selectable:focus-visible { outline: 2px solid var(--mud-palette-primary); outline-offset: -2px; }
    table.tb tr.sel td { background: var(--mud-palette-action-default-hover); }
    table.tb tr.sel td:first-child { border-inline-start: 4px solid var(--mud-palette-primary); }
    .tb-selbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 10px; padding: 8px 12px; border-radius: 8px;
                 border: 1px dashed var(--mud-palette-lines-default); font-size: .9rem; color: var(--mud-palette-text-secondary); }
    .tb-selbar .mud-button-root { min-height: 44px; }
    .tb-selbar .mud-icon-button { min-width: 44px; min-height: 44px; }
    @@media (max-width: 1099px) { .tb-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 599px) { .tb-filters { grid-template-columns: minmax(0, 1fr); } }
    @@media print {
        .tb-noprint, .mud-appbar, .mud-drawer, nav { display: none !important; }
        .tb-print-title { display: block; margin-bottom: 8px; }
        .tb-wrap { overflow: visible; }
        table.tb thead th { position: static; }
        table.tb tr.sel td { background: none !important; border-inline-start: 0 !important; }
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">

    <div class="inv-card tb-head tb-noprint">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.AccountBalance" /></div>
        <div class="titles">
            <h1 class="inv-title">@Title</h1>
            <div class="sub">@Tr("TBSub")</div>
        </div>
    </div>

    <div class="inv-card tb-gap tb-noprint">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.FilterList" />@Tr("SOFiltersTitle")</h2>
        <div class="tb-filters">
            <MudSelect T="long" Value="_periodId" ValueChanged="OnPeriodAsync" Label="@Tr("FAPeriod")" Variant="Variant.Outlined" ToStringFunc="@(v => PeriodText(v))">
                @foreach (var p in _periods)
                {
                    <MudSelectItem T="long" Value="@p.Id">@PeriodText(p.Id)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="long" Value="_branch" ValueChanged="@(v => { _branch = v; Reset(); })" Label="@Tr("FABranch")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => _branches.FirstOrDefault(b => b.Id == v)?.Name ?? "")">
                @foreach (var b in _branches)
                {
                    <MudSelectItem T="long" Value="@b.Id">@b.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="long" Value="_currency" ValueChanged="@(v => { _currency = v; Reset(); })" Label="@Tr("FACurrency")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => _currencies.FirstOrDefault(c => c.Id == v)?.Name ?? "")">
                @foreach (var c in _currencies)
                {
                    <MudSelectItem T="long" Value="@c.Id">@c.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="FinalAccountsService.BalanceFilter" Value="_filter" ValueChanged="@(v => { _filter = v; Reset(); })" Label="@Tr("TBFilter")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => FilterText(v))">
                <MudSelectItem T="FinalAccountsService.BalanceFilter" Value="FinalAccountsService.BalanceFilter.All">@FilterText(FinalAccountsService.BalanceFilter.All)</MudSelectItem>
                <MudSelectItem T="FinalAccountsService.BalanceFilter" Value="FinalAccountsService.BalanceFilter.WithBalance">@FilterText(FinalAccountsService.BalanceFilter.WithBalance)</MudSelectItem>
                <MudSelectItem T="FinalAccountsService.BalanceFilter" Value="FinalAccountsService.BalanceFilter.MovementOnly">@FilterText(FinalAccountsService.BalanceFilter.MovementOnly)</MudSelectItem>
            </MudSelect>
            <MudDatePicker T="DateTime?" Date="_from" DateChanged="@(d => { _from = d; Reset(); })" Label="@Tr("FADateFrom")" Variant="Variant.Outlined"
                           MinDate="@PeriodFrom" MaxDate="@PeriodTo" Editable="true" />
            <MudDatePicker T="DateTime?" Date="_to" DateChanged="@(d => { _to = d; Reset(); })" Label="@Tr("FADateTo")" Variant="Variant.Outlined"
                           MinDate="@PeriodFrom" MaxDate="@PeriodTo" Editable="true" />
            <MudTextField T="string" @bind-Value="_search" Immediate="true" Label="@Tr("TBSearch")" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
        <div class="tb-btns">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility"
                       Disabled="@_loading" OnClick="ShowAsync">@Tr("FAShow")</MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print"
                       Disabled="@(_loading || _result == null)" OnClick="PrintAsync">@Tr("FAPrint")</MudButton>
            @if (_loading) { <MudProgressCircular Indeterminate="true" Size="Size.Small" /> }
        </div>
        <MudAlert Severity="Severity.Info" Dense="true" Class="tb-status" role="note">@Tr("TBEngineHint") @Tr("TBWritesHint")</MudAlert>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="tb-gap" role="alert">@_error</MudAlert>
    }

    @if (_result != null)
    {
        <div class="inv-card tb-gap">
            <div class="tb-print-title">
                <strong>@Title</strong> — @PeriodText(_periodId) — @(_branches.FirstOrDefault(b => b.Id == _branch)?.Name) — @(_currencies.FirstOrDefault(c => c.Id == _currency)?.Name)
                (@_from?.ToString("yyyy/MM/dd") → @_to?.ToString("yyyy/MM/dd"))
            </div>
            @if (_result.RowCount == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" role="status">@Tr("TBNoData")</MudAlert>
            }
            else
            {
                @if (AssistOn)
                {
                    <div class="tb-selbar tb-noprint" role="region" aria-live="polite" aria-label="@Tr("AIH_Title")">
                        <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Small" Color="Color.Primary" aria-hidden="true" />
                        @if (SelectedRow == null)
                        {
                            <span>@Tr("AIH_RowHint")</span>
                        }
                        else
                        {
                            <span style="color:var(--mud-palette-text-primary);font-weight:600;">@Tr("AIH_SelectedAccount", SelectedRow.Code + " " + SelectedRow.AccountName)</span>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="ExplainAccountAsync">@Tr("AIH_Btn_ExplainBalance")</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@Tr("AIH_ClearSelection")" Title="@Tr("AIH_ClearSelection")" OnClick="@(() => _selectedAccountId = 0)" />
                        }
                    </div>
                }
                <div class="tb-wrap">
                    <table class="tb">
                        <thead>
                            <tr>
                                <th>@Tr("TBColCode")</th>
                                <th>@Tr("TBColAccount")</th>
                                @if (Closing)
                                {
                                    <th>@Tr("TBFirstDebit")</th><th>@Tr("TBFirstCredit")</th>
                                }
                                <th>@Tr("TBMoveDebit")</th><th>@Tr("TBMoveCredit")</th>
                                @if (Closing)
                                {
                                    <th>@Tr("TBLastDebit")</th><th>@Tr("TBLastCredit")</th>
                                }
                                else
                                {
                                    <th>@Tr("TBPeriodDebit")</th><th>@Tr("TBPeriodCredit")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in VisibleGroups)
                            {
                                <tr class="grp"><td colspan="@ColCount">@g.MainCode @g.MainAccountName</td></tr>
                                @foreach (var r in g.Rows)
                                {
                                    var row = r;
                                    bool sel = AssistOn && row.AccountId == _selectedAccountId;
                                    <tr class="@(AssistOn ? (sel ? "selectable sel" : "selectable") : null)" tabindex="@(AssistOn ? "0" : null)"
                                        aria-selected="@(AssistOn ? (sel ? "true" : "false") : null)"
                                        @onclick="@(() => SelectRow(row.AccountId))" @onkeydown="@(e => RowKey(e, row.AccountId))">
                                        <td>@if (sel) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="vertical-align:middle" aria-hidden="true" /> }@r.Code</td>
                                        <td class="name">@r.AccountName</td>
                                        @if (Closing)
                                        {
                                            <td class="num">@N(r.FirstMadin)</td><td class="num">@N(r.FirstDa2n)</td>
                                        }
                                        <td class="num">@N(r.Import)</td><td class="num">@N(r.Export)</td>
                                        @if (Closing)
                                        {
                                            <td class="num">@N(r.LastMadin)</td><td class="num">@N(r.LastDa2n)</td>
                                        }
                                        else
                                        {
                                            <td class="num">@N(r.TransactionMadin)</td><td class="num">@N(r.TransactionDa2n)</td>
                                        }
                                    </tr>
                                }
                                <tr class="sub">
                                    <td></td><td>@Tr("TBSubTotal") @g.MainAccountName</td>
                                    @if (Closing)
                                    {
                                        <td class="num">@N(g.Total.FirstMadin)</td><td class="num">@N(g.Total.FirstDa2n)</td>
                                    }
                                    <td class="num">@N(g.Total.Import)</td><td class="num">@N(g.Total.Export)</td>
                                    @if (Closing)
                                    {
                                        <td class="num">@N(g.Total.LastMadin)</td><td class="num">@N(g.Total.LastDa2n)</td>
                                    }
                                    else
                                    {
                                        <td class="num">@N(g.Total.TransactionMadin)</td><td class="num">@N(g.Total.TransactionDa2n)</td>
                                    }
                                </tr>
                            }
                            <tr class="grand">
                                <td></td><td>@Tr("TBTotal")</td>
                                @if (Closing)
                                {
                                    <td class="num">@N(_result.Total.FirstMadin)</td><td class="num">@N(_result.Total.FirstDa2n)</td>
                                }
                                <td class="num">@N(_result.Total.Import)</td><td class="num">@N(_result.Total.Export)</td>
                                @if (Closing)
                                {
                                    <td class="num">@N(_result.Total.LastMadin)</td><td class="num">@N(_result.Total.LastDa2n)</td>
                                }
                                else
                                {
                                    <td class="num">@N(_result.Total.TransactionMadin)</td><td class="num">@N(_result.Total.TransactionDa2n)</td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
                <MudAlert Severity="@(_result.IsBalanced ? Severity.Success : Severity.Warning)" Dense="true" Class="tb-status tb-noprint" role="status">
                    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px 12px;">
                        <span>@(_result.IsBalanced ? Tr("TBBalanced") : Tr("TBUnbalanced", UnbalancedText))</span>
                        @if (!_result.IsBalanced && AssistOn)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" Style="min-height:40px" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="ExplainUnbalancedAsync">@Tr("AIH_Btn_WhyUnbalanced")</MudButton>
                        }
                    </div>
                </MudAlert>
            }
        </div>
    }
</div>
</MudContainer>

@code {
    // P3 المساعد الذكى (open_screen): ?from=&to=&branch=&run=1 اختيارية؛ بدونها السلوك الافتراضى كما هو.
    [SupplyParameterFromQuery(Name = "from")] public string? FromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToQuery { get; set; }
    [SupplyParameterFromQuery(Name = "branch")] public long? BranchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "run")] public int? RunQuery { get; set; }
    [SupplyParameterFromQuery(Name = "filter")] public string? FilterQuery { get; set; }

    [SupplyParameterFromQuery(Name = "mode")] public string? Mode { get; set; }

    private readonly FinalAccountsService _svc = new();
    private List<FinalAccountsService.PeriodRow> _periods = new();
    private List<FinalAccountsService.Option> _branches = new(), _currencies = new();
    private long _periodId, _branch, _currency = FinalAccountsService.EquivalentCurrencyId;
    private DateTime? _from, _to;
    private FinalAccountsService.BalanceFilter _filter = FinalAccountsService.BalanceFilter.All;
    private string _search = "";
    private FinalAccountsService.TrialBalanceResult? _result;
    private string? _error;
    private bool _loading;

    private bool Closing => string.Equals(Mode, "closing", StringComparison.OrdinalIgnoreCase);
    private string Title => Tr(Closing ? "TBTitleClosing" : "TBTitleTotals");
    private int ColCount => Closing ? 8 : 6;
    private DateTime? PeriodFrom => _periods.FirstOrDefault(p => p.Id == _periodId)?.DateFrom;
    private DateTime? PeriodTo => _periods.FirstOrDefault(p => p.Id == _periodId)?.DateTo;
    // ثلاثة أزواج (أ-10): الافتتاحى والحركة والختامى، مدين = دائن، على كل الحسابات قبل المرشح
    private string UnbalancedText => string.Join(" — ", new[]
    {
        (Key: "TBPairOpening", Diff: _result!.OpeningDifference),
        (Key: "TBPairMovement", Diff: _result.MovementDifference),
        (Key: "TBPairClosing", Diff: _result.ClosingDifference),
    }.Where(p => Math.Abs(p.Diff) >= 0.005m).Select(p => Tr(p.Key, N(Math.Abs(p.Diff)))));

    // التصفية بالاسم تخفى الصفوف غير المطابقة مع إبقاء مجاميع المجموعة والإجمالى من النتيجة الكاملة (كما فى الديسكتوب: الفلتر على الشبكة فقط)
    private IEnumerable<FinalAccountsService.TrialBalanceGroup> VisibleGroups =>
        string.IsNullOrWhiteSpace(_search)
            ? _result!.Groups
            : _result!.Groups.Select(g => new FinalAccountsService.TrialBalanceGroup
              {
                  MainCode = g.MainCode, MainAccountName = g.MainAccountName, Total = g.Total,
                  Rows = g.Rows.Where(r => r.AccountName.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList()
              }).Where(g => g.Rows.Count > 0);

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        try
        {
            var equivalent = Tr("TBEquivalent");
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                _periods = _svc.GetPeriods();
                _branches = _svc.GetBranches();
                _currencies = _svc.GetCurrencies(equivalent);
            });
            var today = DateTime.Today;
            var cur = _periods.FirstOrDefault(p => p.DateFrom <= today && today <= p.DateTo) ?? _periods.LastOrDefault();
            _periodId = cur?.Id ?? 0;
            _from = cur?.DateFrom; _to = cur?.DateTo;
            _branch = _branches.Any(b => b.Id == AccountModelsLib.Common.Branch_Id) ? AccountModelsLib.Common.Branch_Id : _branches.FirstOrDefault()?.Id ?? 0;
            FinalAccountsQuery.Apply(FromQuery, ToQuery, BranchQuery, _periods, _branches, ref _periodId, ref _from, ref _to, ref _branch);
            _filter = FilterQuery switch
            {
                "with_balance" => FinalAccountsService.BalanceFilter.WithBalance,
                "movement_only" => FinalAccountsService.BalanceFilter.MovementOnly,
                _ => _filter,
            };
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        _pendingRun = RunQuery == 1 && _error == null && _periodId != 0;
    }

    // التشغيل التلقائى (run=1) بعد أول عرض تفاعلى لا أثناء التهيئة: منتقيا التاريخ يستدعيان DateChanged ← Reset عند أول عرض لهما،
    // فلو كانت النتيجة جاهزة وقتها تُمسح أثناء العرض نفسه (NullReference). OnAfterRender لا يعمل فى العرض المسبق.
    private bool _pendingRun;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingRun) return;
        _pendingRun = false;
        await ShowAsync();
        StateHasChanged();
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private void Reset() { _result = null; _error = null; _selectedAccountId = 0; }

    // ───── P8.9.2: المساعد داخل الشاشة (ويب فقط — الخدمة غير مسجّلة فى MAUI فلا يظهر شىء) ─────
    private long _selectedAccountId;
    private AiScreenAssistService? Assist => ServiceProvider.GetService(typeof(AiScreenAssistService)) as AiScreenAssistService;
    private bool AssistOn => Assist?.IsAvailable(AiScreenKinds.TrialBalance) == true;
    private FinalAccountsService.TrialBalanceRow? SelectedRow =>
        _selectedAccountId == 0 || _result == null ? null : _result.Groups.SelectMany(g => g.Rows).FirstOrDefault(r => r.AccountId == _selectedAccountId);

    private void SelectRow(long accountId)
    {
        if (AssistOn) _selectedAccountId = _selectedAccountId == accountId ? 0 : accountId;
    }

    private void RowKey(KeyboardEventArgs e, long accountId)
    {
        if (e.Key is "Enter" or " " or "Spacebar") SelectRow(accountId);
    }

    /// <summary>محددات الشاشة المعروضة فقط (ص2): المدى والفرع والعملة والمرشح والوضع (+ الحساب).</summary>
    private AiScreenPayload Payload(string question, long accountId = 0) => new()
    {
        Kind = AiScreenKinds.TrialBalance, Question = question, From = _from, To = _to, BranchId = _branch, CurrencyId = _currency,
        Filter = _filter switch { FinalAccountsService.BalanceFilter.WithBalance => "with_balance", FinalAccountsService.BalanceFilter.MovementOnly => "movement_only", _ => "all" },
        Mode = Closing ? "closing" : "totals", EntityId = accountId,
    };

    private async Task ExplainUnbalancedAsync()
    {
        if (Assist is { } a) await a.OpenDialogAsync(DialogService, Payload(AiScreenQuestions.WhyUnbalanced), "/accounts/final/trial-balance", Title);
    }

    private async Task ExplainAccountAsync()
    {
        if (Assist is { } a && _selectedAccountId != 0) await a.OpenDialogAsync(DialogService, Payload(AiScreenQuestions.ExplainAccount, _selectedAccountId), "/accounts/final/trial-balance", Title);
    }

    private void OnPeriodAsync(long id)
    {
        _periodId = id; _from = PeriodFrom; _to = PeriodTo; Reset();
    }

    private string PeriodText(long id)
    {
        var p = _periods.FirstOrDefault(x => x.Id == id);
        return p == null ? "" : $"{(string.IsNullOrWhiteSpace(p.Name) ? "" : p.Name + "  ")}{p.DateFrom:yyyy/MM/dd} — {p.DateTo:yyyy/MM/dd}";
    }

    private string FilterText(FinalAccountsService.BalanceFilter f) => f switch
    {
        FinalAccountsService.BalanceFilter.WithBalance => Tr("TBFilterBalance"),
        FinalAccountsService.BalanceFilter.MovementOnly => Tr("TBFilterMovement"),
        _ => Tr("TBFilterAll"),
    };

    private async Task ShowAsync()
    {
        _error = null; _result = null;
        var period = _periods.FirstOrDefault(p => p.Id == _periodId);
        var bad = FinalAccountsService.ValidateRange(period!, _from ?? default, _to ?? default);
        if (period == null || _from == null || _to == null || bad != null)
        {
            _error = Tr("FAErr" + (bad ?? "PeriodRequired"));
            return;
        }
        if (_branch <= 0) { _error = Tr("FAErrBranchRequired"); return; }
        _loading = true;
        try
        {
            long branch = _branch, currency = _currency; DateTime from = _from.Value, to = _to.Value; var filter = _filter;
            _result = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetTrialBalance(period, branch, currency, from, to, filter); });
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        finally { _loading = false; }
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    private static string N(decimal v) => v == 0 ? "" : v.ToString("N2", CultureInfo.InvariantCulture);

    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
