    // 🟢 يقابل btnDelete_Click بالضبط: نفس فحوصَى الأمان (Check_Account_No_Found_OnSubAccount يمنع حذف
    // عقدة لها أبناء، Check_Account_No_WithEntry_Used يمنع حذف حساب استُخدِم فى قيود) قبل Delete_Account.
    private async Task DeleteAsync()
    {
        if (_selected == null) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Tr("DeleteAccountTitle"),
            Tr("DeleteAccountConfirm", _selected.SubAccount_Name),
            yesText: Tr("Yes"), cancelText: Tr("No"));

        if (confirmed != true) return;

        _isBusy = true;
        _errorMessage = null;
        var id = _selected.Id;
        try
        {
            bool hasChildren = false;
            bool usedInEntries = false;
            int excp = 0;
            string msg = "";
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var acc = new Sub_Account();
                hasChildren = acc.Check_Account_No_Found_OnSubAccount(ref excp, id);
                if (!hasChildren)
                {
                    usedInEntries = acc.Check_Account_No_WithEntry_Used(ref excp, id);
                    if (!usedInEntries)
                    {
                        acc.Delete_Account(ref excp, ref msg, id);
                    }
                }
            });

            if (hasChildren)
            {
                _errorMessage = Tr("AccountCannotDeleteHasChildren");
                return;
            }
            if (usedInEntries)
            {
                _errorMessage = Tr("AccountCannotDeleteUsedInEntries");
                return;
            }

            if (excp == 0)
            {
                Snackbar.Add(Tr("AccountDeleted"), Severity.Success);
                _selected = null;
                _isAsset = false;
                if (_treePicker != null)
                {
                    await _treePicker.ReloadAsync();
                }
            }
            else
            {
                _errorMessage = string.IsNullOrEmpty(msg) ? Tr("AccountCannotDelete") : msg;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    // 🟢 معرض الصور (وضع التعديل) - يقابل FixedAssetsUSCTRL.GetImagesFromDatabase/cmdStoreNewImage_Click/
    // BtnDelete_Click بالضبط، برفع byte[] مباشرة بدل مسار ملف محلى (راجع تعليق الرأس).
    private async Task LoadImagesAsync(long fixedAssetDataId)
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return _cls.Get_FixedAssetData_ImagesStore(fixedAssetDataId);
        });

        var list = new List<ImageRow>();
        foreach (DataRow r in dt.Rows)
        {
            list.Add(new ImageRow(
                Convert.ToInt64(r["ImageId"]),
                r["Description"]?.ToString() ?? "",
                r["ImageData"] as byte[] ?? Array.Empty<byte>()));
        }
        _images = list;
        _selectedImageId = 0;
        _selectedImageDataUrl = null;
        _imageDesc = "";
    }

    private Task SelectImageAsync(ImageRow img)
    {
        _selectedImageId = img.ImageId;
        _imageDesc = img.Description;
        _selectedImageDataUrl = $"data:image/png;base64,{Convert.ToBase64String(img.Data)}";
        return Task.CompletedTask;
    }

    private async Task OnImageSelectedAsync(IBrowserFile? file)
    {
        if (file == null || !_isAsset) return;

        using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        var bytes = ms.ToArray();
        var desc = _imageDesc;
        var fixedAssetDataId = _fixedAssetDataId;

        _isBusy = true;
        try
        {
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                int excp = 0;
                var opp = new operations();
                _cls.SaveImage(ref excp, ref opp, bytes, fixedAssetDataId, desc ?? "", file.Name);
            });
            await LoadImagesAsync(fixedAssetDataId);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteImageAsync()
    {
        if (_selectedImageId == 0) return;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            Tr("DeleteImageTitle"), Tr("DeleteImageConfirm"), yesText: Tr("Yes"), cancelText: Tr("No"));
        if (confirmed != true) return;

        var imageId = _selectedImageId;
        var fixedAssetDataId = _fixedAssetDataId;
        _isBusy = true;
        try
        {
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                _cls.Delete_FixedAssetData_ImagesStore(imageId.ToString());
            });
            await LoadImagesAsync(fixedAssetDataId);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
