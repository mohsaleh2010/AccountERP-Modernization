    // 🟢 يقابل FixedAssetsUSCTRL.AddFixedAsset (عبر FixedAssetCLS.AddNewFixedAssetsWithImg) بالضبط: يُنشئ
    // حساباً فرعياً جديداً (Sub_Account.Add_AccountSupplierCustomerOther) ثم صف FixedAssetData المرتبط به
    // معاً، ثم يحفظ صورة واحدة إن اختيرت.
    private async Task SaveNewAssetAsync()
    {
        if (_selected == null) return;
        if (string.IsNullOrWhiteSpace(_nameAr)) { _errorMessage = Tr("AssetNameRequired"); return; }

        _isBusy = true;
        _errorMessage = null;
        var branchId = _branchId;
        try
        {
            int excp = 0;
            string msg = "";
            long newSubAccountId = -1;
            var imageBytes = _newAssetImageBytes;
            var imageDesc = _imageDesc;

            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var fx = BuildFixedAssetCls();
                var opp = new operations(1);
                try
                {
                    int localExcp = 0;
                    string localMsg = "";
                    fx.AddNewFixedAssets(ref localExcp, ref localMsg, ref opp, fx);
                    if (localExcp == 0)
                    {
                        if (imageBytes != null)
                        {
                            int imgExcp = 0;
                            fx.SaveImage(ref imgExcp, ref opp, imageBytes, fx.fxd.Id, imageDesc ?? "");
                        }
                        opp.Commit();
                        newSubAccountId = fx.fxd.SubAccount_Id ?? -1;
                        excp = 0;
                    }
                    else
                    {
                        opp.Rollback();
                        excp = 1;
                        msg = localMsg;
                    }
                }
                catch (Exception ee)
                {
                    opp.Rollback();
                    excp = 1;
                    msg = ee.Message;
                }
            });

            if (excp == 0)
            {
                Snackbar.Add(Tr("AssetAdded"), Severity.Success);
                _addingAsset = false;
                if (_treePicker != null)
                {
                    await _treePicker.ReloadAsync();
                    await _treePicker.SelectAndRevealAsync(newSubAccountId);
                }
            }
            else
            {
                _errorMessage = string.IsNullOrEmpty(msg) ? Tr("SystemError", "") : msg;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private FixedAssetCLS BuildFixedAssetCls()
    {
        var fx = new FixedAssetCLS();
        fx.fxd.Code = _code;
        fx.fxd.Name_Ar = _nameAr.Trim();
        fx.fxd.Name_En = _nameEn;
        fx.fxd.Purchase_Date = _purchaseDate;
        fx.fxd.Account_Ehlak_Status = _ehlakStatus;
        fx.fxd.Account_Ehlak_Status_Str = FixedAssetLookups.EhlakStatuses.FirstOrDefault(s => s.Value == _ehlakStatus)?.TextAr ?? "";
        fx.fxd.Emp_Id = _empId;
        fx.fxd.Emp_Receive_Date = _empReceiveDate;
        fx.fxd.Model = _model;
        fx.fxd.Industry_Factory = _industryFactory;
        fx.fxd.Fixed_Serial_No = _fixedSerialNo;
        fx.fxd.Location = _location;
        fx.fxd.Factory_warrantyFinal_Date = _warrantyFinalDate;
        fx.fxd.Supplier_Name = _supplierName;
        fx.fxd.Factory_warranty_Details = _warrantyDetails;
        fx.fxd.Account_Ehlak_Type = _ehlakType;
        fx.fxd.Account_Ehlak_Type_Str = _depreciationTypes.FirstOrDefault(t => t.Id == _ehlakType).Name ?? "";
        fx.fxd.Main_Value = _mainValue;
        fx.fxd.Accumulated_Depreciation_Value = _accumulatedDepreciation;
        fx.fxd.Rate_of_depreciation = _rateOfDepreciation;
        fx.fxd.Book_value = _bookValue;
        fx.fxd.beginning_service_Date = _beginServiceDate;
        fx.fxd.Price_scrap_Value = _priceScrapValue;
        fx.fxd.Last_Modified_Value = _lastModifiedValue;
        fx.fxd.Default_Age = _defaultAge;
        return fx;
    }

    // 🟢 يستدعي Update_FixedAssetData_Full (وليس Update_NewFixedAsset الأصلية) - راجع تعليق الرأس: الأصلية
    // تحذف صف FixedAssetData فعلياً بدل تحديثه (خلل حقيقى فى الشاشة الأصلية، بموافقة صريحة من المستخدم على
