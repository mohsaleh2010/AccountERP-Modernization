@page "/"

@* 🟢 كانت هذه الصفحة القالب الافتراضي الخام من Blazor (<h1>Hello, world!</h1>) بلا أي تنسيق - تُرسم
   مباشرة أسفل MudAppBar الثابت فتبدو غير واضحة/ملتصقة به. أُعيد بناؤها كصفحة ترحيب مختصرة تناسب تطبيق
   ERP داخلي (وليست صفحة تسويقية) بنفس هوية شاشة الدخول (بانر بتدرج لوني بلون العلامة + بطاقات MudPaper)،
   مع اختصارات حقيقية لوحدات النظام المسموح بها فعلياً لهذا المستخدم بدلاً من محتوى وهمي. راجع أيضاً إصلاح
   مساحة إفلات الـ AppBar فى MainLayoutMud.razor (السبب الفعلي لالتصاق النص بالشريط العلوي) وMODERNIZATION_NOTES.md. *@

@using System.Globalization
@using AccountERP.SharedUI.Services
@inject MenuStateService MenuState
@inject LanguageService LangService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject NotificationCenterService NotificationCenter
@implements IDisposable

<PageTitle>@Tr("NavHome")</PageTitle>

<MudPaper Elevation="0" Class="pa-6 pa-md-8 mb-6 rounded-lg" Style="background:linear-gradient(135deg, var(--mud-palette-primary) 0%, var(--mud-palette-primary-darken) 100%); color:#fff;">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="4">
        <div>
            <MudText Typo="Typo.h4" Class="fw-bold mb-2">@Tr("WelcomeUser", Common.FullUserName)</MudText>
            <MudText Typo="Typo.body1" Style="opacity:.9; max-width:40rem;">@Tr("HomeSubtitle")</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="font-size:4rem; opacity:.3;" />
    </MudStack>
</MudPaper>

@{
    // 🟢 دعم التنقّل الهرمي بالبطاقات: بدلاً من الاقتصار على مستوى واحد (الوحدات الرئيسية فقط، ParentId==0)،
    // الضغط على بطاقة لها أبناء يعرض أبناءها كبطاقات جديدة فى نفس الصفحة (CurrentLevelMenus أدناه) بدلاً
    // من فتح شاشة أو رسالة "قيد الإنشاء"، و_path يحمل المسار الكامل من الجذر حتى المستوى الحالي لعرضه
    // كـ Breadcrumb فوق البطاقات - راجع OpenModule/NavigateToBreadcrumb فى @code.
    var currentLevelMenus = MenuState?.UserAllowedMenus?.Where(m => m != null && m.ParentId == CurrentParentId).ToList() ?? new();
}

@* 🤖 P8.1.5 (ق23): بطاقة الموجز اليومى للمشترك (لا تظهر بلا صلاحية أو فى MAUI) *@
@if (_path.Count == 0)
{
    <AccountERP.SharedUI.Components.Assistant.AiBriefCard />
}

@if (_path.Count > 0)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
        <MudLink Underline="Underline.Hover" OnClick="@(() => NavigateToBreadcrumb(-1))" Class="d-flex align-items-center" Style="gap:4px; cursor:pointer;">
            <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
            @Tr("HomeQuickAccessTitle")
        </MudLink>
        @for (var i = 0; i < _path.Count; i++)
        {
            var idx = i;
            var isLast = idx == _path.Count - 1;
            <MudIcon Icon="@(LangService.IsRtl ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)" Size="Size.Small" Class="mud-text-secondary" />
            @if (isLast)
            {
                <MudText Typo="Typo.body2" Class="fw-medium">@_path[idx].GetLocalizedDescription(LangService.CurrentLanguage)</MudText>
            }
            else
            {
                <MudLink Underline="Underline.Hover" OnClick="@(() => NavigateToBreadcrumb(idx))" Style="cursor:pointer;">
                    @_path[idx].GetLocalizedDescription(LangService.CurrentLanguage)
                </MudLink>
            }
        }
        @* خطة 05 بند 27: نفس المستوى كصفحة تجميع بالكروت (أقسام لكل مجموعة، وكل شاشة مرة واحدة) *@
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Dashboard"
                   Href="@($"/hub/{CurrentParentId}")">@Tr("HubOpen")</MudButton>
    </MudStack>
}
else
{
    <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">@Tr("HomeQuickAccessTitle")</MudText>
}

@if (currentLevelMenus.Any())
{
    <MudGrid Spacing="3">
        @foreach (var menu in currentLevelMenus)
        {
            var hasChildren = MenuState!.UserAllowedMenus.Any(c => c.ParentId == menu.Menu_ID);
            var implemented = hasChildren || KnownRoutes.IsImplemented(menu.GetEffectiveRoute());
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudCard Outlined="true" Class="h-100 module-quick-card" @onclick="@(() => OpenModule(menu))">
                    <MudCardContent Class="d-flex align-items-center justify-content-between" Style="gap:12px;">
                        <div class="d-flex align-items-center" style="gap:12px; min-width:0;">
                            <MudIcon Icon="@GetCardIcon(menu, hasChildren)" Color="Color.Primary" />
                            <MudText Typo="Typo.body1" Class="fw-medium text-truncate">@menu.GetLocalizedDescription(LangService.CurrentLanguage)</MudText>
                        </div>
                        @if (hasChildren)
                        {
                            @* 🟢 مؤشر بصري فقط (بلا تنقّل خاص به) يوضّح أن هذه البطاقة "مجلد" يحتوي على قوائم فرعية
                               ستظهر فى نفس الصفحة عند الضغط، وليست شاشة تُفتح مباشرة. *@
                            <MudIcon Icon="@(LangService.IsRtl ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)" Class="flex-shrink-0 mud-text-secondary" />
                        }
                        else if (!implemented)
                        {
                            @* 🟢 Text="..." بدلاً من ChildContent: لوحظ أن MudChip لا يُحدّث نص ChildContent بشكل
                               موثوق عند تبديل اللغة فقط (على عكس كل النصوص الأخرى فى نفس الصفحة، بما فيها @key
                               بلغة الواجهة الحالية التى جُرِّبت أولاً ولم تحل المشكلة) - خاصية Text نص عادي
                               يُقارَن (Diff) كأي Parameter آخر فتتحدّث بشكل صحيح دائماً. *@
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="flex-shrink-0" Text="@Tr("ComingSoon")" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">@Tr("NoModulesAvailable")</MudAlert>
}

<style>
    .module-quick-card { cursor: pointer; transition: box-shadow 150ms ease, border-color 150ms ease; }
    .module-quick-card:hover, .module-quick-card:focus-within { border-color: var(--mud-palette-primary); box-shadow: var(--mud-elevation-2); }
</style>

@code {
    // 🟢 اشتراك مباشر فى LangService.OnLanguageChanged (بدلاً من الاعتماد فقط على أن MainLayoutMud يُعيد
    // رسم @Body تلقائياً) بنفس نمط NavMenuMud.razor - لوحظ أن بطاقات الوحدات هنا (خاصة MudChip "قريباً")
    // لا تتحدّث بشكل موثوق 100% من الوقت بالاعتماد على الرندرة المتتالية من الأب وحدها.
    protected override void OnInitialized()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        // 🟢 نفس السبب بالضبط الذى دفع NavMenuMud.razor للاشتراك فى MenuState.OnAuthChanged - بعد Refresh
        // كامل للمتصفح مع كوكي دخول موقّع، تُستعاد الجلسة بشكل غير متزامن فى MainLayoutMud (تُملأ
        // MenuState.UserAllowedMenus فعلياً وتُطلَق OnAuthChanged)، لكن بطاقات الوحدات هنا كانت تعتمد فقط
        // على رندرة MainLayoutMud المتتالية (غير موثوقة لنفس السبب الموثّق فى NavMenuMud.razor) فتبقى
        // عالقة على "لا توجد قوائم متاحة لحسابك" رغم أن السايد بار (بعد إصلاحه) يظهر بشكل صحيح - راجع
        // MODERNIZATION_NOTES.md.
        MenuState.OnAuthChanged += OnLanguageChangedHandler;
    }

    private void OnLanguageChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
        MenuState.OnAuthChanged -= OnLanguageChangedHandler;
    }

    // 🟢 مسار التنقّل الهرمي الحالي (من الجذر حتى المستوى المعروض الآن) - فارغ يعني عرض الوحدات الرئيسية
    // (ParentId==0)، وكل عنصر مُضاف يعني أن المستخدم "دخل" فى بطاقة لها أبناء. يُعرض كـ Breadcrumb فوق
    // البطاقات (راجع أعلى الملف) بدلاً من التنقّل الفوري لشاشة أو رسالة "قيد الإنشاء" لأي بطاقة لها أبناء.
    private List<MenuViewModel> _path = new();

    // 🟢 يدعم الروابط الوسيطة فى MenuBreadcrumb.razor (مثال: "/?openMenu=123" عند الضغط على "بيانات أساسية"
    // أو "العملاء" فى مسار شاشة مفتوحة): يعيد فتح الرئيسية مباشرة عند نفس مستوى ذلك العنصر، بدل الرجوع دائماً
    // لأعلى مستوى فقط. أي تنقّل عادي للرئيسية بدون هذا الباراميتر (مثل رابط "الرئيسية" فى الشريط العلوي)
    // يُصفِّر المسار للمستوى الأعلى كالمعتاد.
    [SupplyParameterFromQuery(Name = "openMenu")]
    public long? OpenMenu { get; set; }

    protected override void OnParametersSet()
    {
        var target = OpenMenu.HasValue
            ? MenuState.UserAllowedMenus.FirstOrDefault(m => m.Menu_ID == OpenMenu.Value)
            : null;

        _path = target == null ? new List<MenuViewModel>() : MenuState.UserAllowedMenus.BuildAncestorPath(target);
    }

    private long CurrentParentId => _path.Count > 0 ? _path[^1].Menu_ID : 0;

    // 🟢 نفس أيقونات القائمة الجانبية بالضبط (MenuIcons.cs) بدل أيقونة Folder/Apps العامة الموحَّدة لكل
    // البطاقات سابقاً: وحدة رئيسية (المستوى الأعلى) بنمط Filled، مجموعة فرعية لها أبناء بنمط Outlined،
    // وشاشة نهائية بأيقونة تُطابق طبيعتها (قائمة/إضافة/تقرير...) - يجعل بطاقات الشاشة الرئيسية مميزة بصرياً
    // بدل تشابهها جميعاً بأيقونة واحدة عامة.
    private string GetCardIcon(MenuViewModel menu, bool hasChildren)
    {
        if (!hasChildren) return MenuIcons.GetLeafIcon(menu.Description);
        return menu.ParentId == 0 ? MenuIcons.GetModuleIcon(menu.Description) : MenuIcons.GetGroupIcon(menu.Description);
    }

    // 🟢 نفس منطق الاختيار/التنقّل المستخدم فى NavMenuMud لأعلى مستوى من القوائم (SelectMainMenu + حماية
    // KnownRoutes) حتى لا تتفرّع هذه البطاقات إلى سلوك تنقّل مختلف عن السايد بار نفسه. بطاقة لها أبناء
    // "تدخل" إلى مستوى أعمق فى نفس الصفحة بدلاً من فتح شاشة أو رسالة "قيد الإنشاء" مباشرة.
    private void OpenModule(MenuViewModel menu)
    {
        var hasChildren = MenuState.UserAllowedMenus.Any(c => c.ParentId == menu.Menu_ID);
        if (hasChildren)
        {
            _path.Add(menu);
            if (menu.ParentId == 0)
            {
                // 🟢 يبقي السايد بار (NavMenuMud) متزامناً مع الوحدة الرئيسية المفتوحة هنا من الصفحة الرئيسية،
                // بنفس السلوك الذى كان موجوداً قبل دعم التنقّل الهرمي.
                MenuState.SelectMainMenu(menu.Menu_ID);
            }
            return;
        }

        var route = menu.GetEffectiveRoute();
        if (KnownRoutes.IsImplemented(route))
        {
            NavigationManager.NavigateTo(route);
        }
        else
        {
            var message = Tr("ScreenNotBuiltYet", menu.GetLocalizedDescription(LangService.CurrentLanguage));
            Snackbar.Add(message, MudBlazor.Severity.Info);
            NotificationCenter.Add(message, MudBlazor.Severity.Info);
        }
    }

    // 🟢 index == -1 يعني الضغط على "الرئيسية" (جذر المسار) فيُفرَّغ المسار بالكامل، وإلا يُقتَطع المسار
    // حتى العنصر المضغوط عليه ضمناً (رجوع لأعلى بعدد أي خطوات دفعة واحدة، لا خطوة واحدة فقط فى كل مرة).
    private void NavigateToBreadcrumb(int index)
    {
        _path = index < 0 ? new List<MenuViewModel>() : _path.Take(index + 1).ToList();
    }

    // 🟢 Tr(...) بدلاً من Lang[...] مباشرة فى كل هذا الملف (اسم مختلف عمداً عن "T" لتفادي أي تضارب مع
    // خاصية النوع العام T="string" على مكوّنات MudBlazor مثل MudChip فى نفس الشجرة - راجع MODERNIZATION_NOTES.md): نُبدّل CultureInfo.CurrentUICulture مؤقتاً
    // لثقافة LangService الصحيحة (LangService.CurrentCultureInfo) وقت الاستدعاء فقط ثم نُعيدها - بدلاً من
    // الاعتماد على أنها ضُبطت مسبقاً بشكل صحيح على الخيط الفعلي وقت الرندرة (IStringLocalizer.WithCulture(...)
    // غير متاحة فى net10.0). كانت نصوص Lang[...] هنا (مرحباً/الوحدات المتاحة لك...) تبقى بلغتها القديمة بعد
    // تبديل اللغة رغم أن الصفحة فعلياً أُعيد رسمها بنجاح (القيم الأخرى المبنية على LangService.CurrentLanguage
    // مباشرة، مثل GetLocalizedDescription، كانت تتحدّث بشكل صحيح) - راجع MODERNIZATION_NOTES.md.
    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
