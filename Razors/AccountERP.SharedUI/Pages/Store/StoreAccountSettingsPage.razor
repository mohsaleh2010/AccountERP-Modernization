@page "/store/account-settings"

@* 🟢 «ربط المخازن بالحسابات» (SysConfigMenus menuItemRelatedStoreAccounts تحت «ربط الحسابات»): لكل حركة مخزنية الحساب المقابل لحساب المخزن
   (مثل جدول تحديد الحسابات فى SAP وحسابات تقييم المخزون فى Odoo). ثلاثة مستويات: افتراضى الفرع، نوع مخزن، مخزن محدد - والأخص يغلب.
   كل اختيار يُحفظ فوراً عبر AccountModelsLib.Models.StoreAccountDeterminationCLS (جدول Store_Account_Determination).
   القيود الفعلية لا تقرأ هذه الإعدادات بعد - ربط الأذون والفواتير بها مرحلة لاحقة منفصلة، والتنبيه أعلى الجدول يوضح ذلك. *@

@using System.Globalization
@using AccountERP.SharedUI.Components.Shared
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.ViewModels
@using AccountModelsLib
@using AccountModelsLib.Models
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>@Tr("SADTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Spacing="1">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@Tr("SADTitle")</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Tr("SADSubtitle")</MudText>
        </MudStack>
        <MudGrid Spacing="2" Class="mt-2" Style="align-items:center;">
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Value="_level" ValueChanged="OnLevelChanged" Label="@Tr("SADLevelLabel")" Variant="Variant.Outlined"
                           Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int" Value="0">@Tr("SADLevelBranch")</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@Tr("SADLevelType")</MudSelectItem>
                    <MudSelectItem T="int" Value="2">@Tr("SADLevelStore")</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (_level == 1)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="int" @bind-Value="_type" Label="@Tr("StoreUsedTypeLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var t in _storeTypes)
                        {
                            <MudSelectItem T="int" Value="@((int)t.Value)">@t.Text</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            else if (_level == 2)
            {
                <MudItem xs="12" sm="4">
                    <MudSelect T="long" @bind-Value="_storeId" Label="@Tr("SADStoreLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                               AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem T="long" Value="0L">@Tr("SADChooseStore")</MudSelectItem>
                        @foreach (var s in _stores)
                        {
                            <MudSelectItem T="long" Value="@s.Id">@s.Store_Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            @if (_level == 0)
            {
                <MudItem xs="12" sm="4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoFixHigh"
                               OnClick="SuggestAsync" Disabled="_busy">@Tr("SADSuggest")</MudButton>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-2">@Tr("IAMTitle")</MudText>
        <MudGrid Spacing="2" Style="align-items:center;">
            <MudItem xs="12" md="5">
                <MudSelect T="int" @bind-Value="_method" Label="@Tr("IAMTitle")" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int" Value="0">@Tr("IAMPeriodic")</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@Tr("IAMContinuous")</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker T="DateTime?" @bind-Date="_methodStart" Label="@Tr("IAMStart")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(_method != 1)" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveMethodAsync" Disabled="_busy">@Tr("IAMSave")</MudButton>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@Tr("IAMHelp")</MudText>

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">@Tr("IAMOpenTitle")</MudText>
        <MudGrid Spacing="2" Style="align-items:center;">
            <MudItem xs="12" md="5">
                <MudSelect T="int" @bind-Value="_valuation" Label="@Tr("IAMValuation")" Variant="Variant.Outlined" Margin="Margin.Dense" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="int" Value="0">@Tr("IAMValAvg")</MudSelectItem>
                    <MudSelectItem T="int" Value="1">@Tr("IAMValLast")</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Visibility" OnClick="PreviewOpeningAsync" Disabled="_busy">@Tr("IAMOpenPreview")</MudButton>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PostAdd" OnClick="PostOpeningAsync" Disabled="@(_busy || _openingRows == null || !_openingRows.Any(r => r.Delta != 0))">@Tr("IAMOpenPost")</MudButton>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@Tr("IAMOpenHelp")</MudText>
        @if (_openingRows != null)
        {
            <MudSimpleTable Dense="true" Class="mt-2">
                <thead><tr><th>@Tr("IAMOpenStore")</th><th>@Tr("IAMOpenTarget")</th><th>@Tr("IAMOpenPosted")</th><th>@Tr("IAMOpenDelta")</th></tr></thead>
                <tbody>
                    @foreach (var r in _openingRows)
                    {
                        <tr><td>@r.StoreName</td><td>@r.Target.ToString("N2")</td><td>@r.Posted.ToString("N2")</td><td>@r.Delta.ToString("N2")</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">@Tr("SIATitle")</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@Tr("SIAHelp")</MudText>
        <MudTable T="StoreRow" Items="@_stores" Dense="true" Hover="true" Bordered="true" Elevation="0" Breakpoint="Breakpoint.Sm" Loading="@_isLoading">
            <HeaderContent>
                <MudTh>@Tr("SADStoreLabel")</MudTh>
                <MudTh>@Tr("StoreUsedTypeLabel")</MudTh>
                <MudTh>@Tr("SIAAccount")</MudTh>
                <MudTh Style="width:120px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                @{ var acc = StoreAccount(context.Id); }
                <MudTd DataLabel="@Tr("SADStoreLabel")"><span class="font-weight-bold">@context.Store_Name</span></MudTd>
                <MudTd DataLabel="@Tr("StoreUsedTypeLabel")">@(_storeTypes.FirstOrDefault(t => t.Value == context.StoreUsed_Type)?.Text)</MudTd>
                <MudTd DataLabel="@Tr("SIAAccount")">
                    @if (acc != null)
                    {
                        <div>@acc.Value.Name <span class="mud-text-secondary sad-code">@acc.Value.No</span></div>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning">@Tr("SIANotLinked")</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudTooltip Text="@Tr("SADPick")">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Small"
                                       aria-label="@Tr("SADPick")" OnClick="@(() => OpenStorePicker(context))" Disabled="_busy" />
                    </MudTooltip>
                    @if (acc != null)
                    {
                        <MudTooltip Text="@Tr("SIAClear")">
                            <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Error" Size="Size.Small"
                                           aria-label="@Tr("SIAClear")" OnClick="@(() => ClearStoreAccountAsync(context))" Disabled="_busy" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@_errorMessage</MudAlert>
    }

    @if (_level == 2 && _storeId == 0)
    {
        <MudPaper Class="pa-6" Elevation="1">
            <MudText Align="Align.Center" Class="mud-text-secondary">@Tr("SADChooseStore")</MudText>
        </MudPaper>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="font-weight-bold mb-1">@Tr("SADTableTitle")</MudText>
        <MudTable T="StoreAccountRoleInfo" Items="@StoreAccountDeterminationCLS.Roles" Hover="true" Bordered="true" Loading="@_isLoading"
                  Elevation="1" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@Tr("SADRoleColumn")</MudTh>
                <MudTh>@Tr("SADUsedByColumn")</MudTh>
                <MudTh>@Tr("SADAccountColumn")</MudTh>
                <MudTh Style="width:120px;"></MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var own = Own(context.Role);
                    var (inherited, source) = Inherited(context.Role);
                }
                <MudTd DataLabel="@Tr("SADRoleColumn")"><span class="font-weight-bold">@Tr("SADRole" + (int)context.Role)</span></MudTd>
                <MudTd DataLabel="@Tr("SADUsedByColumn")">
                    <div class="sad-usedby">
                        @foreach (var t in UsedBy(context))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@t</MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="@Tr("SADAccountColumn")">
                    @if (own != null)
                    {
                        <div>@own.SubAccount_Name <span class="mud-text-secondary sad-code">@own.SubAccount_NO</span></div>
                        <MudText Typo="Typo.caption" Color="Color.Success">@Tr("SADSourceHere")</MudText>
                    }
                    else if (inherited != null)
                    {
                        <div class="mud-text-secondary">@inherited.SubAccount_Name <span class="sad-code">@inherited.SubAccount_NO</span></div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Tr("SADSourceInherited", source)</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning">@Tr("SADNotSet")</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudTooltip Text="@Tr("SADPick")">
                        <MudIconButton Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Small"
                                       aria-label="@Tr("SADPick")" OnClick="@(() => OpenPicker(context))" Disabled="_busy" />
                    </MudTooltip>
                    @if (own != null)
                    {
                        <MudTooltip Text="@Tr("SADClear")">
                            <MudIconButton Icon="@Icons.Material.Filled.Clear" Color="Color.Error" Size="Size.Small"
                                           aria-label="@Tr("SADClear")" OnClick="@(() => SaveAsync(context.Role, 0))" Disabled="_busy" />
                        </MudTooltip>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

<MudDialog @bind-Visible="_pickerOpen" Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true })">
    <TitleContent>@(_pickStore != null ? Tr("SIAPickTitle", _pickStore.Store_Name) : Tr("SADPickTitle", _pickRole == null ? "" : Tr("SADRole" + (int)_pickRole.Role)))</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(_pickError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">@_pickError</MudAlert>
        }
        <div style="height:50vh;">
            <AccountTreePicker BranchId="Common.Branch_Id" SelectedValue="_pickedNode" SelectedValueChanged="OnAccountPicked" Height="50vh" />
        </div>
        @if (_pickedNode != null)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@Tr("SADSelectedAccount"): <b>@_pickedNode.SubAccount_Name</b> <span class="sad-code">@_pickedNode.SubAccount_NO</span></MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                   OnClick="ConfirmPickAsync" Disabled="@(_busy || _pickedNode == null)">@Tr("SADConfirm")</MudButton>
        <MudButton OnClick="@(() => _pickerOpen = false)">@Tr("Cancel")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<StoreAccountSetting> _settings = new();
    private List<StoreLookupItem> _storeTypes = new();
    private List<StoreRow> _stores = new();
    private Dictionary<int, string> _orderTypeNames = new();
    private bool _isLoading = true;
    private bool _busy;
    private string _errorMessage = string.Empty;

    private int _level;          // 0 فرع، 1 نوع مخزن، 2 مخزن

    // طريقة المحاسبة المخزنية للفرع (InventoryPostingService): 0 دورى (الافتراضى)، 1 مستمر من تاريخ
    private readonly InventoryPostingService _posting = new();
    private int _method;
    private DateTime? _methodStart;
    private int _valuation;
    private List<InventoryPostingService.OpeningRow>? _openingRows;
    private int _type = 1;
    private long _storeId;

    private bool _pickerOpen;
    private StoreAccountRoleInfo? _pickRole;
    private AccountTreeNodeViewModel? _pickedNode;
    private string _pickError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        await LoadAsync();
        try
        {
            var branch = Common.Branch_Id;
            var setting = await Task.Run(() => _posting.GetSetting(branch));
            _method = (int)setting.Method;
            _methodStart = setting.StartDate;
            _valuation = (int)setting.Valuation;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }

    private async Task SaveMethodAsync()
    {
        _errorMessage = string.Empty;
        if (_method == 1 && _methodStart == null) { Snackbar.Add(Tr("IAMStartRequired"), Severity.Warning); return; }
        _busy = true;
        try
        {
            var branch = Common.Branch_Id; var method = (InventoryPostingService.Method)_method; var start = _methodStart;
            var valuation = (InventoryPostingService.ValuationMethod)_valuation;
            await Task.Run(() => _posting.SaveSetting(branch, method, start, valuation));
            _openingRows = null; // تغيّرت الطريقة/التاريخ فالمعاينة السابقة لم تعد صالحة
            Snackbar.Add(Tr("IAMSaved"), Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PreviewOpeningAsync()
    {
        _errorMessage = string.Empty;
        _busy = true;
        try
        {
            var branch = Common.Branch_Id;
            _openingRows = await Task.Run(() => _posting.GetOpeningPreview(branch));
            if (_openingRows.Count == 0) Snackbar.Add(Tr("IAMOpenNone"), Severity.Info);
        }
        catch (InvalidOperationException ex) when (ex.Message == "OpeningNeedsContinuous")
        {
            _openingRows = null;
            Snackbar.Add(Tr("IAMStartRequired"), Severity.Warning);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PostOpeningAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("IAMOpenTitle"), Tr("IAMOpenConfirm"), yesText: Tr("IAMOpenPost"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _errorMessage = string.Empty;
        _busy = true;
        try
        {
            var branch = Common.Branch_Id;
            long entryId = await Task.Run(() => _posting.PostOpeningEntry(branch));
            Snackbar.Add(entryId > 0 ? Tr("IAMOpenDone", entryId) : Tr("IAMOpenNone"), entryId > 0 ? Severity.Success : Severity.Info);
            _openingRows = await Task.Run(() => _posting.GetOpeningPreview(branch));
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        try
        {
            var branch = Common.Branch_Id;
            var data = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var stores = new StoreCLS();
                var orderTypes = new StoreOrderPageService().GetOrderTypes().ToDictionary(o => o.Order_Type, o => o.Name_Ar);
                var det = new StoreAccountDeterminationCLS();
                return (det.GetSettings(branch), stores.GetStoreTypes(), stores.GetStores(branch), orderTypes, det.GetStoreInventoryAccounts(branch));
            });
            _storeAccounts = data.Item5;
            _settings = data.Item1;
            _storeTypes = data.Item2;
            _stores = data.Item3;
            _orderTypeNames = data.Item4;
            if (_storeTypes.Count > 0 && !_storeTypes.Any(t => t.Value == _type)) _type = (int)_storeTypes[0].Value;
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnLevelChanged(int level) => _level = level;

    // مفتاح المستوى المعروض حالياً (نوع، مخزن) كما يُخزَّن فى الجدول.
    private (int Type, long Store) CurrentKey => _level switch
    {
        1 => (_type, 0L),
        2 => (0, _storeId),
        _ => (0, 0L),
    };

    private StoreAccountSetting? Find(int type, long store, StoreAccountRole role) =>
        _settings.FirstOrDefault(s => s.StoreUsed_Type == type && s.Store_Id == store && s.Account_Role == (int)role);

    private StoreAccountSetting? Own(StoreAccountRole role)
    {
        var key = CurrentKey;
        return Find(key.Type, key.Store, role);
    }

    // ما يسرى عند غياب إعداد هذا المستوى: للمخزن ← نوعه ثم الفرع، وللنوع ← الفرع.
    private (StoreAccountSetting? Setting, string Source) Inherited(StoreAccountRole role)
    {
        if (_level == 0) return (null, "");
        if (_level == 2)
        {
            int storeType = _stores.FirstOrDefault(s => s.Id == _storeId)?.StoreUsed_Type ?? 0;
            var byType = storeType == 0 ? null : Find(storeType, 0, role);
            if (byType != null) return (byType, _storeTypes.FirstOrDefault(t => t.Value == storeType)?.Text ?? "");
        }
        var branch = Find(0, 0, role);
        return (branch, branch == null ? "" : Tr("SADLevelBranch"));
    }

    private IEnumerable<string> UsedBy(StoreAccountRoleInfo info)
    {
        foreach (var part in info.OrderTypes.Split(',', StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(part, out int t)) yield return _orderTypeNames.TryGetValue(t, out var name) ? name : part;
        }
        if (info.Role == StoreAccountRole.COGS) yield return Tr("SADSalesInvoices");
        if (info.Role == StoreAccountRole.PurchasePriceVariance) yield return Tr("SADPurchaseInvoices");
        if (info.Role == StoreAccountRole.OpeningBalance) yield return Tr("SADItemOpening");
    }

    private void OpenPicker(StoreAccountRoleInfo info)
    {
        _pickRole = info;
        _pickStore = null;
        _pickedNode = null;
        _pickError = string.Empty;
        _pickerOpen = true;
    }

    // حساب المخزون لكل مخزن (Store.SubAccount_Id)
    private Dictionary<long, (string Name, string No)> _storeAccounts = new();
    private StoreRow? _pickStore;

    private (string Name, string No)? StoreAccount(long storeId) =>
        _storeAccounts.TryGetValue(storeId, out var a) ? a : null;

    private async Task OpenStorePicker(StoreRow store)
    {
        if (_storeAccounts.ContainsKey(store.Id))
        {
            var ok = await DialogService.ShowMessageBoxAsync(Tr("SIATitle"), Tr("SIAChangeConfirm", store.Store_Name), yesText: Tr("SIAChangeYes"), cancelText: Tr("Cancel"));
            if (ok != true) return;
        }
        _pickStore = store;
        _pickRole = null;
        _pickedNode = null;
        _pickError = string.Empty;
        _pickerOpen = true;
    }

    private async Task<string> SaveStoreAccountAsync(long storeId, long subAccountId)
    {
        _busy = true;
        try
        {
            int excp = 0;
            string msg = string.Empty;
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                new StoreAccountDeterminationCLS().SetStoreInventoryAccount(ref excp, ref msg, storeId, subAccountId);
            });
            if (excp != 0) return string.IsNullOrEmpty(msg) ? Tr("SystemError", "") : msg;
            await LoadAsync();
            Snackbar.Add(Tr("SADSaved"), Severity.Success);
            return string.Empty;
        }
        catch (Exception ex)
        {
            return Tr("SystemError", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ClearStoreAccountAsync(StoreRow store)
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("SIATitle"), Tr("SIAClearConfirm", store.Store_Name), yesText: Tr("SIAClearYes"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _errorMessage = await SaveStoreAccountAsync(store.Id, 0);
    }

    // الاختيار من الشجرة يحدد الحساب فقط؛ الحفظ عند زر «موافقة».
    private void OnAccountPicked(AccountTreeNodeViewModel? node)
    {
        _pickedNode = node;
        _pickError = string.Empty;
    }

    private async Task ConfirmPickAsync()
    {
        var node = _pickedNode;
        if (node == null) return;
        if (_pickStore != null)
        {
            string storeError = await SaveStoreAccountAsync(_pickStore.Id, node.Id);
            if (string.IsNullOrEmpty(storeError)) _pickerOpen = false;
            else _pickError = storeError;
            return;
        }
        if (_pickRole == null) return;
        string error = await SaveAsync(_pickRole.Role, node.Id);
        if (string.IsNullOrEmpty(error)) _pickerOpen = false;
        else _pickError = error;
    }

    // يحفظ ثم يعيد التحميل؛ يرجع نص الخطأ (فارغ = نجاح) ليُعرض داخل حوار الاختيار.
    private async Task<string> SaveAsync(StoreAccountRole role, long subAccountId)
    {
        _busy = true;
        try
        {
            var key = CurrentKey;
            var branch = Common.Branch_Id;
            int excp = 0;
            string msg = string.Empty;
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                new StoreAccountDeterminationCLS().Save(ref excp, ref msg, branch, key.Type, key.Store, role, subAccountId);
            });
            if (excp != 0)
            {
                if (!_pickerOpen) _errorMessage = msg;
                return string.IsNullOrEmpty(msg) ? Tr("SystemError", "") : msg;
            }
            await LoadAsync();
            Snackbar.Add(Tr("SADSaved"), Severity.Success);
            return string.Empty;
        }
        catch (Exception ex)
        {
            return Tr("SystemError", ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    // يملأ أدوار الفرع الفارغة التى يوجد لها حساب فرعى واحد بالضبط من نوعها فى الشجرة؛ لا يغيّر دوراً محدداً.
    private async Task SuggestAsync()
    {
        _busy = true;
        int count = 0;
        try
        {
            var branch = Common.Branch_Id;
            var empty = StoreAccountDeterminationCLS.Roles.Where(r => Find(0, 0, r.Role) == null).Select(r => r.Role).ToList();
            count = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var cls = new StoreAccountDeterminationCLS();
                int n = 0;
                foreach (var role in empty)
                {
                    long id = cls.SuggestAccount(branch, role);
                    if (id == 0) continue;
                    int excp = 0;
                    string msg = string.Empty;
                    cls.Save(ref excp, ref msg, branch, 0, 0, role, id);
                    if (excp == 0) n++;
                }
                return n;
            });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _busy = false;
        }
        Snackbar.Add(count > 0 ? Tr("SADSuggestDone", count) : Tr("SADSuggestNone"), count > 0 ? Severity.Success : Severity.Info);
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
    }
}

