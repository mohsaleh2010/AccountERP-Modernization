@* 🟢 خطة 03 — المرحلة 6: الاحتياجات (حد الطلب) — بديل NeedeD_balance وNeeded_balance_Total: الأصناف التى رصيدها ≤ حد الطلب
   (Unit_item.Upon_Request)، والكمية المقترحة = حد الطلب − الرصيد، والتكلفة التقديرية بآخر سعر شراء، مرتبة بالأشد نقصاً.
   التصميم حسب ui-ux-pro-max. *@
@page "/store/needs"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.StoreMovementReportService
@inject LanguageService LangService
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider
@implements IDisposable

<PageTitle>@Tr("SNTitle")</PageTitle>

<InvoiceStyles />

<style>
    .sn-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .sn-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-error) 12%, transparent); color: var(--mud-palette-error); }
    .sn-head .ico .mud-icon-root { font-size: 2rem; }
    .sn-head .titles { flex: 1 1 260px; min-width: 0; }
    .sn-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .sn-gap { margin-top: 16px; }
    .sn-filters { display: grid; grid-template-columns: minmax(140px, .7fr) minmax(200px, 1.2fr) minmax(220px, 1.6fr); gap: 12px; align-items: start; }
    .sn-name { font-weight: 600; } .sn-code { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .sn-num { font-variant-numeric: tabular-nums; }
    .sn-short { color: var(--mud-palette-error); font-weight: 700; }
    .sn-bar { display: inline-block; width: 90px; height: 8px; border-radius: 999px; background: var(--mud-palette-background-gray); overflow: hidden; vertical-align: middle; margin-inline-start: 8px; }
    .sn-bar > i { display: block; height: 100%; background: var(--mud-palette-error); }
    .sn-pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-top: 12px; }
    .sn-pager .info { font-size: .875rem; color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums; }
    .sn-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    .sn-empty .mud-icon-root { color: var(--mud-palette-success); }
    @@media (max-width: 899px) { .sn-filters { grid-template-columns: minmax(0, 1fr); } }
    @@media print { body * { visibility: hidden; } .sn-print, .sn-print * { visibility: visible; } .sn-print { position: absolute; inset-inline-start: 0; top: 0; width: 100%; } .sn-noprint { display: none !important; } }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page sn-print">
    <div class="inv-card sn-head">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.ProductionQuantityLimits" /></div>
        <div class="titles">
            <h1 class="inv-title">@Tr("SNTitle")</h1>
            <div class="sub">@Tr("SNSub")</div>
        </div>
        <MudButton Class="sn-noprint" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Disabled="_loading" OnClick="PrintAsync">@Tr("PrintButton")</MudButton>
    </div>

    @if (_smartAvailable)
    {
        @* P8.6.3: تبويبان — حد الطلب (كما هو) | الاقتراح الذكى *@
        <div class="sn-gap sn-noprint">
            <MudToggleGroup T="int" Value="_tab" ValueChanged="@(v => _tab = v)" Color="Color.Primary" Size="Size.Small">
                <MudToggleItem Value="0" Text="@Tr("AIQ_TabManual")" />
                <MudToggleItem Value="1" Text="@Tr("AIQ_TabSmart")" />
            </MudToggleGroup>
        </div>
    }
    @if (_tab == 1 && _smartAvailable)
    {
        <AccountERP.SharedUI.Components.Store.SmartReorderPanel Stores="_stores" />
    }
    else
    {

    <div class="inv-card sn-gap sn-noprint" role="search">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.FilterList" />@Tr("SOFiltersTitle")</h2>
        <div class="sn-filters">
            <MudSelect T="int" Value="_storeType" ValueChanged="OnStoreTypeAsync" Label="@Tr("SOPartyType")" Variant="Variant.Outlined" ToStringFunc="@(v => Tr("SOParty_" + v))">
                <MudSelectItem T="int" Value="4">@Tr("SOParty_4")</MudSelectItem>
                <MudSelectItem T="int" Value="20">@Tr("SOParty_20")</MudSelectItem>
            </MudSelect>
            <MudSelect T="long" Value="_storeId" ValueChanged="OnStoreAsync" Label="@Tr("SOParty_" + _storeType)" Variant="Variant.Outlined"
                       ToStringFunc="@(v => v == 0 ? Tr("SBAll") : _stores.FirstOrDefault(s => s.Id == v)?.Name ?? "")">
                <MudSelectItem T="long" Value="0L">@Tr("SBAll")</MudSelectItem>
                @foreach (var s in _stores)
                {
                    <MudSelectItem T="long" Value="@s.Id">@s.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField T="string" Value="_text" ValueChanged="OnTextAsync" Label="@Tr("SOItemSearch")" Variant="Variant.Outlined" Immediate="true" DebounceInterval="400"
                          Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    </div>

    <div class="inv-card sn-gap">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@Tr("SNResults")<span class="inv-count">@_total</span></h2>
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert> }
        <MudTable Items="@_rows" T="NeedRow" Hover="true" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Loading="_loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>@Tr("SOParty_" + _storeType)</MudTh>
                <MudTh>@Tr("SOItem")</MudTh>
                <MudTh Style="text-align:end">@Tr("SOBalance")</MudTh>
                <MudTh Style="text-align:end">@Tr("SNReorder")</MudTh>
                <MudTh Style="text-align:end">@Tr("SNSuggested")</MudTh>
                <MudTh Style="text-align:end">@Tr("SNEstimate")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("SOParty_" + _storeType)">@context.Store_Name</MudTd>
                <MudTd DataLabel="@Tr("SOItem")"><div class="sn-name">@context.Item_Name</div><div class="sn-code">@CodeText(context.Code)</div></MudTd>
                <MudTd DataLabel="@Tr("SOBalance")" Style="text-align:end">
                    <span class="sn-num">@Bal(context.Balance_Small, context)</span>
                    <span class="sn-bar" aria-hidden="true"><i style="@($"width:{Pct(context)}%")"></i></span>
                </MudTd>
                <MudTd DataLabel="@Tr("SNReorder")" Style="text-align:end"><span class="sn-num">@Qty(context.Reorder_Large) @context.B_Unit</span></MudTd>
                <MudTd DataLabel="@Tr("SNSuggested")" Style="text-align:end"><span class="sn-num sn-short">@Bal(context.Shortage_Small, context)</span></MudTd>
                <MudTd DataLabel="@Tr("SNEstimate")" Style="text-align:end">
                    <span class="sn-num">@(context.Last_Purchase_Large is decimal p ? Money(p * context.Shortage_Small / (context.Factor <= 0 ? 1 : context.Factor)) : "—")</span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="sn-empty"><MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" /><b>@Tr("SNEmpty")</b><span>@Tr("SNEmptyHint")</span></div>
            </NoRecordsContent>
        </MudTable>
        @if (_total > 0)
        {
            <div class="sn-pager sn-noprint">
                <span class="info">@Tr("SOPageInfo", _skip + 1, Math.Min(_skip + PageSize, _total), _total)</span>
                <div style="display:flex; gap:8px;">
                    <MudButton Variant="Variant.Outlined" Disabled="@(_skip == 0 || _loading)" OnClick="@(() => PageAsync(-1))">@Tr("SOPrev")</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="@(_skip + PageSize >= _total || _loading)" OnClick="@(() => PageAsync(1))">@Tr("SONext")</MudButton>
                </div>
            </div>
        }
    </div>
    }
</div>
</MudContainer>

@code {
    private const int PageSize = 50;
    private readonly StoreMovementReportService _svc = new();
    private readonly StoreBalancesService _bal = new();
    private List<StoreBalancesService.Option> _stores = new();
    private List<NeedRow> _rows = new();
    private int _storeType = 4, _skip, _total;
    private long _storeId;
    private string? _text, _error;
    private bool _loading = true;
    private int _tab;
    private bool _smartAvailable;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        try { _smartAvailable = ServiceProvider.GetService(typeof(AiReorderUiService)) is AiReorderUiService rs && rs.CanView(); } catch { _smartAvailable = false; }
        try { _stores = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _bal.GetStores(4); }); }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        await LoadAsync();
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private async Task OnStoreTypeAsync(int t)
    {
        _storeType = t; _storeId = 0; _skip = 0;
        _stores = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _bal.GetStores(t); });
        await LoadAsync();
    }
    private async Task OnStoreAsync(long id) { _storeId = id; _skip = 0; await LoadAsync(); }
    private async Task OnTextAsync(string? t) { _text = t; _skip = 0; await LoadAsync(); }
    private async Task PageAsync(int dir) { _skip = Math.Max(0, _skip + dir * PageSize); await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        int st = _storeType, skip = _skip; long sid = _storeId; string? text = _text;
        try
        {
            _rows = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetNeeds(st, sid, text, skip, PageSize); });
            _total = _rows.FirstOrDefault()?.Total_Rows ?? 0;
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); _rows = new(); _total = 0; }
        finally { _loading = false; }
    }

    private static int Pct(NeedRow r)
    {
        decimal reorder = r.Reorder_Large * (r.Factor <= 0 ? 1 : r.Factor);
        return reorder <= 0 ? 0 : (int)Math.Clamp(r.Balance_Small / reorder * 100m, 0, 100);
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");
    private static string Money(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);
    private static string Qty(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string CodeText(string code) => string.IsNullOrWhiteSpace(code) || code.Trim() == "0" ? "" : code;
    private static string Bal(decimal small, NeedRow r)
    {
        decimal f = r.Factor <= 0 ? 1 : r.Factor, abs = Math.Abs(small), large = Math.Floor(abs / f), rest = abs - large * f;
        string t = rest != 0 ? $"{Qty(large)} {r.B_Unit} + {Qty(rest)} {r.S_Unit}" : $"{Qty(large)} {r.B_Unit}";
        return small < 0 ? "-" + t : t;
    }
    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try { CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo; return Lang[key, args]; }
        finally { CultureInfo.CurrentUICulture = previousCulture; }
    }
}
