@* 🟢 خطة 05 بند 24: أرصدة أصناف الأدوية (بدل Item_balance_ph). سطر لكل دواء فى مخزن: الرصيد بالعبوة والجزء، حد الطلب، وأقرب صلاحية
   بشارة نص ولون مع رابط تشغيلات الصنف (/store/balances/expiry?item=). تصفية بالمخزن والفئة والنوع والمصنع والبحث (عربى/إنجليزى/كود/باركود)
   و«حد الطلب فقط». لا تعديل رصيد مباشر (الديسك توب كان يحدّث Unit_item بلا حركة) — التعديل بإذن تسوية من المخازن.
   الاستعلامات فى PharmacyBalancesService بمعاملات. التصميم حسب ui-ux-pro-max ونظام inv-* المشترك. *@
@page "/store/balances/pharmacy"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.PharmacyBalancesService
@inject LanguageService LangService
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Tr("PHTitle")</PageTitle>

<InvoiceStyles />

<style>
    .ph-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .ph-head .ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center;
                    background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .ph-head .ico .mud-icon-root { font-size: 2rem; }
    .ph-head .titles { flex: 1 1 260px; min-width: 0; }
    .ph-head .sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .ph-head .mud-button-root { min-height: 44px; }
    .ph-gap { margin-top: 16px; }
    .ph-filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: start; }
    .ph-filters .f-text { grid-column: 1 / -1; }
    .ph-row2 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 8px; }
    .ph-tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .ph-tile { padding: 14px 18px; border-radius: 12px; border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .ph-tile .k { display: flex; align-items: center; gap: 6px; font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .ph-tile .v { margin-top: 4px; font-size: 1.5rem; font-weight: 700; font-variant-numeric: tabular-nums; }
    .ph-tile.bad .v { color: var(--mud-palette-error); }
    .ph-tile.warn .v { color: var(--mud-palette-warning-darken); }
    .ph-name { font-weight: 600; }
    .ph-sub { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .ph-num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ph-neg { color: var(--mud-palette-error); font-weight: 700; }
    .ph-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 999px; font-size: .8125rem; font-weight: 600; white-space: nowrap; }
    .ph-badge .mud-icon-root { font-size: 1rem; }
    .ph-badge.s1 { background: color-mix(in srgb, var(--mud-palette-error) 14%, transparent); color: var(--mud-palette-error-darken); }
    .ph-badge.s2 { background: color-mix(in srgb, var(--mud-palette-warning) 18%, transparent); color: var(--mud-palette-warning-darken); }
    .ph-badge.s3 { background: color-mix(in srgb, var(--mud-palette-success) 14%, transparent); color: var(--mud-palette-success-darken); }
    .ph-badge.low { background: color-mix(in srgb, var(--mud-palette-error) 14%, transparent); color: var(--mud-palette-error-darken); }
    .ph-actions { display: flex; gap: 4px; justify-content: flex-end; }
    .ph-pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-top: 12px; }
    .ph-pager .info { font-size: .875rem; color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums; }
    .ph-pager .btns { display: flex; gap: 8px; }
    .ph-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 12px; color: var(--mud-palette-text-secondary); text-align: center; }
    .ph-empty .mud-icon-root { opacity: .5; }
    @@media (max-width: 1199px) { .ph-filters, .ph-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (max-width: 599px) { .ph-filters { grid-template-columns: minmax(0, 1fr); } }
    @@media print {
        body * { visibility: hidden; }
        .ph-print, .ph-print * { visibility: visible; }
        .ph-print { position: absolute; inset-inline-start: 0; top: 0; width: 100%; }
        .ph-noprint { display: none !important; }
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page ph-print">

    <div class="inv-card ph-head">
        <div class="ico" aria-hidden="true"><MudIcon Icon="@Icons.Material.Filled.Medication" /></div>
        <div class="titles">
            <h1 class="inv-title">@Tr("PHTitle")</h1>
            <div class="sub">@(_below ? Tr("PHSubBelow") : Tr("PHSub"))</div>
        </div>
        <MudButton Class="ph-noprint" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.EventBusy" Href="/store/balances/expiry">@Tr("EXTitle")</MudButton>
        <MudButton Class="ph-noprint" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Href="/items/p/pharmacy/new">@Tr("PHAddItem")</MudButton>
        <MudButton Class="ph-noprint" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Disabled="_loading" OnClick="PrintAsync">@Tr("PrintButton")</MudButton>
    </div>

    <div class="inv-card ph-gap ph-noprint" role="search">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.FilterList" />@Tr("SOFiltersTitle")</h2>
        <div class="ph-filters">
            <MudSelect T="long" Value="_storeId" ValueChanged="@(v => SetAsync(() => _storeId = v))" Label="@Tr("SOParty_4")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => Name(_stores, v))">
                <MudSelectItem T="long" Value="0L">@Tr("SBAll")</MudSelectItem>
                @foreach (var s in _stores) { <MudSelectItem T="long" Value="@s.Id">@s.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="long" Value="_categoryId" ValueChanged="@(v => SetAsync(() => _categoryId = v))" Label="@Tr("SBCategory")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => Name(_categories, v))">
                <MudSelectItem T="long" Value="0L">@Tr("SBAll")</MudSelectItem>
                @foreach (var c in _categories) { <MudSelectItem T="long" Value="@c.Id">@c.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="long" Value="_typeId" ValueChanged="@(v => SetAsync(() => _typeId = v))" Label="@Tr("PHType")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => Name(_types, v))">
                <MudSelectItem T="long" Value="0L">@Tr("SBAll")</MudSelectItem>
                @foreach (var t in _types) { <MudSelectItem T="long" Value="@t.Id">@t.Name</MudSelectItem> }
            </MudSelect>
            <MudSelect T="long" Value="_factoryId" ValueChanged="@(v => SetAsync(() => _factoryId = v))" Label="@Tr("PHFactory")" Variant="Variant.Outlined"
                       ToStringFunc="@(v => Name(_factories, v))">
                <MudSelectItem T="long" Value="0L">@Tr("SBAll")</MudSelectItem>
                @foreach (var t in _factories) { <MudSelectItem T="long" Value="@t.Id">@t.Name</MudSelectItem> }
            </MudSelect>
            <div class="f-text">
                <MudTextField T="string" Value="_text" ValueChanged="@(v => SetAsync(() => _text = v))" Label="@Tr("PHSearch")" Variant="Variant.Outlined"
                              Immediate="true" DebounceInterval="400" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
            </div>
        </div>
        <div class="ph-row2">
            <MudSwitch T="bool" Value="_below" ValueChanged="@(v => SetAsync(() => _below = v))" Color="Color.Primary" Label="@Tr("PHBelowOnly")" />
            <MudSwitch T="bool" Value="_includeZero" ValueChanged="@(v => SetAsync(() => _includeZero = v))" Color="Color.Primary" Label="@Tr("SBIncludeZero")" />
        </div>
    </div>

    <div class="ph-tiles ph-gap">
        <div class="ph-tile"><div class="k">@Tr("SBLines")</div><div class="v">@_total</div></div>
        <div class="ph-tile @(_sum.Below_Rows > 0 ? "bad" : "")"><div class="k"><MudIcon Icon="@Icons.Material.Filled.TrendingDown" Size="Size.Small" />@Tr("PHBelowTile")</div><div class="v">@_sum.Below_Rows</div></div>
        <div class="ph-tile @(_sum.Expired_Rows > 0 ? "bad" : "")"><div class="k"><MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" />@Tr("PHExpiredTile")</div><div class="v">@_sum.Expired_Rows</div></div>
        <div class="ph-tile @(_sum.Near_Rows > 0 ? "warn" : "")"><div class="k"><MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />@Tr("PHNearTile")</div><div class="v">@_sum.Near_Rows</div></div>
    </div>

    <div class="inv-card ph-gap">
        <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@Tr("SBResults")<span class="inv-count">@_total</span></h2>
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true" role="alert">@_error</MudAlert>
        }
        <MudTable Items="@_rows" T="PharmacyRow" Hover="true" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Loading="_loading" LoadingProgressColor="Color.Primary">
            <HeaderContent>
                <MudTh>@Tr("SOItem")</MudTh>
                <MudTh>@Tr("PHType")</MudTh>
                <MudTh>@Tr("SOParty_4")</MudTh>
                <MudTh Style="text-align:end">@Tr("SOBalance")</MudTh>
                <MudTh Style="text-align:end">@Tr("PHReorder")</MudTh>
                <MudTh>@Tr("PHNearest")</MudTh>
                <MudTh Class="ph-noprint" Style="text-align:end">@Tr("PHActions")</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Tr("SOItem")">
                    <div class="ph-name">@context.Item_Name</div>
                    <div class="ph-sub">@CodeText(context.Code)@(string.IsNullOrWhiteSpace(context.English_Name) ? "" : " · " + context.English_Name)</div>
                </MudTd>
                <MudTd DataLabel="@Tr("PHType")">@context.Type_Name<div class="ph-sub">@context.Factory_Name</div></MudTd>
                <MudTd DataLabel="@Tr("SOParty_4")">@context.Store_Name</MudTd>
                <MudTd DataLabel="@Tr("SOBalance")" Style="text-align:end">
                    <span class="ph-num @(context.Balance_Small < 0 ? "ph-neg" : "")">@SmallToText(context.Balance_Small, context.Factor, context.B_Unit, context.S_Unit)</span>
                </MudTd>
                <MudTd DataLabel="@Tr("PHReorder")" Style="text-align:end">
                    @if (context.Reorder_Large <= 0) { <span class="ph-num">—</span> }
                    else if (context.Below_Reorder)
                    {
                        <span class="ph-badge low"><MudIcon Icon="@Icons.Material.Filled.TrendingDown" />@Tr("PHReachedReorder", Qty(context.Reorder_Large))</span>
                    }
                    else { <span class="ph-num">@Qty(context.Reorder_Large) @context.B_Unit</span> }
                </MudTd>
                <MudTd DataLabel="@Tr("PHNearest")">
                    @if (context.Nearest_Expiry is DateTime d)
                    {
                        <span class="ph-badge s@(context.Expiry_Status)"><MudIcon Icon="@StatusIcon(context.Expiry_Status)" />@d.ToString("yyyy/MM/dd", CultureInfo.InvariantCulture)</span>
                    }
                    else { <span class="ph-sub">@Tr("PHNoBatches")</span> }
                </MudTd>
                <MudTd Class="ph-noprint">
                    <div class="ph-actions">
                        <MudTooltip Text="@Tr("PHBatches", context.Batches)">
                            <MudIconButton Icon="@Icons.Material.Filled.Inventory" aria-label="@Tr("PHBatches", context.Batches)" Href="@($"/store/balances/expiry?item={context.Item_Id}")" />
                        </MudTooltip>
                        <MudTooltip Text="@Tr("PHOpenItem")">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" aria-label="@Tr("PHOpenItem")" Href="@($"/items/p/pharmacy/{context.Item_Id}")" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="ph-empty">
                    <MudIcon Icon="@Icons.Material.Filled.Medication" Size="Size.Large" />
                    <b>@Tr("SBEmpty")</b>
                    @if (!_includeZero)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" OnClick="@(() => SetAsync(() => _includeZero = true))">@Tr("SBIncludeZero")</MudButton>
                    }
                </div>
            </NoRecordsContent>
        </MudTable>
        @if (_total > 0)
        {
            <div class="ph-pager ph-noprint">
                <span class="info" aria-live="polite">@Tr("SOPageInfo", _skip + 1, Math.Min(_skip + PageSize, _total), _total)</span>
                <div class="btns">
                    <MudButton Variant="Variant.Outlined" StartIcon="@(LangService.IsRtl ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                               Disabled="@(_skip == 0 || _loading)" OnClick="@(() => PageAsync(-1))">@Tr("SOPrev")</MudButton>
                    <MudButton Variant="Variant.Outlined" EndIcon="@(LangService.IsRtl ? Icons.Material.Filled.ChevronLeft : Icons.Material.Filled.ChevronRight)"
                               Disabled="@(_skip + PageSize >= _total || _loading)" OnClick="@(() => PageAsync(1))">@Tr("SONext")</MudButton>
                </div>
            </div>
        }
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3 ph-noprint">
            @Tr("PHEditNote")
            <MudLink Href="/store/order/1007" Class="ms-2">@Tr("PHAdjustUp")</MudLink> ·
            <MudLink Href="/store/order/1008">@Tr("PHAdjustDown")</MudLink>
        </MudAlert>
    </div>
</div>
</MudContainer>

@code {
    private const int PageSize = 50;

    /// <summary>below=1 يفتح على «حد الطلب فقط».</summary>
    [SupplyParameterFromQuery(Name = "below")] public int? BelowQuery { get; set; }

    private readonly PharmacyBalancesService _svc = new();
    private readonly StoreBalancesService _balances = new();
    private List<StoreBalancesService.Option> _stores = new();
    private List<Option> _categories = new(), _types = new(), _factories = new();
    private List<PharmacyRow> _rows = new();
    private PharmacyRow _sum = new();
    private long _storeId, _categoryId, _typeId, _factoryId;
    private string? _text, _error;
    private bool _below, _includeZero, _loading = true;
    private int _skip, _total;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        _below = BelowQuery == 1;
        try
        {
            (_stores, (_categories, _types, _factories)) = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return (_balances.GetStores(4), _svc.GetLookups()); });
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); }
        await LoadAsync();
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private async Task SetAsync(Action set) { set(); _skip = 0; await LoadAsync(); }
    private async Task PageAsync(int dir) { _skip = Math.Max(0, _skip + dir * PageSize); await LoadAsync(); }

    private async Task LoadAsync()
    {
        _loading = true; _error = null;
        var f = new PharmacyFilter
        {
            StoreId = _storeId, CategoryId = _categoryId, TypeId = _typeId, FactoryId = _factoryId, Text = _text,
            BelowReorder = _below, IncludeZero = _includeZero, Skip = _skip, Take = PageSize,
        };
        try
        {
            _rows = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetBalances(f); });
            _sum = _rows.FirstOrDefault() ?? new PharmacyRow();
            _total = _sum.Total_Rows;
        }
        catch (Exception ex) { _error = Tr("SystemError", Inner(ex)); _rows = new(); _sum = new(); _total = 0; }
        finally { _loading = false; }
    }

    private string Name<T>(List<T> list, long id) where T : class =>
        id == 0 ? Tr("SBAll") : list switch
        {
            List<Option> o => o.FirstOrDefault(x => x.Id == id)?.Name ?? "",
            List<StoreBalancesService.Option> o => o.FirstOrDefault(x => x.Id == id)?.Name ?? "",
            _ => "",
        };

    private static string StatusIcon(int s) => s switch
    {
        1 => Icons.Material.Filled.Error, 2 => Icons.Material.Filled.Warning, _ => Icons.Material.Filled.CheckCircle,
    };

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    private static string Qty(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string CodeText(string code) => string.IsNullOrWhiteSpace(code) || code.Trim() == "0" ? "" : code;
    private static string SmallToText(decimal small, decimal factor, string bUnit, string sUnit)
    {
        if (factor <= 0) factor = 1;
        decimal abs = Math.Abs(small), large = Math.Floor(abs / factor), rest = abs - large * factor;
        string t = rest != 0 ? $"{Qty(large)} {bUnit} + {Qty(rest)} {sUnit}" : $"{Qty(large)} {bUnit}";
        return small < 0 ? "-" + t : t;
    }
    private static string Inner(Exception ex) { while (ex.InnerException != null) ex = ex.InnerException; return ex.Message; }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
