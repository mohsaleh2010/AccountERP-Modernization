@* 🟢 خطة 03 — المرحلة 2: صفحة إذن المخزن العامة. تقابل Store_LIB.OrdersNew.NewLast.Order_DetailsWorkNewFrm(type) لأنواع الوارد/المنصرف البسيطة
   (عميل، مورد، تسويات، هالك، إنتاج/تشغيل، قطع غيار، ورشة، موظف، ماكينة، مخزن خارجى). قواعد كل نوع (الأطراف، جهة المخزن، مصدر السعر)
   من Store_Order_Type_Settings، والحفظ والترحيل عبر StoreOrderPageService ← StoreOrderService ← محرك المخزون.
   الفرق المقصود عن الشاشة القديمة (م-03-3): مسودة ← ترحيل ← تصحيح بإذن عكسى؛ لا تعديل ولا حذف لإذن مرحَّل.
   الجهة «قسم» مخزن فرعى برصيد (م-03-9). التحويل بين المخازن/الأقسام (1001/1006/1016/1017) فى المرحلة 3. *@
@page "/store/order/{OrderType:int}"

@using System.Globalization
@using AccountModelsLib
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using static AccountModelsLib.StoreOrderService
@using static AccountModelsLib.StoreOrderPageService
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@Title</PageTitle>

<InvoiceStyles />

@* تصميم شاشات الاستلام والصرف (بطلب المستخدم): رأس بأيقونة الاتجاه، صف أول = رقم الإذن وتاريخه، صف ثانٍ = لوحتا «من» و«إلى» متجاورتان
   بسهم الاتجاه بينهما، ولوحة جهة المخزون مميَّزة. الألوان من متغيرات MudBlazor فتعمل فى الوضعين الفاتح والداكن. *@
<style>
    .so-head { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; }
    .so-head .so-ico { flex: none; width: 56px; height: 56px; border-radius: 16px; display: grid; place-items: center; }
    .so-head .so-ico .mud-icon-root { font-size: 2rem; }
    .so-ico.in { background: color-mix(in srgb, var(--mud-palette-success) 15%, transparent); color: var(--mud-palette-success); }
    .so-ico.out { background: color-mix(in srgb, var(--mud-palette-warning) 18%, transparent); color: var(--mud-palette-warning-darken, var(--mud-palette-warning)); }
    .so-ico.tr { background: color-mix(in srgb, var(--mud-palette-info) 15%, transparent); color: var(--mud-palette-info); }
    .so-head .so-titles { flex: 1 1 260px; min-width: 0; }
    .so-head .so-sub { margin-top: 4px; font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .so-head .so-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }

    .so-section-gap { margin-top: 16px; }
    .so-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .so-no { display: flex; flex-direction: column; justify-content: center; gap: 2px; padding: 10px 16px; min-height: 56px; border-radius: 10px;
             border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-background-gray); }
    .so-no .lbl { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .so-no b { font-size: 1.35rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-primary); line-height: 1.2; }
    .so-no b.pending { font-size: 1rem; font-weight: 500; color: var(--mud-palette-text-secondary); }

    .so-parties { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: stretch; gap: 12px; }
    .so-party { position: relative; display: flex; flex-direction: column; gap: 12px; padding: 16px; border-radius: 12px;
                border: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface); }
    .so-party.stock { border: 2px solid color-mix(in srgb, var(--mud-palette-primary) 55%, transparent);
                      background: color-mix(in srgb, var(--mud-palette-primary) 4%, var(--mud-palette-surface)); }
    .so-party-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .so-party-head .name { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 1rem; color: var(--mud-palette-text-primary); }
    .so-party-head .name .mud-icon-root { color: var(--mud-palette-primary); }
    .so-tag { padding: 2px 10px; border-radius: 999px; font-size: .75rem; font-weight: 600; white-space: nowrap;
              background: color-mix(in srgb, var(--mud-palette-primary) 14%, transparent); color: var(--mud-palette-primary); }
    .so-fixed { display: flex; align-items: center; gap: 8px; min-height: 56px; padding: 0 14px; border-radius: 8px;
                border: 1px dashed var(--mud-palette-lines-default); color: var(--mud-palette-text-secondary); font-size: .9375rem; }
    .so-arrow { display: grid; place-items: center; }
    .so-arrow span { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
                     background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); box-shadow: 0 2px 6px rgba(0,0,0,.15); }
    /* سطر إدخال الصنف: كل الحقول وزر الإضافة فى صف واحد */
    .so-entry { display: grid; grid-template-columns: minmax(0, 3fr) repeat(2, minmax(120px, 1fr)) minmax(120px, auto); gap: 12px; align-items: start; }
    .so-entry.priced { grid-template-columns: minmax(0, 3fr) repeat(3, minmax(120px, 1fr)) minmax(120px, auto); }
    .so-entry .f-btn { padding-top: 6px; }
    .so-entry .f-btn .mud-button-root { min-height: 48px; }
    .so-entry-2 { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 12px; }
    .so-entry-2 > .mud-input-control { flex: 1 1 320px; }
    .so-opt { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; }
    .so-opt .nm { display: flex; flex-direction: column; min-width: 0; }
    .so-opt .cd { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .so-opt .bal { flex: none; padding: 2px 10px; border-radius: 999px; font-size: .8125rem; font-weight: 600; font-variant-numeric: tabular-nums;
                   background: color-mix(in srgb, var(--mud-palette-success) 14%, transparent); color: var(--mud-palette-success-darken, var(--mud-palette-success)); }
    .so-opt .bal.zero { background: var(--mud-palette-background-gray); color: var(--mud-palette-text-secondary); }

    /* شريط بيانات الصنف المختار */
    .so-picked { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; padding: 10px 12px; border-radius: 10px;
                 background: var(--mud-palette-background-gray); border: 1px solid var(--mud-palette-lines-default); }
    .so-stat { display: inline-flex; align-items: baseline; gap: 8px; padding: 4px 12px; border-radius: 8px; background: var(--mud-palette-surface);
               border: 1px solid var(--mud-palette-lines-default); }
    .so-stat .k { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .so-stat .v { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--mud-palette-text-primary); }
    .so-stat.good { border-color: color-mix(in srgb, var(--mud-palette-success) 50%, transparent); }
    .so-stat.good .v { color: var(--mud-palette-success-darken, var(--mud-palette-success)); }
    .so-stat.bad { border-color: var(--mud-palette-error); }
    .so-stat.bad .v { color: var(--mud-palette-error); }

    /* جدول الأصناف */
    .so-idx { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; font-size: .8125rem; font-weight: 700;
              background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent); color: var(--mud-palette-primary); }
    .so-item-name { font-weight: 600; color: var(--mud-palette-text-primary); }
    .so-item-code { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .so-q { font-variant-numeric: tabular-nums; font-weight: 600; }
    .so-u { font-size: .8125rem; color: var(--mud-palette-text-secondary); }
    .so-after { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--mud-palette-text-primary); }
    .so-after.bad { color: var(--mud-palette-error); }
    .so-transfer-mode { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; }
    .so-transfer-mode .txt { display: flex; flex-direction: column; flex: 1 1 260px; }
    .so-transfer-mode .txt span { font-size: .875rem; color: var(--mud-palette-text-secondary); }
    .so-recv { display: flex; gap: 8px; min-width: 220px; }
    .so-recv-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .so-close { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 8px; margin-top: 12px; }
    .so-close > .mud-input-control { flex: 1 1 320px; }
    .so-notes { margin-top: 16px; padding-top: 16px; border-top: 1px dashed var(--mud-palette-lines-default); }
    .so-empty { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 32px 12px; color: var(--mud-palette-text-secondary); }
    .so-empty .mud-icon-root { opacity: .5; }

    @@media (max-width: 1199px) {
        .so-entry, .so-entry.priced { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .so-entry .f-item { grid-column: 1 / -1; }
        .so-entry .f-btn { grid-column: 1 / -1; padding-top: 0; }
    }

    @@media (max-width: 899px) {
        .so-parties { grid-template-columns: minmax(0, 1fr); }
        .so-arrow span { transform: rotate(-90deg); }
    }
    @@media (max-width: 599px) { .so-meta { grid-template-columns: minmax(0, 1fr); } }

    /* مستند الطباعة: مخفى على الشاشة؛ وقت الطباعة يظهر وحده بألوان سوداء على أبيض */
    .so-print { display: none; }
    @@media print {
        @@page { size: A4; margin: 14mm 12mm; }
        body * { visibility: hidden; }
        .so-print, .so-print * { visibility: visible; }
        .so-print { display: block; position: absolute; inset-inline-start: 0; top: 0; width: 100%; color: #000; background: #fff;
                    font-size: 11pt; line-height: 1.5; }
        .so-print .pw { position: fixed; top: 40%; left: 0; right: 0; text-align: center; font-size: 72pt; font-weight: 700;
                        color: rgba(0,0,0,.08); transform: rotate(-20deg); }
        .so-print .ph { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-bottom: 8px; border-bottom: 2px solid #000; }
        .so-print .co { font-size: 15pt; font-weight: 700; }
        .so-print .dt { font-size: 13pt; margin-top: 2px; }
        .so-print .pm { border-collapse: collapse; font-size: 10pt; }
        .so-print .pm th, .so-print .pm td { padding: 2px 8px; border: 1px solid #000; text-align: start; }
        .so-print .pm th { background: #eee; font-weight: 600; }
        .so-print .pp { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 10px 0; }
        .so-print .pp > div { border: 1px solid #000; padding: 6px 10px; display: flex; flex-direction: column; }
        .so-print .pp span { font-size: 9pt; }
        .so-print .pl { width: 100%; border-collapse: collapse; }
        .so-print .pl th, .so-print .pl td { border: 1px solid #000; padding: 4px 6px; text-align: start; font-variant-numeric: tabular-nums; }
        .so-print .pl thead th { background: #eee; }
        .so-print .pl tfoot td { font-weight: 700; background: #f5f5f5; }
        .so-print .pl small { color: #444; }
        .so-print .pl tr { page-break-inside: avoid; }
        .so-print .pn { margin-top: 10px; }
        .so-print .ps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 40px; text-align: center; }
        .so-print .ps > div { border-top: 1px solid #000; padding-top: 6px; }
        .so-print .pf { margin-top: 24px; font-size: 8pt; color: #444; }
    }
</style>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">

    @if (_settings is null && string.IsNullOrEmpty(_errorMessage))
    {
        @* حتى يُقرأ إعداد النوع: هيكل تحميل بدل عنوان واتجاه افتراضيين مضلِّلين *@
        <div class="inv-card so-head" aria-busy="true">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="56px" Height="56px" Style="border-radius:16px" />
            <div class="so-titles">
                <MudSkeleton Width="240px" Height="36px" />
                <MudSkeleton Width="180px" />
            </div>
        </div>
    }
    else
    {
    <div class="inv-card so-head">
        <div class="so-ico @DirClass" aria-hidden="true"><MudIcon Icon="@DirIcon" /></div>
        <div class="so-titles">
            <h1 class="inv-title">@Title</h1>
            <div class="so-sub">@DirText</div>
        </div>
        <div class="so-actions">
            <MudChip T="string" Color="@StatusColor" Variant="Variant.Filled" Icon="@StatusIcon" Size="Size.Medium">@StatusText</MudChip>
            @if (_header?.Reversal_Of_No is long ofNo)
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Undo">@Tr("SOReversalOf", ofNo)</MudChip>
            }
            @if (_header?.Reversed_By_No is long byNo)
            {
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Error" Icon="@Icons.Material.Filled.Undo">@Tr("SOReversedBy", byNo)</MudChip>
            }
            @if (!string.IsNullOrWhiteSpace(_header?.Transfer_Close_Reason))
            {
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.ReportProblem">@Tr("SOShortageReason", _header.Transfer_Close_Reason)</MudChip>
            }
            @if (_header?.Source_Order_No is long srcNo)
            {
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.LocalShipping"
                         Href="@($"/store/order/{_header.Source_Order_Type}?id={_header.Source_Order_Id}")">@Tr("SOReceiptOf", srcNo)</MudChip>
            }
            @if (_header is { Engine_Posted: false, Doc_Status: 1 })
            {
                <MudChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.History">@Tr("SOLegacyOrder")</MudChip>
            }
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.List" Href="@($"/store/orders?type={OrderType}")">@Tr("SOListTitle")</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_isBusy" OnClick="NewOrderAsync">@Tr("DstNewButton")</MudButton>
        </div>
    </div>
    }

    @if (_settings is not null && IsReceiptType)
    {
        <MudAlert Severity="Severity.Info" Class="so-section-gap">@Tr("SOReceiptAuto")</MudAlert>
    }
    else if (_settings is not null && _settings.Is_Transfer && !ReadOnly && _transferUi is not null)
    {
        <div class="inv-card so-section-gap so-transfer-mode">
            <MudIcon Icon="@(DirectTransfer ? Icons.Material.Filled.SyncAlt : Icons.Material.Filled.LocalShipping)" Color="Color.Info" />
            <div class="txt">
                <b>@(DirectTransfer ? Tr("SOTransferDirectMode") : Tr("SOTransferTwoStep"))</b>
                <span>@(DirectTransfer ? Tr("SOTransferDirectHint") : Tr("SOTransferTwoStepHint"))</span>
            </div>
            @if (_transferUi.ShowDirectChoice)
            {
                <MudSwitch T="bool" @bind-Value="_directRequested" Color="Color.Primary" Label="@Tr("SOTransferDirectSwitch")" />
            }
        </div>
    }

    @if (_settings is not null)
    {
        <div class="inv-card so-section-gap">
            <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.Inventory2" />@Tr("SOOrderData")</h2>

            @* الصف الأول: رقم الإذن وتاريخه *@
            <div class="so-meta">
                <div class="so-no" aria-live="polite">
                    <span class="lbl">@Tr("SOOrderNo")</span>
                    @if (_orderNo > 0)
                    {
                        <b>@_orderNo</b>
                    }
                    else
                    {
                        <b class="pending">@Tr("SONoAfterSave")</b>
                    }
                </div>
                <MudDatePicker T="DateTime?" @bind-Date="_date" Label="@Tr("SOOrderDate")" Variant="Variant.Outlined" Disabled="@ReadOnly" />
            </div>

            @* الصف الثانى: من ← إلى *@
            <div class="so-parties so-section-gap">
                @PartyPanel(true)
                <div class="so-arrow" aria-hidden="true"><span><MudIcon Icon="@(LangService.IsRtl ? Icons.Material.Filled.ArrowBack : Icons.Material.Filled.ArrowForward)" /></span></div>
                @PartyPanel(false)
            </div>
        </div>

        @if (!ReadOnly)
        {
            <div class="inv-card so-section-gap">
                <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.AddCircle" />@Tr("SOAddLineTitle")</h2>
                @* سطر إدخال واحد: الصنف ثم الكميات (والسعر للنوع اليدوى) ثم زر الإضافة *@
                <div class="so-entry @(_settings.IsManualPrice ? "priced" : "")">
                    <div class="f-item">
                        <MudAutocomplete T="StockLineOption" @key="_pickerKey" Value="_picked" ValueChanged="OnPicked" SearchFunc="SearchAsync"
                                         ToStringFunc="@(o => o == null ? "" : $"{o.Item_Name} — {o.Code}")" Label="@Tr("SOItemSearch")"
                                         Variant="Variant.Outlined" DebounceInterval="350" ResetValueOnEmptyText="true" Disabled="@(StoreId <= 0)"
                                         AdornmentIcon="@Icons.Material.Filled.Search" MaxItems="50" HelperText="@(StoreId <= 0 ? Tr("SOSelectStore") : null)">
                            <ItemTemplate Context="o">
                                <div class="so-opt">
                                    <div class="nm"><b>@o.Item_Name</b><span class="cd">@CodeText(o.Code)</span></div>
                                    <span class="bal @(o.Full_qua <= 0 && o.D_Qua <= 0 ? "zero" : "")">@BalanceText(o.Full_qua, o.D_Qua, o.B_Unit, o.S_Unit)</span>
                                </div>
                            </ItemTemplate>
                        </MudAutocomplete>
                    </div>
                    <div class="f-num"><MudNumericField T="decimal" @bind-Value="_qtyLarge" Label="@Tr("SOQtyLarge")" Variant="Variant.Outlined" HideSpinButtons="true" Min="0"
                                                        Adornment="Adornment.End" AdornmentText="@(_picked?.B_Unit ?? "")" /></div>
                    <div class="f-num"><MudNumericField T="decimal" @bind-Value="_qtySmall" Label="@Tr("SOQtySmall")" Variant="Variant.Outlined" HideSpinButtons="true" Min="0"
                                                        Adornment="Adornment.End" AdornmentText="@(_picked?.S_Unit ?? "")" Disabled="@(_picked != null && _picked.Factor <= 1)" /></div>
                    @if (_settings.IsManualPrice)
                    {
                        <div class="f-num"><MudNumericField T="decimal?" @bind-Value="_unitCost" Label="@Tr("SOUnitCost")" Variant="Variant.Outlined" HideSpinButtons="true" Min="0" Format="0.####" /></div>
                    }
                    <div class="f-btn">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLine" FullWidth="true" Disabled="@(_picked is null)">@Tr("SOAddLine")</MudButton>
                    </div>
                </div>
                <div class="so-entry-2">
                    <MudTextField T="string" @bind-Value="_lineNotes" Label="@Tr("SOLineNotes")" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudCheckBox T="bool" @bind-Value="_onlyWithBalance" Label="@Tr("SOOnlyWithBalance")" Dense="true" Color="Color.Primary" />
                </div>
                @if (_picked != null)
                {
                    var afterSmall = PickedBalanceSmall + Sign * (_qtyLarge * _picked.Factor + _qtySmall);
                    <div class="so-picked" aria-live="polite">
                        <span class="so-stat"><span class="k">@Tr("SOBalance")</span><span class="v">@BalanceText(_picked.Full_qua, _picked.D_Qua, _picked.B_Unit, _picked.S_Unit)</span></span>
                        <span class="so-stat"><span class="k">@Tr("SOAvgCost")</span><span class="v">@Money(_picked.Avg_Cost_Large)</span></span>
                        @if (_qtyLarge + _qtySmall > 0)
                        {
                            <span class="so-stat @(afterSmall < 0 ? "bad" : "good")"><span class="k">@Tr("SOBalanceAfter")</span><span class="v">@SmallToText(afterSmall, _picked.Factor, _picked.B_Unit, _picked.S_Unit)</span></span>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(_lineError))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3" role="alert">@_lineError</MudAlert>
                }
            </div>
        }

        <div class="inv-card so-section-gap">
            <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.ListAlt" />@Tr("SOLinesTitle")<span class="inv-count">@_lines.Count</span></h2>
            <MudTable Items="@_lines" T="LineRow" Hover="true" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh Style="width:56px">#</MudTh>
                    <MudTh>@Tr("SOItem")</MudTh>
                    <MudTh Style="text-align:end">@Tr("SOQtyLarge")</MudTh>
                    <MudTh Style="text-align:end">@Tr("SOQtySmall")</MudTh>
                    @if (_settings.IsManualPrice)
                    {
                        <MudTh Style="text-align:end">@Tr("SOUnitCost")</MudTh>
                        <MudTh Style="text-align:end">@Tr("SOLineValue")</MudTh>
                    }
                    @if (!ReadOnly)
                    {
                        <MudTh Style="text-align:end">@Tr("SOBalanceAfter")</MudTh>
                    }
                    <MudTh>@Tr("SOLineNotes")</MudTh>
                    <MudTh Style="width:56px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="#"><span class="so-idx">@(_lines.IndexOf(context) + 1)</span></MudTd>
                    <MudTd DataLabel="@Tr("SOItem")"><div class="so-item-name">@(string.IsNullOrWhiteSpace(context.Name) ? Tr("SODeletedItem", context.UnitItemId) : context.Name)</div><div class="so-item-code">@CodeText(context.Code)</div></MudTd>
                    <MudTd DataLabel="@Tr("SOQtyLarge")" Style="text-align:end"><span class="so-q">@Qty(context.QtyLarge)</span> <span class="so-u">@context.BUnit</span></MudTd>
                    <MudTd DataLabel="@Tr("SOQtySmall")" Style="text-align:end">
                        @if (context.QtySmall > 0)
                        {
                            <span class="so-q">@Qty(context.QtySmall)</span> <span class="so-u">@context.SUnit</span>
                        }
                        else
                        {
                            <span class="so-u">—</span>
                        }
                    </MudTd>
                    @if (_settings.IsManualPrice)
                    {
                        <MudTd DataLabel="@Tr("SOUnitCost")" Style="text-align:end"><span class="so-q">@(context.Cost is decimal c ? Money(c) : "")</span></MudTd>
                        <MudTd DataLabel="@Tr("SOLineValue")" Style="text-align:end"><b class="so-q">@Money(context.Value)</b></MudTd>
                    }
                    @if (!ReadOnly)
                    {
                        var after = context.BalanceSmall + Sign * (context.QtyLarge * context.Factor + context.QtySmall);
                        <MudTd DataLabel="@Tr("SOBalanceAfter")" Style="text-align:end"><span class="so-after @(after < 0 ? "bad" : "")">@SmallToText(after, context.Factor, context.BUnit, context.SUnit)</span></MudTd>
                    }
                    <MudTd DataLabel="@Tr("SOLineNotes")"><span class="so-u">@context.Notes</span></MudTd>
                    <MudTd>
                        @if (!ReadOnly)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Medium" Color="Color.Error" OnClick="@(() => _lines.Remove(context))" aria-label="@Tr("DeleteItemLabel")" />
                        }
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="so-empty">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" />
                        <div>@Tr("SONoLines")</div>
                    </div>
                </NoRecordsContent>
            </MudTable>

            @* مركز تكلفة الإذن (ق9): يُرحَّل على أسطر قيد الإذن (حساب المقابل: مصروف/تكلفة) عند الترحيل لفرع الجرد المستمر *@
            @if (_ccAny)
            {
                <div class="so-notes" style="max-width:420px">
                    <CostCenterField AllLeaves="true" Label="@Tr("InvCostCenter")" Disabled="@ReadOnly" CenterId="_costCenterId"
                                     CenterIdChanged="@(id => { _costCenterId = id; return Task.CompletedTask; })" />
                </div>
            }
            else
            {
                <div style="display:none"><CostCenterField AllLeaves="true" Label="" Disabled="true" CenterId="_costCenterId"
                                 AllowedChanged="@(a => { _ccAny = a.Centers.Count > 0; return Task.CompletedTask; })" /></div>
            }

            @* ملاحظات الإذن أسفل جدول الأصناف (طلب المستخدم) *@
            <div class="so-notes">
                <MudTextField T="string" @bind-Value="_notes" Label="@Tr("SONotes")" Variant="Variant.Outlined" Disabled="@ReadOnly"
                              Lines="2" AutoGrow="true" MaxLines="6" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Notes" />
            </div>
        </div>

        @if (CanReceive)
        {
            <div class="inv-card so-section-gap">
                <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.MoveToInbox" />@Tr("SOTransferReceiveTitle")</h2>
                <MudTable Items="@_transferLines" T="TransferLineView" Elevation="0" Class="inv-table" Breakpoint="Breakpoint.Sm" Dense="true">
                    <HeaderContent>
                        <MudTh>@Tr("SOItem")</MudTh>
                        <MudTh Style="text-align:end">@Tr("SOShipped")</MudTh>
                        <MudTh Style="text-align:end">@Tr("SOReceived")</MudTh>
                        <MudTh Style="text-align:end">@Tr("SORemaining")</MudTh>
                        <MudTh>@Tr("SOReceiveNow")</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@Tr("SOItem")"><div class="so-item-name">@(string.IsNullOrWhiteSpace(context.Item_Name) ? "—" : context.Item_Name)</div><div class="so-item-code">@CodeText(context.Code)</div></MudTd>
                        <MudTd DataLabel="@Tr("SOShipped")" Style="text-align:end"><span class="so-q">@SmallToText(context.Shipped_Small, context.Factor, context.B_Unit, context.S_Unit)</span></MudTd>
                        <MudTd DataLabel="@Tr("SOReceived")" Style="text-align:end"><span class="so-q">@SmallToText(context.Received_Small, context.Factor, context.B_Unit, context.S_Unit)</span></MudTd>
                        <MudTd DataLabel="@Tr("SORemaining")" Style="text-align:end"><b class="so-q">@SmallToText(context.Remaining_Small, context.Factor, context.B_Unit, context.S_Unit)</b></MudTd>
                        <MudTd DataLabel="@Tr("SOReceiveNow")">
                            @if (context.Remaining_Small > 0)
                            {
                                <div class="so-recv">
                                    <MudNumericField T="decimal" Value="@RecvLarge(context.Detail_Id)" ValueChanged="@(v => SetRecv(context.Detail_Id, v, null))" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                     HideSpinButtons="true" Min="0" Adornment="Adornment.End" AdornmentText="@context.B_Unit" aria-label="@Tr("SOQtyLarge")" />
                                    @if (context.Factor > 1)
                                    {
                                        <MudNumericField T="decimal" Value="@RecvSmall(context.Detail_Id)" ValueChanged="@(v => SetRecv(context.Detail_Id, null, v))" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                         HideSpinButtons="true" Min="0" Adornment="Adornment.End" AdornmentText="@context.S_Unit" aria-label="@Tr("SOQtySmall")" />
                                    }
                                </div>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Check">@Tr("SOTransferDone")</MudChip>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
                <div class="so-recv-actions">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MoveToInbox" Disabled="@(_isBusy || !_recv.Values.Any(v => v.L + v.S > 0))" OnClick="ReceiveAsync">@Tr("SOReceiveButton")</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ReportProblem" Disabled="_isBusy" OnClick="@(() => _showClose = !_showClose)">@Tr("SOCloseShortage")</MudButton>
                </div>
                @if (_showClose)
                {
                    <div class="so-close">
                        <MudTextField T="string" @bind-Value="_closeReason" Label="@Tr("SOCloseReason")" Variant="Variant.Outlined" Lines="2" />
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="_isBusy" OnClick="CloseShortageAsync">@Tr("SOCloseShortageConfirm")</MudButton>
                    </div>
                }
            </div>
        }

        @if (_showReverse)
        {
            <div class="inv-card so-section-gap">
                <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.Undo" />@(_reverseAndCopy ? Tr("SOReverseAndCopy") : Tr("SOReverse"))</h2>
                <MudTextField T="string" @bind-Value="_reverseReason" Label="@Tr("SOReverseReason")" Variant="Variant.Outlined" Lines="2" />
                <div class="mt-3" style="display:flex; gap:8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Undo" Disabled="_isBusy" OnClick="ReverseAsync">@Tr("SOReverseConfirm")</MudButton>
                    <MudButton Variant="Variant.Outlined" Disabled="_isBusy" OnClick="@(() => _showReverse = false)">@Tr("Cancel")</MudButton>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="so-section-gap" role="alert">@_errorMessage</MudAlert>
    }

    <div class="inv-dock so-section-gap @(_settings is null ? "d-none" : "")" role="region">
        <div class="inv-dock-cells">
            <div class="cell"><span class="lbl">@Tr("SOLinesCount")</span><b>@_lines.Count</b></div>
            @if (_settings?.IsManualPrice == true)
            {
                <div class="cell net"><span class="lbl">@Tr("SOTotalValue")</span><b>@Money(_lines.Sum(l => l.Value))</b></div>
            }
        </div>
        <div class="inv-dock-actions">
            @if (_orderId > 0 && _settings is not null)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Print" Disabled="_isBusy" OnClick="PrintAsync">@Tr("PrintButton")</MudButton>
            }
            @if (_status == (int)StockMovementService.DocStatus.Draft && _orderId > 0)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block" Disabled="_isBusy" OnClick="CancelDraftAsync">@Tr("SOCancelDraft")</MudButton>
            }
            @* العكس للأذون المرحَّلة بالمحرك فقط؛ الإذن القديم (قبل المحرك) يُعرض للقراءة *@
            @* الشحنة التى استُلم منها أو أُغلقت لا تُعكس من هنا (تُعكس أذون الاستلام أولاً) *@
            @if (_status == (int)StockMovementService.DocStatus.Posted && _header?.Reversal_Of_Id == null && _header?.Engine_Posted == true
                 && _header.Transfer_Status is null or 1)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Undo" Disabled="_isBusy" OnClick="@(() => OpenReverse(false))">@Tr("SOReverse")</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ContentCopy" Disabled="_isBusy" OnClick="@(() => OpenReverse(true))">@Tr("SOReverseAndCopy")</MudButton>
            }
            @if (!ReadOnly)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Disabled="@(!CanSave)" OnClick="SaveDraftAsync">@Tr("SOSaveDraft")</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" Disabled="@(!CanSave)" OnClick="PostAsync">@Tr("SOPost")</MudButton>
            }
        </div>
    </div>
</div>

@* مستند الإذن للطباعة (طباعة المتصفح، و«حفظ كـ PDF» من مربعها) — مخفى على الشاشة، وكل ما عداه مخفى وقت الطباعة *@
@if (_settings is not null && _orderId > 0)
{
    <div class="so-print print-area" dir="@(LangService.IsRtl ? "rtl" : "ltr")">
        @if (_status == 0)
        {
            <div class="pw" aria-hidden="true">@Tr("SOStatusDraft")</div>
        }
        <header class="ph">
            <div>
                <div class="co">@AccountModelsLib.Common.CompanyTitle</div>
                <div class="dt">@Title</div>
            </div>
            <table class="pm">
                <tr><th>@Tr("SOOrderNo")</th><td>@_orderNo</td></tr>
                <tr><th>@Tr("SOOrderDate")</th><td>@((_date ?? DateTime.Today).ToString("yyyy/MM/dd", CultureInfo.InvariantCulture))</td></tr>
                <tr><th>@Tr("SOStatusLabel")</th><td>@StatusText</td></tr>
            </table>
        </header>
        <div class="pp">
            <div><span>@Tr("SOFrom")</span><b>@PrintParty(true)</b></div>
            <div><span>@Tr("SOTo")</span><b>@PrintParty(false)</b></div>
        </div>
        <table class="pl">
            <thead>
                <tr>
                    <th>#</th><th>@Tr("SOItem")</th><th>@Tr("SOQtyLarge")</th><th>@Tr("SOQtySmall")</th>
                    @if (_settings.IsManualPrice)
                    {
                        <th>@Tr("SOUnitCost")</th><th>@Tr("SOLineValue")</th>
                    }
                    <th>@Tr("SOLineNotes")</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < _lines.Count; i++)
                {
                    var l = _lines[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@(string.IsNullOrWhiteSpace(l.Name) ? Tr("SODeletedItem", l.UnitItemId) : l.Name) <small>@CodeText(l.Code)</small></td>
                        <td>@Qty(l.QtyLarge) @l.BUnit</td>
                        <td>@(l.QtySmall > 0 ? $"{Qty(l.QtySmall)} {l.SUnit}" : "")</td>
                        @if (_settings.IsManualPrice)
                        {
                            <td>@(l.Cost is decimal c ? Money(c) : "")</td><td>@Money(l.Value)</td>
                        }
                        <td>@l.Notes</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="2">@Tr("SOLinesCount"): @_lines.Count</td>
                    <td>@Qty(_lines.Sum(x => x.QtyLarge))</td><td>@Qty(_lines.Sum(x => x.QtySmall))</td>
                    @if (_settings.IsManualPrice)
                    {
                        <td></td><td>@Money(_lines.Sum(x => x.Value))</td>
                    }
                    <td></td>
                </tr>
            </tfoot>
        </table>
        @if (!string.IsNullOrWhiteSpace(_notes))
        {
            <div class="pn"><span>@Tr("SONotes"):</span> @_notes</div>
        }
        <div class="ps">
            <div>@Tr("SOSignStorekeeper")</div><div>@Tr("SOSignReceiver")</div><div>@Tr("SOSignApprover")</div>
        </div>
        <footer class="pf">@Tr("SOPrintedAt", DateTime.Now.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture), AccountModelsLib.Common.User_Name)</footer>
    </div>
}
</MudContainer>

@code {
    /// <summary>BalanceSmall: رصيد السطر الحالى بالوحدة الصغرى (لمعاينة «الرصيد بعد» قبل الترحيل).</summary>
    private record LineRow(long UnitItemId, string Name, string Code, string BUnit, string SUnit, decimal Factor, decimal QtyLarge, decimal QtySmall, decimal? Cost, string Notes, decimal BalanceSmall)
    {
        public decimal Value => (Cost ?? 0) * (QtyLarge + QtySmall / (Factor <= 0 ? 1 : Factor));
    }

    [Parameter] public int OrderType { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public long? IdQuery { get; set; }
    /// <summary>نوع جهة «من»/«إلى» المبدئى من القائمة (مثلاً «إذن صرف لقسم» = 1001 مع to=20).</summary>
    [SupplyParameterFromQuery(Name = "from")] public int? FromQuery { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public int? ToQuery { get; set; }

    private readonly StoreOrderPageService _svc = new();
    private OrderTypeSettings? _settings;
    private OrderHeaderView? _header;
    private List<LineRow> _lines = new();
    private List<PartyOption> _fromList = new(), _toList = new();
    private int _typeFrom, _typeTo, _status = -1;
    private long _idFrom, _idTo, _orderId, _orderNo;
    private DateTime? _date = DateTime.Today;
    private long _costCenterId;
    private bool _ccAny;
    private string? _notes, _lineNotes, _lineError, _errorMessage, _reverseReason;
    private bool _isBusy, _onlyWithBalance = true, _showReverse, _reverseAndCopy;

    // التحويل
    private TransferUi? _transferUi;
    private bool _directRequested, _showClose;
    private string? _closeReason;
    private List<TransferLineView> _transferLines = new();
    private readonly Dictionary<long, (decimal L, decimal S)> _recv = new();

    // سطر جديد
    private StockLineOption? _picked;
    private decimal _qtyLarge, _qtySmall;
    private decimal? _unitCost;
    private int _pickerKey;

    /// <summary>القراءة فقط لكل حالة غير «جديد/مسودة»، ولأنواع التحويل (المرحلة 3).</summary>
    private bool ReadOnly => _settings is null || IsReceiptType || (_status != -1 && _status != (int)StockMovementService.DocStatus.Draft);
    /// <summary>1016/1017: إذن الاستلام يُنشأ من «استلام التحويل» على الشحنة، فلا يُصدر يدوياً.</summary>
    private bool IsReceiptType => OrderType is 1016 or 1017;
    private bool DirectTransfer => _transferUi is not null && (_transferUi.Mode == StoreTransferPolicy.Mode.Direct || (_transferUi.ShowDirectChoice && _directRequested));
    private bool CanReceive => _status == 1 && _header?.Transfer_Status is 1 or 2 && _header.Reversed_By_Id == null && _transferLines.Count > 0;
    private int StoreType => _settings?.StoreIsFrom == true ? _typeFrom : _typeTo;
    private long StoreId => _settings?.StoreIsFrom == true ? _idFrom : _idTo;
    private bool CanSave => !_isBusy && !ReadOnly && _lines.Count > 0 && StoreId > 0
                            && (!PartyHasList(_typeFrom) || _idFrom > 0) && (!PartyHasList(_typeTo) || _idTo > 0);
    private string Title => string.IsNullOrWhiteSpace(_settings?.Name_Ar) ? Tr("SOTitleFallback") : _settings!.Name_Ar;

    // اتجاه الإذن للرأس: وارد (1) / منصرف (2) / تحويل (3)
    private string DirClass => _settings?.Direction switch { 1 => "in", 3 => "tr", _ => "out" };
    private string DirIcon => _settings?.Direction switch { 1 => Icons.Material.Filled.MoveToInbox, 3 => Icons.Material.Filled.SyncAlt, _ => Icons.Material.Filled.Outbox };
    private string DirText => _settings?.Direction switch { 1 => Tr("SODirIn"), 3 => Tr("SODirTransfer"), _ => Tr("SODirOut") };

    /// <summary>لوحة جهة «من» أو «إلى»: نوع الجهة ثم الجهة نفسها (أو نص ثابت للجهات بلا قائمة). لوحة جهة المخزون مميَّزة.</summary>
    private RenderFragment PartyPanel(bool isFrom) => __builder =>
    {
        var s = _settings!;
        int[] types = isFrom ? s.FromParties : s.ToParties;
        int type = isFrom ? _typeFrom : _typeTo;
        long id = isFrom ? _idFrom : _idTo;
        var list = isFrom ? _fromList : _toList;
        bool isStockSide = isFrom == s.StoreIsFrom;
        bool locked = ReadOnly || (isStockSide && _lines.Count > 0);
        <section class="so-party @(isStockSide ? "stock" : "")" aria-label="@(isFrom ? Tr("SOFrom") : Tr("SOTo"))">
            <div class="so-party-head">
                <span class="name"><MudIcon Icon="@(isFrom ? Icons.Material.Filled.Logout : Icons.Material.Filled.Login)" Size="Size.Small" />@(isFrom ? Tr("SOFrom") : Tr("SOTo"))</span>
                @if (isStockSide)
                {
                    <span class="so-tag">@Tr("SOStockSide")</span>
                }
            </div>
            <MudSelect T="int" Value="type" ValueChanged="@(v => isFrom ? OnTypeFromChangedAsync(v) : OnTypeToChangedAsync(v))"
                       Label="@Tr("SOPartyType")" Variant="Variant.Outlined" Disabled="@(locked || types.Length < 2)">
                @foreach (var p in types)
                {
                    <MudSelectItem T="int" Value="@p">@PartyName(p)</MudSelectItem>
                }
            </MudSelect>
            @if (PartyHasList(type))
            {
                <MudSelect T="long" Value="id" ValueChanged="@(v => isFrom ? OnIdFromChangedAsync(v) : OnIdToChangedAsync(v))"
                           Label="@PartyName(type)" Variant="Variant.Outlined" Disabled="@locked" Required="true">
                    @foreach (var o in list)
                    {
                        <MudSelectItem T="long" Value="@o.Id">@o.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <div class="so-fixed"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" />@Tr("SONoPartyList", PartyName(type))</div>
            }
        </section>
    };

    /// <summary>حالة الشحنة تغلب «مرحَّل» فى الرأس: فى الطريق / استُلم جزئياً / مكتمل / مغلق بعجز.</summary>
    private int? ShipState => _status == 1 ? _header?.Transfer_Status : null;
    private string StatusText => ShipState switch
    {
        1 => Tr("SOTransferInTransit"), 2 => Tr("SOTransferPartial"),
        3 => string.IsNullOrEmpty(_header?.Transfer_Close_Reason) ? Tr("SOTransferDone") : Tr("SOTransferClosedShort"),
        _ => _status switch { 0 => Tr("SOStatusDraft"), 1 => Tr("SOStatusPosted"), 2 => Tr("SOStatusReversed"), 3 => Tr("SOStatusCancelled"), _ => Tr("SOStatusNew") }
    };
    private Color StatusColor => ShipState switch
    {
        1 or 2 => Color.Info, 3 => string.IsNullOrEmpty(_header?.Transfer_Close_Reason) ? Color.Success : Color.Warning,
        _ => _status switch { 1 => Color.Success, 0 => Color.Warning, 2 => Color.Error, 3 => Color.Dark, _ => Color.Info }
    };
    private string StatusIcon => ShipState switch
    {
        1 or 2 => Icons.Material.Filled.LocalShipping, 3 => string.IsNullOrEmpty(_header?.Transfer_Close_Reason) ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.ReportProblem,
        _ => _status switch
        {
            1 => Icons.Material.Filled.CheckCircle, 0 => Icons.Material.Filled.EditNote, 2 => Icons.Material.Filled.Undo,
            3 => Icons.Material.Filled.Block, _ => Icons.Material.Filled.FiberNew
        }
    };

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        try
        {
            var type = OrderType;
            _settings = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetSettings(type); });
            _onlyWithBalance = _settings.Direction != 1;   // الوارد يضيف لأصناف قد يكون رصيدها صفراً
            if (_settings.Is_Transfer && !IsReceiptType)
                _transferUi = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetTransferUi(); });
            if (IdQuery is > 0) await LoadOrderAsync(IdQuery.Value);
            else await ResetPartiesAsync();
        }
        catch (Exception ex) { _errorMessage = ErrText(ex); }
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private string PartyName(int p) => Tr("SOParty_" + p);

    private static string BalanceText(decimal large, decimal small, string bUnit, string sUnit) =>
        small != 0 ? $"{Qty(large)} {bUnit} + {Qty(small)} {sUnit}" : $"{Qty(large)} {bUnit}";

    // الأرقام بصيغة ثابتة (نقطة عشرية) مهما كانت ثقافة الخيط، كباقى أرقام الصفحة.
    private static string Money(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);
    private static string Qty(decimal v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    private static string CodeText(string code) => string.IsNullOrWhiteSpace(code) || code.Trim() == "0" ? "" : code;

    /// <summary>كمية بالوحدة الصغرى ← نص بالوحدتين (السالب بعلامة).</summary>
    private static string SmallToText(decimal small, decimal factor, string bUnit, string sUnit)
    {
        if (factor <= 0) factor = 1;
        decimal abs = Math.Abs(small);
        decimal large = Math.Floor(abs / factor);
        string t = BalanceText(large, abs - large * factor, bUnit, sUnit);
        return small < 0 ? "-" + t : t;
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("window.print");

    /// <summary>اسم الجهة للطباعة: الاسم من قائمتها، أو اسم نوعها للجهات بلا قائمة.</summary>
    private string PrintParty(bool isFrom)
    {
        int type = isFrom ? _typeFrom : _typeTo;
        long id = isFrom ? _idFrom : _idTo;
        var list = isFrom ? _fromList : _toList;
        string name = PartyHasList(type) ? list.FirstOrDefault(o => o.Id == id)?.Name ?? "" : "";
        return string.IsNullOrWhiteSpace(name) ? PartyName(type) : $"{PartyName(type)}: {name}";
    }

    /// <summary>اتجاه أثر الإذن على جهة المخزون: +1 وارد، −1 منصرف.</summary>
    private int Sign => _settings?.Direction == 1 ? 1 : -1;
    private decimal PickedBalanceSmall => _picked == null ? 0 : _picked.Full_qua * _picked.Factor + _picked.D_Qua;

    // ============================== الجهات ==============================

    private async Task ResetPartiesAsync()
    {
        if (_settings is null) return;
        _typeFrom = FromQuery is int fq && _settings.FromParties.Contains(fq) ? fq
            : _settings.FromParties.Contains(_settings.Default_From_Party) ? _settings.Default_From_Party : _settings.FromParties.FirstOrDefault();
        _typeTo = ToQuery is int tq && _settings.ToParties.Contains(tq) ? tq
            : _settings.ToParties.Contains(_settings.Default_To_Party) ? _settings.Default_To_Party : _settings.ToParties.FirstOrDefault();
        _fromList = await LoadPartiesAsync(_typeFrom, _settings.Is_Virtual_Outer_From);
        _toList = await LoadPartiesAsync(_typeTo, _settings.Is_Virtual_Outer_To);
        _idFrom = _fromList.FirstOrDefault()?.Id ?? 0;
        // التحويل لا يكون لنفس المخزن: المستلم الافتراضى أول مخزن مختلف عن المرسل.
        _idTo = (_settings.Is_Transfer && _typeFrom == _typeTo ? _toList.FirstOrDefault(o => o.Id != _idFrom) : null)?.Id ?? _toList.FirstOrDefault()?.Id ?? 0;
    }

    private Task<List<PartyOption>> LoadPartiesAsync(int type, bool outer) =>
        PartyHasList(type) ? Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetParties(type, outer); }) : Task.FromResult(new List<PartyOption>());

    private async Task OnTypeFromChangedAsync(int t)
    {
        _typeFrom = t;
        _fromList = await LoadPartiesAsync(t, _settings!.Is_Virtual_Outer_From);
        _idFrom = _fromList.FirstOrDefault()?.Id ?? 0;
        ClearPicker();
    }

    private async Task OnTypeToChangedAsync(int t)
    {
        _typeTo = t;
        _toList = await LoadPartiesAsync(t, _settings!.Is_Virtual_Outer_To);
        _idTo = _toList.FirstOrDefault()?.Id ?? 0;
        ClearPicker();
    }

    private Task OnIdFromChangedAsync(long id) { _idFrom = id; ClearPicker(); return Task.CompletedTask; }
    private Task OnIdToChangedAsync(long id) { _idTo = id; ClearPicker(); return Task.CompletedTask; }

    // ============================== الأصناف ==============================

    private async Task<IEnumerable<StockLineOption>> SearchAsync(string text, CancellationToken ct)
    {
        int st = StoreType; long sid = StoreId; bool only = _onlyWithBalance;
        if (sid <= 0) return Enumerable.Empty<StockLineOption>();
        return await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.SearchLines(st, sid, text, only); }, ct);
    }

    private void OnPicked(StockLineOption? o)
    {
        _picked = o; _lineError = null;
        _unitCost = _settings?.IsManualPrice == true && o != null && o.Avg_Cost_Large > 0 ? o.Avg_Cost_Large : null;
    }

    private void ClearPicker() { _picked = null; _qtyLarge = 0; _qtySmall = 0; _unitCost = null; _lineNotes = null; _pickerKey++; }

    private void AddLine()
    {
        _lineError = null;
        if (StoreId <= 0) { _lineError = Tr("SOSelectStore"); return; }
        if (_picked is null) { _lineError = Tr("SOSelectItem"); return; }
        if (_qtyLarge < 0 || _qtySmall < 0 || _qtyLarge + _qtySmall <= 0) { _lineError = Tr("SOQtyRequired"); return; }
        if (_settings!.IsManualPrice && (_unitCost is null || _unitCost < 0)) { _lineError = Tr("SOCostRequired"); return; }
        if (_lines.Any(l => l.UnitItemId == _picked.Id)) { _lineError = Tr("SOItemAlreadyAdded"); return; }
        _lines.Add(new LineRow(_picked.Id, _picked.Item_Name, _picked.Code, _picked.B_Unit, _picked.S_Unit, _picked.Factor, _qtyLarge, _qtySmall,
            _settings.IsManualPrice ? _unitCost : null, _lineNotes ?? "", PickedBalanceSmall));
        ClearPicker();
    }

    // ============================== الحفظ والترحيل ==============================

    private OrderInput BuildInput() => new OrderInput(OrderType, (_date ?? DateTime.Today).Date, _typeFrom, PartyHasList(_typeFrom) ? _idFrom : 0,
        _typeTo, PartyHasList(_typeTo) ? _idTo : 0,
        _lines.Select(l => new OrderLineInput(l.UnitItemId, l.QtyLarge, l.QtySmall, 0, l.Cost, l.Notes)).ToList(), _notes, 0, _costCenterId);

    private async Task SaveDraftAsync()
    {
        _errorMessage = null; _isBusy = true;
        var input = BuildInput(); var draftId = _orderId;
        try
        {
            var id = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.SaveDraft(input, draftId); });
            await LoadOrderAsync(id);
            Snackbar.Add(Tr("SODraftSaved", _orderNo), Severity.Success);
            Nav.NavigateTo($"/store/order/{OrderType}?id={id}", replace: true);
