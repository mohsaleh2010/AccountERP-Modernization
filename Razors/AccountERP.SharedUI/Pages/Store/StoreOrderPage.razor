    private void OpenReverse(bool andCopy) { _reverseAndCopy = andCopy; _reverseReason = null; _showReverse = true; _errorMessage = null; }

    private async Task ReverseAsync()
    {
        if (string.IsNullOrWhiteSpace(_reverseReason)) { _errorMessage = Tr("SOReasonRequired"); return; }
        _isBusy = true; _errorMessage = null;
        var id = _orderId; var reason = _reverseReason.Trim(); var copy = _reverseAndCopy;
        try
        {
            var newId = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return copy ? _svc.ReverseAndCopy(id, reason) : _svc.Reverse(id, reason); });
            _showReverse = false;
            if (copy)
            {
                Snackbar.Add(Tr("SOCopyCreated"), Severity.Success);
                await LoadOrderAsync(newId);
                Nav.NavigateTo($"/store/order/{OrderType}?id={newId}", replace: true);
            }
            else
            {
                await LoadOrderAsync(id);
                Snackbar.Add(Tr("SOReversed", _header?.Reversed_By_No ?? 0), Severity.Success);
            }
        }
        catch (Exception ex) { _errorMessage = ErrText(ex); }
        finally { _isBusy = false; }
    }

    // ============================== القراءة ==============================

    private async Task LoadOrderAsync(long id)
    {
        var (h, lines) = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetOrder(id); });
        if (h is null || h.Order_Type != OrderType) { _errorMessage = Tr("SOOrderNotFound"); return; }
        _header = h;
        _orderId = h.Id; _orderNo = h.Order_No; _status = h.Doc_Status;
        _date = h.Order_Date.Date; _notes = h.Notes;
        _costCenterId = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.GetHeaderCenter(new AccountModelsLib.operations(), AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.Table_StoreOrder, id); });
        _typeFrom = h.Type_From; _typeTo = h.Type_To; _idFrom = h.Id_From; _idTo = h.Id_To;
        _fromList = await LoadPartiesAsync(_typeFrom, _settings!.Is_Virtual_Outer_From);
        _toList = await LoadPartiesAsync(_typeTo, _settings.Is_Virtual_Outer_To);
        _lines = lines.Select(l => new LineRow(l.Unit_Item_Id, l.Item_Name, l.Code, l.B_Unit, l.S_Unit, l.Factor, l.Qty_Large, l.Qty_Small,
            _settings.IsManualPrice ? l.Unit_Cost_Large : null, l.Notes ?? "", l.Balance_Small)).ToList();
        ClearPicker();
        await LoadTransferLinesAsync();
    }

    // ============================== استلام التحويل ==============================

    /// <summary>أسطر الشحنة بانتظار الاستلام، وكمية الاستلام الافتراضية = الباقى (مقسَّماً على الوحدتين).</summary>
    private async Task LoadTransferLinesAsync()
    {
        _transferLines = new(); _recv.Clear(); _showClose = false; _closeReason = null;
        if (_status != 1 || _header?.Transfer_Status is not (1 or 2)) return;
        var id = _orderId;
        _transferLines = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.GetTransferLines(id); });
        foreach (var l in _transferLines.Where(l => l.Remaining_Small > 0))
        {
            decimal f = l.Factor <= 0 ? 1 : l.Factor, large = Math.Floor(l.Remaining_Small / f);
            _recv[l.Detail_Id] = (large, l.Remaining_Small - large * f);
        }
    }

    private decimal RecvLarge(long detailId) => _recv.TryGetValue(detailId, out var v) ? v.L : 0;
    private decimal RecvSmall(long detailId) => _recv.TryGetValue(detailId, out var v) ? v.S : 0;
    private void SetRecv(long detailId, decimal? large, decimal? small)
    {
        var cur = _recv.TryGetValue(detailId, out var v) ? v : (0m, 0m);
        _recv[detailId] = (Math.Max(0, large ?? cur.Item1), Math.Max(0, small ?? cur.Item2));
    }

    private async Task ReceiveAsync()
    {
        _errorMessage = null;
        var lines = _recv.Where(r => r.Value.L + r.Value.S > 0).Select(r => new ReceiptLineInput(r.Key, r.Value.L, r.Value.S)).ToList();
        if (lines.Count == 0) return;
        var ok = await DialogService.ShowMessageBoxAsync(Tr("SOReceiveButton"), Tr("SOReceiveConfirm"), yesText: Tr("SOReceiveButton"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _isBusy = true;
        var id = _orderId;
        try
        {
            var receiptId = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _svc.ReceiveTransfer(id, DateTime.Today, lines, null); });
            await LoadOrderAsync(id);
            Snackbar.Add(Tr("SOReceivedMsg"), Severity.Success);
        }
        catch (Exception ex) { _errorMessage = ErrText(ex); }
        finally { _isBusy = false; }
    }

    private async Task CloseShortageAsync()
    {
        if (string.IsNullOrWhiteSpace(_closeReason)) { _errorMessage = Tr("SOCloseReasonRequired"); return; }
        _isBusy = true; _errorMessage = null;
        var id = _orderId; var reason = _closeReason.Trim();
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); _svc.CloseTransferShortage(id, reason); });
            await LoadOrderAsync(id);
            Snackbar.Add(Tr("SOTransferClosedShort"), Severity.Success);
        }
        catch (Exception ex) { _errorMessage = ErrText(ex); }
        finally { _isBusy = false; }
    }

    private async Task NewOrderAsync()
    {
        _header = null; _orderId = 0; _orderNo = 0; _status = -1; _lines = new(); _notes = null; _costCenterId = 0; _errorMessage = null; _showReverse = false;
        _date = DateTime.Today;
        ClearPicker();
        await ResetPartiesAsync();
