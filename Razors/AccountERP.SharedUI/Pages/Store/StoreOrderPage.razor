    // رسائل الخدمة عربية أصلاً (InvalidOperationException/NotSupportedException)؛ غيرها خطأ نظام برسالة أعمق استثناء (سبب خطأ قاعدة البيانات).
    private string ErrText(Exception ex)
    {
        if (ex is InvalidOperationException or NotSupportedException) return ex.Message;
        var inner = ex;
        while (inner.InnerException != null) inner = inner.InnerException;
        return Tr("SystemError", inner.Message);
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
