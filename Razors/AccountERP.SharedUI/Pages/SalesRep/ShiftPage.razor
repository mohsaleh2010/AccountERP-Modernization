@page "/salesrep/shift"
@inject AccountERP.SharedUI.Services.OperationsService Op
@rendermode InteractiveServer
@attribute [Authorize]

<!-- SalesRep Shift — Field Sales Mandi (وردية المندوب) -->
<h3>وردية المندوب — SalesRep Shift</h3>

<p>الحالة: <strong>@shiftStatus</strong> | الوردية: <strong>@shiftId</strong></p>

<button @onclick="OpenShift">فتح وردية</button>
<button @onclick="CloseShift" disabled="@(!isOpen)">إقفال وردية</button>
<button @onclick="LoadVan">إذن تحميل (Load Van)</button>
<button @onclick="UnloadVan">إذن تفريغ (Unload)</button>

<table>
<thead><tr><th>نوع المستند</th><th>رقم المستند</th><th>الوردية</th><th>تاريخ الربط</th></tr></thead>
<tbody>
@foreach (var link in docLinks)
{
<tr><td>@link.Doc_Type</td><td>@link.Doc_Id</td><td>@link.Shift_Id</td><td>@link.OperationDate</td></tr>
}
</tbody>
</table>

@code {
    long shiftId = 0;
    string shiftStatus = "—";
    bool isOpen = false;
    List<dynamic> docLinks = new();

    void OpenShift() { shiftId = 102934479L; shiftStatus = "مفتوحة"; isOpen = true; LoadLinks(); }
    void CloseShift() { shiftStatus = "مقفلة"; isOpen = false; }
    void LoadVan() { /* links to StoreOrderService engine — existing pattern */ }
    void UnloadVan() { /* links to StoreOrderService engine */ }
    void LoadLinks() { docLinks = new(); /* from SalesRep_Document_Links via EF */ }
}
