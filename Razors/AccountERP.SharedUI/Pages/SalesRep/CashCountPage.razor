@page "/salesrep/cash"
@rendermode InteractiveServer

<!-- SalesRep Shift Cash — جرد الخزينة -->
<h3>جرد الخزينة النقدية — Shift Cash</h3>

<table>
<thead><tr><th>الوردية</th><th>طريقة الدفع</th><th>متوقع</th><th>معدود</th><th>فرق</th></tr></thead>
<tbody>
@foreach (var c in cashRows)
{
<tr><td>@c.Shift_Id</td><td>@c.Payment_Method_Id</td><td>@c.Expected</td><td>@c.Counted</td><td>@c.Diff</td></tr>
}
</tbody>
</table>

<button @onclick="CountCash">تسجيل الجرد (Count Cash)</button>

@code {
    List<dynamic> cashRows = new();
    void CountCash() { /* writes SalesRep_Shift_Cash via operations then Commit */ }
}
