@page "/salesrep/visits"
@rendermode InteractiveServer
@attribute [Authorize]

<!-- SalesRep Visits Plan — خطة الزيارات -->
<h3>خطة الزيارات الميدانية — SalesRep Visits</h3>

<table>
<thead><tr><th>العميل</th><th>اليوم</th><th>مخطط</th><th>النتيجة</th></tr></thead>
<tbody>
@foreach (var v in visits)
{
<tr><td>@v.Customer_Id</td><td>@v.DayOfWeek</td><td>@v.Planned</td><td>@v.Result</td></tr>
}
</tbody>
</table>

<button @onclick="PlanVisit">جدولة زيارة</button>

@code {
    List<dynamic> visits = new();
    void PlanVisit() { /* SalesRep_Visits via Service + Route + Customer */ }
}
