    // ===== المتاح والمحجوز (للعرض فقط): المتاح = الرصيد − المحجوز من الطلبيات المؤكدة الأخرى =====
    private sealed record AvailRow(decimal BalL, decimal BalS, decimal ResL, decimal ResS)
    {
        public decimal AvailL => BalL - ResL;
        public decimal AvailS => BalS - ResS;
    }
    private Dictionary<long, AvailRow> _avail = new();

    private async Task RefreshAvailabilityAsync()
    {
        var ids = _lines.Select(l => l.Unit_Item_Table_Id ?? 0).Where(i => i > 0).Distinct().ToList();
        var exclude = _orderId;
        try
        {
            var dt = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _service.GetAvailability(ids, exclude); });
            _avail = dt.Rows.Cast<DataRow>().ToDictionary(
                r => Convert.ToInt64(r["Unit_Item_Id"]),
                r => new AvailRow(Convert.ToDecimal(r["Bal_Larg"]), Convert.ToDecimal(r["Bal_Small"]), Convert.ToDecimal(r["Res_Larg"]), Convert.ToDecimal(r["Res_Small"])));
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
    }

    private static string AvailText(decimal larg, decimal small, IInvoices_Details line)
    {
        var l = $"{larg:0.##} {line.UnitStr}";
        return small != 0 ? $"{l} + {small:0.##} {line.UnitSmallStr}" : l;
    }

    private decimal NetTotal => _lines.Sum(l => l.Item_Net_Total_Price ?? 0);
    private bool CanSave => !_isSaving && !_locked && _customer is not null && _lines.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return new CurrencyFactorsCLS_().GetCurrencyList();
        });
        _currencies = dt.Rows.Cast<DataRow>()
            .Select(r => new LookupOption(Convert.ToInt64(r["ID"]), r["Currency_Name"]?.ToString() ?? "")).ToList();
        if (_currencies.Count > 0) _currencyId = _currencies[0].Id;
        await InitRepModeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var wanted = Id ?? 0;
        if (wanted == _loadedId) return;
        _loadedId = wanted;
        if (wanted > 0) await LoadOrderAsync(wanted);
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);
    public void Dispose() => LangService.OnLanguageChanged -= OnLanguageChangedHandler;

    private async Task<IEnumerable<LookupOption>> SearchCustomersAsync(string search, CancellationToken ct)
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return _customerCls.Get_CustomerSupplierListForStatement(0, 0, -1, -1);
        }, ct);
        var list = new List<LookupOption>();
        foreach (DataRow r in dt.Rows)
        {
            var name = r["Name"]?.ToString()?.Trim() ?? "";
            if (string.IsNullOrEmpty(search) || name.Contains(search, StringComparison.OrdinalIgnoreCase))
                list.Add(new LookupOption(Convert.ToInt64(r["Id"]), name));
        }
        return list.Take(50);
    }

    private async Task LoadOrderAsync(long id)
    {
        _errorMessage = null;
        try
        {
            var loaded = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                // يلتقط حذف/تعديل الفواتير المرتبطة (من أى شاشة) قبل العرض فتعود الكميات للمتبقى.
                _service.SyncOrder(id);
                var got = _service.GetOrder(id);
                if (got is null) return ((CustomerOrder, List<CustomerOrderLine>)?)null;
                return got;
            });
            if (loaded is null) { _errorMessage = Tr("COOrderNotFound"); return; }
            var (order, lines) = loaded.Value;
            var hasFulfillments = await Task.Run(() => _service.HasFulfillments(id));

            _orderId = order.Id;
            _orderNo = order.Order_No ?? 0;
            _status = (CustomerOrderStatus)(order.Status ?? 0);
            _orderDate = order.Order_Date;
            _expectedDate = order.Expected_Delivery_Date;
            _notes = order.Notes;
            _currencyId = order.Currency_Id ?? _currencyId;
            _locked = !CustomerOrdersService.IsEditable(order, hasFulfillments);

            var customerName = await Task.Run(() => LookupName("Customer", order.Customer_Id ?? 0, "Name"));
            _customer = new LookupOption(order.Customer_Id ?? 0, customerName);
            _lines = await Task.Run(() => ToInvoiceLines(lines, order.Store_Id ?? 0));
            _orderLines = lines;
            _canFulfill = CustomerOrdersService.CanFulfill(order);
            _alloc = lines.ToDictionary(l => l.Id, l => new AllocInput
            {
                Larg = CustomerOrdersService.RemainingLarg(l),
                Small = CustomerOrdersService.RemainingSmall(l)
            });
            var inv = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _service.GetOrderInvoices(id); });
            _orderInvoices = inv.Rows.Cast<DataRow>()
                .Where(r => r["Invoice_No"] != DBNull.Value)
                .Select(r => new OrderInvoice(Convert.ToInt64(r["Invoices_List_Id"]), Convert.ToInt64(r["Invoice_No"]), Convert.ToDateTime(r["Invoice_Date"]), Convert.ToDecimal(r["Net_Total"])))
                .DistinctBy(x => x.InvoiceListId).ToList();

            // عنوان التبويب لطلبية محفوظة = «بيانات الطلبية رقم {رقم الطلبية}» بدل اسم قائمة «إضافة طلبية» (مفتاح التبويب = المسار بلا query).
            var tabKey = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
            TabWorkspace.SetCustomTitle(tabKey, Tr("COTabView", _orderNo));
            await RefreshAvailabilityAsync();
            var dep = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _service.GetDeposits(id); });
            _deposits = dep.Rows.Cast<DataRow>().Select(r => new DepositRow(r["Order_No"] == DBNull.Value ? 0 : Convert.ToInt64(r["Order_No"]),
                r["Deposit_Date"] == DBNull.Value ? DateTime.Now : Convert.ToDateTime(r["Deposit_Date"]), Convert.ToDecimal(r["Amount"]), Convert.ToDecimal(r["Consumed_Amount"]))).ToList();
            var bal = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return _service.GetDepositBalance(id); });
            _depositRemaining = bal.Remaining;
            _applied = bal.PerInvoice.Rows.Cast<DataRow>().ToDictionary(r => Convert.ToInt64(r["Invoices_List_Id"]), r => Convert.ToDecimal(r["Applied"]));
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
    }

    // كل القيم أرقام long من قاعدة البيانات نفسها (لا مدخلات نصية).
    private static string LookupName(string table, long id, string column)
    {
        var dt = new operations().return_DataTable($"SELECT {column} FROM {table} WHERE Id = {id}");
        return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString()?.Trim() ?? "" : "";
    }

    private List<IInvoices_Details> ToInvoiceLines(List<CustomerOrderLine> lines, long storeId)
    {
        var result = new List<IInvoices_Details>();
        if (lines.Count == 0) return result;
        var ids = string.Join(",", lines.Select(l => l.Unit_Item_Table_Id ?? 0).Distinct());
        var dt = new operations().return_DataTable(
            "SELECT Unit_item.id AS UnitItemId, Unit_item.Item_id, Unit_item.Code, Item.Item_Name, unit.B_Unit, unit.S_unit " +
            "FROM Unit_item INNER JOIN Item ON Unit_item.Item_id = Item.id LEFT JOIN unit ON Unit_item.unit_id = unit.id WHERE Unit_item.id IN (" + ids + ")");
        foreach (var l in lines)
        {
            var row = dt.Rows.Cast<DataRow>().FirstOrDefault(r => Convert.ToInt64(r["UnitItemId"]) == (l.Unit_Item_Table_Id ?? 0));
            result.Add(new IInvoices_Details
            {
                Id = --_tempLineId,
                Unit_Item_Table_Id = l.Unit_Item_Table_Id,
                Item_Id = row is null ? 0 : Convert.ToInt64(row["Item_id"]),
                code = row?["Code"]?.ToString() ?? "",
                Invoice_Item_Name = row?["Item_Name"]?.ToString() ?? "",
                UnitStr = row?["B_Unit"]?.ToString() ?? "",
                UnitSmallStr = row?["S_unit"]?.ToString() ?? "",
                Larg_Qnty = l.Qty_Larg,
                Small_Qnty = l.Qty_Small,
                PriceUnit = l.Unit_Price,
                Item_TaxSales10_Value = l.Tax_Value,
                Item_Net_Total_Price = l.Line_Total,
                // خصم السطر المحفوظ يعود للسطر فلا يضيع عند إعادة الحفظ.
                Net_Total_Item_Commission = l.Discount_Value,
                ItemCommissionTotal = l.Discount_Value,
                Qnty_value = (l.Line_Total ?? 0) + (l.Discount_Value ?? 0) - (l.Tax_Value ?? 0),
                Store_Id = storeId
            });
        }
        return result;
    }

    private void NewOrder()
    {
        _orderId = 0; _orderNo = 0; _status = CustomerOrderStatus.Draft; _locked = false;
        _customer = null; _lines = new(); _notes = null;
        _orderDate = DateTime.Now.Date; _expectedDate = null; _errorMessage = null;
        _loadedId = 0;
        _repDeposit = 0; _repDocGuid = Guid.NewGuid(); _repViolations = new(); _repWarnings = new(); _repApprovalReason = null;
        if (RepQuery is > 0) _expectedDate = DateTime.Today.AddDays(1);
        Nav.NavigateTo("/accounts/sales/customer-order" + (RepQuery is > 0 ? $"?rep={RepQuery}" : ""));
    }

    private void OpenInvoiceTab(OrderInvoice inv) => Nav.NavigateTo($"/accounts/invoices/sales-invoice/{inv.InvoiceListId}");

    private void OpenAddItemDialog() { _editingLine = null; _itemDialogOpen = true; }
    private void OpenEditItemDialog(IInvoices_Details line) { _editingLine = line; _itemDialogOpen = true; }
    private async Task DeleteLine(IInvoices_Details line) { _lines.Remove(line); await RefreshAvailabilityAsync(); }

    private Task OnItemDialogSaved(IInvoices_Details line)
    {
        line.Id = _editingLine?.Id ?? --_tempLineId;
        if (_editingLine is null)
        {
            _lines.Add(line);
        }
        else
        {
            var index = _lines.IndexOf(_editingLine);
            if (index >= 0) _lines[index] = line;
            _editingLine = line;
        }
        return RefreshAvailabilityAsync();
    }

    private async Task SaveAsync(bool confirm)
    {
        _errorMessage = null;
        if (_customer is null) { _errorMessage = Tr("OrdNotesSelectCustomerHint"); return; }
        if (_lines.Count == 0) { _errorMessage = Tr("NoItemsMessage"); return; }

        _isSaving = true;
        var header = new CustomerOrder
        {
            Id = _orderId,
            Customer_Id = _customer.Id,
            Currency_Id = _currencyId,
            Order_Date = _orderDate,
            Expected_Delivery_Date = _expectedDate,
            Notes = _notes,
            Store_Id = _lines.Select(l => l.Store_Id).FirstOrDefault(s => s is > 0)
        };
        var lines = _lines.Select(l => new CustomerOrderLine
        {
            Unit_Item_Table_Id = l.Unit_Item_Table_Id,
            Qty_Larg = l.Larg_Qnty,
            Qty_Small = l.Small_Qnty,
            Unit_Price = l.PriceUnit,
            Tax_Value = l.Item_TaxSales10_Value,
            Line_Total = l.Item_Net_Total_Price,
            // خصم السطر (خصم قائمة الأسعار أو اليدوى) يُحفظ قيمةً ونسبةً من الإجمالى، فيُحسب إجمالى الطلبية قبل الخصم صحيحاً.
            Discount_Value = l.Net_Total_Item_Commission ?? 0,
            Discount_Percent = (l.Qnty_value ?? 0) > 0 ? Math.Round((l.Net_Total_Item_Commission ?? 0) / l.Qnty_value!.Value * 100, 2) : 0
        }).ToList();

        try
        {
            var (id, no) = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return _service.SaveOrder(header, lines, confirm);
            });
            _orderId = id;
            _orderNo = no;
            _status = confirm ? CustomerOrderStatus.Confirmed : CustomerOrderStatus.Draft;
            _loadedId = id;
            Snackbar.Add(Tr("COSaved", no), Severity.Success);
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string FormatQnty(IInvoices_Details line)
    {
        var largTxt = line.Larg_Qnty is > 0 ? $"{line.Larg_Qnty:0.##} {line.UnitStr}" : "";
        var smallTxt = line.Small_Qnty is > 0 ? $"{line.Small_Qnty:0.##} {line.UnitSmallStr}" : "";
        return string.Join(" ", new[] { largTxt, smallTxt }.Where(s => !string.IsNullOrEmpty(s)));
    }

    private static string Qty(decimal? larg, decimal? small, IInvoices_Details? d)
    {
        var l = larg ?? 0;
        var s = small ?? 0;
        if (l == 0 && s == 0) return "0";
        var parts = new List<string>();
        if (l != 0) parts.Add($"{l:0.##} {d?.UnitStr}");
        if (s != 0) parts.Add($"{s:0.##} {d?.UnitSmallStr}");
        return string.Join(" + ", parts);
    }

    // «تحويل إلى فاتورة»: تفتح فاتورة المبيعات الحالية معبّأة بالكميات المختارة (لا يُسجَّل الربط إلا بعد نجاح حفظ الفاتورة).
    private void ConvertToInvoice()
    {
        var alloc = string.Join(";", _orderLines
            .Where(l => _alloc.TryGetValue(l.Id, out var a) && (a.Larg > 0 || a.Small > 0))
            .Select(l =>
            {
                var a = _alloc[l.Id];
                var larg = Math.Min(a.Larg, CustomerOrdersService.RemainingLarg(l));
                var small = Math.Min(a.Small, CustomerOrdersService.RemainingSmall(l));
                return string.Create(CultureInfo.InvariantCulture, $"{l.Id}:{larg}:{small}");
            }));
        if (string.IsNullOrEmpty(alloc)) { Snackbar.Add(Tr("COConvertNothing"), Severity.Warning); return; }
        Nav.NavigateTo($"/accounts/invoices/sales-invoice?agile={_invoiceAgile}&fromOrder={_orderId}&alloc={Uri.EscapeDataString(alloc)}");
    }

    private async Task CloseRemainingAsync()
    {
        _isSaving = true;
        var id = _orderId;
        var reason = _closeReason ?? "";
        try
        {
            await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); _service.CloseRemaining(id, reason); });
            Snackbar.Add(Tr("COClosedRemainingMsg"), Severity.Success);
            _showCloseRemaining = false;
            await LoadOrderAsync(id);
        }
        catch (Exception ex) { _errorMessage = Tr("SystemError", ex.Message); }
        finally { _isSaving = false; }
    }

    private string StatusText(CustomerOrderStatus s) => s switch
    {
        CustomerOrderStatus.Confirmed => Tr("COStatusConfirmed"),
        CustomerOrderStatus.PartiallyFulfilled => Tr("COStatusPartial"),
        CustomerOrderStatus.Fulfilled => Tr("COStatusFulfilled"),
        CustomerOrderStatus.Cancelled => Tr("COStatusCancelled"),
        CustomerOrderStatus.Closed => Tr("COStatusClosed"),
        _ => Tr("COStatusDraft")
    };

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
