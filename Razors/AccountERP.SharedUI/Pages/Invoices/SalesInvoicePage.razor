@* 🟢 يقابل Accounts.Requests.Make_Invoices + Accounts.Requests.EditFRM_Invoices + قاعدتهما المشتركة
   NewFrmInvoive (شاشة الفاتورة القياسية) - نسخة أولى (v1) توحّد الشاشات التالية بمعاملات بدل صفحات منفصلة
   (بموافقة صريحة من المستخدم):
     - فاتورة جديدة نقدى (Make_Invoices, Agile=0)
     - فاتورة جديدة آجل (Make_Invoices, Agile=1)
     - فاتورة جديدة - حفظ الأصناف مباشرة (Make_Invoices, SaveDirectly=1)
     - فاتورة جديدة قطاعى (Make_Invoices, Kta3y=1)
     - عرض/تعديل فاتورة مبيعات (EditFRM_Invoices)

   يشمل v1: بيانات رأس الفاتورة الأساسية (عميل/عملة/تاريخ/ملاحظات)، جدول الأصناف بالأعمدة الأكثر استخداماً
   فقط (الاسم/الكمية/السعر/الإجمالى/الضريبة/الصافى)، إضافة/تعديل/حذف صنف عبر AddInvoiceItemDialog، حساب
   إجماليات الفاتورة (InvoiceLineCalculator)، والحفظ عبر نفس محرك الحفظ الأصلى بدون أى تعديل فيه
   (Requests_ModelCls.Make_Invoice_Update_CustomerAccount / Edit_Invoice_Update_CustomerAccount).

   مُؤجَّل لمرحلة لاحقة (موثَّق فى خطة التحويل): باقى الأعمدة الشرطية الثلاثين تقريباً المتحكَّم فيها بأعلام
   AccountCommonDataLIB.Common.Show_*_OnInvoiceMonitor، المندوب (ShowSalesMan)، القسط (Takseet)، استلام
   النقدية المباشر من الشاشة، البحث بالباركود، ومتغيّر الصيدلية (ItemDataPh + اختيار دفعة الصلاحية).

   إصلاح معمارى مقصود عن الأصل (موثَّق فى خطة التحويل وبموافقة المستخدم): كل الحالة هنا محلية بالصفحة/المكوّن؛
   لا يوجد أى مكافئ لحقول static bool BtnOk / static DataView dv_Request التى فى أصل Make_Invoices - هذه
   كانت لتمرير حالة بين الفورم والحوار، وتُستبدَل هنا بـ EventCallback/متغيرات محلية عادية. *@

@* 🟢 المرحلة ٢ (الصفحة ب - فاتورة المرتجع الموحّدة، بموافقة المستخدم على التوحيد): نفس هذا المكوّن يخدم أيضاً
   Accounts.Requests.Make_Invoices_Reverse + EditFRM_Invoices_Reverse عبر المسار الثانى sales-return (الوضع
   _isReverse). الفروق الفعلية عن البيع (موثّقة من الأصل): رقم فاتورة مرتجع مستقل (Make_New_Invoice_ReverseNo)،
   InvoicesOperationListCLS/CLS(1) (Invoices_List_Reverse)، محرك حفظ/تعديل مستقل (Requests_Cls.Make_Invoice_Reverse_
   Update_CustomerAccount / Edit_InvoiceReverse_Update_CustomerAccount)، تحميل عبر Get_Invoices_List_Reverse +
   GetInvoiceDetails_Reverse، ورصيد العميل بعد = قبل − الصافى (عكس البيع). ?type=1 = فاتورة "عام" ضريبية (ATS05=0.05،
   TaxSales10=10، كما فى Check_InvoiceType الأصلية) و0 = "خاص" بلا ضرائب. *@
@page "/accounts/invoices/sales-invoice/{Id:long?}"
@page "/accounts/invoices/sales-return/{Id:long?}"

@using System.Data
@using System.Globalization
@using AccountModelsLib
@using AccountModelsLib.Models
@using AccountERP.SharedUI.Services
@using AccountERP.SharedUI.Components.Shared
@using AccountERP.SharedUI.Components.Assistant
@inject LanguageService LangService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject TabWorkspaceService TabWorkspace
@inject MenuStateService MenuState
@inject IServiceProvider ServiceProvider
@implements IDisposable

<PageTitle>@_pageTitle</PageTitle>

<InvoiceStyles />

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">
<div class="inv-page">

    @* ===== رأس الصفحة: العنوان + شارات (الرقم / نقدى-آجل / الحالة) ===== *@
    @* العنوان والشارات داخل مستطيل بخلفية بيضاء مثل بطاقة «بيانات الفاتورة» (بطلب المستخدم) *@
    <div class="inv-head inv-card">
        <h1 class="inv-title">@_pageTitle</h1>
        <div class="inv-badges">
            <span class="inv-chip primary"><MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />@_invoiceNoDisplay</span>
            <span class="inv-chip">@(_header.Is_Invoice_Agile == 1 ? Tr("DS_InvoiceCredit") : Tr("DS_InvoiceCash"))</span>
            <span class="inv-chip @(_isSaved || (Id.HasValue && Id.Value > 0) ? "success" : "warn")">
                @(_isSaved || (Id.HasValue && Id.Value > 0) ? Tr("InvoiceStatusSaved") : Tr("InvoiceStatusNew"))
            </span>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_isSaving" OnClick="NewInvoiceAsync">@Tr("NewInvoiceButton")</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Filled.Close" OnClick="@(() => Nav.NavigateTo("/"))">@Tr("Cancel")</MudButton>
        </div>
    </div>

    @* ===== وضع المندوب (خطة المندوبين المرحلة 3): مخزن السيارة وصندوق العهدة والمندوب مقفلة، والحفظ عبر SalesRepSaleService ===== *@
    @if (IsRepMode)
    {
        <div class="inv-card mb-3" aria-live="polite">
            @if (_repCtx is null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" role="alert">@(_repError ?? Tr("FSVNoRep"))</MudAlert>
            }
            else
            {
                <div class="inv-badges" style="flex-wrap:wrap;gap:8px">
                    <span class="inv-chip primary"><MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Small" />@Tr("FSVRepMode"): @_repCtx.Rep_Name</span>
                    <span class="inv-chip">@Tr("FSRVan"): @_repCtx.Van_Store_Name</span>
                    <span class="inv-chip">@Tr("FSRBox"): @_repCtx.Cash_Box_Name (@_repCtx.Cash_On_Hand.ToString("N2"))</span>
                    <span class="inv-chip @(_repCtx.CanSell ? "success" : "warn")">@Tr(_repCtx.Shift_Status is int st ? "FSSStatus_" + st : "FSSNoShift")</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.PointOfSale" Href="@($"/salesrep/shift?rep={_repCtx.Rep_Id}")">@Tr("FSSTitle")</MudButton>
                </div>
                @if (!_repCtx.CanSell)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2" role="alert">@Tr("FSVNoOpenShift")</MudAlert>
                }
                @* بقايا المرحلة 2: طريقة دفع البيع النقدى؛ غير النقدى يدخل بنك الطريقة لا صندوق العهدة. *@
                @if (_header.Is_Invoice_Agile != 1 && _repMethods.Count > 1 && !_isSaved)
                {
                    <MudSelect T="long" @bind-Value="_repMethodId" Label="@Tr("FSYMethod")" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Style="max-width:320px"
                               HelperText="@Tr(_repMethodId == AccountModelsLib.SalesRep.SalesRepShiftService.CashPaymentMethodId ? "FSYMethodCashHint" : "FSYMethodBankHint")"
                               ToStringFunc="@(v => _repMethods.FirstOrDefault(m => m.Id == v)?.Name ?? "")">
                        @foreach (var m in _repMethods) { <MudSelectItem T="long" Value="@m.Id">@m.Name</MudSelectItem> }
                    </MudSelect>
                }
                @foreach (var w in _repWarnings)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@w</MudAlert>
                }
                @if (_repViolations.Count > 0)
                {
                    <h3 class="inv-card-title mt-3"><MudIcon Icon="@Icons.Material.Filled.Gavel" />@Tr("FSVApprovalsNeeded")</h3>
                    @foreach (var v in _repViolations)
                    {
                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:6px">
                            <MudIcon Icon="@(v.Covered ? Icons.Material.Filled.CheckCircle : v.Approval_Status == 2 ? Icons.Material.Filled.Cancel : Icons.Material.Filled.HourglassTop)"
                                     Color="@(v.Covered ? Color.Success : v.Approval_Status == 2 ? Color.Error : Color.Warning)" Size="Size.Small" aria-hidden="true" />
                            <span>@v.Message</span>
                            <span class="inv-chip @(v.Covered ? "success" : "warn")">@Tr(v.Approval_Status is int s ? "FSVApproval_" + s : "FSVApprovalNone")</span>
                        </div>
                    }
                    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:12px">
                        <MudTextField T="string" @bind-Value="_repApprovalReason" Label="@Tr("FSVReason")" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width:240px" />
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Send" Disabled="@(_repBusy || _repViolations.All(v => v.Covered || v.Approval_Status == 0))" OnClick="RequestRepApprovalsAsync">@Tr("FSVRequestApproval")</MudButton>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh" Disabled="_repBusy" OnClick="CheckRepSaleAsync">@Tr("FSVRefreshStatus")</MudButton>
                    </div>
                }
                else if (_lines.Count > 0 && !_isSaved)
                {
                    <div class="mt-2"><MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.FactCheck" Disabled="_repBusy" OnClick="CheckRepSaleAsync">@Tr("FSVCheck")</MudButton></div>
                }
            }
        </div>
    }
    @if (_repLinkedShiftId is long linkedShift)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.LocalShipping">@Tr("FSVLinkedReadOnly")</MudAlert>
    }

    @if (_aiDraft is not null)
    {
        <AiDraftBanner Payload="_aiDraft" Extra="_aiDraftExtra" OnDiscard="DiscardAiDraftAsync" />
    }

    @if (_fromOrderId > 0)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Assignment">
            @string.Format(CultureInfo.InvariantCulture, Tr("COInvoiceFromOrder"), _fromOrderNo)
        </MudAlert>
    }

    <MudGrid Spacing="3">

        @* ===== العمود الرئيسى: بيانات الفاتورة ثم الأصناف ===== *@
        <MudItem xs="12" lg="@(_showSummary ? 8 : 12)">

            <div class="inv-card">
                <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.Description" />@Tr("InvoiceDataTitle")</h2>
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudAutocomplete T="CustomerOption" Value="_selectedCustomer" SearchFunc="SearchCustomersAsync"
                                          ToStringFunc="@(o => o?.Name ?? "")" Label="@Tr("CustomerLabel")" Variant="Variant.Outlined"
                                          ValueChanged="OnCustomerPickedAsync" ResetValueOnEmptyText="true" Disabled="_isSaved || _customerLocked" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="long" @bind-Value="_currencyId" Label="@Tr("CurrencyLabel")" Variant="Variant.Outlined" Disabled="_isSaved">
                            @foreach (var c in _currencies)
                            {
                                <MudSelectItem T="long" Value="@c.Id">@c.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudDatePicker T="DateTime?" @bind-Date="_invoiceDate" Label="@Tr("InvoiceDateLabel")" Variant="Variant.Outlined" Disabled="_isSaved" />
                    </MudItem>
                </MudGrid>

                @* 🟢 يقابل cbAccountTaxInfo (IsInvoiceTaxInfo) و cbIs_TaxPer_Item (Is_Tax_Per_Item) - قاعدة المستخدم: الأولى تحدد أن الفاتورة
                   ضريبية، والثانية طريقة الحساب (1 على كل صنف، 0 على إجمالى الفاتورة). عند الحساب لكل صنف لا تتكرر الضريبة على الإجمالى. *@
                <div class="inv-tax">
                    <MudCheckBox T="bool" Value="_isTaxInvoice" ValueChanged="OnTaxInvoiceChanged" Label="@Tr("TaxInvoiceLabel")" Disabled="_isSaved"
                                 Dense="true" Size="Size.Small" />
                    <MudCheckBox T="bool" Value="_isTaxPerItem" ValueChanged="OnTaxPerItemChanged" Label="@Tr("TaxPerItemLabel")"
                                 Disabled="_isSaved || !_isTaxInvoice || _taxPerItemForced" Dense="true" Size="Size.Small" />
                    @if (_isTaxInvoice)
                    {
                        @* نسبتا الضريبة قابلتان للتعديل كما فى nuTaxSalesList_Rate/nuATS05List_Rate؛ تُطبَّقان على الإجمالى أو على كل صنف حسب Is_Tax_Per_Item. *@
                        <MudNumericField T="decimal" Value="_defaultTaxSales" ValueChanged="@(v => { _defaultTaxSales = v; ApplyTaxSettings(); })"
                                         Label="@($"{Tr("TaxSalesColumn")} %")" Variant="Variant.Outlined" Format="0.##" Margin="Margin.Dense" Disabled="_isSaved" Style="max-width:120px" />
                        <MudNumericField T="decimal" Value="_defaultATS05" ValueChanged="@(v => { _defaultATS05 = v; ApplyTaxSettings(); })"
                                         Label="@($"{Tr("ATS05Column")} %")" Variant="Variant.Outlined" Format="0.##" Margin="Margin.Dense" Disabled="_isSaved" Style="max-width:120px" />
                    }
                </div>

                @if (_selectedCustomer is not null)
                {
                    <div class="inv-cust">
                        <span class="inv-avatar">@(string.IsNullOrWhiteSpace(_selectedCustomer.Name) ? "?" : _selectedCustomer.Name.Trim()[0].ToString())</span>
                        <div class="who"><b>@_selectedCustomer.Name</b><small>@Tr("BalanceBeforeLabel")</small></div>
                        @if (AccountModelsLib.Common.IS_Use_Price_Type_List == 1 && !string.IsNullOrEmpty(_customerPriceTypeName))
                        {
                            <span class="inv-chip">@Tr("PriceTypeLabel"): @_customerPriceTypeName</span>
                        }
                        <span class="inv-chip @(_customerAccountBefore < 0 ? "success" : "warn")">@(_customerAccountBefore < 0 ? Tr("NatureCreditLabel") : Tr("NatureDebitLabel")): @Common.RoundMe(Math.Abs(_customerAccountBefore)).ToString("N2")</span>
                    </div>
                }
            </div>

            <div class="inv-card">
                <div class="inv-card-head">
                    <h2 class="inv-card-title">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" />@Tr("ItemsHeader")
                        @if (_lines.Count > 0)
                        {
                            <span class="inv-count">@_lines.Count</span>
                        }
                    </h2>
                    @* بحث بالكود/الباركود: قارئ الباركود يكتب الكود ثم Enter، فيُفتح حوار الصنف والصنف محدد ليُدخَل العدد ويُضاف للفاتورة. *@
                    @* يقابل Common.Show_SearchItemBy_BarCode_On_Invoice: يُخفى حقل الباركود لو الإعداد 0 (كما فى الأصل). *@
                    @if (Common.Show_SearchItemBy_BarCode_On_Invoice == 1)
                    {
                        <MudTextField T="string" @ref="_barcodeField" @bind-Value="_barcodeText" Class="inv-barcode" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" Label="@Tr("BarcodeSearchLabel")"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.QrCodeScanner"
                                      Disabled="_selectedCustomer is null || _isSaved" OnKeyDown="OnBarcodeKeyDownAsync" />
                    }
                    @if (_lines.Count > 0)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenAddItemDialog" Disabled="_selectedCustomer is null || _isSaved">
                            @Tr("AddItemButton")
                        </MudButton>
                    }
                </div>

                @if (_lines.Count == 0)
                {
                    <div class="inv-empty2">
                        <span class="ico"><MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" /></span>
                        <div style="font-size:1.05rem;font-weight:600;color:var(--mud-palette-text-primary)">@Tr("NoItemsMessage")</div>
                        <div style="font-size:.9375rem">@Tr("AddFirstItemHint")</div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mt-1"
                                   OnClick="OpenAddItemDialog" Disabled="_selectedCustomer is null || _isSaved">
                            @Tr("AddItemButton")
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="inv-lines" style="--cols:@LinesGridCols;--minw:@LinesMinWidth">
                        <div class="inv-lines-head" role="row">
                            <span>#</span>
                            <span>@Tr("ItemNameColumn")</span>
                            <span class="n hide-sm">@Tr("QuantityColumn")</span>
                            <span class="n hide-sm">@Tr("UnitPriceColumn")</span>
                            <span class="n">@Tr("NetTotalColumn")</span>
                            <span></span>
                        </div>

                        @{ var idx = 0; }
                        @foreach (var line in _lines)
                        {
                            idx++;
                            var sub = string.Join(" · ", new[] { line.code, line.Store_Name }.Where(s => !string.IsNullOrWhiteSpace(s)));
                            <div class="inv-line" role="row" @key="line">
                                <span class="inv-idx">@idx</span>
                                <div class="inv-item">
                                    <b>@line.Invoice_Item_Name</b>
                                    @if (!string.IsNullOrEmpty(sub))
                                    {
                                        <small>@sub</small>
                                    }
                                    <small class="inv-formula">@FormatQnty(line) × @((line.PriceUnit ?? 0).ToString("N2"))</small>
                                    @* 🟢 أعمدة الأصل المخفية بـWidth=0 وتظهر بإعدادات Show_*_OnInvoiceMonitor (InvoiceColumnSettings): كل عمود مفعَّل له قيمة يظهر شارة تحت الصنف *@
                                    @{ var chips = ExtraChips(line).ToList(); }
                                    @if (chips.Count > 0)
                                    {
                                        <div class="inv-extras">
                                            @foreach (var c in chips)
                                            {
                                                <span class="inv-xchip"><i>@c.Label</i> @c.Value</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="n hide-sm"><span class="inv-qty">@FormatQnty(line)</span></div>
                                <div class="n hide-sm">@((line.PriceUnit ?? 0).ToString("N2"))</div>
                                <div class="n inv-netcell">
                                    <span class="inv-net">@((line.Item_Net_Total_Price ?? 0).ToString("N2"))</span>
                                    @if (_showTaxSalesColumn)
                                    {
                                        @* الضريبة لكل صنف: تفصيلها سطر صغير تحت الصافى بدل أعمدة إضافية (لا تمرير أفقى) *@
                                        <small class="inv-taxline">
                                            @Tr("TaxSalesColumn") @((line.Item_TaxSales10_Value ?? 0).ToString("N2"))
                                            @if ((line.Item_ATS05_Value ?? 0) != 0)
                                            {
                                                <span> · @Tr("ATS05Column") @((line.Item_ATS05_Value ?? 0).ToString("N2"))</span>
                                            }
                                        </small>
                                    }
                                </div>
                                <div class="inv-acts">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditNote" Size="Size.Medium" Disabled="_isSaved" OnClick="@(() => OpenEditItemDialog(line))" aria-label="@Tr("EditItemLabel")" />
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Medium" Color="Color.Error" Disabled="_isSaved" OnClick="@(() => DeleteLine(line))" aria-label="@Tr("DeleteItemLabel")" />
                                </div>
                            </div>
                        }

                        <div class="inv-lines-foot">
                            <span class="stat">@Tr("LinesCountLabel"): <b>@_lines.Count</b></span>
                            <span class="stat">@Tr("LinesQtyLabel"): <b>@_lines.Sum(l => l.Larg_Qnty ?? 0).ToString("0.##")</b></span>
                            <span class="stat">@Tr("NetTotalColumn"): <b>@_lines.Sum(l => l.Item_Net_Total_Price ?? 0).ToString("N2")</b></span>
                        </div>
                    </div>
                }

                @* 🟢 يقابل مجموعة إجمالى الفاتورة وبيانات الرأس فى NewFrmInvoive: رقم البوليصة وعدد الطرود ومصروفات أخرى والخصم (نسبة + قيمة، يُعطَّل مع الضريبة لكل صنف)
                   وتاريخ الاستحقاق (صلاحية 957)، وقيمة الشحن والبائع وملاحظات العميل تظهر فقط بإعدادات الشركة كالأصل (Show_Shipment_DataInvoiceMonitor
                   وShow_EmployeeSeller_OnInvoiceMonitor وShow_Customer_Notes_OnInvoiceMonitor). *@
                @* مغلق افتراضياً (استخدامه قليل ويزحم الصفحة): زر عريض يفتحه/يخفيه، ويعرض عدد الحقول المعبّأة وهو مغلق. *@
                <div class="inv-extra @(_extraOpen ? "open" : "")">
                    <button type="button" class="inv-extra-toggle" aria-expanded="@(_extraOpen ? "true" : "false")" @onclick="@(() => _extraOpen = !_extraOpen)">
                        <span class="ico"><MudIcon Icon="@Icons.Material.Filled.Inventory" /></span>
                        <span class="ttl">@Tr("PurchExtraDataHeader")</span>
                        @if (ExtraFilledCount > 0)
                        {
                            <span class="inv-chip primary">@ExtraFilledCount</span>
                        }
                        <span class="hint">@(_extraOpen ? Tr("ExtraDataHide") : Tr("ExtraDataShow"))</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="chev" />
                    </button>
                    @if (_extraOpen)
                    {
                    <div class="inv-extra-body">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField T="string" @bind-Value="_header.PolicaNo" Label="@Tr("PolicyNoLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSaved" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudTextField T="string" @bind-Value="_header.troodContainerNo" Label="@Tr("ParcelsCountLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSaved" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="3">
                            <MudNumericField T="decimal" @bind-Value="OtherExpenses" Label="@Tr("OtherExpensesLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             Format="0.##" Immediate="true" HideSpinButtons="true" Disabled="_isSaved" />
                        </MudItem>
                        @if (!(_isTaxInvoice && _isTaxPerItem))
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="decimal" @bind-Value="DiscountRate" Label="@Tr("InvoiceDiscountRateLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Format="0.##" Immediate="true" HideSpinButtons="true" Disabled="_isSaved" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="decimal" @bind-Value="DiscountValue" Label="@Tr("InvoiceDiscountValueLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Format="0.##" Immediate="true" HideSpinButtons="true" Disabled="_isSaved" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="decimal" Value="@(_header.Net_Total_CommissionValue ?? 0)" Label="@Tr("TotalDiscountLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Format="0.##" HideSpinButtons="true" ReadOnly="true" />
                            </MudItem>
                        }
                        @if (_showDueDate)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudDatePicker T="DateTime?" @bind-Date="_dueDate" Label="@Tr("PmtDueDateColumn")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSaved" />
                            </MudItem>
                        }
                        @if (Common.Show_Shipment_DataInvoiceMonitor == 1)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudNumericField T="decimal" @bind-Value="ShipmentValue" Label="@Tr("ShipmentValueLabel")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                 Format="0.##" Immediate="true" HideSpinButtons="true" Disabled="_isSaved" />
                            </MudItem>
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="SellerOption" Value="_shipmentCompany" ValueChanged="OnShipmentCompanyPicked" SearchFunc="SearchShipmentCompaniesAsync" ToStringFunc="@(s => s?.Name ?? "")"
                                                 Label="@Tr("ShipmentCompanyLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" CoerceText="false"
                                                 ResetValueOnEmptyText="true" MaxItems="50" Disabled="_isSaved" />
                            </MudItem>
                        }
                        @if (Common.ShowSalesMan == 1)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="SellerOption" Value="_salesman" ValueChanged="OnSalesmanPicked" SearchFunc="SearchSalesmenAsync" ToStringFunc="@(s => s?.Name ?? "")"
                                                 Label="@Tr("SalesmanLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" CoerceText="false"
                                                 ResetValueOnEmptyText="true" MaxItems="50" Required="true" Disabled="@(_isSaved || IsRepMode)" />
                            </MudItem>
                        }
                        @if (Common.Show_EmployeeSeller_OnInvoiceMonitor == 1)
                        {
                            <MudItem xs="12" sm="6" md="3">
                                <MudAutocomplete T="SellerOption" Value="_seller" ValueChanged="OnSellerPicked" SearchFunc="SearchSellersAsync" ToStringFunc="@(s => s?.Name ?? "")"
                                                 Label="@Tr("PmtSellerLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" CoerceText="false"
                                                 ResetValueOnEmptyText="true" MaxItems="50" Disabled="_isSaved" />
                            </MudItem>
                        }
                        <MudItem xs="12" sm="6" md="3" Style="@(_ccAny ? null : "display:none")">
                            @* مركز تكلفة المستند (ق9): يُرحَّل على أسطر القيد التى يقبل حسابها مراكز (إيراد/تكلفة)، ويُخفى لو لا توجد مراكز *@
                            <CostCenterField AllLeaves="true" Label="@Tr("InvCostCenter")" Disabled="_isSaved" CenterId="_costCenterId"
                                             CenterIdChanged="@(id => { _costCenterId = id; return Task.CompletedTask; })"
                                             AllowedChanged="@(a => { _ccAny = a.Centers.Count > 0; return Task.CompletedTask; })" />
                        </MudItem>
                        @if (Common.Show_Customer_Notes_OnInvoiceMonitor == 1)
                        {
                            <MudItem xs="12" sm="6" md="6">
                                <MudTextField T="string" @bind-Value="_header.Customer_Notes" Label="@Tr("CustomerNotesLabel")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_isSaved" />
                            </MudItem>
                        }
                    </MudGrid>
                    </div>
                    }
                </div>

                @* ملاحظات الفاتورة: أسفل جدول الأصناف بطلب المستخدم *@
                @if (Common.Show_AddNotes_On_Invoice == 1)
                {
                    @* يقابل Common.Show_AddNotes_On_Invoice: تُخفى ملاحظات الفاتورة لو الإعداد 0 (كما فى الأصل). *@
                    <div class="inv-notes">
                        <MudTextField T="string" @bind-Value="_notes" Immediate="true" Label="@Tr("NotesLabel")" Variant="Variant.Outlined" Disabled="_isSaved" Lines="2" AutoGrow="true" />
                    </div>
                }
            </div>
        </MudItem>

        @* ===== الملخص التفصيلى: مخفى عند تحميل الفاتورة، يُظهره/يُخفيه المستخدم بزر "الملخص التفصيلى" ===== *@
        @if (_showSummary)
        {
            <MudItem xs="12" lg="4" Class="inv-sum-col">
                <div class="inv-card inv-sum">
                    <h2 class="inv-card-title"><MudIcon Icon="@Icons.Material.Filled.Calculate" />@Tr("InvoiceSummaryTitle")</h2>

                    <div class="inv-sum-row"><span>@Tr("TotalLabel")</span><b>@((_header.Total ?? 0).ToString("N2"))</b></div>
                    <div class="inv-sum-row"><span>@Tr("TotalWithoutTaxLabel")</span><b>@((_header.Total_PriceWithoutTax ?? 0).ToString("N2"))</b></div>
                    @if (_isTaxInvoice)
                    {
                        <div class="inv-sum-row"><span>@Tr("TaxSalesValueLabel")</span><b>@((_header.TaxSales10_Value ?? 0).ToString("N2"))</b></div>
                        <div class="inv-sum-row"><span>@Tr("ATS05ValueLabel")</span><b>@((_header.ATS05_Value ?? 0).ToString("N2"))</b></div>
                    }
                    @if (_selectedCustomer is not null)
                    {
                        <div class="inv-sum-row"><span>@Tr("BalanceBeforeLabel")</span><b>@_customerAccountBefore.ToString("N2")</b></div>
                        <div class="inv-sum-row"><span>@Tr("BalanceAfterLabel")</span><b>@((_isReverse ? _customerAccountBefore - (_header.Net_Total ?? 0) : _customerAccountBefore + (_header.Net_Total ?? 0)).ToString("N2"))</b></div>
                    }
                    <div class="inv-sum-net">
                        <span class="lbl">@Tr("NetTotalLabel")</span>
                        <span class="amount">@((_header.Net_Total ?? 0).ToString("N2"))</span>
                    </div>
                </div>
            </MudItem>
        }
    </MudGrid>

    @* ===== شريط الملخص الثابت أسفل جدول الفاتورة: يبقى ظاهراً أثناء التمرير، ومعه زر الحفظ (الإجراء الأساسى الوحيد) ===== *@
    <div class="inv-dock" role="region" aria-label="@Tr("InvoiceSummaryTitle")">
        <div class="inv-dock-cells">
            <div class="cell"><span class="lbl">@Tr("LinesCountLabel")</span><b>@_lines.Count</b></div>
            <div class="cell"><span class="lbl">@Tr("TotalLabel")</span><b>@((_header.Total ?? 0).ToString("N2"))</b></div>
            @if (_isTaxInvoice)
            {
                <div class="cell"><span class="lbl">@Tr("TaxSalesValueLabel")</span><b>@((_header.TaxSales10_Value ?? 0).ToString("N2"))</b></div>
                @if ((_header.ATS05_Value ?? 0) != 0)
                {
                    <div class="cell"><span class="lbl">@Tr("ATS05ValueLabel")</span><b>@((_header.ATS05_Value ?? 0).ToString("N2"))</b></div>
                }
            }
            @if ((_header.Net_Total_CommissionValue ?? 0) != 0)
            {
                <div class="cell"><span class="lbl">@Tr("TotalDiscountLabel")</span><b>@((_header.Net_Total_CommissionValue ?? 0).ToString("N2"))</b></div>
            }
            @if ((_header.AnotherPayment ?? 0) != 0)
            {
                <div class="cell"><span class="lbl">@Tr("OtherExpensesLabel")</span><b>@((_header.AnotherPayment ?? 0).ToString("N2"))</b></div>
            }
            @if ((_header.Shipment_Value ?? 0) != 0)
            {
                <div class="cell"><span class="lbl">@Tr("ShipmentValueLabel")</span><b>@((_header.Shipment_Value ?? 0).ToString("N2"))</b></div>
            }
            <div class="cell net"><span class="lbl">@Tr("NetTotalLabel")</span><b>@((_header.Net_Total ?? 0).ToString("N2"))</b></div>
        </div>
        <div class="inv-dock-actions">
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@(_showSummary ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                       OnClick="@(() => _showSummary = !_showSummary)">
                @(_showSummary ? Tr("SummaryDetailsHide") : Tr("SummaryDetailsShow"))
            </MudButton>
            @if (IsExistingInvoice)
            {
                @* إذن نقدية مرتبط بهذه الفاتورة (استلام/صرف حسب النوع) — المفتاح نوع العملية + رقم الفاتورة كما فى الأصل *@
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Payments"
                           OnClick="@(() => Nav.NavigateTo($"/accounts/cash/voucher-party?doc={Id}&dtype={(_isReverse ? 7 : 1)}"))">@Tr("InvCashVoucherButton")</MudButton>
            }
            @if (IsExistingInvoice && ScreenAssistOn)
            {
                @* P8.9.3 (ص5): «اشرح الفاتورة» للفاتورة المحفوظة بلا تعديلات معلّقة فقط؛ قراءة فقط *@
                bool dirty = Fingerprint() != _baseline;
                <MudTooltip Text="@(dirty ? Tr("AIH_SaveFirst") : "")" Disabled="@(!dirty)">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                               Disabled="@(_isSaving || dirty)" OnClick="ExplainInvoiceAsync"
                               UserAttributes="@(dirty ? new Dictionary<string, object> { ["aria-description"] = Tr("AIH_SaveFirst") } : null)">
                        @Tr(_isReverse ? "AIH_Btn_ExplainReturn" : "AIH_Btn_ExplainInvoice")
                    </MudButton>
                </MudTooltip>
            }
            @if (IsExistingInvoice && _isTaxInvoice && EInvoiceAvailable)
            {
                @* P8.3.3 (ف14): شرح خطأ الفاتورة الإلكترونية — للفاتورة الضريبية المحفوظة فقط؛ لا تعديل ولا إعادة إرسال *@
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Outlined.ReportProblem"
                           OnClick="OpenEInvoiceErrorAsync">@Tr("AIEI_Button")</MudButton>
            }
            @if (IsExistingInvoice && _repLinkedShiftId is null)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever"
                           Disabled="_isSaving" OnClick="DeleteInvoiceAsync">@Tr("InvDeleteButton")</MudButton>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                       Disabled="@(!CanSave)" OnClick="SaveInvoiceAsync">
                @Tr("SaveButton")
            </MudButton>
        </div>
    </div>

    @* الضريبة تُمرَّر للصنف فقط عند الحساب لكل صنف (Is_Tax_Per_Item=1 والفاتورة ضريبية)؛ نسب الرأس عندها صفر. *@
    <AddInvoiceItemDialog ShowExtraFields="true" Visible="_itemDialogOpen" PriceTypeId="_customerPriceTypeId" CustomerId="@(_selectedCustomer?.Id ?? 0)" VisibleChanged="OnItemDialogVisibleChangedAsync" ExistingLine="_editingLine"
                          FixedStoreId="@(IsRepMode ? _repCtx?.Van_Store_Id ?? -1 : 0)"
                          TaxSalesRate="_defaultTaxSales" ATS05Rate="_defaultATS05"
                          InitialCode="@_dialogInitialCode" InitialCodeToken="_barcodeToken" OnCodeNotFound="OnBarcodeNotFoundAsync"
                          IsTaxPerItem="_isTaxInvoice && _isTaxPerItem" OnItemAdded="OnItemDialogSaved" />

</div>
</MudContainer>

@code {
    private record CustomerOption(long Id, string Name);
    private record CurrencyOption(long Id, string Name);
    private record SellerOption(long Id, string Name);

    [Parameter] public long? Id { get; set; }
    [SupplyParameterFromQuery(Name = "agile")] public int? AgileQuery { get; set; }
    [SupplyParameterFromQuery(Name = "kta3y")] public int? Kta3yQuery { get; set; }
    [SupplyParameterFromQuery(Name = "saveDirectly")] public int? SaveDirectlyQuery { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public int? TypeQuery { get; set; }
    // 🟢 تحويل طلبية عميل إلى فاتورة (نظام الطلبيات الحديث): fromOrder = معرّف الطلبية، alloc = "سطر:كبرى:صغرى;..." (الكميات المختارة).
    [SupplyParameterFromQuery(Name = "fromOrder")] public long? FromOrderQuery { get; set; }
    [SupplyParameterFromQuery(Name = "alloc")] public string? AllocQuery { get; set; }
    private long _fromOrderId;
    private long _fromOrderNo;
    // 🤖 P5: مسودة من المساعد الذكى (AI_Drafts): تعبّئ فاتورة جديدة فقط، ولا يُحفظ شىء قبل ضغط المستخدم «حفظ».
    [SupplyParameterFromQuery(Name = "aiDraft")] public long? AiDraftQuery { get; set; }
    private long _aiDraftId;
    private AiDraftPayload? _aiDraft;
    private readonly List<string> _aiDraftExtra = new();
    private List<CustomerOrdersService.Allocation> _orderAllocations = new();
    private long _costCenterId;
    private bool _ccAny;

    private readonly CustomerCLS _customerCls = new();
    private bool _isReverse;
    private InvoicesOperationListCLS _invL_O = new(0);
    private InvoicesOperationCLS _invD_O = new(0);
    private IInvoices_List _header => _invL_O.invL;
    private List<IInvoices_Details> _lines => _invD_O.invDlst.Where(l => (l.Item_DeletedFlage ?? 0) != 1).ToList();

    private CustomerOption? _selectedCustomer;
    private List<CurrencyOption> _currencies = new();
    private long _currencyId;
    private string _invoiceNoDisplay = "";
    private DateTime? _invoiceDate = DateTime.Now;
    private string _notes = "";
    // 🟢 حقول الرأس المالية (يقابل NewFrmInvoive): تاريخ الاستحقاق (صلاحية 957) والبائع (Emp_Id/Emp_Name).
    private DateTime? _dueDate = DateTime.Now;
    private bool _showDueDate;
    private SellerOption? _seller;
    private SellerOption? _salesman;
    private SellerOption? _shipmentCompany;
    private readonly AccountModelsLib.BusinessLibShared.Store.InvoiceHeaderLookupsCLS _lookups = new();
    private decimal OtherExpenses { get => _header.AnotherPayment ?? 0; set { _header.AnotherPayment = value; RecomputeTotals(); } }
    private decimal DiscountRate { get => _header.List_CommissionRate ?? 0; set { _header.List_CommissionRate = value; RecomputeTotals(); } }
    private decimal DiscountValue { get => _header.List_CommissionValue ?? 0; set { _header.List_CommissionValue = value; RecomputeTotals(); } }
    private decimal ShipmentValue { get => _header.Shipment_Value ?? 0; set { _header.Shipment_Value = value; RecomputeTotals(); } }
    private string _balanceLabel = "";
    private string _pageTitle = "";
    private bool _isSaved;

    // P8.3.3: زر «اشرح خطأ الفاتورة الإلكترونية» (البوابة مسجّلة على الويب فقط — ف23).
    private bool EInvoiceAvailable => ServiceProvider.GetService(typeof(AiEInvoiceService)) is AiEInvoiceService s && s.IsAvailable;

    // P8.9.3: «اشرح الفاتورة» (الخدمة مسجّلة على الويب فقط — ص27). الحقائق من الـ Views بصلاحيات المستخدم؛ علما الضريبة من الـ View (القاعدة 11).
    private bool ScreenAssistOn => ServiceProvider.GetService(typeof(AiScreenAssistService)) is AiScreenAssistService s
                                   && s.IsAvailable(_isReverse ? AiScreenKinds.SalesReturn : AiScreenKinds.SalesInvoice);

    // P8.9.4 (ص22): سياق الشاشة المحيط للفاتورة المحفوظة فقط (المعرّف وحده يصل للخادم)؛ الجديدة غير المحفوظة لا تسجّل شيئاً.
    private string _assistRoute = "";
    private void RegisterAssistContext()
    {
        try
        {
            if (!IsExistingInvoice || ServiceProvider.GetService(typeof(AiScreenAssistService)) is not AiScreenAssistService s) return;
            _assistRoute = Nav.Uri;
            s.SetContext(_assistRoute, new AiScreenPayload { Kind = _isReverse ? AiScreenKinds.SalesReturn : AiScreenKinds.SalesInvoice, EntityId = _header.Id },
                         Tr(_isReverse ? "AIH_K_sales_return" : "AIH_K_sales_invoice") + " " + _header.Invoice_Id);
        }
        catch { }
    }

    public void Dispose()
    {
        try
        {
            if (_assistRoute.Length > 0 && ServiceProvider.GetService(typeof(AiScreenAssistService)) is AiScreenAssistService s) s.ClearContext(_assistRoute);
        }
        catch { }
    }

    private async Task ExplainInvoiceAsync()
    {
        if (ServiceProvider.GetService(typeof(AiScreenAssistService)) is not AiScreenAssistService s || !IsExistingInvoice || Fingerprint() != _baseline) return;
        var p = new AiScreenPayload
        {
            Kind = _isReverse ? AiScreenKinds.SalesReturn : AiScreenKinds.SalesInvoice, Question = AiScreenQuestions.ExplainInvoice, EntityId = _header.Id,
        };
        await s.OpenDialogAsync(DialogService, p, _isReverse ? "/accounts/invoices/sales-return" : "/accounts/invoices/sales-invoice",
                                Tr(_isReverse ? "AIH_Btn_ExplainReturn" : "AIH_Btn_ExplainInvoice"));
    }

    private async Task OpenEInvoiceErrorAsync()
    {
        var p = new DialogParameters<EInvoiceErrorDialog>
        {
            { x => x.SaleId, _header.Id },
            { x => x.InvoiceNo, _header.Invoice_Id },
            { x => x.DocKind, _isReverse ? AiEInvoiceConst.DocReturn : AiEInvoiceConst.DocInvoice },
            { x => x.Route, _isReverse ? "/accounts/invoices/sales-return" : "/accounts/invoices/sales-invoice" },
        };
        var o = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<EInvoiceErrorDialog>(Tr("AIEI_Title"), p, o);
    }
    // 🟢 زر الحفظ: يُعطَّل أثناء الحفظ (منع الضغط المتكرر الذى يضاعف الطلبات على الخادم)، وبعد الحفظ يبقى معطَّلاً حتى يتغير أى شىء
    // فى بيانات الفاتورة عن آخر حالة محفوظة/محمَّلة (بصمة الحالة أدناه)، فيُفعَّل ويُحفَظ التعديل بالضغط عليه. الفاتورة الجديدة غير المحفوظة
    // يكفى لتفعيله وجود صنف واحد على الأقل.
    private bool _isSaving;
    private string _baseline = "";
    private bool IsExistingInvoice => Id.HasValue && Id.Value > 0;

    // ===================== وضع المندوب (خطة المندوبين المرحلة 3) =====================
    [SupplyParameterFromQuery(Name = "rep")] public long? RepQuery { get; set; }
    private bool IsRepMode => RepQuery is > 0 && !_isReverse && !IsExistingInvoice;
    private AccountModelsLib.SalesRep.SalesRepSaleService.SaleContext? _repCtx;
    private string? _repError;
    private Guid _repDocGuid = Guid.NewGuid();
    private List<AccountModelsLib.SalesRep.SalesRepSaleService.Violation> _repViolations = new();
    private List<string> _repWarnings = new();
    private string? _repApprovalReason;
    private bool _repBusy;
    private List<AccountModelsLib.SalesRep.SalesRepPaymentService.Option> _repMethods = new();
    private long _repMethodId = AccountModelsLib.SalesRep.SalesRepShiftService.CashPaymentMethodId;
    // فاتورة محفوظة مربوطة بوردية مندوب: تُعرض للقراءة فقط (التصحيح بمرتجع، كما فى أنظمة المبيعات الميدانية).
    private long? _repLinkedShiftId;

    private async Task InitRepModeAsync()
    {
        if (IsExistingInvoice)
        {
            // المرحلة 4: مرتجع المندوب مربوط بوردية (Doc_Type = 2) للقراءة فقط كذلك، وفاتورة أُرجع منها بمرتجع مندوب لا تُعدَّل
            // (المسموح بإرجاعه محسوب من أسطرها).
            var invoiceId = Id!.Value;
            int docType = _isReverse ? 2 : 1;
            _repLinkedShiftId = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var dt = new AccountModelsLib.operations().return_DataTable(
                    "IF OBJECT_ID(N'dbo.SalesRep_Document_Links', N'U') IS NOT NULL SELECT TOP 1 Shift_Id FROM (SELECT Shift_Id FROM SalesRep_Document_Links WHERE Doc_Type = " + docType + " AND Doc_Id = " + invoiceId +
                    (docType == 1 ? " UNION ALL SELECT CAST(0 AS bigint) FROM SalesRep_Invoice_Return_Links WHERE Original_Invoice_Id = " + invoiceId : "") + ") x" +
                    " ELSE SELECT CAST(NULL AS bigint) AS Shift_Id WHERE 1 = 0");
                return dt.Rows.Count > 0 && dt.Rows[0][0] != DBNull.Value ? (long?)Convert.ToInt64(dt.Rows[0][0]) : null;
            });
            if (_repLinkedShiftId != null) { _canEditItems = false; _canDeleteInvoice = false; }
        }
        if (!IsRepMode) return;
        try
        {
            var repId = RepQuery!.Value;
            _repCtx = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return new AccountModelsLib.SalesRep.SalesRepSaleService().GetContext(repId); });
            _repMethods = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return new AccountModelsLib.SalesRep.SalesRepPaymentService().GetMethodsForRep(repId); });
            _salesman = new SellerOption(_repCtx.Employee_Id, _repCtx.Rep_Name);
            _header.Salesman_Id = _repCtx.Employee_Id;
        }
        catch (Exception ex) { _repCtx = null; _repError = ex.Message; }
    }

    private AccountModelsLib.SalesRep.SalesRepSaleService.SaleInput RepInput() => new()
    {
        Doc_Guid = _repDocGuid,
        Customer_Id = _selectedCustomer?.Id ?? 0,
        Is_Credit = _header.Is_Invoice_Agile == 1,
        Net_Total = _header.Net_Total ?? 0,
        Lines = AccountModelsLib.SalesRep.SalesRepSaleService.LinesOf(new AccountModelsLib.operations(), _invL_O, _invD_O),
        Payment_Method_Id = _header.Is_Invoice_Agile == 1 ? 0 : _repMethodId,
    };

    private async Task CheckRepSaleAsync() => await RunRepAsync(false);
    private async Task RequestRepApprovalsAsync() => await RunRepAsync(true);

    private async Task RunRepAsync(bool request)
    {
        if (_repCtx is null || _selectedCustomer is null) return;
        _repBusy = true;
        try
        {
            var repId = _repCtx.Rep_Id;
            var reason = _repApprovalReason;
            var result = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var svc = new AccountModelsLib.SalesRep.SalesRepSaleService();
                var input = RepInput();
                return request ? svc.RequestApprovals(repId, input, reason) : svc.Check(repId, input);
            });
            _repViolations = result.Violations;
            _repWarnings = result.Warnings;
            if (request) Snackbar.Add(Tr("FSVApprovalRequested"), Severity.Info);
            else if (result.Ok) Snackbar.Add(Tr("FSVCheckOk"), Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _repBusy = false; }
    }
    // 🟢 صلاحيات الفاتورة المحفوظة (نفس جدول صلاحيات القوائم SysConfigMenusPERMATIONS كما فى الأصل): 322 تعديل الفاتورة (إضافة/تعديل/حذف صنف)،
    // 932 حذف فاتورة مبيعات (وتشمل المرتجع). الأصل يفحص 322 فى BtnAddItem/BtnDeleteItem/Make_ItemEdit ويرفض برسالة.
    private bool _canEditItems = true;
    private bool _canDeleteInvoice;
    private bool _deletingInvoice;
    private void LoadInvoicePermissions()
    {
        _canEditItems = Common.IsHavePermissionSysMenu(Common.User_Id, 322, 2, -1);
        _canDeleteInvoice = Common.IsHavePermissionSysMenu(Common.User_Id, 932, 2, -1);
    }
    private bool GuardEditItems()
    {
        if (IsExistingInvoice && !_canEditItems)
        {
            Snackbar.Add(Tr("InvNoEditPermission"), Severity.Warning);
            return false;
        }
        return true;
    }

    // حذف فاتورة محفوظة كاملة: كما فى EditFRM_Invoices_Reverse.DeleteAllItems — كل الأسطر تُعلَّم محذوفة ثم تُحفظ بمحرك التعديل نفسه
    // فيُرجَع رصيد الأصناف وحركة العميل والقيد. الصلاحية 322 ثم 932.
    private async Task DeleteInvoiceAsync()
    {
        if (!IsExistingInvoice || _isSaving) return;
        if (!_canEditItems) { Snackbar.Add(Tr("InvNoEditPermission"), Severity.Warning); return; }
        if (!_canDeleteInvoice) { Snackbar.Add(Tr("InvNoDeletePermission"), Severity.Warning); return; }
        var linkedVouchers = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return new CashVouchersService().CountLinkedCashVouchers(_isReverse ? 7 : 1, Id!.Value, _header.Is_Invoice_Agile != 1); });
        if (linkedVouchers > 0) { Snackbar.Add(Tr("InvDeleteHasVouchers"), Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBoxAsync(Tr("InvDeleteButton"), Tr("InvDeleteConfirm"),
            yesText: Tr("InvDeleteButton"), cancelText: Tr("Cancel"));
        if (confirmed != true) return;
        for (var i = _invD_O.invDlst.Count - 1; i >= 0; i--)
        {
            var item = _invD_O.invDlst[i];
            item.Item_DeletedFlage = 1;
            item.Item_ProcessedFlage = 1;
            _invD_O.invDlst_Deleted.Add(item);
            _invD_O.invDlst.RemoveAt(i);
        }
        RecomputeTotals();
        _deletingInvoice = true;
        _isSaving = true;
        StateHasChanged();
        try { await SaveInvoiceCoreAsync(); }
        finally { _isSaving = false; _deletingInvoice = false; }
    }
    private bool CanSave => !_isSaving && !_isSaved && _lines.Count > 0 && (!IsExistingInvoice || Fingerprint() != _baseline)
                            && _repLinkedShiftId is null && (RepQuery is not > 0 || _repCtx?.CanSell == true);

    // بصمة نصية لكل ما يمكن للمستخدم تعديله فى الفاتورة (العميل، العملة، التاريخ، الملاحظات، الضريبة، والأصناف بكمياتها وأسعارها وحذفها).
    private string Fingerprint()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(_selectedCustomer?.Id).Append('|').Append(_currencyId).Append('|').Append(_invoiceDate?.Date.Ticks).Append('|').Append(_notes)
          .Append('|').Append(_isTaxInvoice).Append(_isTaxPerItem).Append('|').Append(_defaultTaxSales).Append('|').Append(_defaultATS05)
          .Append('|').Append(_header.PolicaNo).Append('|').Append(_header.troodContainerNo).Append('|').Append(_header.AnotherPayment).Append('|').Append(_header.List_CommissionRate)
          .Append('|').Append(_header.List_CommissionValue).Append('|').Append(_header.Shipment_Value).Append('|').Append(_dueDate?.Date.Ticks).Append('|').Append(_seller?.Id)
          .Append('|').Append(_header.Customer_Notes).Append('|').Append(_salesman?.Id).Append('|').Append(_shipmentCompany?.Id);
        foreach (var l in _invD_O.invDlst)
        {
            sb.Append('#').Append(l.Id).Append(',').Append(l.Item_DeletedFlage).Append(',').Append(l.Unit_Item_Table_Id).Append(',')
              .Append(l.Larg_Qnty).Append(',').Append(l.Small_Qnty).Append(',').Append(l.PriceUnit).Append(',').Append(l.Store_Id);
        }
        sb.Append("D").Append(_invD_O.invDlst_Deleted.Count);
        return sb.ToString();
    }
