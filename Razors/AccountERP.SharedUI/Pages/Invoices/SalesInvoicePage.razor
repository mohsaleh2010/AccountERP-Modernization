        RegisterAssistContext();
    }

    private async Task SaveInvoiceCoreAsync()
    {
        if (_selectedCustomer is null)
        {
            Snackbar.Add(Tr("CustomerRequiredError"), Severity.Warning);
            return;
        }
        // يقابل Make_Invoices.Validation: مع تفعيل ShowSalesMan اختيار المندوب إلزامى.
        if (Common.ShowSalesMan == 1 && _salesman is null)
        {
            Snackbar.Add(Tr("SalesmanRequiredError"), Severity.Warning);
            return;
        }

        _header.Customer_Id = _selectedCustomer.Id;
        _header.CustomerName = _selectedCustomer.Name;
        _header.SubAccount_Name = _selectedCustomer.Name;
        // 🟢 يقابل NewFrmInvoive سطر 2856: الحساب الفرعى للعميل يُحفظ على رأس الفاتورة. استعلام قيد الفاتورة
        // (Get_EntryForInvoices) يربط Invoices_List.SubAccount_Id بـ Submain_Account، فبدونه لا يُنشأ قيد أبداً
        // حتى مع تفعيل IS_Make_AutomaticFromTar7eel_For_Invoice (اكتُشف فى المرحلة 1 من خطة الفواتير).
        var customerIdForAccount = _selectedCustomer.Id;
        _header.SubAccount_Id = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var dtSub = new AccountModelsLib.operations().return_DataTable("select SubAccount_Id from Customer where Id=" + customerIdForAccount);
            return dtSub.Rows.Count > 0 && long.TryParse(dtSub.Rows[0][0]?.ToString(), out var subId) ? subId : 0L;
        });
        _header.Currency_id = _currencyId;
        _header.Currency = _currencies.FirstOrDefault(c => c.Id == _currencyId)?.Name ?? "";
        _header.Invoice_Date = _invoiceDate ?? DateTime.Now;
        _header.Invoice_DateTime = DateTime.Now;
        _header.Notes = _notes;
        _header.User_Id = Common.User_Id;
        _header.Branch_Id = Common.Branch_Id;
        // يقابل Get_MakeInvoiceListData: تاريخ الإدخال يُكتب صراحةً (عمود القاعدة له افتراضى getdate() لكن EF يرسل NULL فيبقى فارغاً).
        if (!(Id.HasValue && Id.Value > 0))
        {
            _header.Insert_ServerDateTime = DateTime.Now;
            // قيم الويندوز الافتراضية لحقول الرأس غير المبنية بعد فى Razor (NewFrmInvoive سطور 1800 و1835 و2284: بوليصة/حاوية "0"،
            // تاريخ الاستحقاق = الآن، والباقى صفر/فارغ) كى تُحفظ الفاتورة بنفس القيم بدل NULL.
            _header.InvoiceDueDate = DateTime.Now;
            if (string.IsNullOrEmpty(_header.PolicaNo)) _header.PolicaNo = "0";
            if (string.IsNullOrEmpty(_header.troodContainerNo)) _header.troodContainerNo = "0";
            _header.Customer_Notes ??= "";
            _header.Emp_Name ??= "";
            _header.ShipmentCompany_Name ??= "";
            _header.Emp_Id ??= 0;
            _header.ShipmentCompany_Id ??= 0;
            _header.Shipment_Value ??= 0;
            _header.AnotherPayment ??= 0;
            _header.Salesman_Id ??= 0;
        }
        // تاريخ الاستحقاق: يُحفظ من الحقل عند إتاحته للمستخدم (صلاحية 957)، وإلا يبقى الافتراضى/المحفوظ.
        if (_showDueDate && _dueDate.HasValue) _header.InvoiceDueDate = _dueDate;
        _header.CustomerAccountBefor = _customerAccountBefore;
        // 🟢 يقابل NewFrmInvoive سطر 3381: المرتجع يُنقص رصيد العميل والبيع يزيده.
        _header.CustomerAccountAfter = _isReverse
            ? _customerAccountBefore - (_header.Net_Total ?? 0)
            : _customerAccountBefore + (_header.Net_Total ?? 0);
        // 🟢 يقابل Get_MakeInvoiceListData(Common.Invoice_Type_Id | Common.InvoiceReverse_Type_Id).
        _invL_O.Invoice_Type_Id = _isReverse ? Common.InvoiceReverse_Type_Id : Common.Invoice_Type_Id;
        // يقابل Get_MakeInvoiceListData: علما الضريبة يُحفظان صراحةً (IsInvoiceTaxInfo + Is_Tax_Per_Item).
        _header.IsInvoiceTaxInfo = _isTaxInvoice ? 1 : 0;
        _header.Is_Tax_Per_Item = _isTaxPerItem ? 1 : 0;
        // الأصل يحفظ IS_Posted_Flage=0 (غير مُرحَّل) وقراءات الترحيل تشترط = 0؛ كانت الصفحة تحفظها NULL فتُفلت الفاتورة من الترحيل (نفس عيب المشتريات).
        _header.IS_Posted_Flage ??= 0;
        InvoiceLineCalculator.ZeroNullNumerics(_header);

        var excp = 0;
        var msg = "";
        // 🟢 محرك الحفظ الأصلى يبتلع الاستثناءات داخلياً (Insert_Invoices_List تحتفظ بالرسالة فى متغير محلى وتُسقطها)
        // فيعود excp=1 برسالة فارغة. نلتقط هنا آخر استثناء SQL/EF أثناء الاستدعاء فقط (من جهة Razor، بدون لمس
        // كود المحرك) لعرض السبب الحقيقى للمستخدم بدل رسالة عامة.
        string? swallowed = null;
        EventHandler<System.Runtime.ExceptionServices.FirstChanceExceptionEventArgs> handler = (_, e) =>
        {
            var name = e.Exception.GetType().Name;
            if (name.Contains("Sql") || name.Contains("DbUpdate") || name.Contains("Invalid") || name.Contains("Null"))
            {
                swallowed = e.Exception.Message;
                var frames = string.Join(" <- ", Environment.StackTrace.Split('\n').Skip(3).Take(8).Select(s => s.Trim()));
                Console.Error.WriteLine($"[SalesInvoice.Save] {e.Exception.GetType().FullName}: {e.Exception.Message} @ {frames}");
            }
        };
        try
        {
            AppDomain.CurrentDomain.FirstChanceException += handler;
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                // مركز التكلفة يُمرَّر للخيط نفسه؛ يستهلكه قيد الفاتورة (InvoiceCostCenter.Apply) ويُمسح هنا لو فشل الحفظ قبله.
                AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.SetPending(_costCenterId);
                try
                {
                if (_isReverse)
                {
                    // محرك المرتجع المستقل (Requests_Cls) - يقابل EditFRM_Invoices_Reverse سطر 586/603.
                    var rr = new Requests_Cls();
                    if (Id.HasValue && Id.Value > 0)
                    {
                        rr.Edit_InvoiceReverse_Update_CustomerAccount(ref excp, ref msg, _invL_O, _invD_O);
                    }
                    else
                    {
                        rr.Make_Invoice_Reverse_Update_CustomerAccount(ref excp, _invL_O, _invD_O);
                    }
                    return;
                }
                if (IsRepMode)
                {
                    // خطة المندوبين المرحلة 3: نفس محرك الحفظ داخل معاملة واحدة مع فحوص المندوب وربط الوردية.
                    new AccountModelsLib.SalesRep.SalesRepSaleService().SaveSale(RepQuery!.Value, _repDocGuid, _invL_O, _invD_O,
                        paymentMethodId: _header.Is_Invoice_Agile == 1 ? 0 : _repMethodId);
                    return;
                }
                var rc = new Requests_ModelCls();
                if (Id.HasValue && Id.Value > 0)
                {
                    rc.Edit_Invoice_Update_CustomerAccount(ref excp, _invL_O, _invD_O);
                }
                else
                {
                    rc.Make_Invoice_Update_CustomerAccount(ref excp, ref msg, _invL_O, _invD_O);
                }
                }
                finally { AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.ClearPending(); }
            });
        }
        catch (AccountModelsLib.SalesRep.SalesRepApprovalRequiredException ex)
        {
            // البيع يحتاج موافقة: تظهر المخالفات فى بطاقة المندوب مع زر طلب الموافقة.
            _repViolations = ex.Violations.ToList();
            Snackbar.Add(Tr("FSVApprovalsNeeded"), Severity.Warning);
            return;
        }
        catch (Exception ex)
        {
            // 🟢 يقابل أسلوب معالجة الأخطاء المعتمد فى المشروع (try/catch + عرض رسالة للمستخدم) - بدون هذه
            // الكتلة، أى استثناء غير متوقع من محرك الحفظ القديم كان يُسقط دائرة Blazor Server بالكامل (اكتُشف
            // حياً: قطع اتصال WebSocket بعد الضغط على "حفظ الفاتورة" مباشرة قبل إضافة هذه المعالجة).
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            AppDomain.CurrentDomain.FirstChanceException -= handler;
        }

        if (excp == 0)
        {
            if (_deletingInvoice)
            {
                Snackbar.Add(Tr("InvDeletedMessage"), Severity.Success);
                Nav.NavigateTo(_isReverse ? "/accounts/invoices/list?return=1" : "/accounts/invoices/list");
                return;
            }
            if (!_quietSave) Snackbar.Add(Tr("InvoiceSavedMessage"), Severity.Success);
            await LinkOrderAfterSaveAsync();
            if (IsExistingInvoice)
            {
                await ReloadSavedInvoiceAsync();
            }
            else
            {
                if (_aiDraftId > 0)
                {
                    await AiDraftPageHelper.MarkConsumedAsync(_aiDraftId, _header.Id, Convert.ToString(_header.Invoice_Id, CultureInfo.InvariantCulture) ?? "");
                    _aiDraftId = 0;
                    _aiDraft = null;
                }
                _isSaved = true;
                var oldRelative = Nav.ToBaseRelativePath(Nav.Uri);
                var savedUrl = $"/accounts/invoices/{(_isReverse ? "sales-return" : "sales-invoice")}/{_header.Id}";
                // وضع «حفظ الأصناف» يستمر بعد إنشاء الفاتورة: يبقى المعامل فى رابط الفاتورة المحفوظة فيُكمَل الحفظ عند كل تعديل تالٍ.
                if (_isSaveDirectly) savedUrl += "?saveDirectly=1";
                Nav.NavigateTo(savedUrl, replace: true);
                CloseStaleNewInvoiceTab(oldRelative);
            }
        }
        else
        {
            var detail = string.IsNullOrEmpty(msg) ? swallowed : msg;
            Snackbar.Add(string.IsNullOrEmpty(detail) ? Tr("InvoiceSaveError") : $"{Tr("InvoiceSaveError")}: {detail}", Severity.Error);
        }
    }

    // ===================== تحويل طلبية عميل إلى هذه الفاتورة =====================

    // يعبّئ فاتورة جديدة من طلبية مؤكدة: العميل (مقفل) + سطر لكل كمية مختارة بسعر الطلبية (قابل للتعديل) وبنفس قيم السطر الافتراضية
    // التى يضبطها حوار الصنف (AddInvoiceItemDialog.OnItemPickedAsync) حتى يقبلها محرك الحفظ القديم.
    private async Task LoadFromOrderAsync(long orderId, string alloc)
    {
        try
        {
            var service = new CustomerOrdersService();
            var loaded = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); service.SyncOrder(orderId); return service.GetOrder(orderId); });
            if (loaded is null) { Snackbar.Add(Tr("COOrderNotFound"), Severity.Error); return; }
            var (order, orderLines) = loaded.Value;
            if (!CustomerOrdersService.CanFulfill(order)) { Snackbar.Add(Tr("COConvertNotOpen"), Severity.Warning); return; }

            var requested = new Dictionary<long, (decimal L, decimal S)>();
            foreach (var part in alloc.Split(';', StringSplitOptions.RemoveEmptyEntries))
            {
                var p = part.Split(':');
                if (p.Length == 3 && long.TryParse(p[0], out var lid)
                    && decimal.TryParse(p[1], NumberStyles.Number, CultureInfo.InvariantCulture, out var l)
                    && decimal.TryParse(p[2], NumberStyles.Number, CultureInfo.InvariantCulture, out var sm))
                    requested[lid] = (l, sm);
            }

            _fromOrderId = orderId;
            _fromOrderNo = order.Order_No ?? 0;
            var customerId = order.Customer_Id ?? 0;
            var customerName = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var dt = new AccountModelsLib.operations().return_DataTable("SELECT Name FROM Customer WHERE Id = " + customerId);
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString()?.Trim() ?? "" : "";
            });
            await OnCustomerPickedAsync(new CustomerOption(customerId, customerName), skipCashCustomerConfirm: true);
            _customerLocked = true;
            if (order.Currency_Id is > 0) _currencyId = order.Currency_Id.Value;
            if (!string.IsNullOrWhiteSpace(order.Notes) && string.IsNullOrWhiteSpace(_notes)) _notes = order.Notes!;

            var picked = new List<(CustomerOrderLine Line, decimal L, decimal S)>();
            foreach (var ol in orderLines)
            {
                var remL = CustomerOrdersService.RemainingLarg(ol);
                var remS = CustomerOrdersService.RemainingSmall(ol);
                var q = requested.Count == 0 ? (L: remL, S: remS) : requested.TryGetValue(ol.Id, out var rq) ? rq : (L: 0m, S: 0m);
                var takeL = Math.Min(q.L, remL);
                var takeS = Math.Min(q.S, remS);
                if (takeL > 0 || takeS > 0) picked.Add((ol, takeL, takeS));
            }
            if (picked.Count == 0) { Snackbar.Add(Tr("COConvertNothing"), Severity.Warning); return; }

            var ids = string.Join(",", picked.Select(x => x.Line.Unit_Item_Table_Id ?? 0).Distinct());
            var items = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return new AccountModelsLib.operations().return_DataTable(
                    "SELECT Unit_item.Id, Unit_item.Item_id, Item.Item_Name, Item.code, Unit_item.Full_qua, Unit_item.D_Qua, " +
                    "unit.B_Unit, unit.S_unit, unit.S_unit_Value, Unit_item.Store_id, Store.Store_Name " +
                    "FROM Unit_item INNER JOIN unit ON Unit_item.unit_id = unit.id INNER JOIN Item ON Unit_item.Item_id = Item.id " +
                    "INNER JOIN Store ON Unit_item.Store_id = Store.id WHERE Unit_item.Id IN (" + ids + ")");
            });
            var perItemTax = _isTaxInvoice && _isTaxPerItem;
            foreach (var x in picked)
            {
                var r = items.Rows.Cast<DataRow>().FirstOrDefault(row => Convert.ToInt64(row["Id"]) == (x.Line.Unit_Item_Table_Id ?? 0));
                if (r is null) continue;
                var unitSmallValue = r["S_unit_Value"] == DBNull.Value ? 1m : Convert.ToDecimal(r["S_unit_Value"]);
                if (unitSmallValue == 0) unitSmallValue = 1;
                var price = x.Line.Unit_Price ?? 0;
                var line = new IInvoices_Details
                {
                    Item_Id = Convert.ToInt64(r["Item_id"]),
                    Unit_Item_Table_Id = x.Line.Unit_Item_Table_Id,
                    Invoice_Item_Name = r["Item_Name"]?.ToString() ?? "",
                    code = r["code"]?.ToString() ?? "",
                    Store_Id = Convert.ToInt64(r["Store_id"]),
                    Store_Name = r["Store_Name"]?.ToString() ?? "",
                    Available_Larg_Balance = Convert.ToDecimal(r["Full_qua"]),
                    Available_Small_Balance = Convert.ToDecimal(r["D_Qua"]),
                    UnitStr = r["B_Unit"]?.ToString() ?? "",
                    UnitSmallStr = r["S_unit"]?.ToString() ?? "",
                    Unit_Used_for_Price = 1,
                    Make_Order = 0,
                    Unit_Item_ExpireDate_Id = 0,
                    Bills_Details_Id = 0,
                    Item_Expire_Date = DateTime.Now.Date,
                    Tash3ela = "",
                    StatementNo = "",
                    OperationNo = "",
                    Merchant_Name = "",
                    Item_TaxSales10 = perItemTax ? _defaultTaxSales : 0,
                    Item_ATS05 = perItemTax ? _defaultATS05 : 0,
                    Larg_Qnty = x.L,
                    Small_Qnty = x.S,
                    PriceUnit = price,
                    Larg_Unit_Price = price,
                    Item_DeletedFlage = 0,
                    Item_ProcessedFlage = 0
                };
                InvoiceLineCalculator.ComputeLine(line, unitSmallValue);
                _invD_O.invDlst.Add(line);
                _orderAllocations.Add(new CustomerOrdersService.Allocation(x.Line.Id, x.L, x.S));
            }
            RecomputeTotals();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ===================== 🤖 P5: مسودة من المساعد الذكى =====================

    // يعبّئ فاتورة جديدة من AI_Drafts بنفس قيم السطر الافتراضية التى يضبطها حوار الصنف (AddInvoiceItemDialog.OnItemPickedAsync) وبنفس
    // ترتيب أسعاره: سعر المسودة إن ذكره المستخدم، وإلا سعر العميل الخاص (PriceListService)، وإلا سعر الصنف فى المخزن. الضريبة من إعداد الشاشة
    // (أو علم الفاتورة الضريبية فى المسودة عبر ApplyTaxSettings نفسها). البنود غير المطابقة لا تُضاف؛ تظهر فى الشريط ليختارها المستخدم.
    private async Task LoadFromAiDraftAsync(long draftId)
    {
        try
        {
            var res = await AiDraftPageHelper.LoadAsync(draftId, AiDraftKind.Sales);
            if (res.AlreadyUsed)
            {
                Snackbar.Add(string.Format(CultureInfo.InvariantCulture, Tr("AID_AlreadyUsed"), res.Row?.Target_Doc_No ?? ""), Severity.Info);
                if (res.Row?.Target_Doc_Id is long docId and > 0) Nav.NavigateTo($"/accounts/invoices/sales-invoice/{docId}", replace: true);
                return;
            }
            if (res.ErrorKey is not null || res.Payload is null) { Snackbar.Add(Tr(res.ErrorKey ?? "AID_NotFound"), Severity.Warning); return; }
            var p = res.Payload;
            _aiDraftId = draftId;
            _aiDraft = p;

            await OnCustomerPickedAsync(new CustomerOption(p.PartyId, p.PartyName), skipCashCustomerConfirm: true);
            _customerLocked = false;
            if (p.Date is DateTime d) _invoiceDate = d.Date + DateTime.Now.TimeOfDay;
            if (!string.IsNullOrWhiteSpace(p.Notes) && string.IsNullOrWhiteSpace(_notes)) _notes = p.Notes!;
            if (p.TaxInvoice is bool tax && tax != _isTaxInvoice) { _isTaxInvoice = tax; ApplyTaxSettings(); }

            var stock = await AiDraftPageHelper.StockAsync(p.Lines.Select(l => l.UnitItemId));
            var perItemTax = _isTaxInvoice && _isTaxPerItem;
            var priceSvc = new AccountModelsLib.PriceListService();
            foreach (var dl in p.Lines)
            {
                var r = stock.FirstOrDefault(x => x.UnitItemId == dl.UnitItemId);
                if (r is null || !r.ItemActive) { _aiDraftExtra.Add(string.Format(CultureInfo.InvariantCulture, Tr("AID_LineGone"), dl.ItemName)); continue; }
                decimal price = dl.Price ?? 0;
                if (dl.Price is null)
                {
                    long cust = p.PartyId, item = r.ItemId, store = r.StoreId;
                    decimal? custPrice = await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); return priceSvc.GetCustomerPrice(cust, item, store); });
                    price = custPrice ?? r.SalePrice;
                }
                var line = new IInvoices_Details
                {
                    Item_Id = r.ItemId,
                    Unit_Item_Table_Id = r.UnitItemId,
                    Invoice_Item_Name = r.ItemName,
                    code = r.Code,
                    Store_Id = r.StoreId,
                    Store_Name = r.StoreName,
                    Available_Larg_Balance = r.FullQua,
                    Available_Small_Balance = r.DQua,
                    UnitStr = r.BUnit,
                    UnitSmallStr = r.SUnit,
                    Unit_Used_for_Price = 1,
                    Make_Order = 0,
                    Unit_Item_ExpireDate_Id = 0,
                    Bills_Details_Id = 0,
                    Item_Expire_Date = DateTime.Now.Date,
                    Tash3ela = "",
                    StatementNo = "",
                    OperationNo = "",
                    Merchant_Name = "",
                    Item_TaxSales10 = perItemTax ? _defaultTaxSales : 0,
                    Item_ATS05 = perItemTax ? _defaultATS05 : 0,
                    Larg_Qnty = dl.QtyLarge,
                    Small_Qnty = dl.QtySmall,
                    PriceUnit = price,
                    Larg_Unit_Price = price,
                    Item_DeletedFlage = 0,
                    Item_ProcessedFlage = 0
                };
                if (price <= 0) _aiDraftExtra.Add(string.Format(CultureInfo.InvariantCulture, Tr("AID_NoPrice"), r.ItemName));
                InvoiceLineCalculator.ComputeLine(line, r.SmallPerLarge);
                _invD_O.invDlst.Add(line);
            }
            RecomputeTotals();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DiscardAiDraftAsync()
    {
        var ok = await DialogService.ShowMessageBoxAsync(Tr("AID_Discard"), Tr("AID_DiscardConfirm"), yesText: Tr("AID_Discard"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        try { await AiDraftPageHelper.DiscardAsync(_aiDraftId); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); return; }
        await ResetToNewInvoiceAsync();
        Snackbar.Add(Tr("AID_DiscardedDone"), Severity.Info);
        Nav.NavigateTo(NewInvoiceUrl(), replace: true);
    }

    // بعد نجاح حفظ الفاتورة: فاتورة جديدة من طلبية → تسجيل الربط؛ فاتورة موجودة → مطابقة روابطها مع كمياتها الجديدة (يُرجع المحذوف للطلبية).
    private async Task LinkOrderAfterSaveAsync()
    {
        if (_isReverse) return;
        try
        {
            var invoiceId = _header.Id;
            if (invoiceId <= 0) return;
            var service = new CustomerOrdersService();
            if (!IsExistingInvoice && _fromOrderId > 0 && _orderAllocations.Count > 0)
            {
                var orderId = _fromOrderId;
                var allocations = _orderAllocations.ToList();
                await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); service.RecordFulfillments(orderId, invoiceId, allocations); });
                Snackbar.Add(string.Format(CultureInfo.InvariantCulture, Tr("COInvoiceLinked"), _fromOrderNo), Severity.Info);
                _orderAllocations.Clear();
            }
            else if (IsExistingInvoice)
            {
                await Task.Run(() => { AccountCultureGuard.EnsureInvariant(); service.SyncInvoice(invoiceId); });
            }
        }
        catch (Exception ex)
        {
            // الفاتورة نفسها حُفظت؛ فشل الربط فقط، فيُعرض بوضوح ولا يُسقط الشاشة.
            Snackbar.Add($"{Tr("COInvoiceLinkError")}: {ex.Message}", Severity.Error);
        }
    }

    private string Tr(string key)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
