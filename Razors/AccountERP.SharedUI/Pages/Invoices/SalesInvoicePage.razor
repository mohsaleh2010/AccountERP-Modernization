    protected override async Task OnInitializedAsync()
    {
        LoadInvoicePermissions();
        _isAgile = AgileQuery == 1;
        _isKta3y = Kta3yQuery == 1;
        _isSaveDirectly = SaveDirectlyQuery == 1;
        // 🟢 يقابل Common.IsShowInvoices_List_WithDueDate (صلاحية القائمة 957) من قوائم المستخدم الحالى.
        _showDueDate = MenuState.UserAllowedMenus.Any(m => m.Menu_ID == 957);
        _isReverse = Nav.Uri.Contains("/sales-return", StringComparison.OrdinalIgnoreCase);
        // 🟢 يقابل new InvoicesOperationListCLS(1)/InvoicesOperationCLS(1) فى Make_Invoices_Reverse (Invoices_List_Reverse).
        _invL_O = new InvoicesOperationListCLS(_isReverse ? 1 : 0);
        _invD_O = new InvoicesOperationCLS(_isReverse ? 1 : 0);

        await LoadCurrenciesAsync();
        await LoadTaxDefaultsAsync();

        if (Id.HasValue && Id.Value > 0)
        {
            await LoadExistingInvoiceAsync(Id.Value);
            _baseline = Fingerprint();
            RegisterAssistContext();
        }
        else
        {
            await InitializeNewInvoiceAsync();
            if (FromOrderQuery is > 0) await LoadFromOrderAsync(FromOrderQuery.Value, AllocQuery ?? "");
            else if (AiDraftQuery is > 0 && !_isReverse) await LoadFromAiDraftAsync(AiDraftQuery.Value);
        }
        await InitRepModeAsync();

        // 🟢 عنوان التبويب لفاتورة موجودة = "فاتورة مبيعات رقم {رقم الفاتورة}" (Invoice_Id) وليس معرّف السجل Id الذى فى الرابط.
        // مفتاح التبويب = مسار الصفحة وقت إنشائها بلا الـ query (نفس ما يبنيه MainLayoutMud.UpdateWorkspaceForCurrentRoute).
        if (Id.HasValue && Id.Value > 0 && _header.Invoice_Id.HasValue)
        {
            var tabKey = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
            var format = _isReverse ? Tr("InvoiceTabReturn") : Tr("InvoiceTabSales");
            TabWorkspace.SetCustomTitle(tabKey, string.Format(CultureInfo.InvariantCulture, format, _header.Invoice_Id.Value));
        }

        var isQaa = Convert.ToInt32(_header.Invoice_Type) == 1;
        _pageTitle = _isReverse
            ? (_header.Is_InvoiceKta3y == 1 ? Tr("InvoiceTitleReturnKta3y") : isQaa ? Tr("InvoiceTitleReturnCash") : Tr("InvoiceTitleReturn"))
            : isQaa ? Tr("InvoiceTitleQaa")
            : _isSaveDirectly ? Tr("InvoiceTitleSaveDirectly")
            : _header.Is_InvoiceKta3y == 1 ? Tr("InvoiceTitleKta3y")
            : _header.Is_Invoice_Agile == 1 ? Tr("InvoiceTitleAgile")
            : Tr("InvoiceTitleCash");

        // 🟢 يقابل NewFrmInvoive.GetInvoiceName: العنوان المخصص من إعدادات الشركة (Invoice_MainTitle_Invoice / _Reverse) إن لم يكن فارغاً،
        // ويُلحق به «- حفظ الأصناف -» فى وضع حفظ الأصناف.
        var customTitle = (_isReverse ? Common.Invoice_MainTitle_Invoice_Reverse : Common.Invoice_MainTitle_Invoice)?.Trim();
        if (!string.IsNullOrEmpty(customTitle))
        {
            _pageTitle = _isSaveDirectly ? $"{customTitle}  {Tr("SaveItemsModeSuffix")}" : customTitle;
        }
    }

    private async Task LoadCurrenciesAsync()
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return new CurrencyFactorsCLS_().GetCurrencyList();
        });
        _currencies = dt.Rows.Cast<DataRow>()
            .Select(r => new CurrencyOption(Convert.ToInt64(r["ID"]), r["Currency_Name"]?.ToString() ?? ""))
            .ToList();
        if (_currencies.Count > 0) _currencyId = _currencies[0].Id;
    }

    private async Task InitializeNewInvoiceAsync()
    {
        // 🟢 Invoice_Type علم قديم يجرى التخلص منه (بتوجيه المستخدم): لا يُعامَل كنوع ضريبى/غير ضريبى، ويبقى فقط رقم سلسلة
        // الترقيم الذى تتطلبه Make_New_Invoice_No/ReverseNo (الافتراضى 0). نقدى/آجل = Is_Invoice_Agile؛ الضريبة = IsInvoiceTaxInfo.
        var invoiceType = TypeQuery ?? 0;
        _header.Invoice_Type = invoiceType;
        _header.Is_Invoice_Agile = _isAgile ? 1 : 0;
        _header.Is_InvoiceKta3y = _isKta3y ? 1 : 0;
        _header.IS_Make_Sarf_Item_BalanceFromInvoice = _isKta3y ? 0 : 1;
        ApplyTaxSettings();

        var invoiceNo = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var inv = new InvoicesClss();
            return _isReverse ? inv.Make_New_Invoice_ReverseNo(invoiceType) : inv.Make_New_Invoice_No(invoiceType);
        });
        _header.Invoice_Id = invoiceNo;
        _invoiceNoDisplay = invoiceNo.ToString();
        await ApplyDefaultCustomerAsync();
    }

    // 🟢 يقابل NewFrmInvoive.SetConfigOnMonitor: عميل الفاتورة النقدية التلقائى (Customer_Id_ForInvoiceNakdy، ويُقفل الاختيار إذا
    // Customer_Id_ForInvoiceNakdyThenDisableCombo > 0) ثم العميل الافتراضى (Customer_Id_DefaultSelect) الذى يغلب عليه. القيمتان -1 = معطَّل.
    private bool _customerLocked;

    private async Task ApplyDefaultCustomerAsync()
    {
        _customerLocked = false;
        long customerId = 0;
        if (_header.Is_Invoice_Agile == 0 && Common.Customer_Id_ForInvoiceNakdy > 0)
        {
            customerId = Common.Customer_Id_ForInvoiceNakdy;
            _customerLocked = Common.Customer_Id_ForInvoiceNakdyThenDisableCombo > 0;
        }
        if (Common.Customer_Id_DefaultSelect > 0) customerId = Common.Customer_Id_DefaultSelect;
        if (customerId <= 0) return;

        var name = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var dt = _customerCls.Get_CustomerSupplierListForStatement(0, 0, -1, -1);
            return dt.Rows.Cast<DataRow>().Where(r => Convert.ToInt64(r["Id"]) == customerId)
                .Select(r => r["Name"]?.ToString()?.Trim() ?? "").FirstOrDefault();
        });
        if (name is null) { _customerLocked = false; return; }
        await OnCustomerPickedAsync(new CustomerOption(customerId, name), skipCashCustomerConfirm: true);
    }

    private async Task LoadExistingInvoiceAsync(long invoiceListTableId)
    {
        await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            if (_isReverse)
            {
                // يقابل EditFRM_Invoices_Reverse سطر 265-266.
                _invL_O.Get_Invoices_List_Reverse(invoiceListTableId);
                _invD_O.GetInvoiceDetails_Reverse(invoiceListTableId);
            }
            else
            {
                _invL_O.Get_Invoices_List(invoiceListTableId);
                _invD_O.GetInvoiceDetailsToEdit(invoiceListTableId);
            }
        });

        // 🟢 أعلام أسطر المعالجة: أسطر المرتجع تُخزَّن فى القاعدة بعلم 0 (بينما البيع 100)، والمحرك يعتبر 0 = "سطر جديد" فيعيد
        // إدراج كل سطر غير معدَّل ويعيد ترحيل رصيده عند إضافة/حذف سطر (اكتشفه اختبار السيناريوهات R-POST-05/06). نُطبِّعها
        // هنا: 100 = "محفوظ بلا تغيير"، فلا يعالج المحرك إلا الأسطر التى نعدّلها صراحةً.
        foreach (var l in _invD_O.invDlst)
        {
            l.Item_ProcessedFlage = 100;
            l.Item_DeletedFlage = 100;
        }
        _invoiceNoDisplay = _header.Invoice_Id?.ToString() ?? "";
        _invoiceDate = _header.Invoice_Date;
        _notes = _header.Notes ?? "";
        _costCenterId = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.GetHeaderCenter(new AccountModelsLib.operations(),
                _isReverse ? AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.Table_SalesReturn : AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.Table_Sales, invoiceListTableId);
        });
        _dueDate = _header.InvoiceDueDate ?? _invoiceDate;
        _seller = (_header.Emp_Id ?? 0) > 0 ? new SellerOption(_header.Emp_Id!.Value, _header.Emp_Name ?? "") : null;
        _shipmentCompany = (_header.ShipmentCompany_Id ?? 0) > 0 ? new SellerOption(_header.ShipmentCompany_Id!.Value, _header.ShipmentCompany_Name ?? "") : null;
        _salesman = null;
        if ((_header.Salesman_Id ?? 0) > 0)
        {
            // اسم المندوب لا يُخزَّن على الفاتورة؛ يُقرأ من قائمة المناديب (كل الموظفين لو لم يعد فعّالاً).
            var salesmanId = _header.Salesman_Id!.Value;
            var name = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var dt = _lookups.GetSellers();
                return dt.Rows.Cast<DataRow>().Where(r => Convert.ToInt64(r["Id"]) == salesmanId).Select(r => r["Name"]?.ToString()?.Trim() ?? "").FirstOrDefault() ?? "";
            });
            _salesman = new SellerOption(salesmanId, name);
        }
        _currencyId = _header.Currency_id ?? _currencyId;
        if (_header.Customer_Id is > 0)
        {
            _selectedCustomer = new CustomerOption(_header.Customer_Id.Value, _header.CustomerName ?? _header.SubAccount_Name ?? "");
            await LoadCustomerPriceTypeAsync(_header.Customer_Id.Value);
        }
        _customerAccountBefore = _header.CustomerAccountBefor ?? 0;
        // نقرأ علمى الضريبة المحفوظين كما هما (لا نعيد تطبيق النسب الافتراضية على فاتورة موجودة).
        _isTaxInvoice = _header.IsInvoiceTaxInfo == 1;
        _isTaxPerItem = _taxPerItemForced || _header.Is_Tax_Per_Item == 1;
        UpdateBalanceLabel();
    }

    private async Task<IEnumerable<CustomerOption>> SearchCustomersAsync(string search, CancellationToken ct)
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return _customerCls.Get_CustomerSupplierListForStatement(0, 0, -1, -1);
        }, ct);
        var list = new List<CustomerOption>();
        foreach (DataRow r in dt.Rows)
        {
            var name = r["Name"]?.ToString()?.Trim() ?? "";
            if (string.IsNullOrEmpty(search) || name.Contains(search, StringComparison.OrdinalIgnoreCase))
            {
                list.Add(new CustomerOption(Convert.ToInt64(r["Id"]), name));
            }
        }
        return list.Take(50);
    }

    // 🟢 يقابل NewFrmInvoive.SelectCustomer + GetCustomerAccountBefor بالضبط.
    // نوع سعر العميل واسمه من Customer.Price_Type_List_ID (يقابل NewFrmInvoive.SelectCustomer)؛ يُعرض فى بطاقة العميل ويُمرَّر لحوار الأصناف.
    private async Task LoadCustomerPriceTypeAsync(long customerId)
    {
        var result = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var dt = new AccountModelsLib.operations().return_DataTable(
                "SELECT ISNULL(c.Price_Type_List_ID, 0) AS TypeId, ISNULL(t.Price_Name, N'') AS TypeName FROM Customer c " +
                "LEFT JOIN Price_Type_List t ON t.ID = c.Price_Type_List_ID WHERE c.Id = " + customerId);
            return dt.Rows.Count > 0
                ? (Convert.ToInt64(dt.Rows[0]["TypeId"]), dt.Rows[0]["TypeName"]?.ToString()?.Trim() ?? "")
                : (0L, "");
        });
        _customerPriceTypeId = result.Item1;
        _customerPriceTypeName = result.Item2;
        // سلسلة السعر للمندوب (§6.3): قائمة العميل أولاً، وإلا قائمة المندوب الافتراضية.
        if (IsRepMode && _customerPriceTypeId == 0 && _repCtx?.Price_Type_List_ID is long repList && repList > 0)
        {
            _customerPriceTypeId = repList;
            _customerPriceTypeName = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var dt = new AccountModelsLib.operations().return_DataTable("SELECT ISNULL(Price_Name, N'') FROM Price_Type_List WHERE ID = " + repList);
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString()?.Trim() ?? "" : "";
            });
        }
    }

    private Task OnCustomerPickedAsync(CustomerOption? option) => OnCustomerPickedAsync(option, skipCashCustomerConfirm: false);

    private async Task OnCustomerPickedAsync(CustomerOption? option, bool skipCashCustomerConfirm)
    {
        // 🟢 يقابل NewFrmInvoive.SelectCustomer: فاتورة آجلة جديدة لعميل الفاتورة النقدية تحتاج تأكيداً، والرفض يمسح الاختيار.
        if (option is not null && !skipCashCustomerConfirm && !IsExistingInvoice && _header.Is_Invoice_Agile == 1
            && Common.Customer_Id_ForInvoiceNakdy > 0 && option.Id == Common.Customer_Id_ForInvoiceNakdy)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(Tr("CashCustomerCreditConfirmTitle"), Tr("CashCustomerCreditConfirm"),
                yesText: Tr("Yes"), cancelText: Tr("Cancel"));
            if (confirmed != true)
            {
                _selectedCustomer = null;
                _customerPriceTypeId = 0;
                _customerPriceTypeName = "";
                _balanceLabel = "";
                return;
            }
        }
        _selectedCustomer = option;
        if (option is null) { _customerPriceTypeId = 0; _customerPriceTypeName = ""; }
        else await LoadCustomerPriceTypeAsync(option.Id);
        if (option is null) return;

        var balance = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var balDt = _customerCls.GetCustomerBalance(option.Id);
            decimal bal = 0;
            if (balDt.Rows.Count > 0) decimal.TryParse(balDt.Rows[0]["Balance"]?.ToString(), out bal);
            return Common.RoundMe(bal);
        });

        _customerAccountBefore = balance;
        UpdateBalanceLabel();
    }

    private void UpdateBalanceLabel()
    {
        if (_selectedCustomer is null) { _balanceLabel = ""; return; }
        var rounded = Common.RoundMe(Math.Abs(_customerAccountBefore));
        var natureKey = _customerAccountBefore < 0 ? "NatureCreditLabel" : "NatureDebitLabel";
        _balanceLabel = $"{_selectedCustomer.Name} — {Tr(natureKey)}: {rounded:N2}";
    }

    // شارات الأعمدة الإضافية لسطر الفاتورة: لكل عمود مفعَّل بإعداداته (InvoiceColumnSettings) وقيمته غير صفرية/فارغة.
    private IEnumerable<(string Label, string Value)> ExtraChips(IInvoices_Details l)
    {
        static string N(decimal? v) => (v ?? 0).ToString("0.##");
        var list = new List<(string, string)>();
        void Add(bool on, string key, string value, bool show) { if (on && show) list.Add((Tr(key), value)); }
        void AddDec(bool on, string key, decimal? v) => Add(on, key, N(v), (v ?? 0) != 0);
        void AddTxt(bool on, string label, string? v) { if (on && !string.IsNullOrWhiteSpace(v)) list.Add((label, v!)); }

        AddDec(InvoiceColumnSettings.ItemNo, "ItemNoLabel", l.Qnty_Another);
        AddDec(InvoiceColumnSettings.ThreeMola, "Total3MolaLabel", l.Total3Mola);
        AddDec(InvoiceColumnSettings.ItemCommissionRate, "ItemCommissionRateLabel", l.Item_CommissionRate);
        AddDec(InvoiceColumnSettings.ItemCommissionValue, "ItemCommissionValueLabel", l.Item_CommissionValue);
        AddDec(InvoiceColumnSettings.UnitCommissionValue, "UnitCommissionLabel", l.Unit_CommissionValue);
        AddDec(InvoiceColumnSettings.ItemCommissionTotal, "ItemCommissionTotalLabel", l.ItemCommissionTotal);
        AddDec(InvoiceColumnSettings.AlternateItemCommissionRate, "AltItemCommissionRateLabel", l.Alternate_Item_CommissionRate);
        AddDec(InvoiceColumnSettings.AlternateItemCommissionValue, "AltItemCommissionValueLabel", l.Alternate_Item_CommissionValue);
        AddDec(InvoiceColumnSettings.AlternateUnitCommissionValue, "AltUnitCommissionLabel", l.Alternate_Unit_CommissionValue);
        AddDec(InvoiceColumnSettings.AlternateItemCommissionTotal, "AltItemCommissionTotalLabel", l.Alternate_ItemCommissionTotal);
        AddDec(InvoiceColumnSettings.NetItemCommission, "NetItemCommissionLabel", l.Net_Total_Item_Commission);
        AddDec(InvoiceColumnSettings.TaxSalesRate, "ItemTaxRateLabel", l.Item_TaxSales10);
        AddDec(InvoiceColumnSettings.TaxSalesValue, "ItemTaxValueLabel", l.Item_TaxSales10_Value);
        AddDec(InvoiceColumnSettings.ATS05Rate, "ItemATS05RateLabel", l.Item_ATS05);
        AddDec(InvoiceColumnSettings.ATS05Value, "ItemATS05ValueLabel", l.Item_ATS05_Value);
        AddTxt(InvoiceColumnSettings.StatementNo, InvoiceColumnSettings.StatementLabel(Tr("StatementNoLabel")), l.StatementNo);
        AddTxt(InvoiceColumnSettings.OperationNo, Tr("OperationNoLabel"), l.OperationNo);
        AddTxt(InvoiceColumnSettings.MerchantName, InvoiceColumnSettings.MerchantLabel(Tr("MerchantNameLabel")), l.Merchant_Name);
        AddTxt(InvoiceColumnSettings.Tash3ela, Tr("BatchLabel"), l.Tash3ela);
        AddDec(InvoiceColumnSettings.FreeQuantity, "FreeQuantityLabel", l.LargItemsQnty_Free);
        AddDec(InvoiceColumnSettings.FreeQuantity, "FreeSmallQuantityLabel", l.SmallItemsQnty_Free);
        AddDec(InvoiceColumnSettings.FreeItemNo, "FreeItemNoLabel", l.Item_No_Free);
        if (InvoiceColumnSettings.ExpireDate && l.Item_Expire_Date is { } d && d.Year > 1900) list.Add((Tr("ExpireDateLabel"), d.ToString("yyyy/MM/dd")));
        AddDec(InvoiceColumnSettings.TotalNoTax, "TotalNoTaxLabel", l.Item_Total_WithoutTax);
        AddDec(InvoiceColumnSettings.QntyValue, "QntyValueLabel", l.Qnty_value);
        return list;
    }

    private static string FormatQnty(IInvoices_Details line)
    {
        var largTxt = line.Larg_Qnty is > 0 ? $"{line.Larg_Qnty:0.##} {line.UnitStr}" : "";
        var smallTxt = line.Small_Qnty is > 0 ? $"{line.Small_Qnty:0.##} {line.UnitSmallStr}" : "";
        return string.Join(" ", new[] { largTxt, smallTxt }.Where(s => !string.IsNullOrEmpty(s)));
    }

