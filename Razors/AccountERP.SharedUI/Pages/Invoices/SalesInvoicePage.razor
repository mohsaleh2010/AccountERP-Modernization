    // بعد حفظ فاتورة جديدة تنتقل الصفحة لرابط رقمها (تبويب جديد)، فيبقى تبويب «فاتورة جديدة» القديم بحالة محفوظة/مقفلة ويُعاد تنشيطه بالخطأ
    // عند فتح فاتورة جديدة ثانية؛ نغلقه هنا (مفتاح التبويب = المسار + query عنصر القائمة).
    private void CloseStaleNewInvoiceTab(string relativeWithQuery)
    {
        var parts = relativeWithQuery.Split('?', 2);
        var key = "/" + parts[0].Trim('/');
        TabWorkspace.Close(key);
        if (parts.Length > 1 && parts[1].Length > 0) TabWorkspace.Close(key + "?" + parts[1]);
    }

    // 🟢 غلاف الحفظ: يمنع التكرار قبل أى await (المعالجات تعمل بالتتابع فالنقرة الثانية تجد _isSaving=true وتخرج فوراً).
    private async Task SaveInvoiceAsync()
    {
        if (_isSaving) return;
        _isSaving = true;
        StateHasChanged();
        try
        {
            await SaveInvoiceCoreAsync();
        }
        finally
        {
            _isSaving = false;
        }
    }

    // بعد حفظ تعديل فاتورة موجودة: إعادة تحميلها من القاعدة (أسطر بأرقامها الجديدة وأعلام المعالجة) وتجديد البصمة، فيبقى الزر معطَّلاً
    // حتى التعديل التالى. الفاتورة الجديدة تنتقل لرابط رقمها كما كان (نسخة صفحة جديدة بحالة محفوظة).
    private async Task ReloadSavedInvoiceAsync()
    {
        _invL_O = new InvoicesOperationListCLS(_isReverse ? 1 : 0);
        _invD_O = new InvoicesOperationCLS(_isReverse ? 1 : 0);
