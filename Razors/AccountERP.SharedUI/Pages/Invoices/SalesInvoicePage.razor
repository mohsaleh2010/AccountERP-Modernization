    // 🟢 يقابل ItemData.fillListView (استدعاء الأب لإضافة/تحديث السطر) - يميّز بين إضافة سطر جديد وتعديل سطر
    // موجود بالفعل عبر _editingLine (مضبوطة فى OpenEditItemDialog قبل فتح الحوار).
    private async Task OnItemDialogSaved(IInvoices_Details line)
    {
        if (_editingLine is null)
        {
            line.Item_DeletedFlage = 0;
            line.Item_ProcessedFlage = 0;
            _invD_O.invDlst.Add(line);
        }
        else
        {
            var index = _invD_O.invDlst.IndexOf(_editingLine);
            if (index >= 0)
            {
                if (_editingLine.Id > 0)
                {
                    // 🟢 اختبار الرصيد (Unit_Item.Full_Qua) كشف أن مسار "السطر المعدَّل" (Item_ProcessedFlage=-1) فى محرك التعديل
                    // القديم يطرح الكمية الجديدة كاملة من الرصيد دون إرجاع القديمة (القديمة تُستخدم فقط لجدول الصلاحية)، فتنقص
                    // مرتين (سلوك المحرك نفسه فى الديسك توب ولا يجوز لمسه). الحل من جهة Razor: تعديل سطر محفوظ = حذف القديم
                    // (المحرك يُرجع رصيده) + إضافة الجديد كسطر جديد (يطرح رصيده)، فيصح الرصيد فى الحالتين.
                    _editingLine.Item_DeletedFlage = 1;
                    _editingLine.Item_ProcessedFlage = 1;
                    _invD_O.invDlst_Deleted.Add(_editingLine);
                }
                line.Id = 0;
                line.Item_DeletedFlage = 0;
                line.Item_ProcessedFlage = 0;
                _invD_O.invDlst[index] = line;
            }
            _editingLine = line;
        }
        RecomputeTotals();
        await AutoSaveIfDirectAsync();
    }

    private async Task DeleteLine(IInvoices_Details line)
    {
        if (!GuardEditItems()) return;
        if (line.Id > 0)
        {
            line.Item_DeletedFlage = 1;
            line.Item_ProcessedFlage = 1;
            _invD_O.invDlst_Deleted.Add(line);
            _invD_O.invDlst.Remove(line);   // كما فى الأصل (EditFRM_Invoices_Reverse سطر 819-820): يُنقل لقائمة المحذوفات.
        }
        else
        {
            _invD_O.invDlst.Remove(line);
        }
        RecomputeTotals();
        await AutoSaveIfDirectAsync();
    }

    // 🟢 وضع «فاتورة جديدة - حفظ الأصناف» (Is_SaveOnDB_When_AddItemDirectly_On_invoice=1): يقابل Save_Add_Edit_Item الذى يُستدعى بعد كل إضافة/تعديل/حذف
    // صنف (AddNew_Item / EditNow / BtnDeleteItem_Click): تُحفَظ الفاتورة فوراً (إنشاء أول مرة ثم تعديل) فتتحرك الأرصدة لحظياً. لا يحدث شىء
    // بلا عميل (الأصل يمنع إضافة صنف بلا عميل)، ولا رسالة نجاح لكل صنف (الأصل صامت).
    private bool _quietSave;

