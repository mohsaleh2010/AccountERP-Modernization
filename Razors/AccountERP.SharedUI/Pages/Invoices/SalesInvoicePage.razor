    private void RecomputeTotals()
    {
        // يقابل SetCommissionOnScreen: مع الضريبة لكل صنف يُصفَّر الخصم على مستوى الفاتورة ويُعطَّل.
        if (_isTaxInvoice && _isTaxPerItem)
        {
