        InvoiceLineCalculator.ComputeHeaderTotals(_header, _invD_O.invDlst, _isTaxInvoice && _isTaxPerItem);
        StateHasChanged();
    }

    // 🟢 قوائم اختيار رأس الفاتورة عبر InvoiceHeaderLookupsCLS (AccountModelsLib): البائع (employeeSellerUSR1 → Emp_Id/Emp_Name)،
    // مندوب المبيعات (SalesMan_List → Salesman_Id، إلزامى عند ShowSalesMan=1)، وشركة الشحن (ShipmentCoUSR → ShipmentCompany_Id/Name).
    private async Task<IEnumerable<SellerOption>> SearchLookupAsync(Func<DataTable> read, string search, CancellationToken ct)
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return read();
        }, ct);
        var list = new List<SellerOption>();
        foreach (DataRow r in dt.Rows)
        {
            var name = r["Name"]?.ToString()?.Trim() ?? "";
            if (string.IsNullOrEmpty(search) || name.Contains(search, StringComparison.OrdinalIgnoreCase))
                list.Add(new SellerOption(Convert.ToInt64(r["Id"]), name));
        }
        return list.Take(50);
    }

    private Task<IEnumerable<SellerOption>> SearchSellersAsync(string search, CancellationToken ct) => SearchLookupAsync(_lookups.GetSellers, search, ct);
    private Task<IEnumerable<SellerOption>> SearchSalesmenAsync(string search, CancellationToken ct) => SearchLookupAsync(_lookups.GetSalesmen, search, ct);
    private Task<IEnumerable<SellerOption>> SearchShipmentCompaniesAsync(string search, CancellationToken ct) => SearchLookupAsync(_lookups.GetShipmentCompanies, search, ct);

