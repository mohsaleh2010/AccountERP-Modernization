    private decimal? GetAlloc(long invoiceId) => _alloc.TryGetValue(invoiceId, out var v) ? v : null;

    private void SetAlloc(InvoiceRow row, decimal? value)
    {
        if (value is null or <= 0) { _alloc.Remove(row.Id); return; }
        _alloc[row.Id] = Math.Min(value.Value, row.Remaining);
    }

    // أقصى ما يسمح به الإذن والفاتورة معاً
    private void FillRest(InvoiceRow row)
    {
        var otherApplied = AppliedTotal - (GetAlloc(row.Id) ?? 0);
        var room = Math.Max(0, (_voucher?.Value ?? 0) - otherApplied);
        var amount = Math.Min(row.Remaining, room);
        if (amount > 0) _alloc[row.Id] = Common.RoundMe(amount); else _alloc.Remove(row.Id);
    }

    private void ClearAllocations() => _alloc.Clear();

    private async Task SaveDistributionAsync()
    {
        if (_voucher == null) { Snackbar.Add(Tr("RD_PickFirst"), Severity.Warning); return; }
        _isBusy = true;
        _errorMessage = null;
        StateHasChanged();
        var voucher = _voucher;
        var amounts = _alloc.Where(a => a.Value is > 0).ToDictionary(a => a.Key, a => a.Value!.Value);
        try
        {
            var count = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return _distSvc.Save(voucher.BoxLineId, amounts);
            });
            Snackbar.Add(Tr("RD_Saved", count), Severity.Success);
            await ReloadVoucherAsync(voucher.BoxLineId);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = DistributionError(ex.Message);
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteDistributionAsync()
    {
        if (_voucher == null) { Snackbar.Add(Tr("RD_PickFirst"), Severity.Warning); return; }
        var ok = await Dialog.ShowMessageBoxAsync(Tr("RD_Delete"), Tr("RD_DeleteConfirm"), yesText: Tr("RD_Delete"), cancelText: Tr("Cancel"));
        if (ok != true) return;
        _isBusy = true;
        _errorMessage = null;
        StateHasChanged();
        var boxId = _voucher.BoxLineId;
        try
        {
            var removed = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return _distSvc.Delete(boxId);
            });
            Snackbar.Add(Tr("RD_Deleted", removed), Severity.Success);
            await ReloadVoucherAsync(boxId);
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isBusy = false;
        }
    }

    // بعد الحفظ/الحذف: يعيد قراءة الإذن (الموزَّع منه) والفواتير من القاعدة
    private async Task ReloadVoucherAsync(long boxLineId)
    {
        var fresh = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return _distSvc.GetReceipt(boxLineId);
        });
        if (fresh == null) return;
        _voucher = fresh;
        await SearchAsync(false);
    }

    private string DistributionError(string code) => code switch
    {
        "ReceiptNotFound" or "InvoiceNotFound" or "ExceedsReceipt" or "ExceedsInvoice" or "InvoiceOtherCustomer" => Tr("RD_" + code),
        _ => Tr("SystemError", code)
    };

