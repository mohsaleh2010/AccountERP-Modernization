                list.Add(new LookupOption(Convert.ToInt64(r["id"]), name));
            }
        }
        return list.Take(50);
    }

    // يقابل NuInvoiceNo_TextChanged: رقم فاتورة > 0 يبحث بالرقم وحده (بلا عميل ولا تواريخ).
    private async Task OnInvoiceNoKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        // قيمة الحقل (Immediate) قد تصل بعد حدث Enter مباشرة عند الكتابة السريعة/الملصق الضوئى؛ مهلة قصيرة تضمن قراءة الرقم كاملاً.
        await Task.Delay(150);
        if ((_invoiceNo ?? 0) > 0)
        {
            await SearchAsync(true);
        }
    }

    private async Task SearchAsync(bool byNumberOnly)
    {
        _errorMessage = null;
        _isLoading = true;
        _selectedId = null;
        _payments = new();
        StateHasChanged();

        var invoiceNo = _invoiceNo ?? 0;
        var customerId = byNumberOnly ? 0 : _customer?.Id ?? 0;
        var useFrom = !byNumberOnly && _useFrom;
        var useTo = !byNumberOnly && _useTo;
        var from = _dateFrom ?? DateTime.Now.Date;
        var to = _dateTo ?? DateTime.Now.Date;
        var kind = _invoiceKind;
        var paid = _paidStatus;
        var sellerId = _seller?.Id ?? 0;
        var isDistribution = _isDistribution;

        try
        {
            if (isDistribution && _voucher != null)
            {
                // عند اختيار إذن قبض: فواتير عميل الإذن وحده بتوزيعه الحالى (نفس معنى Get_Customers_InvoicesForDistributeMoney بمعرّف الإذن)
                var voucher = _voucher;
                var found = await Task.Run(() =>
                {
                    AccountCultureGuard.EnsureInvariant();
                    return _distSvc.GetInvoices(voucher.BoxLineId, voucher.CustomerId, useFrom ? from : null, useTo ? to : null, invoiceNo, paid == 0);
                });
                var vrows = new List<InvoiceRow>();
                _alloc.Clear();
                foreach (var f in found)
                {
                    vrows.Add(new InvoiceRow(f.Id, vrows.Count + 1, f.Customer, f.InvoiceNo, f.Date, f.DueDate, f.Net, f.PaidAll - f.Allocated, f.Remaining, f.Notes, f.User));
                    if (f.Allocated > 0) _alloc[f.Id] = f.Allocated;
                }
                _rows = vrows;
                _netSum = Common.RoundMe(vrows.Sum(x => x.Net));
                _paidSum = Common.RoundMe(vrows.Sum(x => x.Paid));
                _remainingSum = Common.RoundMe(vrows.Sum(x => x.Remaining));
                _searched = true;
                return;
            }

            var dt = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var excp = 0;
                var cls = new InvoicesClss { Is_Invoice_Agile = kind, Is_Net_Total_Paid = paid, Emp_Id = sellerId };
                return isDistribution
                    ? cls.Get_Customers_InvoicesForDistributeMoney(ref excp, 0, invoiceNo, customerId, useFrom, from, useTo, to, 0, false, -1, true)
                    : cls.Get_Customers_Invoices(ref excp, 0, invoiceNo, customerId, useFrom, from, useTo, to, false, -1, -1);
            });

            var rows = new List<InvoiceRow>();
            var serial = 0;
            decimal netSum = 0, paidSum = 0, remainingSum = 0;
            foreach (DataRow r in dt.Rows)
            {
                // فلتر تاريخ الاستحقاق (صلاحية 957): الأصل يعرض الحقول دون ربطها بالاستعلام، فيُطبَّق هنا على النتيجة
                var due = Dt(r, "InvoiceDueDate");
                if (_showDueDate && ((_useDueFrom && _dueFrom.HasValue && (!due.HasValue || due.Value.Date < _dueFrom.Value.Date))
                                  || (_useDueTo && _dueTo.HasValue && (!due.HasValue || due.Value.Date > _dueTo.Value.Date)))) continue;
                serial++;
                var net = Dec(r, "Net_Total");
                var paidValue = Dec(r, "PaymentValue");
                var remaining = Dec(r, "StillValues");
                netSum += net; paidSum += paidValue; remainingSum += remaining;
                rows.Add(new InvoiceRow(
                    Convert.ToInt64(r["Id"]), serial, r["Name"]?.ToString()?.Trim() ?? "",
                    r["Invoice_Id"] == DBNull.Value ? 0 : Convert.ToInt64(r["Invoice_Id"]), Dt(r, "Invoice_Date"), Dt(r, "InvoiceDueDate"),
                    net, paidValue, remaining, r["Notes"]?.ToString() ?? "", r["USER_NAME"]?.ToString() ?? ""));
            }

            _rows = rows;
            _netSum = Common.RoundMe(netSum);
            _paidSum = Common.RoundMe(paidSum);
            _remainingSum = Common.RoundMe(remainingSum);
            _searched = true;
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // يقابل Dg_List_CellClick → ShowMoneyTransaction: مدفوعات الفاتورة المحددة.
    private async Task SelectInvoiceAsync(InvoiceRow row)
    {
        _selectedId = row.Id;
        _isPaymentsLoading = true;
        _payments = new();
        StateHasChanged();

        var invoiceId = row.Id;
        var isDistribution = _isDistribution;
        try
        {
            var dt = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var cls = new Money_Transaction_BoxOrderReportCLS();
                return isDistribution
                    ? cls.GetMoney_Box_TransactionForInvoicesDistribut(Common.Invoice_Type_Id, invoiceId)
                    : cls.GetMoney_Box_TransactionInvoices(Common.Invoice_Type_Id, invoiceId);
            });

            var list = new List<PaymentRow>();
            var serial = 0;
            foreach (DataRow r in dt.Rows)
            {
                // الأصل يُلحق صف إجمالى بلا رقم إذن؛ نتخطاه لأن الإجمالى يظهر فى بطاقات الصفحة.
                if (!dt.Columns.Contains("Order_No") || r["Order_No"] == DBNull.Value) continue;
                serial++;
                list.Add(new PaymentRow(r.Table.Columns.Contains("Id") && r["Id"] != DBNull.Value ? Convert.ToInt64(r["Id"]) : 0, serial, r["Order_No"].ToString() ?? "", Dt(r, "Order_Date"), r["Bank_Name"]?.ToString() ?? "",
                    r["Man_Name"]?.ToString() ?? "", Dec(r, "Import_Value"), Dec(r, "Export_Value"), r["Order_Notes"]?.ToString() ?? ""));
            }
            _payments = list;
        }
        catch (Exception ex)
        {
            _errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            _isPaymentsLoading = false;
        }
    }

