    private async Task SaveInvoiceCoreAsync()
    {
        if (_selectedSupplier is null)
        {
            Snackbar.Add(Tr("SupplierRequiredError"), Severity.Warning);
            return;
        }

        var supplierId = _selectedSupplier.Id;
        _header.Supplier_Id = supplierId;
        // يقابل Make_Bill_Templat سطر 1064: الحساب الفرعى للمورد يُحفظ على الرأس (يبنى عليه قيد الفاتورة).
        _header.SubAccount_Id = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var dt = new AccountModelsLib.operations().return_DataTable("SELECT SubAccount_Id FROM Supplier WHERE Id = " + supplierId);
            return dt.Rows.Count > 0 && long.TryParse(dt.Rows[0][0]?.ToString(), out var sub) ? sub : 0L;
        });
        _header.SubAccount_Name = _selectedSupplier.Name;
        _header.Currency_id = _currencyId;
        _header.Currency = _currencies.FirstOrDefault(c => c.Id == _currencyId)?.Name ?? "";
        _header.Invoice_Date = _invoiceDate ?? DateTime.Now;
        _header.Notes = _notes;
        _header.Is_Invoice_Agile = _isAgile ? 1 : 0;
        _header.Is_Invoice_AgileStr = _isAgile ? Tr("DS_InvoiceCredit") : Tr("DS_InvoiceCash");
        _header.IsInvoiceTaxInfo = _isTaxInvoice ? 1 : 0;
        _header.Is_Tax_Per_Item = _isTaxInvoice ? 1 : 0;
        _header.User_Id = Common.User_Id;
        _header.Branch_Id = Common.Branch_Id;
        if (!IsExistingInvoice)
        {
            _header.Invoice_DateTime = DateTime.Now;
            _header.Insert_ServerDateTime = DateTime.Now;
            _header.InvoiceDueDate = DateTime.Now;
            if (string.IsNullOrEmpty(_header.PolicaNo)) _header.PolicaNo = "0";
            if (string.IsNullOrEmpty(_header.TroodContainerNo)) _header.TroodContainerNo = "0";
            _header.Supplier_Notes ??= "";
            _header.Salesman_Id ??= 0;
            _header.Emp_Name ??= "";
            // الأصل يحفظ IS_Posted_Flage=0 (غير مُرحَّل)؛ وقراءات المحرك (Get_EntryFor_Bills: سطور الضريبة/العمولة فى حركة المورد، والترحيل لاحقاً) تشترط = 0 فتتخطى NULL.
            _header.IS_Posted_Flage ??= 0;
            // الأصل: مربع «الحمولة على الضريبة» مُعلَّم افتراضياً ما لم يكن Show_Item_TaxSale_On_Bill_Monitor=1.
            _header.Is_Load_Payment_OnTax ??= Common.Show_Item_TaxSale_On_Bill_Monitor == 1 ? 0 : 1;
        }
        _header.CustomerAccountBefor = _supplierBalanceBefore;
        _header.CustomerAccountAfter = BalanceAfter;
        foreach (var l in _invD_O.invDlst) BillLineCalculator.ZeroNullNumerics(l);
        BillLineCalculator.ZeroNullNumerics(_header);

        var excp = 0;
        var msg = "";
        // المحرك القديم قد يبتلع استثناءات داخلياً؛ نلتقط آخر استثناء SQL/EF أثناء الاستدعاء (من جهة Razor فقط) لعرض السبب الحقيقى.
        string? swallowed = null;
        EventHandler<System.Runtime.ExceptionServices.FirstChanceExceptionEventArgs> handler = (_, e) =>
        {
            var name = e.Exception.GetType().Name;
            if (name.Contains("Sql") || name.Contains("DbUpdate") || name.Contains("Invalid") || name.Contains("Null"))
                swallowed = e.Exception.Message;
        };
        try
        {
            AppDomain.CurrentDomain.FirstChanceException += handler;
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var engine = new BillsClss();
                // مركز التكلفة يُمرَّر للخيط نفسه؛ يستهلكه قيد الفاتورة (InvoiceCostCenter.Apply) ويُمسح هنا لو فشل الحفظ قبله.
                AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.SetPending(_costCenterId);
                try
                {
                    if (_isReverse)
                    {
                        if (IsExistingInvoice) engine.Edit_Bill_List_reverse_Update_Supplier_Account(ref excp, ref msg, _invD_O, _invL_O);
                        else engine.Make_Bills_List_Reverse_Update_SupplierAccount(ref excp, ref msg, _invD_O, _invL_O);
                    }
                    else
                    {
                        if (IsExistingInvoice) engine.Edit_Bill_Update_Supplier_Account(ref excp, ref msg, _invD_O, _invL_O);
                        else engine.Make_Bill_Update_SupplierAccount(ref excp, ref msg, _invD_O, _invL_O);
                    }
                }
                finally { AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.ClearPending(); }
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }
        finally
        {
            AppDomain.CurrentDomain.FirstChanceException -= handler;
        }

        if (excp == 0)
        {
            if (_deletingInvoice)
            {
                Snackbar.Add(Tr("InvDeletedMessage"), Severity.Success);
                Nav.NavigateTo(_isReverse ? "/accounts/invoices/purchases-list?return=1" : "/accounts/invoices/purchases-list");
                return;
            }
            Snackbar.Add(Tr("InvoiceSavedMessage"), Severity.Success);
            if (IsExistingInvoice)
            {
                await ReloadSavedInvoiceAsync();
            }
            else
            {
                _isSaved = true;
                var oldRelative = Nav.ToBaseRelativePath(Nav.Uri);
                Nav.NavigateTo($"/accounts/invoices/{(_isReverse ? "purchase-return" : "purchase-invoice")}/{_header.Id}", replace: true);
                CloseStaleNewInvoiceTab(oldRelative);
            }
        }
        else
        {
            var detail = string.IsNullOrEmpty(msg) ? swallowed : msg;
            Snackbar.Add(string.IsNullOrEmpty(detail) ? Tr("InvoiceSaveError") : $"{Tr("InvoiceSaveError")}: {detail}", Severity.Error);
        }
    }

    private string Tr(string key)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
