    // زر الحفظ: معطَّل أثناء الحفظ، وبعده حتى يتغير شىء عن آخر حالة محفوظة/محمَّلة. الفاتورة الجديدة يكفى لها صنف واحد.
    private bool CanSave => !_isSaving && !_isSaved && _lines.Count > 0 && (!IsExistingInvoice || Fingerprint() != _baseline);

    private string Fingerprint()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(_selectedSupplier?.Id).Append('|').Append(_currencyId).Append('|').Append(_invoiceDate?.Date.Ticks).Append('|').Append(_notes)
          .Append('|').Append(_isTaxInvoice).Append('|').Append(_defaultTaxSales).Append('|').Append(_defaultATS05)
          .Append('|').Append(_header.PolicaNo).Append('|').Append(_header.TroodContainerNo).Append('|').Append(_header.Load_Payment).Append('|').Append(_header.Damaghat)
          .Append('|').Append(_header.List_CommissionRate).Append('|').Append(_header.List_CommissionValue);
        foreach (var l in _invD_O.invDlst)
        {
            sb.Append('#').Append(l.Id).Append(',').Append(l.Item_DeletedFlage).Append(',').Append(l.Unit_Item_Table_Id).Append(',')
              .Append(l.Larg_Qnty).Append(',').Append(l.Small_Qnty).Append(',').Append(l.PriceUnit).Append(',').Append(l.Store_Id);
        }
        sb.Append("D").Append(_invD_O.invDlst_Deleted.Count);
        return sb.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        LoadInvoicePermissions();
        _isAgile = AgileQuery == 1;
        _isSaveDirectly = SaveDirectlyQuery == 1;
        _isReverse = Nav.Uri.Contains("/purchase-return", StringComparison.OrdinalIgnoreCase);
        _invL_O = new BillOperationListCLS_New(_isReverse ? 1 : 0);
        _invD_O = new BillOperationCLS_New(_isReverse ? 1 : 0);

        await LoadCurrenciesAsync();
        await LoadTaxDefaultsAsync();

        if (IsExistingInvoice)
        {
            await LoadExistingInvoiceAsync(Id!.Value);
            _baseline = Fingerprint();
        }
        else
        {
            await InitializeNewInvoiceAsync();
        }

        if (IsExistingInvoice && _header.Invoice_Id.HasValue)
        {
            var tabKey = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
            TabWorkspace.SetCustomTitle(tabKey, string.Format(CultureInfo.InvariantCulture, _isReverse ? Tr("PurchTabReturn") : Tr("PurchTabInvoice"), _header.Invoice_Id.Value));
        }
        UpdateTitle();
    }

    private void UpdateTitle()
    {
        var isQaa = Convert.ToInt32(_header.Invoice_Type) == 1;
        _pageTitle = _isReverse
            ? (isQaa ? Tr("PurchTitleReturnQaa") : Tr("PurchTitleReturn"))
            : isQaa ? Tr("PurchTitleQaa")
            : _isSaveDirectly ? Tr("PurchTitleSaveDirectly")
            : _isAgile ? Tr("PurchTitleAgile")
            : Tr("PurchTitleCash");
    }

    private async Task LoadCurrenciesAsync()
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return new CurrencyFactorsCLS_().GetCurrencyList();
        });
        _currencies = dt.Rows.Cast<DataRow>()
            .Select(r => new CurrencyOption(Convert.ToInt64(r["ID"]), r["Currency_Name"]?.ToString() ?? ""))
            .ToList();
        if (_currencies.Count > 0) _currencyId = _currencies[0].Id;
    }

    // نسب الضريبة الافتراضية (تقابل SetTaxDataOnForm): ضريبة القيمة المضافة T1 وضريبة الخصم والإضافة T4/W002 (×100).
    private async Task LoadTaxDefaultsAsync()
    {
        await Task.Run(() =>
        {
            try
            {
                AccountCultureGuard.EnsureInvariant();
                var opp = new AccountModelsLib.operations();
                var tax = new TaxListCLS();
                _defaultTaxSales = (tax.Get_TaxInfoRatio(ref opp, "T1", "")?.TaxRate ?? 0) * 100;
                _defaultATS05 = (tax.Get_TaxInfoRatioList(ref opp).FirstOrDefault(x => x.MainCode == "T4" && x.SubCode == "W002")?.TaxRate ?? 0) * 100;
            }
            catch { _defaultTaxSales = 0; _defaultATS05 = 0; }
        });
    }

    private async Task InitializeNewInvoiceAsync()
    {
        // Invoice_Type رقم سلسلة الترقيم فقط (0 عادى، 1 ق.ع)؛ ليس علم ضريبة (قاعدة المستخدم).
        var invoiceType = TypeQuery ?? 0;
        _header.Invoice_Type = invoiceType;
        _header.Is_InvoiceKta3y = 0;
        _header.IS_Make_Sarf_Item_BalanceFromInvoice = 1;
        _header.Supplier_BalanceSet = 1;
        ApplyTaxSettings();

        var no = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var b = new Bills_ModelsClss();
            return _isReverse ? b.Make_New_Invoice_No_Reverse(invoiceType) : b.Make_New_Invoice_No(invoiceType);
        });
        _header.Invoice_Id = no;
