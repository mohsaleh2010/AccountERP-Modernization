    // إضافة سطر جديد = علما المعالجة 0؛ تعديل سطر محفوظ = حذف القديم (يُرجع المحرك رصيده) + سطر جديد (يضيف رصيده).
    private void OnItemDialogSaved(IBills_Details line)
    {
        if (_editingLine is null)
        {
            line.Item_DeletedFlage = 0;
            line.Item_ProcessedFlage = 0;
            _invD_O.invDlst.Add(line);
        }
        else
        {
            var index = _invD_O.invDlst.IndexOf(_editingLine);
            if (index >= 0)
            {
                if (_editingLine.Id > 0)
                {
                    _editingLine.Item_DeletedFlage = 1;
                    _editingLine.Item_ProcessedFlage = 1;
                    _invD_O.invDlst_Deleted.Add(_editingLine);
                }
                line.Id = 0;
                line.Item_DeletedFlage = 0;
                line.Item_ProcessedFlage = 0;
                _invD_O.invDlst[index] = line;
            }
            _editingLine = line;
        }
        RecomputeTotals();
    }

    private void DeleteLine(IBills_Details line)
    {
        if (!GuardEditItems()) return;
        if (line.Id > 0)
        {
            line.Item_DeletedFlage = 1;
            line.Item_ProcessedFlage = 1;
            _invD_O.invDlst_Deleted.Add(line);
        }
        _invD_O.invDlst.Remove(line);
        RecomputeTotals();
    }

    private void RecomputeTotals()
    {
        BillLineCalculator.ComputeHeaderTotals(_header, _invD_O.invDlst);
        StateHasChanged();
    }

    private void OnTaxInvoiceChanged(bool value)
    {
        _isTaxInvoice = value;
        ApplyTaxSettings();
    }

    // الفاتورة الضريبية = ضريبة لكل صنف (Is_Tax_Per_Item=1) ونسب الرأس صفر؛ بدونها كل النسب صفر. تُعاد حسابات الأسطر الموجودة.
    private void ApplyTaxSettings()
    {
        _header.IsInvoiceTaxInfo = _isTaxInvoice ? 1 : 0;
        _header.Is_Tax_Per_Item = _isTaxInvoice ? 1 : 0;
        _header.TaxSales10 = 0;
        _header.ATS05 = 0;

        foreach (var line in _invD_O.invDlst.Where(l => (l.Item_DeletedFlage ?? 0) != 1).ToList())
        {
            var target = line;
            if (line.Id > 0)
            {
                // سطر محفوظ تغيّرت ضريبته فقط: حذف القديم + نسخة جديدة (نفس عقد التعديل).
                var index = _invD_O.invDlst.IndexOf(line);
                var old = line.Clone();
                old.Item_DeletedFlage = 1;
                old.Item_ProcessedFlage = 1;
                _invD_O.invDlst_Deleted.Add(old);
                target = line.Clone();
                target.Id = 0;
                target.Item_DeletedFlage = 0;
                target.Item_ProcessedFlage = 0;
                _invD_O.invDlst[index] = target;
            }
            BillLineCalculator.ApplyItemTax(target, _isTaxInvoice ? _defaultTaxSales : 0, _isTaxInvoice ? _defaultATS05 : 0);
        }
        RecomputeTotals();
    }

