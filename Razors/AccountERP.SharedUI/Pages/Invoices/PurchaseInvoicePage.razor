    private decimal Damaghat { get => _header.Damaghat ?? 0; set { _header.Damaghat = value; BillLineCalculator.ComputeHeaderTotals(_header, _invD_O.invDlst); } }
    private decimal ListCommissionRate { get => _header.List_CommissionRate ?? 0; set { _header.List_CommissionRate = value; BillLineCalculator.ComputeHeaderTotals(_header, _invD_O.invDlst); } }
