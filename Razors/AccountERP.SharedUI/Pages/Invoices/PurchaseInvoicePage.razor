    private async Task LoadExistingInvoiceAsync(long billTableId)
    {
        await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            if (_isReverse)
            {
                _invL_O.Get_Bills_List_Reverse(billTableId);
                _invD_O.GeDetails_ReverseToEdit(billTableId);
            }
            else
            {
                _invL_O.Get_Bills_List(billTableId);
                _invD_O.GeBills_DetailsToEdit(billTableId);
            }
        });

        // 100 = "محفوظ بلا تغيير": المحرك لا يعالج إلا الأسطر التى نعدّلها صراحةً (نفس درس المبيعات).
        foreach (var l in _invD_O.invDlst)
        {
            l.Item_ProcessedFlage = 100;
            l.Item_DeletedFlage = 100;
        }
        _invoiceNoDisplay = _header.Invoice_Id?.ToString() ?? "";
        _invoiceDate = _header.Invoice_Date;
        _notes = _header.Notes ?? "";
        _costCenterId = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.GetHeaderCenter(new AccountModelsLib.operations(),
                _isReverse ? AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.Table_PurchaseReturn : AccountModelsLib.BusinessLibShared.CostCenters.InvoiceCostCenter.Table_Purchase, billTableId);
        });
        _currencyId = _header.Currency_id ?? _currencyId;
        _isAgile = _header.Is_Invoice_Agile == 1;
        _isTaxInvoice = _header.IsInvoiceTaxInfo == 1;
        // نسب الضريبة تُخزَّن على الأسطر لا على الرأس (نسب الرأس صفر)، فتُستعاد من أول سطر بضريبة ليعرضها الحقلان ولا تُصفَّر عند التعديل.
        var taxedLine = _invD_O.invDlst.FirstOrDefault(l => (l.Item_TaxSales10 ?? 0) != 0 || (l.Item_ATS05 ?? 0) != 0);
        if (_isTaxInvoice && taxedLine != null)
        {
            _defaultTaxSales = taxedLine.Item_TaxSales10 ?? 0;
            _defaultATS05 = taxedLine.Item_ATS05 ?? 0;
        }
        if (_header.Supplier_Id is > 0)
        {
            var name = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var dt = new AccountModelsLib.operations().return_DataTable("SELECT Name FROM Supplier WHERE Id = " + _header.Supplier_Id);
                return dt.Rows.Count > 0 ? dt.Rows[0][0]?.ToString()?.Trim() ?? "" : "";
            });
            _selectedSupplier = new PartyOption(_header.Supplier_Id.Value, string.IsNullOrEmpty(name) ? _header.SubAccount_Name ?? "" : name);
        }
        _supplierBalanceBefore = _header.CustomerAccountBefor ?? 0;
    }

    private async Task<IEnumerable<PartyOption>> SearchSuppliersAsync(string search, CancellationToken ct)
    {
        var dt = await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            return _supplierCls.Get_SupplierListForStatement(0, 0, 0, true);
        }, ct);
        var list = new List<PartyOption>();
        foreach (DataRow r in dt.Rows)
        {
            var name = r["Name"]?.ToString()?.Trim() ?? "";
            if (string.IsNullOrEmpty(search) || name.Contains(search, StringComparison.OrdinalIgnoreCase))
                list.Add(new PartyOption(Convert.ToInt64(r["Id"]), name));
        }
        return list.Take(50);
    }

