        _selectedSupplier = null;
        _supplierBalanceBefore = 0;
        _notes = "";
        _costCenterId = 0;
        _invoiceDate = DateTime.Now;
        _isSaved = false;
        _editingLine = null;
        _barcodeText = "";
        _dialogInitialCode = "";
        _isTaxInvoice = false;
        _invL_O = new BillOperationListCLS_New(_isReverse ? 1 : 0);
        _invD_O = new BillOperationCLS_New(_isReverse ? 1 : 0);
        await InitializeNewInvoiceAsync();
        UpdateTitle();
    }

