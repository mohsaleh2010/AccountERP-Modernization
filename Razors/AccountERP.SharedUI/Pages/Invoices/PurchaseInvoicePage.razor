    private string NewInvoiceUrl()
    {
        var path = _isReverse ? "/accounts/invoices/purchase-return" : "/accounts/invoices/purchase-invoice";
        var query = new List<string>();
        if (_isAgile) query.Add("agile=1");
        var type = Convert.ToInt32(_header.Invoice_Type);
        if (type != 0) query.Add("type=" + type);
        if (_isSaveDirectly) query.Add("saveDirectly=1");
        return query.Count > 0 ? path + "?" + string.Join("&", query) : path;
    }

    private bool HasUnsavedWork() =>
        !_isSaved && (IsExistingInvoice
            ? Fingerprint() != _baseline
            : _lines.Count > 0 || _selectedSupplier is not null || !string.IsNullOrWhiteSpace(_notes));

    private async Task NewInvoiceAsync()
    {
        if (_isSaving) return;
        if (HasUnsavedWork())
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(Tr("NewInvoiceButton"), Tr("DiscardChangesConfirm"),
