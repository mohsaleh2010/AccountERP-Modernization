@* 🟢 "تست طباعة الباركود" - النسخة Blazor. الفحص الفعلى للأصل (Store_LIB.PrintItemsBarCodeSettingFor_DeveloperNew
   + Store_LIB.BarCodeSettingsForm، يُفتَحان معاً عند الضغط على menuItemPrintBarCode) بيَّن أنها فعلياً أداة
   اختبار داخلية للمطورين تقارن بين محرِّكَى باركود (القديم البكسلى المُستخدَم فى "إعدادات طباعة الباركود"،
   والأحدث Store_LIB.BarCodeCtrlNew المبنى بالمليمتر لطباعة "استيكر صيدلية" متعدد الأصناف/الباركودات فى
   استيكر واحد). بموافقة المستخدم الصريحة (راجع barcode-print-settings-razor-plan.md) حُوِّلت هنا كشاشة
   استخدام حقيقية (طباعة استيكر باركود متعدد الأصناف لصيدلية) بدل أزرار اختبار ببيانات ثابتة (Hardcoded) كما
   فى الأصل - نفس محرك BarCodeCtrlNew (استيكر بالمليمتر، أكثر من باركود فى الاستيكر الواحد) لكن بأصناف حقيقية
   يختارها المستخدم. لا يوجد جدول قاعدة بيانات لحفظ إعدادات هذا الوضع فى الأصل (كانت مكتوبة مباشرة فى الكود) -
   فالإعدادات هنا محلية للجلسة فقط، بنفس غياب الحفظ فى الأصل تماماً. *@

@page "/main-data/barcode-pharmacy-stickers"

@using System.Globalization
@using AccountERP.SharedUI.Services
@using AccountModelsLib
@using AccountModelsLib.Models
@using ZXing
@inject LanguageService LangService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@Tr("BarcodeStickersTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">

    <MudPaper Class="pa-4 mb-4 no-print" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@Tr("BarcodeStickersTitle")</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintAsync" Disabled="@(flatSlots.Count == 0)">
                @Tr("PrintButton")
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="5" Class="no-print">
            <MudPaper Class="pa-4 mb-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@Tr("BarcodeStickerSettingsSection")</MudText>
                <MudStack Spacing="2">
                    <MudStack Row="true" Spacing="2">
                        <MudNumericField @bind-Value="settings.StickerWidthMm" @bind-Value:after="Refresh" Label="@Tr("BarcodeStickerWidthMm")" Variant="Variant.Outlined" Min="10" />
                        <MudNumericField @bind-Value="settings.StickerHeightMm" @bind-Value:after="Refresh" Label="@Tr("BarcodeStickerHeightMm")" Variant="Variant.Outlined" Min="10" />
                    </MudStack>
                    <MudStack Row="true" Spacing="2">
                        <MudNumericField @bind-Value="settings.StickerGapMm" @bind-Value:after="Refresh" Label="@Tr("BarcodeStickerGapMm")" Variant="Variant.Outlined" Min="0" />
                        <MudNumericField @bind-Value="settings.BarcodesPerSticker" @bind-Value:after="Refresh" Label="@Tr("BarcodeCountPerSticker")" Variant="Variant.Outlined" Min="1" Max="6" />
                    </MudStack>
                    <MudStack Row="true" Spacing="2">
                        <MudNumericField @bind-Value="settings.HeaderFontSize" @bind-Value:after="Refresh" Label="@Tr("BarcodeHeaderFontSize")" Variant="Variant.Outlined" Min="3" Max="20" />
                        <MudNumericField @bind-Value="settings.FooterFontSize" @bind-Value:after="Refresh" Label="@Tr("BarcodeFooterFontSize")" Variant="Variant.Outlined" Min="3" Max="20" />
                    </MudStack>
                    <MudCheckBox T="bool" @bind-Value="settings.ShowDividerLine" Label="@Tr("BarcodeShowDivider")" />
                    <MudCheckBox T="bool" @bind-Value="settings.OneStickerPerPage" Label="@Tr("BarcodeOneStickerPerPage")" />
                </MudStack>
            </MudPaper>

            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2">@Tr("BarcodeAddItemsSection")</MudText>
                <MudStack Spacing="2">
                    <MudAutocomplete T="Items" Label="@Tr("BarcodeSearchItemLabel")" Value="pendingItem" ValueChanged="OnItemPicked"
                                      SearchFunc="SearchItemsAsync" ToStringFunc="@(i => i == null ? null : $"{i.code} - {i.Item_Name}")"
                                      Clearable="true" ResetValueOnEmptyText="true" Variant="Variant.Outlined" FullWidth="true"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                        <MudTextField @bind-Value="pendingCode" Label="@Tr("BarcodeCodeLabel")" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="pendingHeader" Label="@Tr("BarcodeHeaderTextLabel")" Variant="Variant.Outlined" />
                        <MudNumericField @bind-Value="pendingQuantity" Label="@Tr("BarcodeQuantityRequired")" Variant="Variant.Outlined" Min="1" Max="200" Style="max-width:110px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem">@Tr("AddMixed")</MudButton>
                    </MudStack>

                    @if (stickerItems.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>@Tr("BarcodeCodeLabel")</th>
                                    <th>@Tr("BarcodeHeaderTextLabel")</th>
                                    <th>@Tr("BarcodeQuantityRequired")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var it in stickerItems)
                                {
                                    <tr>
                                        <td>@it.Code</td>
                                        <td>@it.HeaderText</td>
                                        <td>@it.Quantity</td>
                                        <td>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => RemoveItem(it)" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">@Tr("BarcodeNoItemsAdded")</MudAlert>
                    }
                </MudStack>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4 no-print mb-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    @Tr("BarcodePreviewLabel") — @flatSlots.Count @Tr("BarcodeSlotsWord") / @stickersCount @Tr("BarcodeStickersWord")
                </MudText>
            </MudPaper>
            <div class="print-area">
                <div class="sticker-page">
                    @for (var s = 0; s < stickersCount; s++)
                    {
                        var sIndex = s;
                        <div class="sticker" style="@StickerStyle">
                            @for (var slot = 0; slot < settings.BarcodesPerSticker; slot++)
                            {
                                var flatIndex = sIndex * settings.BarcodesPerSticker + slot;
                                if (flatIndex >= flatSlots.Count) { continue; }
                                var item = flatSlots[flatIndex];
                                <div class="sticker-slot" style="@SlotStyle(slot)">
                                    <div class="s-header" style="font-size:@(settings.HeaderFontSize)pt;">@item.HeaderText</div>
                                    @{ var uri = GetBarcodeUri(item.Code); }
                                    @if (!string.IsNullOrEmpty(uri))
                                    {
                                        <img src="@uri" class="s-image" alt="barcode" />
                                    }
                                    <div class="s-footer" style="font-size:@(settings.FooterFontSize)pt;">@item.Code</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .sticker-page { display: flex; flex-wrap: wrap; }
    .sticker { display: flex; flex-direction: column; box-sizing: border-box; border: 1px dashed #bbb; background: #fff; overflow: hidden; }
    .sticker-slot { display: flex; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; }
    /* الصورة تأخذ المساحة الباقية بين العنوان والكود فقط - بدون max-height كانت أطول من الخانة فتُقص بالكامل */
    .s-header, .s-footer { flex: 0 0 auto; width: 100%; line-height: 1.1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .s-header { font-weight: 600; }
    .s-image { flex: 1 1 auto; min-height: 0; max-width: 92%; max-height: 100%; object-fit: contain; image-rendering: pixelated; }

    @@media print {
        .no-print { display: none !important; }
        .sticker { border: none; }
    }
</style>

@code {
    private class StickerSettings
    {
        public float StickerWidthMm { get; set; } = 38f;
        public float StickerHeightMm { get; set; } = 25f;
        public float StickerGapMm { get; set; } = 2f;
        public int BarcodesPerSticker { get; set; } = 2;
        public float HeaderFontSize { get; set; } = 6f;
        public float FooterFontSize { get; set; } = 6f;
        public bool ShowDividerLine { get; set; } = true;
        // طابعة استيكرات: كل استيكر صفحة بمقاسه بالضبط، وإلا تُرص على ورقة A4
        public bool OneStickerPerPage { get; set; } = true;
    }

    private class StickerItem
    {
        public string Code { get; set; } = "";
        public string HeaderText { get; set; } = "";
        public int Quantity { get; set; } = 1;
    }

    private StickerSettings settings = new();
    private List<StickerItem> stickerItems = new();
    private List<StickerItem> flatSlots = new();
    private Dictionary<string, string> barcodeCache = new();

    private List<Items> allItems = new();
    private Items? pendingItem;
    private string pendingCode = "";
    private string pendingHeader = "";
    private int pendingQuantity = 1;

    private int stickersCount => (int)Math.Ceiling(flatSlots.Count / (double)Math.Max(1, settings.BarcodesPerSticker));

    private string StickerStyle => $"width:{settings.StickerWidthMm}mm; height:{settings.StickerHeightMm}mm; margin:{settings.StickerGapMm / 2}mm;";

    private string SlotStyle(int slot)
    {
        var slotHeight = settings.StickerHeightMm / settings.BarcodesPerSticker;
        var border = settings.ShowDividerLine && slot > 0 ? "border-top:1px dashed #ccc;" : "";
        return $"height:{slotHeight}mm; {border}";
    }

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            var opp = new operations();
            allItems = new ItemCLS().GetAllOnlyItems(ref opp, "", 0);
        });
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
    }

    private Task<IEnumerable<Items>> SearchItemsAsync(string value, System.Threading.CancellationToken token)
    {
        IEnumerable<Items> result = string.IsNullOrWhiteSpace(value)
            ? allItems.Take(30)
            : allItems.Where(i => (!string.IsNullOrEmpty(i.Item_Name) && i.Item_Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                                   || (!string.IsNullOrEmpty(i.code) && i.code.Contains(value, StringComparison.OrdinalIgnoreCase))).Take(30);
        return Task.FromResult(result);
    }

    private void OnItemPicked(Items? item)
    {
        pendingItem = item;
        if (item != null)
        {
            pendingCode = item.code ?? "";
            pendingHeader = item.Item_Name ?? "";
        }
    }

    private void AddItem()
    {
        if (string.IsNullOrWhiteSpace(pendingCode))
        {
            Snackbar.Add(Tr("BarcodeCodeRequired"), Severity.Warning);
            return;
        }
        stickerItems.Add(new StickerItem { Code = pendingCode.Trim().ToUpperInvariant(), HeaderText = pendingHeader, Quantity = Math.Max(1, pendingQuantity) });
        pendingItem = null;
        pendingCode = "";
        pendingHeader = "";
        pendingQuantity = 1;
        Refresh();
    }

    private void RemoveItem(StickerItem item)
    {
        stickerItems.Remove(item);
        Refresh();
    }

    private void Refresh()
    {
        flatSlots = new List<StickerItem>();
        foreach (var it in stickerItems)
        {
            for (var q = 0; q < it.Quantity; q++)
            {
                flatSlots.Add(it);
            }
        }
        barcodeCache.Clear();
        StateHasChanged();
    }

    private string GetBarcodeUri(string code)
    {
        if (barcodeCache.TryGetValue(code, out var cached))
        {
            return cached;
        }
        try
        {
            var heightPx = Math.Max(30, (int)((settings.StickerHeightMm / settings.BarcodesPerSticker) * 6));
            var uri = BarcodeImageService.GeneratePngDataUri(code, BarcodeFormat.CODE_39, 260, heightPx);
            barcodeCache[code] = uri;
            return uri;
        }
        catch
        {
            return string.Empty;
        }
    }

    // يطبع منطقة الاستيكرات وحدها داخل iframe (راجع accountErpInterop.printElement فى interop.js)
    private async Task PrintAsync()
    {
        var w = settings.StickerWidthMm.ToString(CultureInfo.InvariantCulture);
        var h = settings.StickerHeightMm.ToString(CultureInfo.InvariantCulture);
        var pageCss = settings.OneStickerPerPage
            ? $"@page {{ size: {w}mm {h}mm; margin: 0; }} .sticker-page {{ display: block !important; }} .sticker {{ margin: 0 !important; border: none !important; break-after: page; page-break-after: always; }} .sticker:last-child {{ break-after: auto; page-break-after: auto; }}"
            : "@page { size: A4; margin: 5mm; } .sticker { border: none !important; break-inside: avoid; }";
        await JS.InvokeVoidAsync("accountErpInterop.printElement", ".print-area", Tr("BarcodeStickersTitle"), LangService.IsRtl ? "rtl" : "ltr", pageCss);
    }

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }
}
