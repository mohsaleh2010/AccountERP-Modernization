@page "/main-data/shipment-companies"

@* 🟢 النسخة Blazor من Connection4It.ShipmentCompanyLisFrm (WinForms، فى connectionit\ShipmentCompany\ShipmentCompanyLisFrm.cs).
   شركات الشحن = موردو خدمات فى جدول Supplier بعلامة IS_ShipmentCompany = 1 (قرار المستخدم 2026-10-23)، ولكل شركة حساب من النوع 65
   تحت الحساب الأب «شركات الشحن». الإضافة والإضافة المتعددة وتعديل الاسم والحذف كلها عبر AccountModelsLib.Services.ShipmentCompanyEFCLS
   (نفس الكود الذى تستخدمه شاشة الويندوز فورمز). صفوف جدول ShipmentCompany القديم تظهر فى تنبيه بزر استيراد صريح، ولا يتغير الجدول القديم.
   النموذج التفاعلى بنفس أسلوب CustomerGroupsList.razor (مودال إضافة + تعديل داخل الصف + حذف بتأكيد). *@

@using System.Globalization
@using AccountERP.SharedUI.Services
@using AccountModelsLib.Models
@using AccountModelsLib.Services
@inject LanguageService LangService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>@Tr("ShipmentCompaniesTitle")</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="mt-4" Style="@($"direction: {(LangService.IsRtl ? "rtl" : "ltr")};")">

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Color="Color.Primary" Class="font-weight-bold">@Tr("ShipmentCompaniesTitle")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@Tr("ShipmentCompaniesHint")</MudText>
            </MudStack>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenAddDialog">
                @Tr("AddShipmentCompany")
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (legacyNames.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
                <span>@Tr("ShipmentLegacyFound", legacyNames.Count, string.Join("، ", legacyNames))</span>
                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="ImportLegacy" Disabled="@isImporting">
                    @Tr("ShipmentLegacyImport")
                </MudButton>
            </MudStack>
        </MudAlert>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudTable Items="@companies" Hover="true" Striped="true" Bordered="true" Loading="@isLoading" Elevation="1" Breakpoint="Breakpoint.None">
        <HeaderContent>
            <MudTh>@Tr("NameColumn")</MudTh>
            <MudTh>@Tr("ShipmentAccountColumn")</MudTh>
            <MudTh Style="width:140px;"></MudTh>
        </HeaderContent>
        <RowTemplate>
            @if (editingId == context.Id)
            {
                <MudTd>
                    <MudTextField T="string" @bind-Value="editingName" Immediate="true" AutoFocus="true" OnKeyDown="@(e => OnEditKeyDown(e, context.Id))" />
                </MudTd>
                <MudTd>@AccountNo(context)</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" aria-label="@Tr("Save")"
                                   OnClick="@(() => SaveEdit(context.Id))" Disabled="@isSavingEdit" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" aria-label="@Tr("Close")" OnClick="CancelEdit" />
                </MudTd>
            }
            else
            {
                <MudTd>@context.Name</MudTd>
                <MudTd><span class="ship-acc-no">@AccountNo(context)</span></MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" aria-label="@Tr("DrawEditButton")" OnClick="@(() => StartEdit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" aria-label="@Tr("DeleteShipmentCompanyTitle")"
                                   OnClick="@(() => DeleteCompany(context))" />
                </MudTd>
            }
        </RowTemplate>
        <NoRecordsContent>
            <MudText Align="Align.Center" Class="py-4 mud-text-secondary">@Tr("NoShipmentCompaniesYet")</MudText>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

<MudDialog @bind-Visible="addDialogOpen"
           Options="@(new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small, CloseButton = true, BackdropClick = false })">
    <TitleContent>@Tr("AddShipmentCompany")</TitleContent>
    <DialogContent>
        @if (!string.IsNullOrEmpty(addErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@addErrorMessage</MudAlert>
        }
        <MudTextField T="string" @bind-Value="newName" Label="@Tr("NameColumn")" Variant="Variant.Outlined"
                      FullWidth="true" AutoFocus="true" Immediate="true" @ref="_nameField" OnKeyDown="OnNameKeyDown" />
        <MudCheckBox T="bool" @bind-Value="_addMultiple" Label="@Tr("MultipleAddLabel")" Color="Color.Primary" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => addDialogOpen = false)">@Tr("Close")</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ConfirmAdd" Disabled="@isSavingAdd">
            @if (isSavingAdd)
            {
                <MudProgressCircular Class="me-2" Size="Size.Small" Indeterminate="true" />
            }
            @Tr("Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ShipmentCompany> companies = new();
    private Dictionary<long, string> accountNos = new();
    private List<string> legacyNames = new();
    private bool isLoading = true;
    private bool isImporting;
    private string errorMessage = string.Empty;

    private long? editingId;
    private string editingName = string.Empty;
    private bool isSavingEdit;

    private bool addDialogOpen;
    private string newName = string.Empty;
    private string addErrorMessage = string.Empty;
    private bool isSavingAdd;

    protected override async Task OnInitializedAsync()
    {
        LangService.OnLanguageChanged += OnLanguageChangedHandler;
        await LoadCompanies();
    }

    private void OnLanguageChangedHandler() => InvokeAsync(StateHasChanged);

    private string Tr(string key, params object[] args)
    {
        var previousCulture = CultureInfo.CurrentUICulture;
        try
        {
            CultureInfo.CurrentUICulture = LangService.CurrentCultureInfo;
            return Lang[key, args];
        }
        finally
        {
            CultureInfo.CurrentUICulture = previousCulture;
        }
    }

    private string AccountNo(ShipmentCompany c) => accountNos.TryGetValue(c.SubAccount_Id, out var no) ? no : "";

    private async Task LoadCompanies()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            var data = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                var service = new ShipmentCompanyEFCLS();
                var list = service.GetAll();
                var ids = list.Select(c => c.SubAccount_Id).Where(id => id > 0).ToList();
                var nos = new AccountModelsLib.operations().db.Submain_Account
                    .Where(a => ids.Contains(a.Id)).Select(a => new { a.Id, a.SubAccount_NO }).ToList()
                    .ToDictionary(a => a.Id, a => a.SubAccount_NO ?? "");
                return (list, nos, service.GetLegacyNotImported());
            });
            companies = data.list;
            accountNos = data.nos;
            legacyNames = data.Item3;
        }
        catch (Exception ex)
        {
            errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // حفظ موحَّد (إضافة Id=0 أو تعديل اسم): يرجع رسالة الخطأ أو فارغ عند النجاح.
    private static async Task<string> SaveAsync(long id, string name)
    {
        int excp = 0;
        string msg = string.Empty;
        await Task.Run(() =>
        {
            AccountCultureGuard.EnsureInvariant();
            new ShipmentCompanyEFCLS().Save(ref excp, ref msg, id, name);
        });
        return excp == 0 ? string.Empty : msg;
    }

    private void OpenAddDialog()
    {
        newName = string.Empty;
        addErrorMessage = string.Empty;
        addDialogOpen = true;
    }

    // إضافة متعددة (بطلب المستخدم): عند تفعيلها يبقى الحوار مفتوحاً بعد كل إضافة ويُفرَّغ الاسم ويعود التركيز له؛ Esc يغلق الحوار؛ Enter يضيف.
    private bool _addMultiple;
    private bool _multipleAdded;
    private MudTextField<string>? _nameField;

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || isSavingAdd) return;
        await Task.Delay(150); // يترك آخر حرف مكتوب (Immediate) يصل للخادم قبل الحفظ
        await ConfirmAdd();
    }

    private async Task OnEditKeyDown(KeyboardEventArgs e, long id)
    {
        if (e.Key == "Escape") { CancelEdit(); return; }
        if (e.Key != "Enter" || isSavingEdit) return;
        await Task.Delay(150);
        await SaveEdit(id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_multipleAdded && _nameField is not null)
        {
            _multipleAdded = false;
            await _nameField.FocusAsync();
        }
    }

    private async Task ConfirmAdd()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            addErrorMessage = Tr("ShipmentCompanyNameRequired");
            return;
        }

        isSavingAdd = true;
        addErrorMessage = string.Empty;
        try
        {
            var error = await SaveAsync(0, newName);
            if (error != "") { addErrorMessage = error; return; }

            if (_addMultiple) { newName = string.Empty; _multipleAdded = true; } else { addDialogOpen = false; }
            await LoadCompanies();
            Snackbar.Add(Tr("ShipmentCompanyAdded"), Severity.Success);
        }
        catch (Exception ex)
        {
            addErrorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            isSavingAdd = false;
        }
    }

    private void StartEdit(ShipmentCompany company)
    {
        editingId = company.Id;
        editingName = company.Name;
        errorMessage = string.Empty;
    }

    private void CancelEdit()
    {
        editingId = null;
        editingName = string.Empty;
    }

    private async Task SaveEdit(long id)
    {
        if (string.IsNullOrWhiteSpace(editingName))
        {
            errorMessage = Tr("ShipmentCompanyNameRequired");
            return;
        }

        isSavingEdit = true;
        errorMessage = string.Empty;
        try
        {
            var error = await SaveAsync(id, editingName);
            if (error != "") { errorMessage = error; return; }
            editingId = null;
            await LoadCompanies();
            Snackbar.Add(Tr("StoreSaved"), Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            isSavingEdit = false;
        }
    }

    private async Task DeleteCompany(ShipmentCompany company)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            Tr("DeleteShipmentCompanyTitle"),
            Tr("DeleteShipmentCompanyConfirm", company.Name),
            yesText: Tr("Yes"), cancelText: Tr("No"));

        if (confirmed != true)
        {
            return;
        }

        errorMessage = string.Empty;
        try
        {
            int excp = 0;
            string msg = string.Empty;
            var id = company.Id;
            await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                new ShipmentCompanyEFCLS().Delete(ref excp, ref msg, id);
            });
            if (excp != 0) { errorMessage = msg; return; }
            await LoadCompanies();
            Snackbar.Add(Tr("ShipmentCompanyDeleted"), Severity.Success);
        }
        catch (Exception ex)
        {
            errorMessage = Tr("SystemError", ex.Message);
        }
    }

    // استيراد صريح لصفوف جدول ShipmentCompany القديم: كل اسم يُضاف بنفس Save (مورد + حساب)، والجدول القديم لا يتغير.
    private async Task ImportLegacy()
    {
        isImporting = true;
        errorMessage = string.Empty;
        try
        {
            string msg = string.Empty;
            int n = await Task.Run(() =>
            {
                AccountCultureGuard.EnsureInvariant();
                return new ShipmentCompanyEFCLS().ImportLegacy(ref msg);
            });
            await LoadCompanies();
            if (n > 0) Snackbar.Add(Tr("ShipmentLegacyImported", n), Severity.Success);
            if (!string.IsNullOrEmpty(msg)) errorMessage = msg;
        }
        catch (Exception ex)
        {
            errorMessage = Tr("SystemError", ex.Message);
        }
        finally
        {
            isImporting = false;
        }
    }

    public void Dispose()
    {
        LangService.OnLanguageChanged -= OnLanguageChangedHandler;
    }
}

<style>
    .ship-acc-no { font-variant-numeric: tabular-nums; color: var(--mud-palette-text-secondary); }
</style>
